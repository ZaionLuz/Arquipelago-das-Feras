--!strict
--[[
	BlenderModels.luau - Registry of all MeshPart IDs and creature rig data

	This module is the single source of truth for all Blender-imported creature data.
	Generated by the Blender export pipeline (scripts/blender/export_creatures.py).

	Naming convention: {species}_{stage}_{part}
	Hierarchy: Root → Body → Head/Neck → Limbs → Tail/Wings
	Motor6D joints: J_Body, J_Head, J_Neck, J_Leg1-4, J_WingL/R, J_Tail1-4
	Materials: SmoothPlastic (base), Neon (elemental accents), Glass (crystals)
	LODs: _LOD0 (full), _LOD1 (50%), _LOD2 (25%)
	Scale: 1 Blender unit = 1 stud
	Texture: Vertex colors only (palette from ArtTokens), no external textures
]]

local BlenderModels = {}

-- Type definitions
export type VertexColorData = { [number]: { r: number, g: number, b: number, a: number } }

export type MeshPartData = {
	MeshId: string,           -- Roblox asset ID (rbxassetid://...)
	Size: { number },         -- Vector3 as {x, y, z}
	CFrame: { number },       -- CFrame as 12 components
	Color: { number },        -- Color3 as {r, g, b}
	Material: string,         -- Enum.Material name
	Transparency: number?,
	VertexColors: VertexColorData?,
	LOD1MeshId: string?,      -- 50% reduction
	LOD2MeshId: string?,      -- 25% reduction
}

export type CreatureStageData = {
	Parts: { [string]: MeshPartData },
	AnimatorType: string,     -- "Generic", "Quadruped", "Bird", "Draconic", "Serpentine", etc.
	Scale: number,            -- Overall scale factor
	Bounds: {                 -- Bounding box for scaling reference
		Min: { number },
		Max: { number },
	},
}

export type CreatureData = {
	Species: string,
	DisplayName: string,
	Element: string,
	Family: string,
	Stages: { [number]: CreatureStageData },
	RigTemplate: string,      -- Name of rig template used
	ExportVersion: number,
	ExportTimestamp: number,
}

export type BlenderModelsRegistry = {
	Creatures: { [string]: CreatureData },
	MeshIdMap: { [string]: string },  -- Original name -> Asset ID
	Version: number,
	GeneratedAt: number,
	GitCommit: string?,
}

-- Registry version
BlenderModels.VERSION = 1
BlenderModels.GENERATED_AT = os.time()

--[[
	This table is POPULATED BY THE EXPORT PIPELINE.

	The Python script (scripts/blender/export_creatures.py) generates a JSON manifest
	which is then converted to this Lua format.

	Example structure for one creature:

	Creatures = {
		fenix = {
			Species = "fenix",
			DisplayName = "Fênix",
			Element = "Fogo",
			Family = "winged",
			Stages = {
				[1] = { -- Egg/Hatchling
					Parts = {
						Body = {
							MeshId = "rbxassetid://1234567890",
							Size = { 1.2, 0.9, 1.5 },
							CFrame = { 0, 0.8, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1 },
							Color = { 0.56, 0.15, 0.24 },
							Material = "SmoothPlastic",
							LOD1MeshId = "rbxassetid://1234567891",
							LOD2MeshId = "rbxassetid://1234567892",
						},
						Head = { ... },
						Leg1 = { ... },
						-- etc.
					},
					AnimatorType = "Bird",
					Scale = 0.65,
					Bounds = { Min = { -1, -1, -1 }, Max = { 1, 2, 1 } },
				},
				[2] = { ... }, -- Juvenile
				[3] = { ... }, -- Adult
			},
			RigTemplate = "CreatureRig_v1",
			ExportVersion = 1,
			ExportTimestamp = 1234567890,
		},
	},
]]

BlenderModels.Creatures = {}

-- Mesh ID mapping (populated after uploading to Roblox)
BlenderModels.MeshIdMap = {}

-- Helper functions
function BlenderModels.GetCreature(speciesId: string): CreatureData?
	return BlenderModels.Creatures[speciesId]
end

function BlenderModels.GetStage(speciesId: string, stage: number): CreatureStageData?
	local creature = BlenderModels.Creatures[speciesId]
	if not creature then return nil end
	return creature.Stages[stage]
end

function BlenderModels.GetPart(speciesId: string, stage: number, partName: string): MeshPartData?
	local stageData = BlenderModels.GetStage(speciesId, stage)
	if not stageData then return nil end
	return stageData.Parts[partName]
end

function BlenderModels.GetMeshId(speciesId: string, stage: number, partName: string, lod: number?): string?
	local part = BlenderModels.GetPart(speciesId, stage, partName)
	if not part then return nil end

	lod = lod or 0
	if lod == 1 and part.LOD1MeshId then
		return part.LOD1MeshId
	elseif lod == 2 and part.LOD2MeshId then
		return part.LOD2MeshId
	end
	return part.MeshId
end

function BlenderModels.ListSpecies(): { string }
	local species = {}
	for id, _ in BlenderModels.Creatures do
		table.insert(species, id)
	end
	table.sort(species)
	return species
end

function BlenderModels.ListStages(speciesId: string): { number }
	local creature = BlenderModels.Creatures[speciesId]
	if not creature then return {} end

	local stages = {}
	for stage, _ in creature.Stages do
		table.insert(stages, stage)
	end
	table.sort(stages)
	return stages
end

function BlenderModels.GetPartsForStage(speciesId: string, stage: number): { string }
	local stageData = BlenderModels.GetStage(speciesId, stage)
	if not stageData then return {} end

	local parts = {}
	for partName, _ in stageData.Parts do
		table.insert(parts, partName)
	end
	table.sort(parts)
	return parts
end

-- Validate registry integrity
function BlenderModels.Validate(): { valid: boolean, errors: { string } }
	local errors = {}

	for speciesId, creature in BlenderModels.Creatures do
		if creature.Species ~= speciesId then
			table.insert(errors, string.format("Species ID mismatch: key=%s, data=%s", speciesId, creature.Species))
		end

		if not creature.Stages or next(creature.Stages) == nil then
			table.insert(errors, string.format("Species %s has no stages", speciesId))
		end

		for stage, stageData in creature.Stages do
			if not stageData.Parts or next(stageData.Parts) == nil then
				table.insert(errors, string.format("Species %s stage %d has no parts", speciesId, stage))
			end

			for partName, partData in stageData.Parts do
				if not partData.MeshId or partData.MeshId == "" then
					table.insert(errors, string.format("Part %s_%s_%s missing MeshId", speciesId, stage, partName))
				end

				if not partData.Size or #partData.Size ~= 3 then
					table.insert(errors, string.format("Part %s_%s_%s invalid Size", speciesId, stage, partName))
				end

				if not partData.CFrame or #partData.CFrame ~= 12 then
					table.insert(errors, string.format("Part %s_%s_%s invalid CFrame", speciesId, stage, partName))
				end

				if not partData.Color or #partData.Color ~= 3 then
					table.insert(errors, string.format("Part %s_%s_%s invalid Color", speciesId, stage, partName))
				end

				if not partData.Material or partData.Material == "" then
					table.insert(errors, string.format("Part %s_%s_%s missing Material", speciesId, stage, partName))
				end
			end
		end
	end

	return { valid = #errors == 0, errors = errors }
end

-- Generate from JSON manifest (called by build script)
function BlenderModels.LoadFromManifest(manifestPath: string): boolean
	local HttpService = game:GetService("HttpService")
	local success, content = pcall(function()
		return HttpService:JSONDecode(game:GetService("AssetService"):GetFileContent(manifestPath))
	end)

	if not success then
		warn("Failed to load BlenderModels manifest:", content)
		return false
	end

	-- Convert manifest to runtime format
	BlenderModels.Creatures = content.Creatures or {}
	BlenderModels.MeshIdMap = content.MeshIdMap or {}
	BlenderModels.VERSION = content.Version or 1
	BlenderModels.GENERATED_AT = content.GeneratedAt or os.time()

	return true
end

-- Export to JSON (for pipeline integration)
function BlenderModels.ExportToJson(): string
	local HttpService = game:GetService("HttpService")

	local data = {
		Version = BlenderModels.VERSION,
		GeneratedAt = BlenderModels.GENERATED_AT,
		Creatures = BlenderModels.Creatures,
		MeshIdMap = BlenderModels.MeshIdMap,
	}

	return HttpService:JSONEncode(data)
end

-- Runtime helpers for animators
function BlenderModels.GetRigHierarchy(speciesId: string, stage: number): { [string]: string? }
	-- Returns mapping of part name -> parent part name
	local stageData = BlenderModels.GetStage(speciesId, stage)
	if not stageData then return {} end

	local hierarchy = {}

	for partName, _ in stageData.Parts do
		local parent = nil

		-- Determine parent based on part name
		if partName == "Body" then
			parent = "Root"
		elseif partName == "Head" or partName == "Neck" then
			parent = "Body"
		elseif partName:match("^Leg%d+$") then
			parent = "Body"
		elseif partName:match("^Wing[LR]$") then
			parent = "Body"
		elseif partName:match("^Tail%d+$") then
			local num = tonumber(partName:match("Tail(%d+)"))
			if num and num == 1 then
				parent = "Body"
			elseif num then
				parent = "Tail" .. (num - 1)
			end
		end

		hierarchy[partName] = parent
	end

	return hierarchy
end

function BlenderModels.GetJointName(partName: string): string
	-- Convert part name to Motor6D joint name
	return "J_" .. partName
end

function BlenderModels.GetLODMeshIds(speciesId: string, stage: number, partName: string): { string }
	local part = BlenderModels.GetPart(speciesId, stage, partName)
	if not part then return {} end

	local ids = { part.MeshId }
	if part.LOD1MeshId then table.insert(ids, part.LOD1MeshId) end
	if part.LOD2MeshId then table.insert(ids, part.LOD2MeshId) end
	return ids
end

return BlenderModels