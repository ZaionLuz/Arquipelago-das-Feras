-- Normalize grids: ensure exactly 16x16, spaces become dots
for name, grid in P.Grids do
	for index, row in grid do
		grid[index] = string.sub((row:gsub(" ", ".")) .. string.rep(".", 16), 1, 16)
	end
	assert(#grid == 16, name .. " must have 16 rows")
	for _, row in grid do
		assert(#row == 16, name .. " row must have 16 chars: " .. row)
	end
end

-- Draw icon as Frame with pixel-perfect colored rectangles
function P.draw(parent: Instance, name: string, size: number?, ramp: {Color3}? | Color3?): Frame
	local scale = math.max(1, math.floor(size and (size > 8 and size / 16 or size) or 2))
	local grid = P.Grids[name] or P.Grids.Fera

	-- Build color ramp
	local ink: {[string]: Color3}
	if typeof(ramp) == "Color3" then
		local c = ramp :: Color3
		ink = {
			a = Tokens.Shadow,
			b = Tokens.nearest(c:Lerp(Tokens.Shadow, 0.4)),
			c = c,
			d = c,
			e = Tokens.nearest(c:Lerp(Tokens.Ink, 0.5)),
		}
	else
		local r = (ramp :: {Color3}?) or Tokens.Ramps.Sand
		ink = { a = Tokens.Shadow, b = r[2], c = r[3], d = r[4], e = Tokens.nearest(r[4]:Lerp(Tokens.Ink, 0.5)) }
	end

	local canvas = Instance.new("Frame")
	canvas.Name = "PixelIcon_" .. name
	canvas.BackgroundTransparency = 1
	canvas.Size = UDim2.fromOffset(16 * scale, 16 * scale)
	canvas.Parent = parent

	for y, row in grid do
		local x = 1
		while x <= 16 do
			local symbol = row:sub(x, x)
			local stop = x
			while stop < 16 and row:sub(stop + 1, stop + 1) == symbol do
				stop += 1
			end
			if ink[symbol] then
				local run = Instance.new("Frame")
				run.Name = "Ink"
				run.BorderSizePixel = 0
				run.BackgroundColor3 = ink[symbol]
				run.Position = UDim2.fromOffset((x - 1) * scale, (y - 1) * scale)
				run.Size = UDim2.fromOffset((stop - x + 1) * scale, scale)
				run.ZIndex = canvas.ZIndex
				run.Parent = canvas
			end
			x = stop + 1
		end
	end

	return canvas
end

-- Draw icon into existing frame (for dynamic updates)
function P.drawInto(frame: Frame, name: string, ramp: {Color3}? | Color3?)
	frame:ClearAllChildren()
	frame.Size = UDim2.fromOffset(16, 16)
	P.draw(frame, name, 1, ramp)
end

-- Get grid data for custom rendering
function P.getGrid(name: string): {string}?
	return P.Grids[name]
end

-- List all available icon names
function P.listIcons(): {string}
	local names = {}
	for name in P.Grids do
		table.insert(names, name)
	end
	table.sort(names)
	return names
end

