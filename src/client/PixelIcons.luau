-- Get or generate icon for a creature
function P.getCreatureIcon(speciesId: string): {string}
	-- Check for specific icon first
	if P.Grids[speciesId] then
		return P.Grids[speciesId]
	end
	-- Generate procedural icon based on element + shape
	return P.generateCreatureIcon(speciesId)
end

-- Pre-generate icons for all creatures in the catalog
function P.preloadAllCreatureIcons()
	local C = require(ReplicatedStorage.Shared.Creatures)
	for _, def in C.List do
		if not P.Grids[def.id] then
			P.Grids[def.id] = P.generateCreatureIcon(def.id)
		end
	end
end

-- Enhanced draw that handles creature IDs
function P.drawCreature(parent: Instance, speciesId: string, size: number?): Frame
	local grid = P.getCreatureIcon(speciesId)
	local C = require(ReplicatedStorage.Shared.Creatures)
	local def = C.ById[speciesId]
	local ramp = def and Tokens.Elements[def.el] or Tokens.Ramps.Sand

	-- Create a temporary grid entry for drawing
	local tempName = "__creature_" .. speciesId
	P.Grids[tempName] = grid
	local frame = P.draw(parent, tempName, size, ramp)
	P.Grids[tempName] = nil
	return frame
end

-- Initialize: preload all creature icons
P.preloadAllCreatureIcons()

return P