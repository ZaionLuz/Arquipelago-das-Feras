    <Item class="Script" referent="14">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source">--!strict
-- Server Entry Point - Arquipélago das Feras

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- Load shared modules
local Types = require(ReplicatedStorage.Shared.Types)
local Config = require(ReplicatedStorage.Shared.Config)
local MathUtil = require(ReplicatedStorage.Shared.Util.Math)
local TableUtil = require(ReplicatedStorage.Shared.Util.Table)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

-- Load server systems
local DataStoreSystem = require(ServerScriptService.Server.Systems.DataStoreSystem)
local CreatureSystem = require(ServerScriptService.Server.Systems.CreatureSystem)
local BattleSystem = require(ServerScriptService.Server.Systems.BattleSystem)
local SpawnSystem = require(ServerScriptService.Server.Systems.SpawnSystem)
local PartySystem = require(ServerScriptService.Server.Systems.PartySystem)
local ItemSystem = require(ServerScriptService.Server.Systems.ItemSystem)
local EvolutionSystem = require(ServerScriptService.Server.Systems.EvolutionSystem)
local NPCSystem = require(ServerScriptService.Server.Systems.NPCSystem)
local QuestSystem = require(ServerScriptService.Server.Systems.QuestSystem)
local RemoteSystem = require(ServerScriptService.Server.Systems.RemoteSystem)

-- Server state
local ServerState = {
	IsInitialized = false,
	PlayerData = {} :: {[number]: Types.PlayerData},
	ActiveBattles = {} :: {[string]: Types.BattleData},
	SpawnedCreatures = {} :: {[string]: Model},
}

-- Initialize remotes
RemoteSystem.Initialize()

-- Initialize NPC and Quest systems
NPCSystem.Initialize()
QuestSystem.Initialize()

-- Player joining
Players.PlayerAdded:Connect(function(player: Player)
	print(`[Server] Player joined: {player.Name}`)

	-- Load player data
	local success, playerData = DataStoreSystem.LoadPlayerData(player.UserId)
	if success and playerData then
		ServerState.PlayerData[player.UserId] = playerData
		print(`[Server] Loaded data for {player.Name}`)
	else
		-- Create new player data
		playerData = DataStoreSystem.CreateNewPlayerData(player)
		ServerState.PlayerData[player.UserId] = playerData
		print(`[Server] Created new data for {player.Name}`)
	end

	-- Initialize party system for player
	PartySystem.InitializePlayer(player, playerData)

	-- Initialize quest system for player
	QuestSystem.OnPlayerJoin(player)

	-- Fire client loaded event
	RemoteSystem.FireClient(player, "DataLoaded", playerData)
end)

-- Player leaving
Players.PlayerRemoving:Connect(function(player: Player)
	print(`[Server] Player leaving: {player.Name}`)

	-- Save player data
	local playerData = ServerState.PlayerData[player.UserId]
	if playerData then
		DataStoreSystem.SavePlayerData(player.UserId, playerData)
		ServerState.PlayerData[player.UserId] = nil
	end

	-- Clean up any active battles
	for battleId, battle in pairs(ServerState.ActiveBattles) do
		if battle.PlayerSide then
			for _, participant in ipairs(battle.PlayerSide) do
				if participant.Creature and participant.Creature.Id == player.UserId then
					BattleSystem.EndBattle(battleId, "PlayerLeft")
					break
				end
			end
		end
	end

	PartySystem.CleanupPlayer(player)
	QuestSystem.OnPlayerLeave(player)
end)

-- Game closing
game:BindToClose(function()
	print("[Server] Game closing, saving all player data...")
	for userId, playerData in pairs(ServerState.PlayerData) do
		DataStoreSystem.SavePlayerData(userId, playerData)
	end
	task.wait(2)
end)

-- Heartbeat for systems that need it
RunService.Heartbeat:Connect(function(deltaTime: number)
	SpawnSystem.Update(deltaTime)
	BattleSystem.Update(deltaTime)
end)

-- Initialize spawn system
SpawnSystem.Initialize()

ServerState.IsInitialized = true
print("[Server] Arquipélago das Feras server initialized!")

return nil</string>
      </Properties>
      <Item class="Folder" referent="15">
        <Properties>
          <string name="Name">Systems</string>
        </Properties>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">BattleSystem</string>
            <string name="Source">--!strict
-- BattleSystem.lua - Sistema de batalha (turn-based estilo Pokémon)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Types = require(ReplicatedStorage.Shared.Types)
local Config = require(ReplicatedStorage.Shared.Config)
local MathUtil = require(ReplicatedStorage.Shared.Util.Math)
local TableUtil = require(ReplicatedStorage.Shared.Util.Table)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local BattleSystem = {}

-- Events
BattleSystem.OnBattleStarted = Signal.New()
BattleSystem.OnBattleEnded = Signal.New()
BattleSystem.OnTurnChanged = Signal.New()
BattleSystem.OnMoveUsed = Signal.New()
BattleSystem.OnCreatureFainted = Signal.New()
BattleSystem.OnStatusChanged = Signal.New()

-- Active battles
local ActiveBattles = {} :: {[string]: Types.BattleData}
local BattleQueue = {} :: {Types.BattleData}

-- Battle constants
local TURN_TIMEOUT = 30 -- seconds

-- Start wild battle
function BattleSystem.StartWildBattle(player: Player, wildCreature: Types.CreatureData): Types.BattleData
	local battleId = game:GetService("HttpService"):GenerateGUID(false)

	-- Get player's first alive creature
	local partySystem = require(script.Parent.PartySystem)
	local playerCreature = partySystem.GetFirstAlive(player)

	if not playerCreature then
		error("Player has no alive creatures!")
	end

	-- Create battle participants
	local playerParticipant: Types.BattleParticipant = {
		Creature = playerCreature,
		IsPlayer = true,
		StatStages = {
			Attack = 0, Defense = 0, SpecialAttack = 0, SpecialDefense = 0, Speed = 0,
			Accuracy = 0, Evasion = 0,
		},
		VolatileStatus = {},
		LastMoveUsed = nil,
		TurnsAsleep = 0,
		TurnsFrozen = 0,
	}

	local enemyParticipant: Types.BattleParticipant = {
		Creature = wildCreature,
		IsPlayer = false,
		StatStages = {
			Attack = 0, Defense = 0, SpecialAttack = 0, SpecialDefense = 0, Speed = 0,
			Accuracy = 0, Evasion = 0,
		},
		VolatileStatus = {},
		LastMoveUsed = nil,
		TurnsAsleep = 0,
		TurnsFrozen = 0,
	}

	local battle: Types.BattleData = {
		Id = battleId,
		State = "TurnStart",
		PlayerSide = {playerParticipant},
		EnemySide = {enemyParticipant},
		Weather = "None",
		Terrain = "None",
		TurnCount = 0,
		Seed = math.random(1000000),
	}

	ActiveBattles[battleId] = battle

	-- Set creatures to battling state
	playerCreature.State = "Battling"
	wildCreature.State = "Battling"

	BattleSystem.OnBattleStarted:Fire(battle, player)

	return battle
end

-- Start trainer battle (placeholder)
function BattleSystem.StartTrainerBattle(player: Player, trainerData: any): Types.BattleData
	-- Similar to wild battle but with trainer's team
	return BattleSystem.StartWildBattle(player, trainerData.Team[1])
end

-- Process battle action
function BattleSystem.ProcessAction(battleId: string, action: Types.BattleAction): Types.BattleResult
	local battle = ActiveBattles[battleId]
	if not battle then
		return {Success = false, EffectMessages = {"Battle not found"}}
	end

	if battle.State ~= "PlayerTurn" and battle.State ~= "EnemyTurn" then
		return {Success = false, EffectMessages = {"Not your turn"}}
	end

	local isPlayerTurn = battle.State == "PlayerTurn"
	local actor = isPlayerTurn and battle.PlayerSide[1] or battle.EnemySide[1]
	local target = isPlayerTurn and battle.EnemySide[1] or battle.PlayerSide[1]

	if action.Type == "Move" then
		return BattleSystem.ExecuteMove(battle, actor, target, action.MoveId, action.TargetIndex)
	elseif action.Type == "Switch" then
		return BattleSystem.ExecuteSwitch(battle, actor, action.SwitchIndex)
	elseif action.Type == "Item" then
		return BattleSystem.ExecuteItem(battle, actor, action.ItemId)
	elseif action.Type == "Run" then
		return BattleSystem.ExecuteRun(battle, actor)
	end

	return {Success = false, EffectMessages = {"Invalid action"}}
end

-- Execute move
function BattleSystem.ExecuteMove(
	battle: Types.BattleData,
	actor: Types.BattleParticipant,
	target: Types.BattleParticipant,
	moveId: string,
	targetIndex: number?
): Types.BattleResult
	local move = BattleSystem.GetMoveById(moveId)
	if not move then
		return {Success = false, EffectMessages = {"Move not found"}}
	end

	-- Check PP
	if move.PP &lt;= 0 then
		return {Success = false, EffectMessages = {"No PP left for this move"}}
	end

	-- Check if actor can move (status conditions)
	local canMove, message = BattleSystem.CheckCanMove(actor)
	if not canMove then
		return {Success = false, EffectMessages = {message}}
	end

	move.PP -= 1
	actor.LastMoveUsed = moveId

	-- Calculate accuracy
	local accuracy = move.Accuracy * BattleSystem.GetAccuracyModifier(actor, target)
	local hit = math.random(100) &lt;= accuracy

	if not hit then
		return {
			Success = true,
			Damage = 0,
			EffectMessages = {`{actor.Creature.SpeciesId} usou {move.Name}, mas errou!`},
		}
	end

	-- Calculate damage
	local damage = 0
	local messages = {}

	if move.Category ~= "Status" then
		damage = BattleSystem.CalculateDamage(actor, target, move, battle)
		target.Creature.CurrentHP = math.max(0, target.Creature.CurrentHP - damage)

		table.insert(messages, `{actor.Creature.SpeciesId} usou {move.Name}!`)
		table.insert(messages, `Causou {damage} de dano!`)

		-- Check effectiveness
		local effectiveness = BattleSystem.GetEffectiveness(move.Type, target.Creature.SpeciesId)
		if effectiveness &gt; 1 then
			table.insert(messages, "Foi super efetivo!")
		elseif effectiveness &lt; 1 and effectiveness &gt; 0 then
			table.insert(messages, "Não foi muito efetivo...")
		elseif effectiveness == 0 then
			table.insert(messages, "Não teve efeito!")
		end

		-- Check critical hit
		local isCrit = BattleSystem.CheckCriticalHit(actor, move)
		if isCrit then
			damage = math.floor(damage * 1.5)
			table.insert(messages, "Acerto crítico!")
		end
	else
		table.insert(messages, `{actor.Creature.SpeciesId} usou {move.Name}!`)
	end

	-- Apply move effects
	if move.Effect then
		local effectMessages = BattleSystem.ApplyMoveEffect(actor, target, move, battle)
		for _, msg in ipairs(effectMessages) do
			table.insert(messages, msg)
		end
	end

	-- Check for faint
	local fainted = false
	if target.Creature.CurrentHP &lt;= 0 then
		target.Creature.CurrentHP = 0
		target.Creature.Status = "Fainted"
		fainted = true
		table.insert(messages, `{target.Creature.SpeciesId} desmaiou!`)
		BattleSystem.OnCreatureFainted:Fire(battle, target)
	end

	BattleSystem.OnMoveUsed:Fire(battle, actor, target, move, damage)

	return {
		Success = true,
		Damage = damage,
		EffectMessages = messages,
		Fainted = fainted,
		StateChange = fainted and "BattleEnd" or nil,
	}
end

-- Check if actor can move
function BattleSystem.CheckCanMove(actor: Types.BattleParticipant): (boolean, string?)
	local creature = actor.Creature

	if creature.Status == "Sleep" then
		actor.TurnsAsleep += 1
		if actor.TurnsAsleep &gt;= 3 or math.random() &lt; 0.2 then
			creature.Status = "None"
			actor.TurnsAsleep = 0
			return true, ""
		end
		return false, `{creature.SpeciesId} está dormindo!`
	end

	if creature.Status == "Freeze" then
		actor.TurnsFrozen += 1
		if math.random() &lt; 0.2 then
			creature.Status = "None"
			actor.TurnsFrozen = 0
			return true, ""
		end
		return false, `{creature.SpeciesId} está congelado!`
	end

	if creature.Status == "Paralysis" then
		if math.random() &lt; 0.25 then
			return false, `{creature.SpeciesId} está paralisado e não consegue se mover!`
		end
	end

	if creature.Status == "Confusion" then
		if math.random() &lt; 0.33 then
			-- Self damage
			return false, `{creature.SpeciesId} se machucou na confusão!`
		end
	end

	return true, ""
end

-- Calculate damage
function BattleSystem.CalculateDamage(
	actor: Types.BattleParticipant,
	target: Types.BattleParticipant,
	move: Types.Move,
	battle: Types.BattleData
): number
	local attacker = actor.Creature
	local defender = target.Creature

	local attackStat = move.Category == "Physical" and attacker.Stats.Attack or attacker.Stats.SpecialAttack
	local defenseStat = move.Category == "Physical" and defender.Stats.Defense or defender.Stats.SpecialDefense

	-- Apply stat stages
	attackStat = BattleSystem.ApplyStatStage(attackStat, actor.StatStages[move.Category == "Physical" and "Attack" or "SpecialAttack"])
	defenseStat = BattleSystem.ApplyStatStage(defenseStat, target.StatStages[move.Category == "Physical" and "Defense" or "SpecialDefense"])

	-- Base damage formula
	local level = attacker.Level
	local power = move.Power or 0

	local baseDamage = math.floor((((2 * level / 5 + 2) * power * attackStat / defenseStat) / 50) + 2)

	-- Random factor (85-100%)
	baseDamage = math.floor(baseDamage * (0.85 + math.random() * 0.15))

	-- STAB (Same Type Attack Bonus)
	local speciesData = Config.SpeciesList[attacker.SpeciesId]
	if speciesData and (speciesData.Element == move.Type or (speciesData.Element == "FireWater" and (move.Type == "Fire" or move.Type == "Water"))) then
		baseDamage = math.floor(baseDamage * 1.5)
	end

	-- Type effectiveness
	local effectiveness = BattleSystem.GetEffectiveness(move.Type, defender.SpeciesId)
	baseDamage = math.floor(baseDamage * effectiveness)

	-- Burn reduces physical damage
	if attacker.Status == "Burn" and move.Category == "Physical" then
		baseDamage = math.floor(baseDamage * 0.5)
	end

	-- Weather effects
	if battle.Weather == "Sunny" then
		if move.Type == "Fire" then baseDamage = math.floor(baseDamage * 1.5) end
		if move.Type == "Water" then baseDamage = math.floor(baseDamage * 0.5) end
	elseif battle.Weather == "Rain" then
		if move.Type == "Water" then baseDamage = math.floor(baseDamage * 1.5) end
		if move.Type == "Fire" then baseDamage = math.floor(baseDamage * 0.5) end
	end

	return math.max(1, baseDamage)
end

-- Apply stat stage
function BattleSystem.ApplyStatStage(stat: number, stage: number): number
	if stage &gt; 0 then
		return math.floor(stat * (2 + stage) / 2)
	elseif stage &lt; 0 then
		return math.floor(stat * 2 / (2 - stage))
	end
	return stat
end

-- Get accuracy modifier
function BattleSystem.GetAccuracyModifier(actor: Types.BattleParticipant, target: Types.BattleParticipant): number
	local accStage = actor.StatStages.Accuracy or 0
	local evaStage = target.StatStages.Evasion or 0
	local stageDiff = accStage - evaStage

	if stageDiff &gt; 0 then
		return (3 + stageDiff) / 3
	elseif stageDiff &lt; 0 then
		return 3 / (3 - stageDiff)
	end
	return 1
end

-- Get type effectiveness
function BattleSystem.GetEffectiveness(moveType: string, defenderSpeciesId: string): number
	local defenderData = Config.SpeciesList[defenderSpeciesId]
	if not defenderData then return 1 end

	local defenderType = defenderData.Element
	local effectivenessTable = Config.TypeEffectiveness[moveType]

	if effectivenessTable and effectivenessTable[defenderType] then
		return effectivenessTable[defenderType]
	end

	return 1
end

-- Check critical hit
function BattleSystem.CheckCriticalHit(actor: Types.BattleParticipant, move: Types.Move): boolean
	local critRate = move.Priority &gt; 0 and 0.5 or 0.0625 -- 6.25% base, 50% for high priority

	-- Focus Energy effect would increase this

	return math.random() &lt; critRate
end

-- Apply move effects
function BattleSystem.ApplyMoveEffect(
	actor: Types.BattleParticipant,
	target: Types.BattleParticipant,
	move: Types.Move,
	battle: Types.BattleData
): {string}
	local messages = {}
	local effect = move.Effect
	local chance = effect.Chance or 100

	if math.random(100) &gt; chance then
		return messages
	end

	if effect.Type == "Status" then
		local status = effect.Params.Status
		if target.Creature.Status == "None" then
			target.Creature.Status = status
			table.insert(messages, `{target.Creature.SpeciesId} ficou {status}!`)
			BattleSystem.OnStatusChanged:Fire(battle, target, status)
		end
	elseif effect.Type == "StatChange" then
		local stat = effect.Params.Stat
		local change = effect.Params.Change
		target.StatStages[stat] = MathUtil.Clamp((target.StatStages[stat] or 0) + change, -6, 6)
		local direction = change &gt; 0 and "subiu" or "caiu"
		table.insert(messages, `{stat} de {target.Creature.SpeciesId} {direction}!`)
	elseif effect.Type == "Heal" then
		local amount = effect.Params.Amount or 0
		local healed = math.min(target.Creature.Stats.HP - target.Creature.CurrentHP, amount)
		target.Creature.CurrentHP += healed
		table.insert(messages, `{target.Creature.SpeciesId} recuperou {healed} HP!`)
	elseif effect.Type == "Charge" then
		-- Move requires charging (like Solar Beam)
		table.insert(messages, `{actor.Creature.SpeciesId} está carregando energia!`)
		actor.VolatileStatus.Charging = {MoveId = move.Id, Turns = effect.Params.Turns or 1}
	end

	return messages
end

-- Execute switch
function BattleSystem.ExecuteSwitch(battle: Types.BattleData, actor: Types.BattleParticipant, switchIndex: number?): Types.BattleResult
	-- Implementation for switching creatures
	return {Success = true, EffectMessages = {"Switch executed"}, StateChange = "TurnEnd"}
end

-- Execute item
function BattleSystem.ExecuteItem(battle: Types.BattleData, actor: Types.BattleParticipant, itemId: string?): Types.BattleResult
	-- Implementation for using items
	return {Success = true, EffectMessages = {"Item used"}, StateChange = "TurnEnd"}
end

-- Execute run
function BattleSystem.ExecuteRun(battle: Types.BattleData, actor: Types.BattleParticipant): Types.BattleResult
	local canRun = true -- Would check speed, trapping moves, etc.

	if canRun then
		BattleSystem.EndBattle(battle.Id, "Fled")
		return {Success = true, EffectMessages = {"Fugiu com sucesso!"}, StateChange = "BattleEnd"}
	else
		return {Success = false, EffectMessages = {"Não conseguiu fugir!"}}
	end
end

-- Get move by ID
function BattleSystem.GetMoveById(moveId: string): Types.Move?
	-- Simplified - in reality would look up from move database
	local moveDatabase: {[string]: Types.Move} = {
		Tackle = {Id = "Tackle", Name = "Investida", Type = "Nature", Category = "Physical", Power = 40, Accuracy = 100, PP = 35, MaxPP = 35, Priority = 0},
		Ember = {Id = "Ember", Name = "Brasa", Type = "Fire", Category = "Special", Power = 40, Accuracy = 100, PP = 25, MaxPP = 25, Priority = 0, Effect = {Type = "Status", Params = {Status = "Burn"}, Chance = 10}},
		WaterGun = {Id = "WaterGun", Name = "Jato d'Água", Type = "Water", Category = "Special", Power = 40, Accuracy = 100, PP = 25, MaxPP = 25, Priority = 0},
		VineWhip = {Id = "VineWhip", Name = "Chicote de Vinha", Type = "Nature", Category = "Physical", Power = 45, Accuracy = 100, PP = 25, MaxPP = 25, Priority = 0},
		RockThrow = {Id = "RockThrow", Name = "Lançamento de Rocha", Type = "Earth", Category = "Physical", Power = 50, Accuracy = 90, PP = 15, MaxPP = 15, Priority = 0},
		Gust = {Id = "Gust", Name = "Ventania", Type = "Air", Category = "Special", Power = 40, Accuracy = 100, PP = 35, MaxPP = 35, Priority = 0},
		ShadowSneak = {Id = "ShadowSneak", Name = "Golpe Sombrio", Type = "Shadow", Category = "Physical", Power = 40, Accuracy = 100, PP = 30, MaxPP = 30, Priority = 1},
		Flamethrower = {Id = "Flamethrower", Name = "Lança-chamas", Type = "Fire", Category = "Special", Power = 90, Accuracy = 100, PP = 15, MaxPP = 15, Priority = 0, Effect = {Type = "Status", Params = {Status = "Burn"}, Chance = 10}},
		HydroPump = {Id = "HydroPump", Name = "Hidro Bomba", Type = "Water", Category = "Special", Power = 110, Accuracy = 80, PP = 5, MaxPP = 5, Priority = 0},
		SolarBeam = {Id = "SolarBeam", Name = "Raio Solar", Type = "Nature", Category = "Special", Power = 120, Accuracy = 100, PP = 10, MaxPP = 10, Priority = 0, Effect = {Type = "Charge", Params = {Turns = 1}, Chance = 0}},
		Earthquake = {Id = "Earthquake", Name = "Terremoto", Type = "Earth", Category = "Physical", Power = 100, Accuracy = 100, PP = 10, MaxPP = 10, Priority = 0},
		Hurricane = {Id = "Hurricane", Name = "Furacão", Type = "Air", Category = "Special", Power = 110, Accuracy = 70, PP = 10, MaxPP = 10, Priority = 0, Effect = {Type = "Status", Params = {Status = "Confusion"}, Chance = 30}},
		ShadowBall = {Id = "ShadowBall", Name = "Bola Sombria", Type = "Shadow", Category = "Special", Power = 80, Accuracy = 100, PP = 15, MaxPP = 15, Priority = 0, Effect = {Type = "StatChange", Params = {Stat = "SpecialDefense", Change = -1}, Chance = 20}},
	}

	return moveDatabase[moveId]
end

-- End battle
function BattleSystem.EndBattle(battleId: string, result: "PlayerWon" | "EnemyWon" | "Fled" | "PlayerLeft")
	local battle = ActiveBattles[battleId]
	if not battle then return end

	-- Reset creature states
	for _, participant in ipairs(battle.PlayerSide) do
		participant.Creature.State = "InParty"
	end
	for _, participant in ipairs(battle.EnemySide) do
		participant.Creature.State = "Wild"
	end

	ActiveBattles[battleId] = nil
	BattleSystem.OnBattleEnded:Fire(battle, result)
end

-- Update loop
function BattleSystem.Update(deltaTime: number)
	-- Handle battle timeouts, weather effects, etc.
	for battleId, battle in pairs(ActiveBattles) do
		-- Apply weather damage
		if battle.Weather == "Sandstorm" then
			for _, participant in ipairs({...battle.PlayerSide, ...battle.EnemySide}) do
				if participant.Creature.CurrentHP &gt; 0 then
					local speciesData = Config.SpeciesList[participant.Creature.SpeciesId]
					if speciesData and not TableUtil.Contains({"Earth", "Rock", "Steel"}, speciesData.Element) then
						participant.Creature.CurrentHP = math.max(0, participant.Creature.CurrentHP - math.floor(participant.Creature.Stats.HP / 16))
					end
				end
			end
		end

		-- Apply status damage
		for _, participant in ipairs({...battle.PlayerSide, ...battle.EnemySide}) do
			local creature = participant.Creature
			if creature.Status == "Burn" or creature.Status == "Poison" then
				local damage = math.floor(creature.Stats.HP / (creature.Status == "Burn" and 16 or 8))
				creature.CurrentHP = math.max(0, creature.CurrentHP - damage)
				if creature.CurrentHP &lt;= 0 then
					creature.CurrentHP = 0
					creature.Status = "Fainted"
					BattleSystem.OnCreatureFainted:Fire(battle, participant)
				end
			end
		end
	end
end

return BattleSystem</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">CreatureSystem</string>
            <string name="Source">--!strict
-- CreatureSystem.lua - Sistema de criaturas (spawn, captura, stats, evolução)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local RunService = game:GetService("RunService")

local Types = require(ReplicatedStorage.Shared.Types)
local Config = require(ReplicatedStorage.Shared.Config)
local MathUtil = require(ReplicatedStorage.Shared.Util.Math)
local TableUtil = require(ReplicatedStorage.Shared.Util.Table)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local CreatureSystem = {}

-- Events
CreatureSystem.OnCreatureSpawned = Signal.New()
CreatureSystem.OnCreatureCaptured = Signal.New()
CreatureSystem.OnCreatureReleased = Signal.New()
CreatureSystem.OnCreatureEvolved = Signal.New()
CreatureSystem.OnCreatureLevelUp = Signal.New()

-- Active wild creatures in world
local WildCreatures = {} :: {[string]: Types.CreatureData &amp; {Model: Model?, SpawnTime: number, ZoneId: string}}
local CreatureModels = {} :: {[string]: Model}

-- Species data cache
local SpeciesCache = Config.SpeciesList

-- Generate a wild creature
function CreatureSystem.GenerateWildCreature(speciesId: string, level: number, zoneId: string): Types.CreatureData
	local speciesData = SpeciesCache[speciesId]
	if not speciesData then
		warn(`[CreatureSystem] Species not found: {speciesId}`)
		speciesData = SpeciesCache.CINZELO
	end

	local ivs = CreatureSystem.GenerateIVs()
	local nature = CreatureSystem.GetRandomNature()
	local isShiny = math.random() &lt; Config.Game.ShinyRate

	-- Calculate stats
	local stats = CreatureSystem.CalculateStats(speciesData.BaseStats, ivs, {}, level, nature)

	-- Get moves for this level
	local moves = CreatureSystem.GetMovesForLevel(speciesId, level)

	local creature: Types.CreatureData = {
		Id = game:GetService("HttpService"):GenerateGUID(false),
		SpeciesId = speciesId,
		Nickname = nil,
		Level = level,
		Experience = CreatureSystem.GetExpForLevel(level),
		Stats = stats,
		IVs = ivs,
		EVs = {HP = 0, Attack = 0, Defense = 0, SpecialAttack = 0, SpecialDefense = 0, Speed = 0},
		Nature = nature,
		Ability = speciesData.Abilities[math.random(#speciesData.Abilities)],
		Moves = moves,
		CurrentHP = stats.HP,
		Status = "None",
		State = "Wild",
		CaughtAt = 0,
		CaughtLocation = zoneId,
		OriginalTrainer = "",
		IsShiny = isShiny,
		Gender = CreatureSystem.GetRandomGender(speciesData),
		EvolutionStage = CreatureSystem.GetEvolutionStage(speciesId),
		Friendship = 0,
	}

	return creature
end

-- Generate IVs
function CreatureSystem.GenerateIVs(): Types.IVs
	return {
		HP = math.random(0, 31),
		Attack = math.random(0, 31),
		Defense = math.random(0, 31),
		SpecialAttack = math.random(0, 31),
		SpecialDefense = math.random(0, 31),
		Speed = math.random(0, 31),
	}
end

-- Get random nature
function CreatureSystem.GetRandomNature(): string
	local natures = {}
	for name in pairs(Config.Natures) do
		table.insert(natures, name)
	end
	return natures[math.random(#natures)]
end

-- Get random gender
function CreatureSystem.GetRandomGender(speciesData: Types.SpeciesData): "Male" | "Female" | "Genderless"
	-- Most are 50/50, legendaries genderless
	if speciesData.Rarity == "Legendary" then
		return "Genderless"
	end
	return math.random() &lt; 0.5 and "Male" or "Female"
end

-- Get evolution stage
function CreatureSystem.GetEvolutionStage(speciesId: string): 1 | 2 | 3
	-- Check if this species evolves from something
	for _, data in pairs(SpeciesCache) do
		if data.Evolutions and data.Evolutions.TargetSpecies == speciesId then
			-- This is an evolution
			local baseData = SpeciesCache[data.Evolutions.TargetSpecies]
			if baseData and baseData.Evolutions then
				return 3
			end
			return 2
		end
	end

	-- Check if this species evolves into something
	if SpeciesCache[speciesId] and SpeciesCache[speciesId].Evolutions then
		return 1
	end

	return 1 -- Base form or no evolution
end

-- Calculate stats
function CreatureSystem.CalculateStats(
	baseStats: Types.CreatureStats,
	ivs: Types.IVs,
	evs: Types.EVs,
	level: number,
	nature: string
): Types.CreatureStats
	local natureMod = Config.Natures[nature] or Config.Natures.Hardy

	local function calcStat(base: number, iv: number, ev: number, isHP: boolean): number
		if isHP then
			return math.floor(((2 * base + iv + math.floor(ev / 4)) * level) / 100) + level + 10
		else
			local stat = math.floor(((2 * base + iv + math.floor(ev / 4)) * level) / 100) + 5
			-- Apply nature modifier
			local mod = 1.0
			if not isHP then
				-- Map stat names to nature keys
				-- This is simplified - in reality you'd map each stat properly
			end
			return math.floor(stat * mod)
		end
	end

	return {
		HP = math.floor(((2 * baseStats.HP + ivs.HP + math.floor(evs.HP / 4)) * level) / 100) + level + 10,
		Attack = math.floor((((2 * baseStats.Attack + ivs.Attack + math.floor(evs.Attack / 4)) * level) / 100) + 5) * (natureMod.Atk or 1.0),
		Defense = math.floor((((2 * baseStats.Defense + ivs.Defense + math.floor(evs.Defense / 4)) * level) / 100) + 5) * (natureMod.Def or 1.0),
		SpecialAttack = math.floor((((2 * baseStats.SpecialAttack + ivs.SpecialAttack + math.floor(evs.SpecialAttack / 4)) * level) / 100) + 5) * (natureMod.SpA or 1.0),
		SpecialDefense = math.floor((((2 * baseStats.SpecialDefense + ivs.SpecialDefense + math.floor(evs.SpecialDefense / 4)) * level) / 100) + 5) * (natureMod.SpD or 1.0),
		Speed = math.floor((((2 * baseStats.Speed + ivs.Speed + math.floor(evs.Speed / 4)) * level) / 100) + 5) * (natureMod.Spe or 1.0),
	}
end

-- Get exp for level
function CreatureSystem.GetExpForLevel(level: number): number
	local curve = Config.ExpCurves[Config.Game.ExpCurve] or Config.ExpCurves.Medium
	return curve(level)
end

-- Get moves for level
function CreatureSystem.GetMovesForLevel(speciesId: string, level: number): {Types.Move}
	local speciesData = SpeciesCache[speciesId]
	local moves = {}

	if speciesData and speciesData.Learnset then
		for lvl, moveId in pairs(speciesData.Learnset) do
			if lvl &lt;= level then
				table.insert(moves, CreatureSystem.CreateMove(moveId))
			end
		end
	end

	-- Sort by level learned (descending) and take last 4
	table.sort(moves, function(a, b) return (a.Priority or 0) &gt; (b.Priority or 0) end)
	while #moves &gt; 4 do
		table.remove(moves, 1)
	end

	return moves
end

-- Create move
function CreatureSystem.CreateMove(moveId: string): Types.Move
	local moveDatabase: {[string]: Types.Move} = {
		Tackle = {Id = "Tackle", Name = "Investida", Type = "Nature", Category = "Physical", Power = 40, Accuracy = 100, PP = 35, MaxPP = 35, Priority = 0},
		Ember = {Id = "Ember", Name = "Brasa", Type = "Fire", Category = "Special", Power = 40, Accuracy = 100, PP = 25, MaxPP = 25, Priority = 0, Effect = {Type = "Status", Params = {Status = "Burn"}, Chance = 10}},
		WaterGun = {Id = "WaterGun", Name = "Jato d'Água", Type = "Water", Category = "Special", Power = 40, Accuracy = 100, PP = 25, MaxPP = 25, Priority = 0},
		VineWhip = {Id = "VineWhip", Name = "Chicote de Vinha", Type = "Nature", Category = "Physical", Power = 45, Accuracy = 100, PP = 25, MaxPP = 25, Priority = 0},
		RockThrow = {Id = "RockThrow", Name = "Lançamento de Rocha", Type = "Earth", Category = "Physical", Power = 50, Accuracy = 90, PP = 15, MaxPP = 15, Priority = 0},
		Gust = {Id = "Gust", Name = "Ventania", Type = "Air", Category = "Special", Power = 40, Accuracy = 100, PP = 35, MaxPP = 35, Priority = 0},
		ShadowSneak = {Id = "ShadowSneak", Name = "Golpe Sombrio", Type = "Shadow", Category = "Physical", Power = 40, Accuracy = 100, PP = 30, MaxPP = 30, Priority = 1},
		Flamethrower = {Id = "Flamethrower", Name = "Lança-chamas", Type = "Fire", Category = "Special", Power = 90, Accuracy = 100, PP = 15, MaxPP = 15, Priority = 0, Effect = {Type = "Status", Params = {Status = "Burn"}, Chance = 10}},
		HydroPump = {Id = "HydroPump", Name = "Hidro Bomba", Type = "Water", Category = "Special", Power = 110, Accuracy = 80, PP = 5, MaxPP = 5, Priority = 0},
		SolarBeam = {Id = "SolarBeam", Name = "Raio Solar", Type = "Nature", Category = "Special", Power = 120, Accuracy = 100, PP = 10, MaxPP = 10, Priority = 0, Effect = {Type = "Charge", Params = {Turns = 1}, Chance = 0}},
		Earthquake = {Id = "Earthquake", Name = "Terremoto", Type = "Earth", Category = "Physical", Power = 100, Accuracy = 100, PP = 10, MaxPP = 10, Priority = 0},
		Hurricane = {Id = "Hurricane", Name = "Furacão", Type = "Air", Category = "Special", Power = 110, Accuracy = 70, PP = 10, MaxPP = 10, Priority = 0, Effect = {Type = "Status", Params = {Status = "Confusion"}, Chance = 30}},
		ShadowBall = {Id = "ShadowBall", Name = "Bola Sombria", Type = "Shadow", Category = "Special", Power = 80, Accuracy = 100, PP = 15, MaxPP = 15, Priority = 0, Effect = {Type = "StatChange", Params = {Stat = "SpecialDefense", Change = -1}, Chance = 20}},
	}

	return moveDatabase[moveId] or moveDatabase.Tackle
end

-- Spawn creature in world
function CreatureSystem.SpawnCreatureInWorld(creature: Types.CreatureData, position: Vector3, zoneId: string): string
	local spawnId = game:GetService("HttpService"):GenerateGUID(false)

	creature.State = "Wild"
	creature.CaughtLocation = zoneId

	local spawnData = {
		Creature = creature,
		Model = nil,
		SpawnTime = tick(),
		ZoneId = zoneId,
		Position = position,
	}

	WildCreatures[spawnId] = spawnData

	-- Load model from ServerStorage/Assets
	local model = CreatureSystem.LoadCreatureModel(creature.SpeciesId)
	if model then
		model = model:Clone()
		model.Name = `Wild_{creature.SpeciesId}_{spawnId}`
		model.Parent = workspace
		model:PivotTo(CFrame.new(position))

		-- Scale based on species size
		local speciesData = SpeciesCache[creature.SpeciesId]
		if speciesData then
			local scale = speciesData.Height / 2 -- Normalize
			model:ScaleTo(scale)
		end

		-- Add interaction
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Capturar"
		prompt.ObjectText = creature.SpeciesId
		prompt.HoldDuration = 1
		prompt.RequiresLineOfSight = false
		prompt.Parent = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")

		prompt.Triggered:Connect(function(player)
			CreatureSystem.OnCreatureSpawned:Fire(player, spawnId, creature)
		end)

		spawnData.Model = model
	end

	return spawnId
end

-- Load creature model
function CreatureSystem.LoadCreatureModel(speciesId: string): Model?
	local assets = ServerStorage:FindFirstChild("ServerAssets")
	if assets then
		local model = assets:FindFirstChild(speciesId)
		if model then
			return model
		end
	end
	return nil
end

-- Despawn creature
function CreatureSystem.DespawnCreature(spawnId: string)
	local spawnData = WildCreatures[spawnId]
	if spawnData then
		if spawnData.Model then
			spawnData.Model:Destroy()
		end
		WildCreatures[spawnId] = nil
	end
end

-- Calculate capture rate
function CreatureSystem.CalculateCaptureRate(
	creature: Types.CreatureData,
	ballType: string,
	playerPartyCount: number
): number
	local speciesData = SpeciesCache[creature.SpeciesId]
	if not speciesData then return 0 end

	-- Base capture rate by rarity
	local baseRate = 0
	if speciesData.Rarity == "Common" then baseRate = 0.4
	elseif speciesData.Rarity == "Rare" then baseRate = 0.2
	elseif speciesData.Rarity == "Epic" then baseRate = 0.1
	elseif speciesData.Rarity == "Legendary" then baseRate = 0.03
	end

	-- HP factor (lower HP = higher catch rate)
	local hpFactor = 1 - (creature.CurrentHP / creature.Stats.HP) * 0.5

	-- Status condition bonus
	local statusBonus = 1
	if creature.Status == "Sleep" or creature.Status == "Freeze" then
		statusBonus = 2.5
	elseif creature.Status == "Paralysis" or creature.Status == "Poison" or creature.Status == "Burn" then
		statusBonus = 1.5
	end

	-- Ball multiplier
	local ballMultiplier = 1
	if ballType == "GreatBall" then ballMultiplier = 1.5
	elseif ballType == "UltraBall" then ballMultiplier = 2.0
	elseif ballType == "MasterBall" then ballMultiplier = 255
	end

	-- Level difference penalty
	local levelDiff = creature.Level - 5 -- Assume player level ~5 for now
	if levelDiff &gt; 10 then
		ballMultiplier *= 0.5
	elseif levelDiff &gt; 20 then
		ballMultiplier *= 0.25
	end

	-- Party size bonus (smaller party = easier catch)
	local partyBonus = 1 + (6 - playerPartyCount) * 0.05

	local finalRate = baseRate * hpFactor * statusBonus * ballMultiplier * partyBonus

	return MathUtil.Clamp(finalRate, 0, 1)
end

-- Attempt capture
function CreatureSystem.AttemptCapture(
	player: Player,
	spawnId: string,
	ballType: string
): (boolean, Types.CreatureData?)
	local spawnData = WildCreatures[spawnId]
	if not spawnData then
		return false, nil
	end

	local creature = spawnData.Creature
	local partySystem = require(script.Parent.PartySystem)
	local partyCount = #partySystem.GetPlayerParty(player)

	local captureRate = CreatureSystem.CalculateCaptureRate(creature, ballType, partyCount)
	local roll = math.random()

	if roll &lt;= captureRate or ballType == "MasterBall" then
		-- Success!
		creature.State = "Captured"
		creature.CaughtAt = tick()
		creature.OriginalTrainer = player.Name
		creature.Nickname = nil

		-- Add to party or storage
		local added = partySystem.AddToParty(player, creature)
		if not added then
			partySystem.AddToStorage(player, creature)
		end

		-- Despawn
		CreatureSystem.DespawnCreature(spawnId)

		CreatureSystem.OnCreatureCaptured:Fire(player, creature)

		return true, creature
	else
		-- Failed - creature might flee
		local fleeChance = 0.1 * (1 - captureRate)
		if math.random() &lt; fleeChance then
			CreatureSystem.DespawnCreature(spawnId)
		end

		return false, nil
	end
end

-- Heal creature
function CreatureSystem.HealCreature(creature: Types.CreatureData, amount: number?): number
	if amount and amount &gt; 0 then
		creature.CurrentHP = math.min(creature.Stats.HP, creature.CurrentHP + amount)
	else
		creature.CurrentHP = creature.Stats.HP
		creature.Status = "None"
	end
	return creature.CurrentHP
end

-- Damage creature
function CreatureSystem.DamageCreature(creature: Types.CreatureData, damage: number): number
	creature.CurrentHP = math.max(0, creature.CurrentHP - damage)
	if creature.CurrentHP &lt;= 0 then
		creature.CurrentHP = 0
		creature.Status = "Fainted"
	end
	return creature.CurrentHP
end

-- Gain experience
function CreatureSystem.GainExperience(creature: Types.CreatureData, exp: number): {LeveledUp: boolean, NewLevel: number?, NewMoves: {Types.Move}?}
	local oldLevel = creature.Level
	creature.Experience += exp

	-- Check for level up
	local newLevel = oldLevel
	while creature.Experience &gt;= CreatureSystem.GetExpForLevel(newLevel + 1) and newLevel &lt; Config.Game.MaxLevel do
		newLevel += 1
	end

	local result = {LeveledUp = false, NewLevel = nil, NewMoves = nil}

	if newLevel &gt; oldLevel then
		creature.Level = newLevel
		result.LeveledUp = true
		result.NewLevel = newLevel

		-- Recalculate stats
		local speciesData = SpeciesCache[creature.SpeciesId]
		if speciesData then
			creature.Stats = CreatureSystem.CalculateStats(speciesData.BaseStats, creature.IVs, creature.EVs, newLevel, creature.Nature)
			creature.CurrentHP = creature.Stats.HP -- Full heal on level up
		end

		-- Learn new moves
		local newMoves = CreatureSystem.GetMovesForLevel(creature.SpeciesId, newLevel)
		local learnedNew = false
		for _, move in ipairs(newMoves) do
			local hasMove = false
			for _, existing in ipairs(creature.Moves) do
				if existing.Id == move.Id then
					hasMove = true
					break
				end
			end
			if not hasMove then
				learnedNew = true
				if #creature.Moves &gt;= 4 then
					-- Would need to replace - handled by LearnMove system
				else
					table.insert(creature.Moves, move)
				end
			end
		end

		if learnedNew then
			result.NewMoves = newMoves
		end

		CreatureSystem.OnCreatureLevelUp:Fire(creature, oldLevel, newLevel)
	end

	return result
end

-- Check evolution
function CreatureSystem.CheckEvolution(creature: Types.CreatureData): Types.EvolutionData?
	local speciesData = SpeciesCache[creature.SpeciesId]
	if not speciesData or not speciesData.Evolutions then
		return nil
	end

	local evo = speciesData.Evolutions

	if evo.Method == "Level" and creature.Level &gt;= evo.Requirement then
		return evo
	elseif evo.Method == "Friendship" and creature.Friendship &gt;= evo.Requirement then
		return evo
	-- Other methods (Item, Trade, TimeOfDay, Location) would be checked elsewhere
	end

	return nil
end

-- Evolve creature
function CreatureSystem.EvolveCreature(creature: Types.CreatureData, targetSpeciesId: string): Types.CreatureData
	local oldSpeciesId = creature.SpeciesId
	creature.SpeciesId = targetSpeciesId
	creature.EvolutionStage += 1

	-- Update stats for new species
	local newSpeciesData = SpeciesCache[targetSpeciesId]
	if newSpeciesData then
		creature.Stats = CreatureSystem.CalculateStats(newSpeciesData.BaseStats, creature.IVs, creature.EVs, creature.Level, creature.Nature)
		creature.CurrentHP = creature.Stats.HP

		-- Update ability
		creature.Ability = newSpeciesData.Abilities[math.random(#newSpeciesData.Abilities)]

		-- Learn new moves for this level
		local newMoves = CreatureSystem.GetMovesForLevel(targetSpeciesId, creature.Level)
		creature.Moves = newMoves
	end

	CreatureSystem.OnCreatureEvolved:Fire(creature, oldSpeciesId, targetSpeciesId)

	return creature
end

-- Get creature display info
function CreatureSystem.GetDisplayInfo(creature: Types.CreatureData): {Name: string, Element: string, Rarity: string, Level: number, HP: number, MaxHP: number, IsShiny: boolean}
	local speciesData = SpeciesCache[creature.SpeciesId]
	return {
		Name = creature.Nickname or (speciesData and speciesData.Name or creature.SpeciesId),
		Element = speciesData and speciesData.Element or "Unknown",
		Rarity = speciesData and speciesData.Rarity or "Common",
		Level = creature.Level,
		HP = creature.CurrentHP,
		MaxHP = creature.Stats.HP,
		IsShiny = creature.IsShiny,
	}
end

return CreatureSystem</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">DataStoreSystem</string>
            <string name="Source">--!strict
-- DataStoreSystem.lua - Persistência segura de dados do jogador

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Types = require(game.ReplicatedStorage.Shared.Types)
local Config = require(game.ReplicatedStorage.Shared.Config)
local Signal = require(game.ReplicatedStorage.Shared.Util.Signal)

local DataStoreSystem = {}

-- DataStores
local PlayerDataStore = DataStoreService:GetDataStore("PlayerData_v2")
local BackupDataStore = DataStoreService:GetDataStore("PlayerData_Backup_v2")
local GlobalDataStore = DataStoreService:GetDataStore("GlobalData_v2")

-- Session locking
local SessionLocks = {} :: {[number]: boolean}
local PendingSaves = {} :: {[number]: Types.PlayerData}
local SAVE_INTERVAL = 60 -- segundos
local MAX_RETRIES = 3
local RETRY_DELAY = 2

-- Events
DataStoreSystem.OnDataLoaded = Signal.New()
DataStoreSystem.OnDataSaved = Signal.New()
DataStoreSystem.OnDataError = Signal.New()

-- Generate session lock token
local function GenerateSessionToken(): string
	return `{game.JobId}-{tick()}-{math.random(1000000)}`
end

-- Acquire session lock
local function AcquireSessionLock(userId: number): (boolean, string?)
	local token = GenerateSessionToken()
	local lockKey = `SessionLock_{userId}`

	for attempt = 1, MAX_RETRIES do
		local success, result = pcall(function()
			return PlayerDataStore:UpdateAsync(lockKey, function(oldValue)
				if oldValue and oldValue.Token and oldValue.Token ~= token then
					-- Check if lock is stale (older than 10 minutes)
					if oldValue.Timestamp and (tick() - oldValue.Timestamp) &gt; 600 then
						return {Token = token, Timestamp = tick(), UserId = userId}
					end
					return nil -- Lock held by another server
				end
				return {Token = token, Timestamp = tick(), UserId = userId}
			end)
		end)

		if success and result and result.Token == token then
			SessionLocks[userId] = true
			return true, token
		end

		task.wait(RETRY_DELAY)
	end

	return false, nil
end

-- Release session lock
local function ReleaseSessionLock(userId: number, token: string)
	local lockKey = `SessionLock_{userId}`

	pcall(function()
		PlayerDataStore:UpdateAsync(lockKey, function(oldValue)
			if oldValue and oldValue.Token == token then
				return nil -- Release lock
			end
			return oldValue -- Keep existing lock
		end)
	end)

	SessionLocks[userId] = nil
end

-- Load player data with session locking
function DataStoreSystem.LoadPlayerData(userId: number): (boolean, Types.PlayerData?)
	local lockAcquired, token = AcquireSessionLock(userId)
	if not lockAcquired then
		warn(`[DataStore] Could not acquire session lock for user {userId}`)
		return false, nil
	end

	local success, data = pcall(function()
		return PlayerDataStore:GetAsync(`Player_{userId}`)
	end)

	ReleaseSessionLock(userId, token)

	if success and data then
		-- Validate data structure
		if DataStoreSystem.ValidatePlayerData(data) then
			DataStoreSystem.OnDataLoaded:Fire(userId, data)
			return true, data
		else
			warn(`[DataStore] Invalid data structure for user {userId}, attempting backup`)
			return DataStoreSystem.LoadFromBackup(userId)
		end
	elseif success and not data then
		-- New player
		return true, nil
	else
		warn(`[DataStore] Failed to load data for user {userId}: {data}`)
		DataStoreSystem.OnDataError:Fire(userId, "LoadFailed", data)
		return false, nil
	end
end

-- Load from backup
function DataStoreSystem.LoadFromBackup(userId: number): (boolean, Types.PlayerData?)
	local success, data = pcall(function()
		return BackupDataStore:GetAsync(`Player_{userId}`)
	end)

	if success and data and DataStoreSystem.ValidatePlayerData(data) then
		warn(`[DataStore] Restored from backup for user {userId}`)
		return true, data
	end

	return false, nil
end

-- Save player data
function DataStoreSystem.SavePlayerData(userId: number, playerData: Types.PlayerData): boolean
	if not SessionLocks[userId] then
		warn(`[DataStore] No session lock for user {userId}, attempting to acquire...`)
		local lockAcquired, token = AcquireSessionLock(userId)
		if not lockAcquired then
			-- Queue for later
			PendingSaves[userId] = playerData
			return false
		end
		-- Save with acquired lock
		local result = DataStoreSystem.SavePlayerDataInternal(userId, playerData, token)
		ReleaseSessionLock(userId, token)
		return result
	end

	-- We have the lock, save directly
	return DataStoreSystem.SavePlayerDataInternal(userId, playerData, GenerateSessionToken())
end

-- Internal save with token
function DataStoreSystem.SavePlayerDataInternal(userId: number, playerData: Types.PlayerData, token: string): boolean
	-- Update timestamp
	playerData.LastSaved = tick()

	local success, result = pcall(function()
		-- Save to main DataStore
		PlayerDataStore:SetAsync(`Player_{userId}`, playerData)

		-- Save to backup
		BackupDataStore:SetAsync(`Player_{userId}`, playerData)
	end)

	if success then
		PendingSaves[userId] = nil
		DataStoreSystem.OnDataSaved:Fire(userId)
		return true
	else
		warn(`[DataStore] Failed to save data for user {userId}: {result}`)
		DataStoreSystem.OnDataError:Fire(userId, "SaveFailed", result)
		-- Queue for retry
		PendingSaves[userId] = playerData
		return false
	end
end

-- Create new player data
function DataStoreSystem.CreateNewPlayerData(player: Player): Types.PlayerData
	local starterCreature = DataStoreSystem.GenerateStarterCreature()

	return {
		UserId = player.UserId,
		Username = player.Name,
		Money = 1000,
		Party = {starterCreature},
		Storage = {{}, {}, {}, {}, {}, {}, {}, {}}, -- 8 boxes
		CurrentZone = "StarterTown",
		PlayTime = 0,
		Badges = {},
		Settings = {
			MusicVolume = 0.7,
			SFXVolume = 0.8,
			BattleSpeed = 1.0,
			AutoSave = true,
			Language = "pt-BR",
		},
		LastSaved = tick(),
	}
end

-- Generate starter creature
function DataStoreSystem.GenerateStarterCreature(): Types.CreatureData
	-- Random starter from Common Fire, Water, Nature
	local starters = {"CINZELO", "HIDROSONDA", "VERDANTIS"}
	local speciesId = starters[math.random(#starters)]
	local speciesData = Config.SpeciesList[speciesId]

	local ivs = DataStoreSystem.GenerateIVs()
	local nature = DataStoreSystem.GetRandomNature()

	return {
		Id = game:GetService("HttpService"):GenerateGUID(false),
		SpeciesId = speciesId,
		Nickname = nil,
		Level = 5,
		Experience = 0,
		Stats = DataStoreSystem.CalculateStats(speciesData.BaseStats, ivs, {}, 5, nature),
		IVs = ivs,
		EVs = {HP = 0, Attack = 0, Defense = 0, SpecialAttack = 0, SpecialDefense = 0, Speed = 0},
		Nature = nature,
		Ability = speciesData.Abilities[1],
		Moves = DataStoreSystem.GetStartingMoves(speciesId, 5),
		CurrentHP = 0, -- Will be set to MaxHP
		Status = "None",
		State = "InParty",
		CaughtAt = tick(),
		CaughtLocation = "StarterTown",
		OriginalTrainer = "",
		IsShiny = math.random() &lt; Config.Game.ShinyRate,
		Gender = "Male",
		EvolutionStage = 1,
		Friendship = 70,
	}
end

-- Generate random IVs (0-31)
function DataStoreSystem.GenerateIVs(): Types.IVs
	return {
		HP = math.random(0, 31),
		Attack = math.random(0, 31),
		Defense = math.random(0, 31),
		SpecialAttack = math.random(0, 31),
		SpecialDefense = math.random(0, 31),
		Speed = math.random(0, 31),
	}
end

-- Get random nature
function DataStoreSystem.GetRandomNature(): string
	local natures = {}
	for name in pairs(Config.Natures) do
		table.insert(natures, name)
	end
	return natures[math.random(#natures)]
end

-- Calculate stats from base, IVs, EVs, level, nature
function DataStoreSystem.CalculateStats(
	baseStats: Types.CreatureStats,
	ivs: Types.IVs,
	evs: Types.EVs,
	level: number,
	nature: string
): Types.CreatureStats
	local natureMod = Config.Natures[nature] or Config.Natures.Hardy

	local function calcStat(base: number, iv: number, ev: number, isHP: boolean): number
		if isHP then
			return math.floor(((2 * base + iv + math.floor(ev / 4)) * level) / 100) + level + 10
		else
			local stat = math.floor(((2 * base + iv + math.floor(ev / 4)) * level) / 100) + 5
			return math.floor(stat * (natureMod[isHP and "HP" or "Atk"] or 1.0))
		end
	end

	return {
		HP = calcStat(baseStats.HP, ivs.HP, evs.HP, true),
		Attack = calcStat(baseStats.Attack, ivs.Attack, evs.Attack, false),
		Defense = calcStat(baseStats.Defense, ivs.Defense, evs.Defense, false),
		SpecialAttack = calcStat(baseStats.SpecialAttack, ivs.SpecialAttack, evs.SpecialAttack, false),
		SpecialDefense = calcStat(baseStats.SpecialDefense, ivs.SpecialDefense, evs.SpecialDefense, false),
		Speed = calcStat(baseStats.Speed, ivs.Speed, evs.Speed, false),
	}
end

-- Get starting moves for species at level
function DataStoreSystem.GetStartingMoves(speciesId: string, level: number): {Types.Move}
	local speciesData = Config.SpeciesList[speciesId]
	local moves = {}

	if speciesData and speciesData.Learnset then
		for lvl, moveId in pairs(speciesData.Learnset) do
			if lvl &lt;= level then
				table.insert(moves, DataStoreSystem.CreateMove(moveId))
			end
		end
	end

	-- Limit to 4 moves
	while #moves &gt; 4 do
		table.remove(moves, 1)
	end

	return moves
end

-- Create move from ID
function DataStoreSystem.CreateMove(moveId: string): Types.Move
	-- Simplified move database
	local moveDatabase: {[string]: Types.Move} = {
		Tackle = {Id = "Tackle", Name = "Investida", Type = "Nature", Category = "Physical", Power = 40, Accuracy = 100, PP = 35, MaxPP = 35, Priority = 0},
		Ember = {Id = "Ember", Name = "Brasa", Type = "Fire", Category = "Special", Power = 40, Accuracy = 100, PP = 25, MaxPP = 25, Priority = 0, Effect = {Type = "Status", Params = {Status = "Burn"}, Chance = 10}},
		WaterGun = {Id = "WaterGun", Name = "Jato d'Água", Type = "Water", Category = "Special", Power = 40, Accuracy = 100, PP = 25, MaxPP = 25, Priority = 0},
		VineWhip = {Id = "VineWhip", Name = "Chicote de Vinha", Type = "Nature", Category = "Physical", Power = 45, Accuracy = 100, PP = 25, MaxPP = 25, Priority = 0},
		RockThrow = {Id = "RockThrow", Name = "Lançamento de Rocha", Type = "Earth", Category = "Physical", Power = 50, Accuracy = 90, PP = 15, MaxPP = 15, Priority = 0},
		Gust = {Id = "Gust", Name = "Ventania", Type = "Air", Category = "Special", Power = 40, Accuracy = 100, PP = 35, MaxPP = 35, Priority = 0},
		ShadowSneak = {Id = "ShadowSneak", Name = "Golpe Sombrio", Type = "Shadow", Category = "Physical", Power = 40, Accuracy = 100, PP = 30, MaxPP = 30, Priority = 1},
	}

	return moveDatabase[moveId] or moveDatabase.Tackle
end

-- Validate player data structure
function DataStoreSystem.ValidatePlayerData(data: any): boolean
	if type(data) ~= "table" then return false end
	if type(data.UserId) ~= "number" then return false end
	if type(data.Money) ~= "number" then return false end
	if type(data.Party) ~= "table" then return false end
	if type(data.Storage) ~= "table" then return false end
	if type(data.Settings) ~= "table" then return false end
	return true
end

-- Auto-save loop
task.spawn(function()
	while true do
		task.wait(SAVE_INTERVAL)

		for userId, playerData in pairs(PendingSaves) do
			if SessionLocks[userId] then
				DataStoreSystem.SavePlayerData(userId, playerData)
			else
				local lockAcquired, token = AcquireSessionLock(userId)
				if lockAcquired then
					DataStoreSystem.SavePlayerDataInternal(userId, playerData, token)
					ReleaseSessionLock(userId, token)
				end
			end
		end

		-- Also save all loaded players periodically
		-- (In production, this would iterate through active players)
	end
end)

-- Process pending saves on player leave
function DataStoreSystem.ProcessPendingSaves(userId: number)
	local playerData = PendingSaves[userId]
	if playerData then
		DataStoreSystem.SavePlayerData(userId, playerData)
	end
end

return DataStoreSystem</string>
          </Properties>
        </Item>
