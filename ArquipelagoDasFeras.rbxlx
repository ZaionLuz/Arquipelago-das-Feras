            <string name="Source">--!strict
-- RemoteSystem.lua - Gerenciamento de RemoteEvents/Functions tipados

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Types = require(ReplicatedStorage.Shared.Types)
local Config = require(ReplicatedStorage.Shared.Config)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local RemoteSystem = {}

-- Remote instances
local Remotes = {} :: {[string]: RemoteEvent | RemoteFunction}
local RemoteFolder: Folder

-- Event handlers
local EventHandlers = {} :: {[string]: (...any) -&gt; ...any}
local FunctionHandlers = {} :: {[string]: (...any) -&gt; ...any}

-- Initialize remotes
function RemoteSystem.Initialize()
	RemoteFolder = Instance.new("Folder")
	RemoteFolder.Name = "Remotes"
	RemoteFolder.Parent = ReplicatedStorage

	-- Create all remotes
	RemoteSystem.CreateRemotes()

	-- Connect server listeners
	RemoteSystem.ConnectServerListeners()

	print("[RemoteSystem] Initialized with " .. #TableUtil.Keys(Remotes) .. " remotes")
end

-- Helper
local TableUtil = require(ReplicatedStorage.Shared.Util.Table)

-- Create all remote events/functions
function RemoteSystem.CreateRemotes()
	local remoteDefs = {
		-- Data
		DataLoaded = {Type = "Event", ClientToServer = false},
		RequestData = {Type = "Function", ClientToServer = true},
		SaveGame = {Type = "Function", ClientToServer = true},

		-- Party
		GetParty = {Type = "Function", ClientToServer = true},
		GetStorage = {Type = "Function", ClientToServer = true},
		SwapParty = {Type = "Event", ClientToServer = true},
		MoveToStorage = {Type = "Event", ClientToServer = true},
		MoveToParty = {Type = "Event", ClientToServer = true},
		ReleaseCreature = {Type = "Event", ClientToServer = true},
		NicknameCreature = {Type = "Event", ClientToServer = true},

		-- Creatures
		CaptureCreature = {Type = "Function", ClientToServer = true},
		GetCreatureInfo = {Type = "Function", ClientToServer = true},
		HealCreature = {Type = "Event", ClientToServer = true},
		EvolveCreature = {Type = "Function", ClientToServer = true},
		LearnMove = {Type = "Event", ClientToServer = true},
		ReplaceMove = {Type = "Event", ClientToServer = true},

		-- Battle
		StartBattle = {Type = "Function", ClientToServer = true},
		BattleAction = {Type = "Function", ClientToServer = true},
		GetBattleState = {Type = "Function", ClientToServer = true},
		ForfeitBattle = {Type = "Event", ClientToServer = true},

		-- Items
		GetInventory = {Type = "Function", ClientToServer = true},
		UseItem = {Type = "Function", ClientToServer = true},
		BuyItem = {Type = "Event", ClientToServer = true},
		SellItem = {Type = "Event", ClientToServer = true},

		-- Spawn/World
		GetNearbyCreatures = {Type = "Function", ClientToServer = true},
		RequestSpawn = {Type = "Event", ClientToServer = true},

		-- Player
		GetPlayerData = {Type = "Function", ClientToServer = true},
		UpdateSettings = {Type = "Event", ClientToServer = true},

		-- Social/Trading (future)
		RequestTrade = {Type = "Event", ClientToServer = true},
		AcceptTrade = {Type = "Event", ClientToServer = true},
		CancelTrade = {Type = "Event", ClientToServer = true},

		-- NPC Interaction
		InteractNPC = {Type = "Function", ClientToServer = true},
		NPCHealComplete = {Type = "Event", ClientToServer = false},
		NPCShopBuy = {Type = "Function", ClientToServer = true},
		NPCShopSell = {Type = "Function", ClientToServer = true},

		-- Quests
		GetQuests = {Type = "Function", ClientToServer = true},
		AcceptQuest = {Type = "Function", ClientToServer = true},
		TurnInQuest = {Type = "Function", ClientToServer = true},
		AbandonQuest = {Type = "Event", ClientToServer = true},
		QuestProgress = {Type = "Event", ClientToServer = false},

	for name, def in pairs(remoteDefs) do
		local remote: RemoteEvent | RemoteFunction

		if def.Type == "Event" then
			remote = Instance.new("RemoteEvent")
		else
			remote = Instance.new("RemoteFunction")
		end

		remote.Name = name
		remote.Parent = RemoteFolder
		Remotes[name] = remote
	end
end

-- Connect server-side listeners
function RemoteSystem.ConnectServerListeners()
	-- Data
	RemoteSystem.OnServerInvoke("RequestData", function(player: Player)
		local dataStoreSystem = require(script.Parent.DataStoreSystem)
		return dataStoreSystem.LoadPlayerData(player.UserId)
	end)

	RemoteSystem.OnServerInvoke("SaveGame", function(player: Player)
		local dataStoreSystem = require(script.Parent.DataStoreSystem)
		-- Player data is saved automatically, but can force save
		return true
	end)

	-- Party
	RemoteSystem.OnServerInvoke("GetParty", function(player: Player)
		local partySystem = require(script.Parent.PartySystem)
		return partySystem.GetPartySummary(player)
	end)

	RemoteSystem.OnServerInvoke("GetStorage", function(player: Player, boxIndex: number?)
		local partySystem = require(script.Parent.PartySystem)
		if boxIndex then
			return partySystem.GetStorageBox(player, boxIndex)
		else
			return partySystem.GetPlayerStorage(player)
		end
	end)

	RemoteSystem.OnServerEvent("SwapParty", function(player: Player, index1: number, index2: number)
		local partySystem = require(script.Parent.PartySystem)
		return partySystem.SwapPartyMembers(player, index1, index2)
	end)

	RemoteSystem.OnServerEvent("MoveToStorage", function(player: Player, creatureId: string)
		local partySystem = require(script.Parent.PartySystem)
		return partySystem.MoveCreature(player, creatureId, "Party", "Storage")
	end)

	RemoteSystem.OnServerEvent("MoveToParty", function(player: Player, creatureId: string, boxIndex: number?)
		local partySystem = require(script.Parent.PartySystem)
		return partySystem.MoveCreature(player, creatureId, "Storage", "Party", boxIndex)
	end)

	RemoteSystem.OnServerEvent("ReleaseCreature", function(player: Player, creatureId: string)
		local partySystem = require(script.Parent.PartySystem)
		return partySystem.ReleaseCreature(player, creatureId)
	end)

	RemoteSystem.OnServerEvent("NicknameCreature", function(player: Player, creatureId: string, nickname: string)
		local partySystem = require(script.Parent.PartySystem)
		local party = partySystem.GetPlayerParty(player)
		for _, creature in ipairs(party) do
			if creature.Id == creatureId then
				creature.Nickname = nickname
				return true
			end
		end
		-- Check storage
		for _, box in ipairs(partySystem.GetPlayerStorage(player)) do
			for _, creature in ipairs(box) do
				if creature.Id == creatureId then
					creature.Nickname = nickname
					return true
				end
			end
		end
		return false
	end)

	-- Creatures
	RemoteSystem.OnServerInvoke("CaptureCreature", function(player: Player, spawnId: string, ballType: string)
		local creatureSystem = require(script.Parent.CreatureSystem)
		return creatureSystem.AttemptCapture(player, spawnId, ballType)
	end)

	RemoteSystem.OnServerInvoke("GetCreatureInfo", function(player: Player, creatureId: string)
		local partySystem = require(script.Parent.PartySystem)
		-- Search party
		for _, creature in ipairs(partySystem.GetPlayerParty(player)) do
			if creature.Id == creatureId then
				return creature
			end
		end
		-- Search storage
		for _, box in ipairs(partySystem.GetPlayerStorage(player)) do
			for _, creature in ipairs(box) do
				if creature.Id == creatureId then
					return creature
				end
			end
		end
		return nil
	end)

	RemoteSystem.OnServerEvent("HealCreature", function(player: Player, creatureId: string)
		-- Would use healing item or heal at center
		return true
	end)

	RemoteSystem.OnServerInvoke("EvolveCreature", function(player: Player, creatureId: string)
		local evolutionSystem = require(script.Parent.EvolutionSystem)
		return evolutionSystem.AttemptEvolution(player, creatureId)
	end)

	RemoteSystem.OnServerEvent("LearnMove", function(player: Player, creatureId: string, moveId: string, replaceIndex: number?)
		-- Implementation for learning moves
		return true
	end)

	RemoteSystem.OnServerEvent("ReplaceMove", function(player: Player, creatureId: string, oldMoveIndex: number, newMoveId: string)
		-- Implementation for replacing moves
		return true
	end)

	-- Battle
	RemoteSystem.OnServerInvoke("StartBattle", function(player: Player, enemyType: string, enemyData: any)
		local battleSystem = require(script.Parent.BattleSystem)
		if enemyType == "Wild" then
			return battleSystem.StartWildBattle(player, enemyData)
		else
			return battleSystem.StartTrainerBattle(player, enemyData)
		end
	end)

	RemoteSystem.OnServerInvoke("BattleAction", function(player: Player, battleId: string, action: Types.BattleAction)
		local battleSystem = require(script.Parent.BattleSystem)
		return battleSystem.ProcessAction(battleId, action)
	end)

	RemoteSystem.OnServerInvoke("GetBattleState", function(player: Player, battleId: string)
		local battleSystem = require(script.Parent.BattleSystem)
		local battle = battleSystem.GetBattle(battleId)
		if battle then
			-- Return sanitized battle state (hide enemy info if needed)
			return battle
		end
		return nil
	end)

	RemoteSystem.OnServerEvent("ForfeitBattle", function(player: Player, battleId: string)
		local battleSystem = require(script.Parent.BattleSystem)
		battleSystem.EndBattle(battleId, "EnemyWon")
	end)

	-- Items
	RemoteSystem.OnServerInvoke("GetInventory", function(player: Player)
		local itemSystem = require(script.Parent.ItemSystem)
		return itemSystem.GetInventoryWithInfo(player)
	end)

	RemoteSystem.OnServerInvoke("UseItem", function(player: Player, itemId: string, targetCreatureId: string?)
		local itemSystem = require(script.Parent.ItemSystem)
		return itemSystem.UseItem(player, itemId, targetCreatureId)
	end)

	RemoteSystem.OnServerEvent("BuyItem", function(player: Player, itemId: string, count: number)
		-- Shop system would handle this
		return false
	end)

	RemoteSystem.OnServerEvent("SellItem", function(player: Player, itemId: string, count: number)
		-- Shop system would handle this
		return false
	end)

	-- Spawn
	RemoteSystem.OnServerInvoke("GetNearbyCreatures", function(player: Player)
		local spawnSystem = require(script.Parent.SpawnSystem)
		if not player.Character or not player.Character.PrimaryPart then return {} end

		-- Find creatures near player
		-- Simplified - would check distance
		return {}
	end)

	-- Player
	RemoteSystem.OnServerInvoke("GetPlayerData", function(player: Player)
		local dataStoreSystem = require(script.Parent.DataStoreSystem)
		return dataStoreSystem.LoadPlayerData(player.UserId)
	end)

	RemoteSystem.OnServerEvent("UpdateSettings", function(player: Player, settings: Types.PlayerSettings)
		local dataStoreSystem = require(script.Parent.DataStoreSystem)
		local success, data = dataStoreSystem.LoadPlayerData(player.UserId)
		if success and data then
			data.Settings = settings
			dataStoreSystem.SavePlayerData(player.UserId, data)
		end
	end)

	-- NPC Interaction
	RemoteSystem.OnServerInvoke("InteractNPC", function(player: Player, npcId: string)
		local npcSystem = require(script.Parent.NPCSystem)
		return npcSystem.HandleInteraction(player, npcId, npcSystem.GetNPC(npcId)?.Type or "")
	end)

	RemoteSystem.OnServerInvoke("NPCShopBuy", function(player: Player, npcId: string, itemId: string, count: number)
		local npcSystem = require(script.Parent.NPCSystem)
		local npc = npcSystem.GetNPC(npcId)
		if not npc or npc.Type ~= "Shopkeeper" then return {Success = false, Error = "Not a shopkeeper"} end

		local itemSystem = require(script.Parent.ItemSystem)
		local itemConfig = Config.Items[itemId]
		if not itemConfig then return {Success = false, Error = "Item not found"} end

		local totalCost = itemConfig.Price * count
		local playerData = require(script.Parent.DataStoreSystem).LoadPlayerData(player.UserId)
		if (playerData.Money or 0) &lt; totalCost then
			return {Success = false, Error = "Dinheiro insuficiente"}
		end

		playerData.Money = (playerData.Money or 0) - totalCost
		itemSystem.AddItem(player, itemId, count)
		require(script.Parent.DataStoreSystem).SavePlayerData(player.UserId, playerData)

		return {Success = true, ItemsBought = count, RemainingMoney = playerData.Money}
	end)

	RemoteSystem.OnServerInvoke("NPCShopSell", function(player: Player, npcId: string, itemId: string, count: number)
		local npcSystem = require(script.Parent.NPCSystem)
		local npc = npcSystem.GetNPC(npcId)
		if not npc or npc.Type ~= "Shopkeeper" then return {Success = false, Error = "Not a shopkeeper"} end

		local itemSystem = require(script.Parent.ItemSystem)
		local itemConfig = Config.Items[itemId]
		if not itemConfig then return {Success = false, Error = "Item not found"} end

		local sellPrice = math.floor(itemConfig.Price * 0.5) -- 50% sell value
		local totalEarned = sellPrice * count

		if not itemSystem.RemoveItem(player, itemId, count) then
			return {Success = false, Error = "Item não encontrado no inventário"}
		end

		local playerData = require(script.Parent.DataStoreSystem).LoadPlayerData(player.UserId)
		playerData.Money = (playerData.Money or 0) + totalEarned
		require(script.Parent.DataStoreSystem).SavePlayerData(player.UserId, playerData)

		return {Success = true, ItemsSold = count, MoneyEarned = totalEarned, RemainingMoney = playerData.Money}
	end)

	-- Quests
	RemoteSystem.OnServerInvoke("GetQuests", function(player: Player, npcId: string?)
		local questSystem = require(script.Parent.QuestSystem)
		if npcId then
			return questSystem.GetAvailableQuests(player, npcId)
		else
			return questSystem.GetActiveQuests(player)
		end
	end)

	RemoteSystem.OnServerInvoke("AcceptQuest", function(player: Player, questId: string)
		local questSystem = require(script.Parent.QuestSystem)
		return questSystem.AcceptQuest(player, questId)
	end)

	RemoteSystem.OnServerInvoke("TurnInQuest", function(player: Player, questId: string)
		local questSystem = require(script.Parent.QuestSystem)
		return questSystem.TurnInQuest(player, questId)
	end)

	RemoteSystem.OnServerEvent("AbandonQuest", function(player: Player, questId: string)
		local questSystem = require(script.Parent.QuestSystem)
		local quests = questSystem.GetActiveQuests(player)
		for i, quest in ipairs(quests) do
			if quest.Id == questId then
				table.remove(quests, i)
				questSystem.SavePlayerQuests(player)
				break
			end
		end
	end)
end

-- Server event listener
function RemoteSystem.OnServerEvent(name: string, handler: (Player, ...any) -&gt; ...any)
	local remote = Remotes[name]
	if remote and remote:IsA("RemoteEvent") then
		remote.OnServerEvent:Connect(handler)
		EventHandlers[name] = handler
	else
		warn(`[RemoteSystem] RemoteEvent not found: {name}`)
	end
end

-- Server function listener
function RemoteSystem.OnServerInvoke(name: string, handler: (Player, ...any) -&gt; ...any)
	local remote = Remotes[name]
	if remote and remote:IsA("RemoteFunction") then
		remote.OnServerInvoke = handler
		FunctionHandlers[name] = handler
	else
		warn(`[RemoteSystem] RemoteFunction not found: {name}`)
	end
end

-- Fire to specific client
function RemoteSystem.FireClient(player: Player, name: string, ...: any)
	local remote = Remotes[name]
	if remote and remote:IsA("RemoteEvent") then
		remote:FireClient(player, ...)
	else
		warn(`[RemoteSystem] Cannot fire client - remote not found: {name}`)
	end
end

-- Fire to all clients
function RemoteSystem.FireAllClients(name: string, ...: any)
	local remote = Remotes[name]
	if remote and remote:IsA("RemoteEvent") then
		remote:FireAllClients(...)
	else
		warn(`[RemoteSystem] Cannot fire all - remote not found: {name}`)
	end
end

-- Fire to all clients except one
function RemoteSystem.FireAllClientsExcept(excludePlayer: Player, name: string, ...: any)
	local remote = Remotes[name]
	if remote and remote:IsA("RemoteEvent") then
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= excludePlayer then
				remote:FireClient(player, ...)
			end
		end
	else
		warn(`[RemoteSystem] Cannot fire all except - remote not found: {name}`)
	end
end

-- Invoke client (with timeout)
function RemoteSystem.InvokeClient(player: Player, name: string, timeout: number?, ...: any): (...any)
	local remote = Remotes[name]
	if remote and remote:IsA("RemoteFunction") then
		local thread = coroutine.running()
		local result = {nil}
		local completed = false

		task.spawn(function()
			local success, res = pcall(function()
				return remote:InvokeClient(player, ...)
			end)
			if success then
				result = {res}
			else
				result = {nil, res}
			end
			completed = true
			if coroutine.status(thread) == "suspended" then
				task.spawn(thread)
			end
		end)

		if not completed then
			task.wait(timeout or 10)
		end

		if not completed then
			return nil, "Timeout"
		end

		return unpack(result)
	else
		warn(`[RemoteSystem] Cannot invoke client - remote not found: {name}`)
		return nil, "Remote not found"
	end
end

-- Get remote instance (for client-side)
function RemoteSystem.GetRemote(name: string): RemoteEvent | RemoteFunction?
	return Remotes[name]
end

return RemoteSystem</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">SpawnSystem</string>
            <string name="Source">--!strict
-- SpawnSystem.lua - Sistema de spawn de criaturas selvagens por bioma

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Types = require(ReplicatedStorage.Shared.Types)
local Config = require(ReplicatedStorage.Shared.Config)
local CreatureSystem = require(script.Parent.CreatureSystem)
local MathUtil = require(ReplicatedStorage.Shared.Util.Math)
local TableUtil = require(ReplicatedStorage.Shared.Util.Table)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local SpawnSystem = {}

-- Events
SpawnSystem.OnCreatureSpawned = Signal.New()
SpawnSystem.OnCreatureDespawned = Signal.New()

-- Spawn configuration
local SpawnConfig = {
	MaxCreaturesPerZone = 15,
	BaseSpawnRadius = 80,
	DespawnRadius = 150,
	SpawnInterval = 10, -- seconds
	DespawnTime = 300, -- 5 minutes
	RarityWeights = {
		Common = 50,
		Rare = 25,
		Epic = 15,
		Legendary = 5,
		Hybrid = 2,
	},
	TimeOfDayModifiers = {
		Day = {Fire = 1.0, Water = 1.0, Nature = 1.2, Earth = 1.0, Air = 1.1, Shadow = 0.8},
		Night = {Fire = 0.8, Water = 1.1, Nature = 1.0, Earth = 1.0, Air = 0.9, Shadow = 1.5},
		Dawn = {Fire = 0.9, Water = 1.2, Nature = 1.3, Earth = 1.0, Air = 1.2, Shadow = 0.9},
		Dusk = {Fire = 1.2, Water = 1.0, Nature = 1.1, Earth = 1.1, Air = 1.0, Shadow = 1.3},
	},
	WeatherModifiers = {
		Sunny = {Fire = 1.5, Water = 0.5, Nature = 1.2, Earth = 1.0, Air = 1.0, Shadow = 0.8},
		Rain = {Fire = 0.5, Water = 1.5, Nature = 1.3, Earth = 1.1, Air = 0.9, Shadow = 1.0},
		Sandstorm = {Fire = 1.0, Water = 0.5, Nature = 0.7, Earth = 1.5, Air = 0.8, Shadow = 1.0},
		Snow = {Fire = 0.5, Water = 1.2, Nature = 0.8, Earth = 1.0, Air = 1.0, Shadow = 1.1},
		Fog = {Fire = 0.8, Water = 1.1, Nature = 1.0, Earth = 0.9, Air = 0.8, Shadow = 1.4},
		Windy = {Fire = 0.9, Water = 1.0, Nature = 1.0, Earth = 0.8, Air = 1.5, Shadow = 1.0},
	},
}

-- Zone spawn points (generated dynamically)
local ZoneSpawnPoints = {} :: {[string]: {Vector3}}
local ZoneCreatureCounts = {} :: {[string]: number}
local ActiveSpawns = {} :: {[string]: {SpawnId: string, Creature: Types.CreatureData, Position: Vector3, ZoneId: string, SpawnTime: number}}

-- Initialize spawn system
function SpawnSystem.Initialize()
	-- Generate spawn points for each zone
	for zoneId, zoneData in pairs(Config.Zones) do
		if zoneData.Spawns and #zoneData.Spawns &gt; 0 then
			ZoneSpawnPoints[zoneId] = SpawnSystem.GenerateSpawnPoints(zoneId, 20)
			ZoneCreatureCounts[zoneId] = 0
		end
	end

	-- Initial spawn
	task.spawn(function()
		task.wait(2)
		SpawnSystem.SpawnInitialCreatures()
	end)

	print("[SpawnSystem] Initialized")
end

-- Generate spawn points for a zone
function SpawnSystem.GenerateSpawnPoints(zoneId: string, count: number): {Vector3}
	local points = {}
	local zoneData = Config.Zones[zoneId]

	-- In a real game, these would be placed manually or generated from terrain
	-- For now, generate random points around zone center using island size
	local center = SpawnSystem.GetZoneCenter(zoneId)
	local islandSize = zoneData and zoneData.IslandSize or 80
	local spawnRadius = islandSize * 0.7 -- 70% of island radius

	for i = 1, count do
		local angle = math.random() * 2 * math.pi
		local distance = math.random() * spawnRadius
		local x = center.X + math.cos(angle) * distance
		local z = center.Z + math.sin(angle) * distance
		-- Vary Y based on biome
		local yOffset = 0
		if zoneData and zoneData.Biome == "Air" then
			yOffset = math.random(0, 30)
		elseif zoneData and zoneData.Biome == "Water" then
			yOffset = math.random(-15, 5)
		else
			yOffset = math.random(-5, 5)
		end
		local y = center.Y + yOffset

		table.insert(points, Vector3.new(x, y, z))
	end

	return points
end

-- Get zone center (uses Config.Zones island positions)
function SpawnSystem.GetZoneCenter(zoneId: string): Vector3
	local zoneData = Config.Zones[zoneId]
	if zoneData and zoneData.IslandPosition then
		return zoneData.IslandPosition + Vector3.new(0, 5, 0)
	end
	return Vector3.new(0, 5, 0)
end

-- Initial spawn for all zones
function SpawnSystem.SpawnInitialCreatures()
	for zoneId, zoneData in pairs(Config.Zones) do
		if zoneData.Spawns and #zoneData.Spawns &gt; 0 then
			local targetCount = math.min(SpawnConfig.MaxCreaturesPerZone, 5)
			for i = 1, targetCount do
				SpawnSystem.TrySpawnInZone(zoneId)
			end
		end
	end
end

-- Main update loop
function SpawnSystem.Update(deltaTime: number)
	-- Check for despawns
	SpawnSystem.CheckDespawns()

	-- Try to spawn new creatures
	SpawnSystem.TrySpawnCreatures()
end

-- Check for creatures that should despawn
function SpawnSystem.CheckDespawns()
	local currentTime = tick()

	for spawnId, spawnData in pairs(ActiveSpawns) do
		-- Check despawn time
		if currentTime - spawnData.SpawnTime &gt; SpawnConfig.DespawnTime then
			SpawnSystem.DespawnCreature(spawnId, "Timeout")
			continue
		end

		-- Check distance from players
		local hasNearbyPlayer = false
		for _, player in ipairs(game.Players:GetPlayers()) do
			if player.Character and player.Character.PrimaryPart then
				local distance = (player.Character.PrimaryPart.Position - spawnData.Position).Magnitude
				if distance &lt; SpawnConfig.DespawnRadius then
					hasNearbyPlayer = true
					break
				end
			end
		end

		if not hasNearbyPlayer and currentTime - spawnData.SpawnTime &gt; 60 then
			-- Despawn if no players nearby for 1 minute
			SpawnSystem.DespawnCreature(spawnId, "NoPlayers")
		end
	end
end

-- Try to spawn creatures in zones that need them
function SpawnSystem.TrySpawnCreatures()
	for zoneId, zoneData in pairs(Config.Zones) do
		if not zoneData.Spawns then continue end

		local currentCount = ZoneCreatureCounts[zoneId] or 0
		if currentCount &lt; SpawnConfig.MaxCreaturesPerZone then
			-- Chance to spawn based on deficit
			local deficit = SpawnConfig.MaxCreaturesPerZone - currentCount
			local spawnChance = deficit * 0.1 -- 10% per missing creature

			if math.random() &lt; spawnChance then
				SpawnSystem.TrySpawnInZone(zoneId)
			end
		end
	end
end

-- Try to spawn a single creature in a zone
function SpawnSystem.TrySpawnInZone(zoneId: string): boolean
	local zoneData = Config.Zones[zoneId]
	if not zoneData or not zoneData.Spawns or #zoneData.Spawns == 0 then
		return false
	end

	local spawnPoints = ZoneSpawnPoints[zoneId]
	if not spawnPoints or #spawnPoints == 0 then
		return false
	end

	-- Pick random spawn point
	local position = spawnPoints[math.random(#spawnPoints)]

	-- Select species based on weights, time, weather
	local speciesId = SpawnSystem.SelectSpecies(zoneId)
	if not speciesId then return false end

	-- Determine level
	local level = math.random(zoneData.LevelRange.Min, zoneData.LevelRange.Max)

	-- Generate creature
	local creature = CreatureSystem.GenerateWildCreature(speciesId, level, zoneId)

	-- Spawn in world
	local spawnId = CreatureSystem.SpawnCreatureInWorld(creature, position, zoneId)

	-- Track
	ActiveSpawns[spawnId] = {
		SpawnId = spawnId,
		Creature = creature,
		Position = position,
		ZoneId = zoneId,
		SpawnTime = tick(),
	}

	ZoneCreatureCounts[zoneId] = (ZoneCreatureCounts[zoneId] or 0) + 1

	SpawnSystem.OnCreatureSpawned:Fire(spawnId, creature, position, zoneId)

	return true
end

-- Select species based on zone, time, weather, rarity
function SpawnSystem.SelectSpecies(zoneId: string): string?
	local zoneData = Config.Zones[zoneId]
	if not zoneData or not zoneData.Spawns then return nil end

	-- Get current time of day and weather (simplified)
	local timeOfDay = SpawnSystem.GetTimeOfDay()
	local weather = SpawnSystem.GetCurrentWeather()

	-- Build weighted list
	local weightedSpecies = {}

	for _, speciesId in ipairs(zoneData.Spawns) do
		local speciesData = Config.SpeciesList[speciesId]
		if not speciesData then continue end

		-- Base weight from rarity
		local weight = SpawnConfig.RarityWeights[speciesData.Rarity] or 10

		-- Time of day modifier
		local timeMod = SpawnConfig.TimeOfDayModifiers[timeOfDay]
		if timeMod and timeMod[speciesData.Element] then
			weight = weight * timeMod[speciesData.Element]
		end

		-- Weather modifier
		local weatherMod = SpawnConfig.WeatherModifiers[weather]
		if weatherMod and weatherMod[speciesData.Element] then
			weight = weight * weatherMod[speciesData.Element]
		end

		-- Hybrid bonus for legendary zones
		if speciesData.Rarity == "Legendary" and speciesData.Element:find("FireWater") then
			weight = weight * 0.5 -- Very rare
		end

		table.insert(weightedSpecies, {Item = speciesId, Weight = weight})
	end

	if #weightedSpecies == 0 then return nil end

	return TableUtil.WeightedRandom(weightedSpecies)
end

-- Get current time of day
function SpawnSystem.GetTimeOfDay(): "Day" | "Night" | "Dawn" | "Dusk"
	local cycleTime = (tick() % Config.Game.DayNightCycle) / Config.Game.DayNightCycle

	if cycleTime &lt; 0.25 then return "Dawn"
	elseif cycleTime &lt; 0.5 then return "Day"
	elseif cycleTime &lt; 0.75 then return "Dusk"
	else return "Night"
	end
end

-- Get current weather (simplified)
function SpawnSystem.GetCurrentWeather(): string
	-- In a real game, this would come from a WeatherSystem
	return "None"
end

-- Despawn a creature
function SpawnSystem.DespawnCreature(spawnId: string, reason: string)
	local spawnData = ActiveSpawns[spawnId]
	if not spawnData then return end

	CreatureSystem.DespawnCreature(spawnId)

	ZoneCreatureCounts[spawnData.ZoneId] = math.max(0, (ZoneCreatureCounts[spawnData.ZoneId] or 1) - 1)
	ActiveSpawns[spawnId] = nil

	SpawnSystem.OnCreatureDespawned:Fire(spawnId, reason)
end

-- Force spawn specific creature (for events/quests)
function SpawnSystem.ForceSpawn(zoneId: string, speciesId: string, level: number, position: Vector3?): string?
	local zoneData = Config.Zones[zoneId]
	if not zoneData then return nil end

	local pos = position or ZoneSpawnPoints[zoneId][math.random(#ZoneSpawnPoints[zoneId])]
	local creature = CreatureSystem.GenerateWildCreature(speciesId, level, zoneId)
	local spawnId = CreatureSystem.SpawnCreatureInWorld(creature, pos, zoneId)

	ActiveSpawns[spawnId] = {
		SpawnId = spawnId,
		Creature = creature,
		Position = pos,
		ZoneId = zoneId,
		SpawnTime = tick(),
	}

	ZoneCreatureCounts[zoneId] = (ZoneCreatureCounts[zoneId] or 0) + 1

	return spawnId
end

-- Get active spawns in zone
function SpawnSystem.GetActiveSpawnsInZone(zoneId: string): {string}
	local result = {}
	for spawnId, data in pairs(ActiveSpawns) do
		if data.ZoneId == zoneId then
			table.insert(result, spawnId)
		end
	end
	return result
end

-- Get creature by spawn ID
function SpawnSystem.GetCreatureBySpawnId(spawnId: string): Types.CreatureData?
	local spawnData = ActiveSpawns[spawnId]
	return spawnData and spawnData.Creature or nil
end

-- Get spawn stats for debugging
function SpawnSystem.GetStats(): {TotalActive: number, PerZone: {[string]: number}}
	return {
		TotalActive = #TableUtil.Keys(ActiveSpawns),
		PerZone = ZoneCreatureCounts,
	}
end

return SpawnSystem</string>
