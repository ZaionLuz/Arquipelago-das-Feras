        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Math</string>
            <string name="Source">--!strict
-- Math.lua - Utilitários matemáticos

local MathUtil = {}

-- Clamp value between min and max
function MathUtil.Clamp(value: number, min: number, max: number): number
	return math.max(min, math.min(max, value))
end

-- Lerp between two values
function MathUtil.Lerp(a: number, b: number, t: number): number
	return a + (b - a) * MathUtil.Clamp(t, 0, 1)
end

-- Lerp for Vector3
function MathUtil.LerpVector3(a: Vector3, b: Vector3, t: number): Vector3
	return a:Lerp(b, MathUtil.Clamp(t, 0, 1))
end

-- Round to decimal places
function MathUtil.Round(value: number, decimals: number?): number
	local mult = 10 ^ (decimals or 0)
	return math.floor(value * mult + 0.5) / mult
end

-- Random float between min and max
function MathUtil.RandomFloat(min: number, max: number): number
	return min + math.random() * (max - min)
end

-- Random integer between min and max (inclusive)
function MathUtil.RandomInt(min: number, max: number): number
	return math.random(min, max)
end

-- Weighted random selection
function MathUtil.WeightedRandom&lt;T&gt;(items: {{Item: T, Weight: number}}): T?
	local totalWeight = 0
	for _, item in items do
		totalWeight += item.Weight
	end

	if totalWeight &lt;= 0 then
		return nil
	end

	local roll = math.random() * totalWeight
	local current = 0

	for _, item in items do
		current += item.Weight
		if roll &lt;= current then
			return item.Item
		end
	end

	return items[#items].Item
end

-- Distance between two Vector3
function MathUtil.Distance(a: Vector3, b: Vector3): number
	return (a - b).Magnitude
end

-- Check if point is in radius
function MathUtil.InRadius(point: Vector3, center: Vector3, radius: number): boolean
	return MathUtil.Distance(point, center) &lt;= radius
end

-- Get random point in circle
function MathUtil.RandomPointInCircle(center: Vector2, radius: number): Vector2
	local angle = math.random() * 2 * math.pi
	local r = math.sqrt(math.random()) * radius
	return Vector2.new(center.X + r * math.cos(angle), center.Y + r * math.sin(angle))
end

-- Get random point in sphere
function MathUtil.RandomPointInSphere(center: Vector3, radius: number): Vector3
	local u = math.random()
	local v = math.random()
	local theta = 2 * math.pi * u
	local phi = math.acos(2 * v - 1)
	local r = radius * (math.random() ^ (1/3))

	local x = r * math.sin(phi) * math.cos(theta)
	local y = r * math.sin(phi) * math.sin(theta)
	local z = r * math.cos(phi)

	return center + Vector3.new(x, y, z)
end

-- Sign function
function MathUtil.Sign(value: number): number
	if value &gt; 0 then return 1
	elseif value &lt; 0 then return -1
	else return 0
	end
end

-- Clamp angle to -180 to 180
function MathUtil.ClampAngle(angle: number): number
	while angle &gt; 180 do angle -= 360 end
	while angle &lt; -180 do angle += 360 end
	return angle
end

-- Smooth step
function MathUtil.SmoothStep(t: number): number
	t = MathUtil.Clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

-- Smoother step
function MathUtil.SmootherStep(t: number): number
	t = MathUtil.Clamp(t, 0, 1)
	return t * t * t * (t * (t * 6 - 15) + 10)
end

return MathUtil</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source">--!strict
-- Signal.lua - Sistema de eventos/sinais tipado

export type Connection = {
	Disconnect: (self: Connection) -&gt; (),
	Connected: boolean,
}

export type Signal&lt;T...&gt; = {
	Connect: (self: Signal&lt;T...&gt;, callback: (T...) -&gt; ()) -&gt; Connection,
	Once: (self: Signal&lt;T...&gt;, callback: (T...) -&gt; ()) -&gt; Connection,
	Fire: (self: Signal&lt;T...&gt;, T...) -&gt; (),
	Wait: (self: Signal&lt;T...&gt;) -&gt; T...,
	Destroy: (self: Signal&lt;T...&gt;) -&gt; (),
}

local Signal = {}

function Signal.New&lt;T...&gt;(): Signal&lt;T...&gt;
	local self = {
		_connections = {} :: {Connection},
		_waitingThreads = {} :: {thread},
	}

	function self:Connect(callback: (T...) -&gt; ()): Connection
		local connection = {
			_callback = callback,
			_connected = true,
			_signal = self,
		}

		function connection:Disconnect()
			if self._connected then
				self._connected = false
				local index = table.find(self._signal._connections, connection)
				if index then
					table.remove(self._signal._connections, index)
				end
			end
		end

		table.insert(self._connections, connection)
		return connection
	end

	function self:Once(callback: (T...) -&gt; ()): Connection
		local connection: Connection
		connection = self:Connect(function(...)
			connection:Disconnect()
			callback(...)
		end)
		return connection
	end

	function self:Fire(...: T...)
		for _, connection in ipairs(self._connections) do
			if connection._connected then
				task.spawn(connection._callback, ...)
			end
		end

		for _, thread in ipairs(self._waitingThreads) do
			task.spawn(thread, ...)
		end
		table.clear(self._waitingThreads)
	end

	function self:Wait(): T...
		local thread = coroutine.running()
		table.insert(self._waitingThreads, thread)
		return coroutine.yield()
	end

	function self:Destroy()
		for _, connection in ipairs(self._connections) do
			connection._connected = false
		end
		table.clear(self._connections)
		table.clear(self._waitingThreads)
	end

	return self
end

-- Signal that holds the last fired value
function Signal.NewValue&lt;T&gt;(initialValue: T?): {Value: T, Changed: Signal&lt;T&gt;, Get: (self: any) -&gt; T, Set: (self: any, T) -&gt; ()}
	local signal = Signal.New()
	local value = initialValue

	return {
		Value = initialValue,
		Changed = signal,
		Get = function(self)
			return value
		end,
		Set = function(self, newValue: T)
			value = newValue
			self.Value = newValue
			signal:Fire(newValue)
		end,
	}
end

return Signal</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Table</string>
            <string name="Source">--!strict
-- Table.lua - Utilitários para tabelas

local TableUtil = {}

-- Deep copy a table
function TableUtil.DeepCopy&lt;T&gt;(original: T): T
	local copy = {}
	for k, v in pairs(original) do
		if type(v) == "table" then
			copy[k] = TableUtil.DeepCopy(v)
		else
			copy[k] = v
		end
	end
	return copy
end

-- Shallow copy
function TableUtil.ShallowCopy&lt;T&gt;(original: T): T
	local copy = {}
	for k, v in pairs(original) do
		copy[k] = v
	end
	return copy
end

-- Merge tables (later values override earlier)
function TableUtil.Merge(...: {[any]: any}): {[any]: any}
	local result = {}
	for _, t in ipairs({...}) do
		for k, v in pairs(t) do
			result[k] = v
		end
	end
	return result
end

-- Deep merge
function TableUtil.DeepMerge(...: {[any]: any}): {[any]: any}
	local result = {}
	for _, t in ipairs({...}) do
		for k, v in pairs(t) do
			if type(v) == "table" and type(result[k]) == "table" then
				result[k] = TableUtil.DeepMerge(result[k], v)
			else
				result[k] = v
			end
		end
	end
	return result
end

-- Find index of value in array
function TableUtil.FindIndex&lt;T&gt;(array: {T}, predicate: (T) -&gt; boolean): number?
	for i, v in ipairs(array) do
		if predicate(v) then
			return i
		end
	end
	return nil
end

-- Find value in array
function TableUtil.Find&lt;T&gt;(array: {T}, predicate: (T) -&gt; boolean): T?
	for _, v in ipairs(array) do
		if predicate(v) then
			return v
		end
	end
	return nil
end

-- Filter array
function TableUtil.Filter&lt;T&gt;(array: {T}, predicate: (T) -&gt; boolean): {T}
	local result = {}
	for _, v in ipairs(array) do
		if predicate(v) then
			table.insert(result, v)
		end
	end
	return result
end

-- Map array
function TableUtil.Map&lt;T, U&gt;(array: {T}, mapper: (T) -&gt; U): {U}
	local result = {}
	for _, v in ipairs(array) do
		table.insert(result, mapper(v))
	end
	return result
end

-- Reduce array
function TableUtil.Reduce&lt;T, U&gt;(array: {T}, reducer: (U, T) -&gt; U, initial: U): U
	local acc = initial
	for _, v in ipairs(array) do
		acc = reducer(acc, v)
	end
	return acc
end

-- Check if table is empty
function TableUtil.IsEmpty(t: {[any]: any}): boolean
	return next(t) == nil
end

-- Get table length (works for non-array tables)
function TableUtil.Length(t: {[any]: any}): number
	local count = 0
	for _ in pairs(t) do
		count += 1
	end
	return count
end

-- Get keys of table
function TableUtil.Keys&lt;T&gt;(t: {[any]: T}): {any}
	local keys = {}
	for k in pairs(t) do
		table.insert(keys, k)
	end
	return keys
end

-- Get values of table
function TableUtil.Values&lt;T&gt;(t: {[any]: T}): {T}
	local values = {}
	for _, v in pairs(t) do
		table.insert(values, v)
	end
	return values
end

-- Check if table contains key
function TableUtil.HasKey(t: {[any]: any}, key: any): boolean
	return t[key] ~= nil
end

-- Check if array contains value
function TableUtil.Contains&lt;T&gt;(array: {T}, value: T): boolean
	for _, v in ipairs(array) do
		if v == value then
			return true
		end
	end
	return false
end

-- Remove value from array (first occurrence)
function TableUtil.RemoveValue&lt;T&gt;(array: {T}, value: T): boolean
	local index = TableUtil.FindIndex(array, function(v) return v == value end)
	if index then
		table.remove(array, index)
		return true
	end
	return false
end

-- Shuffle array (Fisher-Yates)
function TableUtil.Shuffle&lt;T&gt;(array: {T}): {T}
	local result = TableUtil.ShallowCopy(array)
	for i = #result, 2, -1 do
		local j = math.random(i)
		result[i], result[j] = result[j], result[i]
	end
	return result
end

-- Get random element from array
function TableUtil.RandomElement&lt;T&gt;(array: {T}): T?
	if #array == 0 then return nil end
	return array[math.random(#array)]
end

-- Chunk array into smaller arrays
function TableUtil.Chunk&lt;T&gt;(array: {T}, size: number): {{T}}
	local chunks = {}
	for i = 1, #array, size do
		local chunk = {}
		for j = i, math.min(i + size - 1, #array) do
			table.insert(chunk, array[j])
		end
		table.insert(chunks, chunk)
	end
	return chunks
end

-- Flatten nested arrays
function TableUtil.Flatten&lt;T&gt;(array: {T | {T}}): {T}
	local result = {}
	for _, v in ipairs(array) do
		if type(v) == "table" then
			for _, item in ipairs(TableUtil.Flatten(v)) do
				table.insert(result, item)
			end
		else
			table.insert(result, v)
		end
	end
	return result
end

-- Group by key
function TableUtil.GroupBy&lt;T&gt;(array: {T}, keySelector: (T) -&gt; string): {[string]: {T}}
	local groups = {}
	for _, item in ipairs(array) do
		local key = keySelector(item)
		if not groups[key] then
			groups[key] = {}
		end
		table.insert(groups[key], item)
	end
	return groups
end

return TableUtil</string>
          </Properties>
        </Item>
      </Item>
