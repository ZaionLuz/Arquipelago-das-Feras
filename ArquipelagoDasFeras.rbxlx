      <Item class="LocalScript" referent="30">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source">--!strict
-- Client Entry Point - Arquipélago das Feras

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

-- Load shared modules
local Types = require(ReplicatedStorage.Shared.Types)
local Config = require(ReplicatedStorage.Shared.Config)
local MathUtil = require(ReplicatedStorage.Shared.Util.Math)
local TableUtil = require(ReplicatedStorage.Shared.Util.Table)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

-- Load client controllers
local UIController = require(script.Parent.Controllers.UIController)
local PlayerController = require(script.Parent.Controllers.PlayerController)
local CreatureController = require(script.Parent.Controllers.CreatureController)
local BattleController = require(script.Parent.Controllers.BattleController)
local WorldController = require(script.Parent.Controllers.WorldController)
local InputController = require(script.Parent.Controllers.InputController)
local CameraController = require(script.Parent.Controllers.CameraController)
local AudioController = require(script.Parent.Controllers.AudioController)
local RemoteClient = require(script.Parent.Controllers.RemoteClient)
local QuestController = require(script.Parent.Controllers.QuestController)

local Player = Players.LocalPlayer

-- Client state
local ClientState = {
	IsLoaded = false,
	PlayerData = nil :: Types.PlayerData?,
	CurrentScreen = "Loading",
	ActiveBattle = nil :: Types.BattleData?,
}

-- Initialize remote client
RemoteClient.Initialize()

-- Wait for data loaded from server
RemoteClient.On("DataLoaded", function(playerData: Types.PlayerData)
	ClientState.PlayerData = playerData
	ClientState.IsLoaded = true

	print(`[Client] Data loaded for {Player.Name}`)

	-- Initialize controllers
	UIController.Initialize(playerData)
	PlayerController.Initialize(playerData)
	CreatureController.Initialize(playerData)
	BattleController.Initialize()
	WorldController.Initialize()
	InputController.Initialize()
	CameraController.Initialize()
	AudioController.Initialize()
	QuestController.Initialize()

	-- Show main menu or game UI
	UIController.ShowScreen("MainMenu")

	ClientState.CurrentScreen = "MainMenu"
end)

-- Request initial data
task.spawn(function()
	task.wait(1)
	RemoteClient.Invoke("RequestData")
end)

-- Handle battle state changes
RemoteClient.On("BattleStarted", function(battleData: Types.BattleData)
	ClientState.ActiveBattle = battleData
	ClientState.CurrentScreen = "Battle"
	UIController.ShowScreen("Battle")
	BattleController.StartBattle(battleData)
end)

RemoteClient.On("BattleEnded", function(battleData: Types.BattleData, result: string)
	ClientState.ActiveBattle = nil
	ClientState.CurrentScreen = "Gameplay"
	UIController.ShowScreen("Gameplay")
	BattleController.EndBattle(result)
end)

RemoteClient.On("BattleUpdate", function(battleData: Types.BattleData)
	ClientState.ActiveBattle = battleData
	BattleController.UpdateBattle(battleData)
end)

-- Handle creature spawns
RemoteClient.On("CreatureSpawned", function(spawnId: string, creature: Types.CreatureData, position: Vector3)
	WorldController.OnCreatureSpawned(spawnId, creature, position)
end)

RemoteClient.On("CreatureDespawned", function(spawnId: string)
	WorldController.OnCreatureDespawned(spawnId)
end)

-- Handle party updates
RemoteClient.On("PartyChanged", function(partySummary: any)
	CreatureController.OnPartyChanged(partySummary)
	UIController.UpdatePartyUI(partySummary)
end)

-- Handle creature capture
RemoteClient.On("CreatureCaptured", function(creature: Types.CreatureData)
	CreatureController.OnCreatureCaptured(creature)
	UIController.ShowCaptureAnimation(creature)
end)

-- Handle evolution
RemoteClient.On("CreatureEvolved", function(oldSpecies: string, newSpecies: string, creature: Types.CreatureData)
	CreatureController.OnCreatureEvolved(creature)
	UIController.ShowEvolutionAnimation(oldSpecies, newSpecies, creature)
end)

-- Handle level up
RemoteClient.On("CreatureLevelUp", function(creature: Types.CreatureData, oldLevel: number, newLevel: number)
	CreatureController.OnCreatureLevelUp(creature, oldLevel, newLevel)
	UIController.ShowLevelUpAnimation(creature, oldLevel, newLevel)
end)

-- Input handling
UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	if gameProcessed then return end

	InputController.HandleInput(input, "Began")
end)

UserInputService.InputEnded:Connect(function(input: InputObject, gameProcessed: boolean)
	InputController.HandleInput(input, "Ended")
end)

-- Game loop
RunService.RenderStepped:Connect(function(deltaTime: number)
	if not ClientState.IsLoaded then return end

	WorldController.Update(deltaTime)
	CameraController.Update(deltaTime)

	if ClientState.ActiveBattle then
		BattleController.Update(deltaTime)
	end
end)

-- Character loaded
Player.CharacterAdded:Connect(function(character)
	PlayerController.OnCharacterAdded(character)
	CameraController.OnCharacterAdded(character)
end)

if Player.Character then
	PlayerController.OnCharacterAdded(Player.Character)
	CameraController.OnCharacterAdded(Player.Character)
end

print("[Client] Arquipélago das Feras client initialized!")

return nil</string>
        </Properties>
        <Item class="Folder" referent="31">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="32">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source">--!strict
-- AudioController.lua - Gerenciamento de áudio (música, SFX, voz)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local Types = require(ReplicatedStorage.Shared.Types)
local Config = require(ReplicatedStorage.Shared.Config)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local AudioController = {}

-- Events
AudioController.OnMusicChanged = Signal.New()
AudioController.OnSFXPlayed = Signal.New()

-- State
local CurrentMusic: Sound?
local CurrentMusicId: string?
local MusicVolume = 0.5
local SFXVolume = 0.7
local MasterVolume = 1.0
local IsMusicMuted = false
local IsSFXMuted = false

-- Sound groups
local MusicGroup = SoundService:FindFirstChild("MusicGroup") or Instance.new("SoundGroup")
local SFXGroup = SoundService:FindFirstChild("SFXGroup") or Instance.new("SoundGroup")
local AmbienceGroup = SoundService:FindFirstChild("AmbienceGroup") or Instance.new("SoundGroup")

MusicGroup.Name = "MusicGroup"
SFXGroup.Name = "SFXGroup"
AmbienceGroup.Name = "AmbienceGroup"

MusicGroup.Parent = SoundService
SFXGroup.Parent = SoundService
AmbienceGroup.Parent = SoundService

-- Music tracks (SoundId -&gt; Config)
local MusicTracks = {
	MainMenu = {Id = "rbxassetid://1837635123", Volume = 0.5, Looped = true},
	Overworld = {Id = "rbxassetid://1837635123", Volume = 0.4, Looped = true},
	BattleWild = {Id = "rbxassetid://1837635123", Volume = 0.6, Looped = true},
	BattleTrainer = {Id = "rbxassetid://1837635123", Volume = 0.7, Looped = true},
	BattleLegendary = {Id = "rbxassetid://1837635123", Volume = 0.8, Looped = true},
	Victory = {Id = "rbxassetid://1837635123", Volume = 0.6, Looped = false},
	Defeat = {Id = "rbxassetid://1837635123", Volume = 0.5, Looped = false},
	Evolution = {Id = "rbxassetid://1837635123", Volume = 0.7, Looped = false},
	Capture = {Id = "rbxassetid://1837635123", Volume = 0.6, Looped = false},
	Healing = {Id = "rbxassetid://1837635123", Volume = 0.4, Looped = false},
	Shop = {Id = "rbxassetid://1837635123", Volume = 0.4, Looped = true},
	Cave = {Id = "rbxassetid://1837635123", Volume = 0.3, Looped = true},
	Night = {Id = "rbxassetid://1837635123", Volume = 0.35, Looped = true},
	Rain = {Id = "rbxassetid://1837635123", Volume = 0.3, Looped = true},
}

-- SFX library
local SFXLibrary = {
	-- UI
	ButtonClick = "rbxassetid://12221967",
	ButtonHover = "rbxassetid://12221976",
	MenuOpen = "rbxassetid://12221988",
	MenuClose = "rbxassetid://12221997",
	Error = "rbxassetid://12222006",
	Success = "rbxassetid://12222015",
	LevelUp = "rbxassetid://12222024",

	-- Battle
	MovePhysical = "rbxassetid://12222033",
	MoveSpecial = "rbxassetid://12222042",
	MoveStatus = "rbxassetid://12222051",
	HitNormal = "rbxassetid://12222060",
	HitSuperEffective = "rbxassetid://12222069",
	HitNotVeryEffective = "rbxassetid://12222078",
	HitImmune = "rbxassetid://12222087",
	CriticalHit = "rbxassetid://12222096",
	Faint = "rbxassetid://12222105",

	-- Creatures
	CaptureThrow = "rbxassetid://12222114",
	CaptureShake = "rbxassetid://12222123",
	CaptureSuccess = "rbxassetid://12222132",
	CaptureFail = "rbxassetid://12222141",
	EvolutionStart = "rbxassetid://12222150",
	EvolutionComplete = "rbxassetid://12222159",

	-- World
	FootstepGrass = "rbxassetid://12222168",
	FootstepWater = "rbxassetid://12222177",
	FootstepCave = "rbxassetid://12222186",
	FootstepSand = "rbxassetid://12222195",
	DoorOpen = "rbxassetid://12222204",
	DoorClose = "rbxassetid://12222213",
	ChestOpen = "rbxassetid://12222222",
	ItemPickup = "rbxassetid://12222231",

	-- Elements
	Fire = "rbxassetid://12222240",
	Water = "rbxassetid://12222249",
	Nature = "rbxassetid://12222258",
	Earth = "rbxassetid://12222267",
	Air = "rbxassetid://12222276",
	Shadow = "rbxassetid://12222285",
	Light = "rbxassetid://12222294",
	Metal = "rbxassetid://12222303",
	Crystal = "rbxassetid://12222312",

	-- Status
	Burn = "rbxassetid://12222321",
	Poison = "rbxassetid://12222330",
	Paralysis = "rbxassetid://12222339",
	Sleep = "rbxassetid://12222348",
	Freeze = "rbxassetid://12222357",
	Heal = "rbxassetid://12222366",
}

-- Active sounds for cleanup
local ActiveSounds = {} :: {Sound}
local AmbienceSounds = {} :: {Sound}

-- Initialize
function AudioController.Initialize()
	print("[AudioController] Initializing...")

	-- Setup sound groups
	MusicGroup.Volume = MusicVolume * MasterVolume
	SFXGroup.Volume = SFXVolume * MasterVolume
	AmbienceGroup.Volume = 0.3 * MasterVolume

	-- Load saved settings
	AudioController.LoadSettings()

	-- Preload common sounds
	AudioController.PreloadSounds()

	print("[AudioController] Initialized")
end

function AudioController.LoadSettings()
	-- Would load from player settings
	-- For now using defaults
end

function AudioController.PreloadSounds()
	-- Preload music
	for _, track in pairs(MusicTracks) do
		local sound = Instance.new("Sound")
		sound.SoundId = track.Id
		sound.Volume = 0
		sound.Looped = track.Looped
		sound.Parent = MusicGroup
		sound:Load()
		sound:Destroy()
	end

	-- Preload SFX
	for _, id in pairs(SFXLibrary) do
		local sound = Instance.new("Sound")
		sound.SoundId = id
		sound.Volume = 0
		sound.Parent = SFXGroup
		sound:Load()
		sound:Destroy()
	end
end

-- Music control
function AudioController.PlayMusic(trackName: string, fadeTime: number?)
	fadeTime = fadeTime or 2

	local track = MusicTracks[trackName]
	if not track then
		warn(`[AudioController] Music track not found: {trackName}`)
		return
	end

	if CurrentMusicId == trackName then return end

	-- Create new music sound
	local newMusic = Instance.new("Sound")
	newMusic.Name = "Music_" .. trackName
	newMusic.SoundId = track.Id
	newMusic.Volume = 0
	newMusic.Looped = track.Looped
	newMusic.SoundGroup = MusicGroup
	newMusic.Parent = SoundService

	-- Fade out current music
	if CurrentMusic then
		local fadeOut = TweenService:Create(CurrentMusic, TweenInfo.new(fadeTime), {Volume = 0})
		fadeOut:Play()

		fadeOut.Completed:Connect(function()
			CurrentMusic:Stop()
			CurrentMusic:Destroy()
		end)
	end

	-- Fade in new music
	newMusic:Play()

	local fadeIn = TweenService:Create(newMusic, TweenInfo.new(fadeTime), {Volume = track.Volume * MusicVolume * MasterVolume})
	fadeIn:Play()

	CurrentMusic = newMusic
	CurrentMusicId = trackName

	AudioController.OnMusicChanged:Fire(trackName)

	print(`[AudioController] Playing music: {trackName}`)
end

function AudioController.StopMusic(fadeTime: number?)
	fadeTime = fadeTime or 1

	if CurrentMusic then
		local fadeOut = TweenService:Create(CurrentMusic, TweenInfo.new(fadeTime), {Volume = 0})
		fadeOut:Play()

		fadeOut.Completed:Connect(function()
			CurrentMusic:Stop()
			CurrentMusic:Destroy()
			CurrentMusic = nil
			CurrentMusicId = nil
		end)
	end
end

function AudioController.PauseMusic()
	if CurrentMusic then
		CurrentMusic.Paused = true
	end
end

function AudioController.ResumeMusic()
	if CurrentMusic then
		CurrentMusic.Paused = false
	end
end

function AudioController.SetMusicVolume(volume: number)
	MusicVolume = math.clamp(volume, 0, 1)
	MusicGroup.Volume = MusicVolume * MasterVolume

	if CurrentMusic then
		local track = MusicTracks[CurrentMusicId]
		if track then
			CurrentMusic.Volume = track.Volume * MusicVolume * MasterVolume
		end
	end
end

function AudioController.GetMusicVolume(): number
	return MusicVolume
end

-- SFX control
function AudioController.PlaySFX(sfxName: string, position: Vector3?, volume: number?, pitch: number?): Sound?
	local soundId = SFXLibrary[sfxName]
	if not soundId then
		warn(`[AudioController] SFX not found: {sfxName}`)
		return nil
	end

	volume = volume or 1
	pitch = pitch or 1

	local sound = Instance.new("Sound")
	sound.Name = "SFX_" .. sfxName
	sound.SoundId = soundId
	sound.Volume = volume * SFXVolume * MasterVolume
	sound.Pitch = pitch
	sound.SoundGroup = SFXGroup
	sound.PlayOnRemove = false

	if position then
		-- 3D sound at position
		local part = Instance.new("Part")
		part.Name = "SFXEmitter"
		part.Size = Vector3.new(0.1, 0.1, 0.1)
		part.Transparency = 1
		part.Anchored = true
		part.CanCollide = false
		part.CFrame = CFrame.new(position)
		part.Parent = workspace

		sound.Parent = part
		sound.RollOffMode = Enum.RollOffMode.Linear
		sound.MaxDistance = 100
		sound.MinDistance = 10

		sound:Play()

		task.delay(sound.TimeLength + 1, function()
			part:Destroy()
		end)
	else
		-- 2D sound
		sound.Parent = SoundService
		sound:Play()

		task.delay(sound.TimeLength + 1, function()
			sound:Destroy()
		end)
	end

	table.insert(ActiveSounds, sound)
	AudioController.OnSFXPlayed:Fire(sfxName, sound)

	-- Cleanup finished sounds
	task.spawn(function()
		task.wait(sound.TimeLength + 1)
		local index = table.find(ActiveSounds, sound)
		if index then table.remove(ActiveSounds, index) end
	end)

	return sound
end

function AudioController.PlaySFXAtPart(sfxName: string, part: BasePart, volume: number?, pitch: number?): Sound?
	local soundId = SFXLibrary[sfxName]
	if not soundId then return nil end

	volume = volume or 1
	pitch = pitch or 1

	local sound = Instance.new("Sound")
	sound.Name = "SFX_" .. sfxName
	sound.SoundId = soundId
	sound.Volume = volume * SFXVolume * MasterVolume
	sound.Pitch = pitch
	sound.SoundGroup = SFXGroup
	sound.RollOffMode = Enum.RollOffMode.Linear
	sound.MaxDistance = 100
	sound.MinDistance = 10
	sound.Parent = part
	sound:Play()

	table.insert(ActiveSounds, sound)

	task.delay(sound.TimeLength + 1, function()
		sound:Destroy()
		local index = table.find(ActiveSounds, sound)
		if index then table.remove(ActiveSounds, index) end
	end)

	return sound
end

function AudioController.PlayCreatureCry(speciesId: string, pitch: number?)
	-- Would play creature-specific cry
	-- For now use a generic sound based on element
	local speciesConfig = Config.SpeciesList[speciesId]
	if not speciesConfig then return end

	local elementSounds = {
		Fire = "Fire",
		Water = "Water",
		Nature = "Nature",
		Earth = "Earth",
		Air = "Air",
		Shadow = "Shadow",
		Light = "Light",
		Metal = "Metal",
		Crystal = "Crystal",
	}

	local soundName = elementSounds[speciesConfig.Element1] or "HitNormal"
	AudioController.PlaySFX(soundName, nil, 0.5, pitch or (1 + math.random() * 0.2 - 0.1))
end

function AudioController.SetSFXVolume(volume: number)
	SFXVolume = math.clamp(volume, 0, 1)
	SFXGroup.Volume = SFXVolume * MasterVolume
end

function AudioController.GetSFXVolume(): number
	return SFXVolume
end

-- Master volume
function AudioController.SetMasterVolume(volume: number)
	MasterVolume = math.clamp(volume, 0, 1)
	MusicGroup.Volume = MusicVolume * MasterVolume
	SFXGroup.Volume = SFXVolume * MasterVolume
	AmbienceGroup.Volume = 0.3 * MasterVolume
end

function AudioController.GetMasterVolume(): number
	return MasterVolume
end

-- Mute
function AudioController.SetMusicMuted(muted: boolean)
	IsMusicMuted = muted
	MusicGroup.Volume = muted and 0 or (MusicVolume * MasterVolume)
end

function AudioController.SetSFXMuted(muted: boolean)
	IsSFXMuted = muted
	SFXGroup.Volume = muted and 0 or (SFXVolume * MasterVolume)
end

function AudioController.IsMusicMuted(): boolean
	return IsMusicMuted
end

function AudioController.IsSFXMuted(): boolean
	return IsSFXMuted
end

-- Battle music
function AudioController.PlayBattleMusic(battleType: "Wild" | "Trainer" | "Legendary")
	local tracks = {
		Wild = "BattleWild",
		Trainer = "BattleTrainer",
		Legendary = "BattleLegendary",
	}
	AudioController.PlayMusic(tracks[battleType], 1.5)
end

function AudioController.PlayVictoryMusic()
	AudioController.PlayMusic("Victory", 1)

	task.delay(5, function()
		AudioController.PlayMusic("Overworld", 2)
	end)
end

function AudioController.PlayDefeatMusic()
	AudioController.PlayMusic("Defeat", 1)

	task.delay(5, function()
		AudioController.PlayMusic("Overworld", 2)
	end)
end

-- Special events
function AudioController.PlayEvolutionMusic()
	AudioController.PlayMusic("Evolution", 0.5)
	AudioController.PlaySFX("EvolutionStart")

	task.delay(3, function()
		AudioController.PlaySFX("EvolutionComplete")
	end)

	task.delay(8, function()
		AudioController.PlayMusic("Overworld", 2)
	end)
end

function AudioController.PlayCaptureSequence()
	AudioController.PlaySFX("CaptureThrow")

	task.delay(0.5, function()
		AudioController.PlaySFX("CaptureShake")
	end)

	task.delay(1.5, function()
		AudioController.PlaySFX("CaptureShake")
	end)

	task.delay(2.5, function()
		AudioController.PlaySFX("CaptureSuccess")
		AudioController.PlayMusic("Capture", 0.5)
	end)

	task.delay(5, function()
		AudioController.PlayMusic("Overworld", 2)
	end)
end

function AudioController.PlayHealSound()
	AudioController.PlaySFX("Heal")
	AudioController.PlayMusic("Healing", 1)

	task.delay(3, function()
		AudioController.PlayMusic("Overworld", 2)
	end)
end

function AudioController.PlayLevelUpSound()
	AudioController.PlaySFX("LevelUp")
end

-- Ambience
function AudioController.PlayAmbience(ambienceType: string, position: Vector3?)
	local ambienceTracks = {
		Rain = {Id = "rbxassetid://12222375", Volume = 0.3},
		Wind = {Id = "rbxassetid://12222384", Volume = 0.2},
		Cave = {Id = "rbxassetid://12222393", Volume = 0.25},
		Forest = {Id = "rbxassetid://12222402", Volume = 0.2},
		Ocean = {Id = "rbxassetid://12222411", Volume = 0.25},
		City = {Id = "rbxassetid://12222420", Volume = 0.15},
	}

	local track = ambienceTracks[ambienceType]
	if not track then return end

	-- Stop existing ambience of same type
	for _, sound in ipairs(AmbienceSounds) do
		if sound:GetAttribute("AmbienceType") == ambienceType then
			sound:Stop()
			sound:Destroy()
		end
	end

	local sound = Instance.new("Sound")
	sound.Name = "Ambience_" .. ambienceType
	sound.SoundId = track.Id
	sound.Volume = track.Volume * MasterVolume
	sound.Looped = true
	sound.SoundGroup = AmbienceGroup
	sound:SetAttribute("AmbienceType", ambienceType)

	if position then
		local part = Instance.new("Part")
		part.Name = "AmbienceEmitter"
		part.Size = Vector3.new(1, 1, 1)
		part.Transparency = 1
		part.Anchored = true
		part.CanCollide = false
		part.CFrame = CFrame.new(position)
		part.Parent = workspace

		sound.Parent = part
		sound.RollOffMode = Enum.RollOffMode.Linear
		sound.MaxDistance = 200
		sound.MinDistance = 50
	else
		sound.Parent = SoundService
	end

	sound:Play()
	table.insert(AmbienceSounds, sound)
end

function AudioController.StopAmbience(ambienceType: string?)
	if ambienceType then
		for i = #AmbienceSounds, 1, -1 do
			local sound = AmbienceSounds[i]
			if sound:GetAttribute("AmbienceType") == ambienceType then
				sound:Stop()
				sound:Destroy()
				table.remove(AmbienceSounds, i)
			end
		end
	else
		for _, sound in ipairs(AmbienceSounds) do
			sound:Stop()
			sound:Destroy()
		end
		AmbienceSounds = {}
	end
end

-- Weather ambience
function AudioController.SetWeatherAmbience(weather: string)
	AudioController.StopAmbience("Rain")
	AudioController.StopAmbience("Wind")

	if weather == "Rain" then
		AudioController.PlayAmbience("Rain")
	elseif weather == "Sandstorm" or weather == "Windy" then
		AudioController.PlayAmbience("Wind")
	end
end

-- Time of day ambience
function AudioController.SetTimeOfDayAmbience(timeOfDay: string)
	if timeOfDay == "Night" then
		AudioController.PlayMusic("Night", 5)
	elseif timeOfDay == "Day" then
		AudioController.PlayMusic("Overworld", 5)
	end
end

-- Zone music
function AudioController.SetZoneMusic(zoneId: string)
	local zoneMusic = {
		Cave = "Cave",
		Forest = "Overworld",
		Mountain = "Overworld",
		Ocean = "Overworld",
		City = "Overworld",
		Desert = "Overworld",
		Snow = "Overworld",
		Volcano = "BattleLegendary",
		Ruins = "Cave",
		Sky = "Overworld",
		Underground = "Cave",
		Beach = "Overworld",
		Swamp = "Cave",
	}

	local track = zoneMusic[zoneId] or "Overworld"
	AudioController.PlayMusic(track, 3)
end

-- Footstep sounds
local LastFootstepTime = 0
local FootstepInterval = 0.4

function AudioController.PlayFootstep(material: Enum.Material, isRunning: boolean)
	local now = tick()
	if now - LastFootstepTime &lt; (isRunning and FootstepInterval * 0.6 or FootstepInterval) then return end
	LastFootstepTime = now

	local footstepSounds = {
		[Enum.Material.Grass] = "FootstepGrass",
		[Enum.Material.Sand] = "FootstepSand",
		[Enum.Material.Mud] = "FootstepGrass",
		[Enum.Material.Ground] = "FootstepGrass",
		[Enum.Material.Rock] = "FootstepCave",
		[Enum.Material.Brick] = "FootstepCave",
		[Enum.Material.Concrete] = "FootstepCave",
		[Enum.Material.Wood] = "FootstepCave",
		[Enum.Material.Water] = "FootstepWater",
		[Enum.Material.Snow] = "FootstepSand",
		[Enum.Material.Ice] = "FootstepCave",
	}

	local soundName = footstepSounds[material] or "FootstepGrass"
	AudioController.PlaySFX(soundName, nil, isRunning and 0.6 or 0.4)
end

-- Cleanup
function AudioController.Cleanup()
	for _, sound in ipairs(ActiveSounds) do
		sound:Stop()
		sound:Destroy()
	end
	ActiveSounds = {}

	for _, sound in ipairs(AmbienceSounds) do
		sound:Stop()
		sound:Destroy()
	end
	AmbienceSounds = {}

	if CurrentMusic then
		CurrentMusic:Stop()
		CurrentMusic:Destroy()
		CurrentMusic = nil
	end
end

return AudioController</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="33">
            <Properties>
              <string name="Name">BattleController</string>
              <string name="Source">--!strict
-- BattleController.lua - Controlador de batalhas

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Types = require(ReplicatedStorage.Shared.Types)
local Config = require(ReplicatedStorage.Shared.Config)
local MathUtil = require(ReplicatedStorage.Shared.Util.Math)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local BattleController = {}

-- Events
BattleController.OnBattleStarted = Signal.New()
BattleController.OnBattleEnded = Signal.New()
BattleController.OnTurnChanged = Signal.New()
BattleController.OnMoveUsed = Signal.New()
BattleController.OnCreatureFainted = Signal.New()
BattleController.OnStatusChanged = Signal.New()
BattleController.OnStatStageChanged = Signal.New()
BattleController.OnWeatherChanged = Signal.New()

-- State
local CurrentBattle: Types.BattleData?
local LocalPlayer = Players.LocalPlayer
local IsPlayerTurn = false
local TurnTimer = 0
local SelectedAction: Types.BattleAction?
local BattleUI = {} :: {[string]: Instance}

-- Animation state
local BattleAnimations = {} :: {thread}

-- Initialize
function BattleController.Initialize()
	print("[BattleController] Initializing...")
	print("[BattleController] Initialized")
end

-- Start battle
function BattleController.StartBattle(battleData: Types.BattleData)
	CurrentBattle = battleData
	IsPlayerTurn = battleData.CurrentTurn == 1 -- Player is usually turn 1
	TurnTimer = Config.Battle.TurnTime or 30

	print("[BattleController] Battle started:", battleData.Id)

	-- Create battle UI
	BattleController.CreateBattleUI(battleData)

	-- Start turn timer
	BattleController.StartTurnTimer()

	BattleController.OnBattleStarted:Fire(battleData)
end

-- End battle
function BattleController.EndBattle(result: string)
	print("[BattleController] Battle ended:", result)

	-- Clean up UI
	BattleController.DestroyBattleUI()

	-- Clear state
	CurrentBattle = nil
	IsPlayerTurn = false
	SelectedAction = nil

	BattleController.OnBattleEnded:Fire(result)
end

-- Update battle state from server
function BattleController.UpdateBattle(battleData: Types.BattleData)
	if not CurrentBattle then return end

	local oldTurn = CurrentBattle.CurrentTurn
	CurrentBattle = battleData
	IsPlayerTurn = battleData.CurrentTurn == 1

	-- Update UI
	BattleController.UpdateBattleUI(battleData)

	-- Check for turn change
	if battleData.CurrentTurn ~= oldTurn then
		TurnTimer = Config.Battle.TurnTime or 30
		BattleController.StartTurnTimer()
		BattleController.OnTurnChanged:Fire(battleData.CurrentTurn, IsPlayerTurn)
	end
end

-- Create battle UI
function BattleController.CreateBattleUI(battleData: Types.BattleData)
	local playerGui = LocalPlayer:WaitForChild("PlayerGui")
	local screenGui = playerGui:FindFirstChild("ArquipelagoUI")

	if not screenGui then return end

	-- Main battle frame
	local battleFrame = Instance.new("Frame")
	battleFrame.Name = "BattleFrame"
	battleFrame.Size = UDim2.new(1, 0, 1, 0)
	battleFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 20)
	battleFrame.BorderSizePixel = 0
	battleFrame.Parent = screenGui
	BattleUI.Main = battleFrame

	-- Background
	local bg = Instance.new("ImageLabel")
	bg.Name = "BattleBg"
	bg.Size = UDim2.new(1, 0, 1, 0)
	bg.BackgroundTransparency = 1
	bg.Image = "rbxassetid://0" -- Battle background
	bg.ImageTransparency = 0.5
	bg.Parent = battleFrame

	-- Weather indicator
	if battleData.Weather then
		BattleController.CreateWeatherIndicator(battleFrame, battleData.Weather)
	end

	-- Player side (bottom)
	local playerSide = BattleController.CreateSideUI(battleFrame, "Player", battleData.PlayerCreature, true)
	BattleUI.PlayerSide = playerSide

	-- Enemy side (top)
	local enemySide = BattleController.CreateSideUI(battleFrame, "Enemy", battleData.EnemyCreature, false)
	BattleUI.EnemySide = enemySide

	-- Action menu (bottom)
	local actionMenu = BattleController.CreateActionMenu(battleFrame)
	BattleUI.ActionMenu = actionMenu

	-- Move selection
	local moveMenu = BattleController.CreateMoveMenu(battleFrame)
	moveMenu.Visible = false
	BattleUI.MoveMenu = moveMenu

	-- Battle log
	local battleLog = BattleController.CreateBattleLog(battleFrame)
	BattleUI.BattleLog = battleLog

	-- Turn timer
	local timerFrame = BattleController.CreateTurnTimer(battleFrame)
	BattleUI.Timer = timerFrame

	-- Creature viewports
	BattleController.CreateBattleViewports(battleFrame, battleData)
end

function BattleController.CreateSideUI(parent: Instance, side: string, creature: Types.CreatureData?, isPlayer: boolean): Frame
	local frame = Instance.new("Frame")
	frame.Name = side .. "Side"
	frame.Size = UDim2.new(0.4, 0, 0.25, 0)
	frame.Position = isPlayer and UDim2.new(0.55, 0, 0.65, 0) or UDim2.new(0.05, 0, 0.1, 0)
	frame.BackgroundColor3 = Color3.fromRGB(20, 20, 35)
	frame.BackgroundTransparency = 0.2
	frame.BorderSizePixel = 0
	frame.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = frame

	if not creature then return frame end

	-- Creature name and level
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "Name"
	nameLabel.Size = UDim2.new(1, -20, 0, 30)
	nameLabel.Position = UDim2.new(0, 10, 0, 10)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = (creature.Nickname ~= "" and creature.Nickname or creature.SpeciesId) .. `  Lv.{creature.Level}`
	nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	nameLabel.TextScaled = true
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Parent = frame

	-- HP Bar
	local hpBg = Instance.new("Frame")
	hpBg.Name = "HpBg"
	hpBg.Size = UDim2.new(1, -20, 0, 16)
	hpBg.Position = UDim2.new(0, 10, 0, 45)
	hpBg.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
	hpBg.BorderSizePixel = 0
	hpBg.Parent = frame

	local hpCorner = Instance.new("UICorner")
	hpCorner.CornerRadius = UDim.new(1, 0)
	hpCorner.Parent = hpBg

	local hpFill = Instance.new("Frame")
	hpFill.Name = "HpFill"
	hpFill.Size = UDim2.new(creature.CurrentHP / creature.MaxHP, 0, 1, 0)
	hpFill.BackgroundColor3 = BattleController.GetHPColor(creature.CurrentHP / creature.MaxHP)
	hpFill.BorderSizePixel = 0
	hpFill.Parent = hpBg

	local hpFillCorner = Instance.new("UICorner")
	hpFillCorner.CornerRadius = UDim.new(1, 0)
	hpFillCorner.Parent = hpFill

	local hpText = Instance.new("TextLabel")
	hpText.Name = "HpText"
	hpText.Size = UDim2.new(1, -10, 1, 0)
	hpText.Position = UDim2.new(0, 5, 0, 0)
	hpText.BackgroundTransparency = 1
	hpText.Text = `{creature.CurrentHP}/{creature.MaxHP}`
	hpText.TextColor3 = Color3.fromRGB(255, 255, 255)
	hpText.TextScaled = true
	hpText.Font = Enum.Font.GothamBold
	hpText.TextXAlignment = Enum.TextXAlignment.Right
	hpText.Parent = hpBg

	-- Status icons
	local statusFrame = Instance.new("Frame")
	statusFrame.Name = "StatusFrame"
	statusFrame.Size = UDim2.new(1, -20, 0, 25)
	statusFrame.Position = UDim2.new(0, 10, 0, 65)
	statusFrame.BackgroundTransparency = 1
	statusFrame.Parent = frame

	local statusLayout = Instance.new("UIListLayout")
	statusLayout.FillDirection = Enum.FillDirection.Horizontal
	statusLayout.Padding = UDim.new(0, 5)
	statusLayout.Parent = statusFrame

	-- Gender
	if creature.Gender ~= "Genderless" then
		local genderLabel = Instance.new("TextLabel")
		genderLabel.Size = UDim2.new(0, 20, 1, 0)
		genderLabel.BackgroundTransparency = 1
		genderLabel.Text = creature.Gender == "Male" and "♂" or "♀"
		genderLabel.TextColor3 = creature.Gender == "Male" and Color3.fromRGB(100, 150, 255) or Color3.fromRGB(255, 100, 200)
		genderLabel.TextScaled = true
		genderLabel.Font = Enum.Font.GothamBold
		genderLabel.Parent = statusFrame
	end

	-- Shiny
	if creature.IsShiny then
		local shinyLabel = Instance.new("TextLabel")
		shinyLabel.Size = UDim2.new(0, 50, 1, 0)
		shinyLabel.BackgroundTransparency = 1
		shinyLabel.Text = "✨"
		shinyLabel.TextScaled = true
		shinyLabel.Parent = statusFrame
	end

	return frame
end

function BattleController.GetHPColor(ratio: number): Color3
	if ratio &gt; 0.5 then return Color3.fromRGB(60, 200, 100)
	elseif ratio &gt; 0.2 then return Color3.fromRGB(255, 180, 50)
	else return Color3.fromRGB(220, 60, 60) end
end

function BattleController.CreateActionMenu(parent: Instance): Frame
	local frame = Instance.new("Frame")
	frame.Name = "ActionMenu"
	frame.Size = UDim2.new(0.4, 0, 0.2, 0)
	frame.Position = UDim2.new(0.55, 0, 0.78, 0)
	frame.BackgroundColor3 = Color3.fromRGB(25, 25, 40)
	frame.BackgroundTransparency = 0.1
	frame.BorderSizePixel = 0
	frame.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = frame

	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.new(0.5, -10, 0.5, -10)
	layout.CellPadding = UDim2.new(0, 10, 0, 10)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Parent = frame

	local actions = {
		{Name = "Lutar", Icon = "⚔️", Color = Color3.fromRGB(220, 60, 60), Action = {Type = "Move"}},
		{Name = "Mochila", Icon = "🎒", Color = Color3.fromRGB(100, 150, 255), Action = {Type = "Item"}},
		{Name = "Criatura", Icon = "🔄", Color = Color3.fromRGB(255, 150, 50), Action = {Type = "Switch"}},
		{Name = "Fugir", Icon = "🏃", Color = Color3.fromRGB(150, 150, 170), Action = {Type = "Flee"}},
	}

	for _, act in ipairs(actions) do
		local btn = Instance.new("TextButton")
		btn.Name = act.Name
		btn.BackgroundColor3 = act.Color
		btn.BorderSizePixel = 0
		btn.Text = act.Icon .. " " .. act.Name
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.TextScaled = true
		btn.Font = Enum.Font.GothamBold
		btn.Parent = frame

		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 10)
		btnCorner.Parent = btn

		btn.MouseButton1Click:Connect(function()
			BattleController.OnActionSelected(act.Action)
		end)
	end

	return frame
end

