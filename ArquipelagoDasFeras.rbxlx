function BattleController.CreateBattleViewports(parent: Instance, battleData: Types.BattleData)
	-- Player creature viewport
	local playerViewport = Instance.new("ViewportFrame")
	playerViewport.Name = "PlayerViewport"
	playerViewport.Size = UDim2.new(0.25, 0, 0.35, 0)
	playerViewport.Position = UDim2.new(0.7, 0, 0.3, 0)
	playerViewport.BackgroundTransparency = 1
	playerViewport.Parent = parent

	local playerCamera = Instance.new("Camera")
	playerCamera.Parent = playerViewport
	playerViewport.CurrentCamera = playerCamera
	BattleUI.PlayerViewport = playerViewport

	-- Enemy creature viewport
	local enemyViewport = Instance.new("ViewportFrame")
	enemyViewport.Name = "EnemyViewport"
	enemyViewport.Size = UDim2.new(0.25, 0, 0.35, 0)
	enemyViewport.Position = UDim2.new(0.05, 0, 0.1, 0)
	enemyViewport.BackgroundTransparency = 1
	enemyViewport.Parent = parent

	local enemyCamera = Instance.new("Camera")
	enemyCamera.Parent = enemyViewport
	enemyViewport.CurrentCamera = enemyCamera
	BattleUI.EnemyViewport = enemyViewport

	-- Load models
	if battleData.PlayerCreature then
		BattleController.LoadBattleModel(battleData.PlayerCreature, playerViewport, true)
	end
	if battleData.EnemyCreature then
		BattleController.LoadBattleModel(battleData.EnemyCreature, enemyViewport, false)
	end
end

function BattleController.LoadBattleModel(creature: Types.CreatureData, viewport: ViewportFrame, isPlayer: boolean)
	-- Load from ReplicatedStorage.Assets.Creatures
	local model = ReplicatedStorage:FindFirstChild("Assets")
		and ReplicatedStorage.Assets:FindFirstChild("Creatures")
		and ReplicatedStorage.Assets.Creatures:FindFirstChild(creature.SpeciesId)

	if not model then
		model = BattleController.CreateBattlePlaceholder(creature)
	end

	local clone = model:Clone()
	clone.Name = "BattleModel"
	clone.Parent = viewport

	-- Position
	local primaryPart = clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart")
	if primaryPart then
		clone:PivotTo(CFrame.new(0, 0, 0))

		local camera = viewport.CurrentCamera
		if camera then
			local cf, size = clone:GetBoundingBox()
			local distance = size.Z * 2.5
			camera.CFrame = CFrame.new(cf.Position + Vector3.new(0, size.Y * 0.3, distance), cf.Position)
			camera.FieldOfView = 25
		end
	end

	-- Apply appearance
	BattleController.ApplyBattleAppearance(clone, creature)

	-- Play entrance animation
	BattleController.PlayEntranceAnimation(clone, isPlayer)
end

function BattleController.CreateBattlePlaceholder(creature: Types.CreatureData): Model
	local model = Instance.new("Model")
	model.Name = creature.SpeciesId

	local part = Instance.new("Part")
	part.Name = "Body"
	part.Size = Vector3.new(4, 4, 4)
	part.Shape = Enum.PartType.Ball
	part.Anchored = true
	part.CanCollide = false
	part.Material = Enum.Material.Neon
	part.Color = BattleController.GetElementColor(creature.Element1)
	part.Parent = model

	model.PrimaryPart = part

	return model
end

function BattleController.GetElementColor(element: Types.ElementType): Color3
	local colors = {
		Fire = Color3.fromRGB(255, 100, 50),
		Water = Color3.fromRGB(50, 150, 255),
		Nature = Color3.fromRGB(80, 200, 80),
		Earth = Color3.fromRGB(180, 140, 80),
		Air = Color3.fromRGB(180, 200, 255),
		Shadow = Color3.fromRGB(120, 60, 180),
		Light = Color3.fromRGB(255, 240, 180),
		Metal = Color3.fromRGB(180, 180, 200),
		Crystal = Color3.fromRGB(200, 220, 255),
	}
	return colors[element] or Color3.fromRGB(200, 200, 200)
end

function BattleController.ApplyBattleAppearance(model: Model, creature: Types.CreatureData)
	if creature.IsShiny then
		for _, part in ipairs(model:GetDescendants()) do
			if part:IsA("BasePart") then
				part.Material = Enum.Material.Neon
				local sparkles = Instance.new("ParticleEmitter")
				sparkles.Name = "ShinySparkles"
				sparkles.Color = ColorSequence.new(Color3.fromRGB(255, 255, 200))
				sparkles.Size = NumberSequence.new(0.3)
				sparkles.Lifetime = NumberRange.new(0.5, 1.5)
				sparkles.Rate = 30
				sparkles.Speed = NumberRange.new(2, 5)
				sparkles.SpreadAngle = Vector2.new(180, 180)
				sparkles.Parent = part
			end
		end
	end

	-- Status effect visuals
	if creature.StatusCondition ~= "None" then
		BattleController.ApplyStatusVisual(model, creature.StatusCondition)
	end
end

function BattleController.ApplyStatusVisual(model: Model, status: string)
	local primaryPart = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	if not primaryPart then return end

	local effects = {
		Burn = {Color = Color3.fromRGB(255, 80, 30), Particles = "Fire"},
		Poison = {Color = Color3.fromRGB(150, 50, 200), Particles = "Smoke"},
		Paralysis = {Color = Color3.fromRGB(255, 255, 100), Particles = "Sparkles"},
		Sleep = {Color = Color3.fromRGB(100, 100, 200), Particles = nil},
		Freeze = {Color = Color3.fromRGB(100, 200, 255), Particles = "Ice"},
	}

	local effect = effects[status]
	if not effect then return end

	-- Tint model
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Color = part.Color:Lerp(effect.Color, 0.3)
		end
	end

	-- Add particles
	if effect.Particles then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "StatusEffect"
		emitter.Color = ColorSequence.new(effect.Color)
		emitter.Size = NumberSequence.new(0.5)
		emitter.Lifetime = NumberRange.new(0.5, 1)
		emitter.Rate = 15
		emitter.Speed = NumberRange.new(1, 3)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Parent = primaryPart
	end
end

function BattleController.PlayEntranceAnimation(model: Model, isPlayer: boolean)
	local primaryPart = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	if not primaryPart then return end

	local startPos = primaryPart.Position
	local endPos = startPos

	if isPlayer then
		startPos = startPos + Vector3.new(-20, 0, 0)
	else
		startPos = startPos + Vector3.new(20, 0, 0)
	end

	model:PivotTo(CFrame.new(startPos))

	local tween = TweenService:Create(primaryPart, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		CFrame = CFrame.new(endPos)
	})
	tween:Play()
end

function BattleController.OnActionSelected(action: Types.BattleAction)
	if not IsPlayerTurn then return end

	if action.Type == "Move" then
		BattleController.ShowMoveMenu()
	elseif action.Type == "Item" then
		BattleController.OpenItemMenu()
	elseif action.Type == "Switch" then
		BattleController.OpenSwitchMenu()
	elseif action.Type == "Flee" then
		BattleController.AttemptFlee()
	end
end

function BattleController.ShowMoveMenu()
	if not CurrentBattle or not CurrentBattle.PlayerCreature then return end

	if BattleUI.ActionMenu then
		BattleUI.ActionMenu.Visible = false
	end

	if BattleUI.MoveMenu then
		BattleUI.MoveMenu.Visible = true
		BattleController.PopulateMoveMenu(CurrentBattle.PlayerCreature)
	end
end

function BattleController.PopulateMoveMenu(creature: Types.CreatureData)
	if not BattleUI.MovesContainer then return end

	-- Clear existing
	for _, child in ipairs(BattleUI.MovesContainer:GetChildren()) do
		if child:IsA("GuiObject") then child:Destroy() end
	end

	-- Add moves
	for i, moveSlot in ipairs(creature.Moves) do
		local moveConfig = Config.Moves[moveSlot.MoveId]
		if not moveConfig then continue end

		local moveFrame = Instance.new("Frame")
		moveFrame.Name = `Move_{i}`
		moveFrame.Size = UDim2.new(1, 0, 0, 50)
		moveFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 55)
		moveFrame.BorderSizePixel = 0
		moveFrame.Parent = BattleUI.MovesContainer

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent = moveFrame

		-- Move name and type
		local nameLabel = Instance.new("TextLabel")
		nameLabel.Size = UDim2.new(0.5, 0, 1, 0)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Text = moveConfig.Name
		nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		nameLabel.TextScaled = true
		nameLabel.Font = Enum.Font.GothamBold
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.Parent = moveFrame

		-- Type tag
		local typeTag = Instance.new("TextLabel")
		typeTag.Size = UDim2.new(0, 80, 0, 25)
		typeTag.Position = UDim2.new(0.5, 5, 0.5, -12)
		typeTag.BackgroundColor3 = BattleController.GetElementColor(moveConfig.Type)
		typeTag.BorderSizePixel = 0
		typeTag.Text = Types.ElementDisplayNames[moveConfig.Type] or moveConfig.Type
		typeTag.TextColor3 = Color3.fromRGB(255, 255, 255)
		typeTag.TextScaled = true
		typeTag.Font = Enum.Font.GothamBold
		typeTag.Parent = moveFrame

		local tagCorner = Instance.new("UICorner")
		tagCorner.CornerRadius = UDim.new(0, 4)
		tagCorner.Parent = typeTag

		-- Category icon
		local catIcon = Instance.new("TextLabel")
		catIcon.Size = UDim2.new(0, 30, 0, 30)
		catIcon.Position = UDim2.new(0.5, 90, 0.5, -15)
		catIcon.BackgroundTransparency = 1
		catIcon.Text = moveConfig.Category == "Physical" and "👊" or moveConfig.Category == "Special" and "💫" or "🛡️"
		catIcon.TextScaled = true
		catIcon.Parent = moveFrame

		-- PP
		local ppLabel = Instance.new("TextLabel")
		ppLabel.Size = UDim2.new(0, 60, 1, 0)
		ppLabel.Position = UDim2.new(1, -65, 0, 0)
		ppLabel.BackgroundTransparency = 1
		ppLabel.Text = `PP {moveSlot.CurrentPP}/{moveSlot.MaxPP}`
		ppLabel.TextColor3 = moveSlot.CurrentPP &gt; 0 and Color3.fromRGB(200, 200, 220) or Color3.fromRGB(220, 60, 60)
		ppLabel.TextScaled = true
		ppLabel.Font = Enum.Font.Gotham
		ppLabel.TextXAlignment = Enum.TextXAlignment.Right
		ppLabel.Parent = moveFrame

		-- Power/Accuracy
		local infoLabel = Instance.new("TextLabel")
		infoLabel.Size = UDim2.new(0.5, -5, 0, 20)
		infoLabel.Position = UDim2.new(0, 5, 1, -22)
		infoLabel.BackgroundTransparency = 1
		infoLabel.Text = `Poder: {moveConfig.Power or "-"}  Precisão: {moveConfig.Accuracy or "-"}`
		infoLabel.TextColor3 = Color3.fromRGB(150, 150, 170)
		infoLabel.TextScaled = true
		infoLabel.Font = Enum.Font.Gotham
		infoLabel.TextXAlignment = Enum.TextXAlignment.Left
		infoLabel.Parent = moveFrame

		-- Click handler
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, 0, 1, 0)
		btn.BackgroundTransparency = 1
		btn.Text = ""
		btn.Parent = moveFrame

		btn.MouseButton1Click:Connect(function()
			if moveSlot.CurrentPP &gt; 0 then
				BattleController.SelectMove(i, moveSlot.MoveId)
			end
		end)

		btn.MouseEnter:Connect(function()
			TweenService:Create(moveFrame, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(45, 45, 65)}):Play()
		end)
		btn.MouseLeave:Connect(function()
			TweenService:Create(moveFrame, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(35, 35, 55)}):Play()
		end)
	end
end

function BattleController.SelectMove(moveIndex: number, moveId: string)
	SelectedAction = {
		Type = "Move",
		MoveIndex = moveIndex,
		MoveId = moveId,
		Target = 2, -- Enemy
	}

	if BattleUI.MoveMenu then
		BattleUI.MoveMenu.Visible = false
	end

	if BattleUI.ActionMenu then
		BattleUI.ActionMenu.Visible = true
	end

	-- Send to server
	BattleController.SendAction(SelectedAction)
end

function BattleController.OpenItemMenu()
	print("[BattleController] Open item menu")
end

function BattleController.OpenSwitchMenu()
	print("[BattleController] Open switch menu")
end

function BattleController.AttemptFlee()
	if CurrentBattle then
		local remote = ReplicatedStorage:FindFirstChild("Remotes")
		local fleeRemote = remote and remote:FindFirstChild("BattleAction")
		if fleeRemote then
			fleeRemote:InvokeServer(CurrentBattle.Id, {Type = "Flee"})
		end
	end
end

function BattleController.SendAction(action: Types.BattleAction)
	if not CurrentBattle then return end

	local remote = ReplicatedStorage:FindFirstChild("Remotes")
	local battleRemote = remote and remote:FindFirstChild("BattleAction")
	if battleRemote then
		battleRemote:InvokeServer(CurrentBattle.Id, action)
	end
end

function BattleController.StartTurnTimer()
	if BattleUI.TimerText then
		BattleUI.TimerText.Text = tostring(TurnTimer)
	end

	task.spawn(function()
		while TurnTimer &gt; 0 and CurrentBattle and IsPlayerTurn do
			task.wait(1)
			TurnTimer -= 1
			if BattleUI.TimerText then
				BattleUI.TimerText.Text = tostring(TurnTimer)
			end
		end

		if TurnTimer &lt;= 0 and IsPlayerTurn and CurrentBattle then
			-- Auto-select first available move
			BattleController.AutoSelectMove()
		end
	end)
end

function BattleController.AutoSelectMove()
	if not CurrentBattle or not CurrentBattle.PlayerCreature then return end

	for i, moveSlot in ipairs(CurrentBattle.PlayerCreature.Moves) do
		if moveSlot.CurrentPP &gt; 0 then
			BattleController.SelectMove(i, moveSlot.MoveId)
			return
		end
	end

	-- Struggle
	BattleController.SelectMove(1, "Struggle")
end

function BattleController.UpdateBattleUI(battleData: Types.BattleData)
	-- Update HP bars
	if BattleUI.PlayerSide and battleData.PlayerCreature then
		BattleController.UpdateCreatureSide(BattleUI.PlayerSide, battleData.PlayerCreature)
	end

	if BattleUI.EnemySide and battleData.EnemyCreature then
		BattleController.UpdateCreatureSide(BattleUI.EnemySide, battleData.EnemyCreature)
	end

	-- Update battle log
	if BattleUI.BattleLog then
		local logText = BattleUI.BattleLog:FindFirstChild("LogText")
		if logText and battleData.BattleLog and #battleData.BattleLog &gt; 0 then
			logText.Text = battleData.BattleLog[#battleData.BattleLog]
		end
	end
end

function BattleController.UpdateCreatureSide(sideFrame: Frame, creature: Types.CreatureData)
	local hpBg = sideFrame:FindFirstChild("HpBg")
	if hpBg then
		local hpFill = hpBg:FindFirstChild("HpFill")
		local hpText = hpBg:FindFirstChild("HpText")

		if hpFill then
			TweenService:Create(hpFill, TweenInfo.new(0.5), {
				Size = UDim2.new(creature.CurrentHP / creature.MaxHP, 0, 1, 0),
				BackgroundColor3 = BattleController.GetHPColor(creature.CurrentHP / creature.MaxHP)
			}):Play()
		end

		if hpText then
			hpText.Text = `{creature.CurrentHP}/{creature.MaxHP}`
		end
	end

	-- Update status
	local statusFrame = sideFrame:FindFirstChild("StatusFrame")
	if statusFrame then
		BattleController.UpdateStatusIcons(statusFrame, creature)
	end
end

function BattleController.UpdateStatusIcons(statusFrame: Frame, creature: Types.CreatureData)
	-- Clear existing status icons (except gender/shiny)
	for _, child in ipairs(statusFrame:GetChildren()) do
		if child:IsA("TextLabel") and not child.Text:match("[♂♀✨]") then
			child:Destroy()
		end
	end

	if creature.StatusCondition ~= "None" then
		local statusIcons = {
			Burn = "🔥",
			Poison = "☠️",
			Paralysis = "⚡",
			Sleep = "💤",
			Freeze = "🧊",
			Confusion = "💫",
		}

		local icon = statusIcons[creature.StatusCondition] or "❓"
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(0, 30, 1, 0)
		label.BackgroundTransparency = 1
		label.Text = icon
		label.TextScaled = true
		label.Parent = statusFrame
	end
end

function BattleController.DestroyBattleUI()
	for _, ui in pairs(BattleUI) do
		if ui and ui.Destroy then
			ui:Destroy()
		end
	end
	BattleUI = {}
end

-- Animation playback
function BattleController.PlayMoveAnimation(moveId: string, attackerSide: string, targetSide: string)
	local moveConfig = Config.Moves[moveId]
	if not moveConfig then return end

	-- Play move animation based on category
	if moveConfig.Category == "Physical" then
		BattleController.PlayPhysicalMoveAnimation(attackerSide, targetSide)
	elseif moveConfig.Category == "Special" then
		BattleController.PlaySpecialMoveAnimation(moveConfig.Type, attackerSide, targetSide)
	else
		BattleController.PlayStatusMoveAnimation(attackerSide, targetSide)
	end
end

function BattleController.PlayPhysicalMoveAnimation(attackerSide: string, targetSide: string)
	local viewport = attackerSide == "Player" and BattleUI.PlayerViewport or BattleUI.EnemyViewport
	local targetViewport = targetSide == "Player" and BattleUI.PlayerViewport or BattleUI.EnemyViewport

	local attackerModel = viewport and viewport:FindFirstChild("BattleModel")
	local targetModel = targetViewport and targetViewport:FindFirstChild("BattleModel")

	if not attackerModel or not targetModel then return end

	local attackerPart = attackerModel.PrimaryPart
	local targetPart = targetModel.PrimaryPart

	if not attackerPart or not targetPart then return end

	-- Attacker lunge
	local originalPos = attackerPart.Position
	local targetPos = targetPart.Position
	local direction = (targetPos - originalPos).Unit

	local lungeTween = TweenService:Create(attackerPart, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		CFrame = CFrame.new(originalPos + direction * 5)
	})
	lungeTween:Play()

	lungeTween.Completed:Wait()

	-- Hit effect on target
	BattleController.CreateHitEffect(targetPart, "Physical")

	-- Return
	local returnTween = TweenService:Create(attackerPart, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		CFrame = CFrame.new(originalPos)
	})
	returnTween:Play()
end

function BattleController.PlaySpecialMoveAnimation(elementType: Types.ElementType, attackerSide: string, targetSide: string)
	-- Create projectile/beam effect based on element
	local viewport = attackerSide == "Player" and BattleUI.PlayerViewport or BattleUI.EnemyViewport
	local targetViewport = targetSide == "Player" and BattleUI.PlayerViewport or BattleUI.EnemyViewport

	local targetModel = targetViewport and targetViewport:FindFirstChild("BattleModel")
	if not targetModel then return end

	local targetPart = targetModel.PrimaryPart
	if not targetPart then return end

	-- Element-specific effects
	BattleController.CreateElementalEffect(targetPart, elementType)
end

function BattleController.PlayStatusMoveAnimation(attackerSide: string, targetSide: string)
	-- Simple glow effect
	local targetViewport = targetSide == "Player" and BattleUI.PlayerViewport or BattleUI.EnemyViewport
	local targetModel = targetViewport and targetViewport:FindFirstChild("BattleModel")

	if targetModel then
		local targetPart = targetModel.PrimaryPart
		if targetPart then
			BattleController.CreateHitEffect(targetPart, "Status")
		end
	end
end

function BattleController.CreateHitEffect(targetPart: BasePart, hitType: string)
	local effect = Instance.new("Part")
	effect.Name = "HitEffect"
	effect.Size = Vector3.new(1, 1, 1)
	effect.Transparency = 1
	effect.Anchored = true
	effect.CanCollide = false
	effect.CFrame = targetPart.CFrame
	effect.Parent = targetPart.Parent

	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = hitType == "Physical" and ColorSequence.new(Color3.fromRGB(255, 200, 100))
		or hitType == "Status" and ColorSequence.new(Color3.fromRGB(100, 200, 255))
		or ColorSequence.new(Color3.fromRGB(255, 100, 100))
	emitter.Size = NumberSequence.new(0, 2)
	emitter.Lifetime = NumberRange.new(0.3, 0.6)
	emitter.Rate = 0
	emitter.Speed = NumberRange.new(5, 15)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Parent = effect

	emitter:Emit(20)

	task.delay(1, function()
		effect:Destroy()
	end)
end

function BattleController.CreateElementalEffect(targetPart: BasePart, element: Types.ElementType)
	local colors = {
		Fire = Color3.fromRGB(255, 100, 30),
		Water = Color3.fromRGB(50, 150, 255),
		Nature = Color3.fromRGB(80, 200, 80),
		Earth = Color3.fromRGB(180, 140, 80),
		Air = Color3.fromRGB(180, 220, 255),
		Shadow = Color3.fromRGB(150, 80, 220),
		Light = Color3.fromRGB(255, 240, 180),
		Metal = Color3.fromRGB(200, 200, 220),
		Crystal = Color3.fromRGB(180, 220, 255),
	}

	local color = colors[element] or Color3.fromRGB(255, 255, 255)

	local effect = Instance.new("Part")
	effect.Name = "ElementalEffect"
	effect.Size = Vector3.new(1, 1, 1)
	effect.Transparency = 1
	effect.Anchored = true
	effect.CanCollide = false
	effect.CFrame = targetPart.CFrame
	effect.Parent = targetPart.Parent

	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.Size = NumberSequence.new(0.5, 3)
	emitter.Lifetime = NumberRange.new(0.5, 1.5)
	emitter.Rate = 0
	emitter.Speed = NumberRange.new(10, 25)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Parent = effect

	emitter:Emit(30)

	task.delay(1.5, function()
		effect:Destroy()
	end)
end

function BattleController.PlayFaintAnimation(creatureSide: string)
	local viewport = creatureSide == "Player" and BattleUI.PlayerViewport or BattleUI.EnemyViewport
	local model = viewport and viewport:FindFirstChild("BattleModel")

	if model then
		local primaryPart = model.PrimaryPart
		if primaryPart then
			-- Fall over animation
			local tween = TweenService:Create(primaryPart, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				CFrame = primaryPart.CFrame * CFrame.Angles(math.rad(90), 0, 0),
				Transparency = 1
			})
			tween:Play()
		end
	end
end

return BattleController</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source">--!strict
-- CameraController.lua - Controlador de câmera (overworld, battle, cutscenes)

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Types = require(ReplicatedStorage.Shared.Types)
local Config = require(ReplicatedStorage.Shared.Config)
local MathUtil = require(ReplicatedStorage.Shared.Util.Math)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local CameraController = {}

-- Events
CameraController.OnCameraModeChanged = Signal.New()
CameraController.OnCameraShake = Signal.New()

-- State
local Camera = Workspace.CurrentCamera
local Player = Players.LocalPlayer
local Character: Model?
local Humanoid: Humanoid?
local RootPart: BasePart?

local CurrentMode = "Follow" :: "Follow" | "Fixed" | "Battle" | "Cutscene" | "Free" | "FirstPerson"
local TargetCFrame: CFrame?
local TargetSubject: Instance?

-- Follow camera settings
local FollowDistance = 15
local FollowHeight = 5
local FollowSmoothness = 0.1
local MinDistance = 5
local MaxDistance = 30
local CurrentDistance = FollowDistance

-- Battle camera settings
local BattleCameraOffset = Vector3.new(0, 8, 25)
local BattleCameraTarget = Vector3.new(0, 0, 0)
local BattleTransitionTime = 1

-- Cutscene
local CutsceneData = nil :: {CFrames: {CFrame}, Duration: number, CurrentIndex: number}?

-- Camera shake
local ShakeIntensity = 0
local ShakeDuration = 0
local ShakeOffset = Vector3.zero

-- Initialize
function CameraController.Initialize()
	print("[CameraController] Initializing...")

	Camera.CameraType = Enum.CameraType.Custom
	Camera.CameraSubject = Player.Character or Player.CharacterAdded:Wait()

	-- Character handling
	Player.CharacterAdded:Connect(CameraController.OnCharacterAdded)
	if Player.Character then
		CameraController.OnCharacterAdded(Player.Character)
	end

	-- Input for camera control
	CameraController.SetupCameraInput()

	-- Render step for custom camera logic
	RunService.RenderStepped:Connect(function(deltaTime)
		CameraController.Update(deltaTime)
	end)

	print("[CameraController] Initialized")
end

function CameraController.OnCharacterAdded(character: Model)
	Character = character
	Humanoid = character:WaitForChild("Humanoid")
	RootPart = character:WaitForChild("HumanoidRootPart")

	Camera.CameraSubject = Humanoid

	-- Reset to follow mode
	CameraController.SetMode("Follow")
end

function CameraController.SetupCameraInput()
	-- Mouse wheel zoom
	UserInputService.InputChanged:Connect(function(input, gameProcessed)
		if gameProcessed then return end

		if input.UserInputType == Enum.UserInputType.MouseWheel then
			CameraController.Zoom(input.Position.Z &gt; 0 and -1 or 1)
		end
	end)

	-- Right mouse button for camera rotation
	local isRotating = false
	local lastMousePos = Vector2.zero

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end

		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			isRotating = true
			lastMousePos = input.Position
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
		end
	end)

	UserInputService.InputEnded:Connect(function(input, gameProcessed)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			isRotating = false
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
	end)

	UserInputService.InputChanged:Connect(function(input, gameProcessed)
		if isRotating and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - lastMousePos
			CameraController.Rotate(delta.X, delta.Y)
			lastMousePos = input.Position
		end
	end)

	-- Keyboard camera controls
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end

		if input.KeyCode == Enum.KeyCode.PageUp then
			CameraController.Zoom(-1)
		elseif input.KeyCode == Enum.KeyCode.PageDown then
			CameraController.Zoom(1)
		elseif input.KeyCode == Enum.KeyCode.Home then
			CameraController.ResetCamera()
		elseif input.KeyCode == Enum.KeyCode.F then
			CameraController.ToggleFirstPerson()
		end
	end)
end

-- Main update loop
function CameraController.Update(deltaTime: number)
	if CurrentMode == "Follow" then
		CameraController.UpdateFollowCamera(deltaTime)
	elseif CurrentMode == "Battle" then
		CameraController.UpdateBattleCamera(deltaTime)
	elseif CurrentMode == "Cutscene" then
		CameraController.UpdateCutscene(deltaTime)
	elseif CurrentMode == "Free" then
		-- Free camera - no auto update
	end

	-- Apply shake
	if ShakeDuration &gt; 0 then
		CameraController.UpdateShake(deltaTime)
	end
end

function CameraController.UpdateFollowCamera(deltaTime: number)
	if not RootPart or not Humanoid then return end

	-- Calculate desired camera position
	local characterCFrame = RootPart.CFrame
	local cameraCFrame = Camera.CFrame

	-- Get horizontal rotation from camera
	local _, yRot, _ = cameraCFrame:ToEulerAnglesYXZ()

	-- Desired position behind character
	local desiredPos = characterCFrame.Position
		- Vector3.new(math.sin(yRot), 0, math.cos(yRot)) * CurrentDistance
		+ Vector3.new(0, FollowHeight, 0)

	-- Raycast to avoid clipping through walls
	local rayParams = RaycastParams.new()
	rayParams.FilterDescendantsInstances = {Character}
	rayParams.FilterType = Enum.RaycastFilterType.Exclude

	local ray = Workspace:Raycast(characterCFrame.Position + Vector3.new(0, FollowHeight, 0),
		(desiredPos - (characterCFrame.Position + Vector3.new(0, FollowHeight, 0))), rayParams)

	if ray then
		desiredPos = ray.Position + ray.Normal * 0.5
	end

	-- Smooth camera movement
	local newCFrame = CFrame.new(desiredPos, characterCFrame.Position + Vector3.new(0, 1.5, 0))
	Camera.CFrame = Camera.CFrame:Lerp(newCFrame, FollowSmoothness)
end

function CameraController.UpdateBattleCamera(deltaTime: number)
	-- Battle camera orbits around the battlefield
	if not TargetCFrame then return end

	local time = tick() * 0.3
	local orbitRadius = 20
	local orbitHeight = 10

	local pos = TargetCFrame.Position + Vector3.new(
		math.sin(time) * orbitRadius,
		orbitHeight,
		math.cos(time) * orbitRadius
	)

	Camera.CFrame = CFrame.new(pos, TargetCFrame.Position)
end

function CameraController.UpdateCutscene(deltaTime: number)
	if not CutsceneData then return end

	CutsceneData.CurrentIndex += deltaTime / CutsceneData.Duration * #CutsceneData.CFrames

	local index = math.floor(CutsceneData.CurrentIndex) + 1
	local nextIndex = math.min(index + 1, #CutsceneData.CFrames)
	local alpha = CutsceneData.CurrentIndex - math.floor(CutsceneData.CurrentIndex)

	if index &lt;= #CutsceneData.CFrames and nextIndex &lt;= #CutsceneData.CFrames then
		Camera.CFrame = CutsceneData.CFrames[index]:Lerp(CutsceneData.CFrames[nextIndex], alpha)
	end

	if CutsceneData.CurrentIndex &gt;= #CutsceneData.CFrames then
		CameraController.EndCutscene()
	end
end

function CameraController.UpdateShake(deltaTime: number)
	ShakeDuration -= deltaTime

	if ShakeDuration &lt;= 0 then
		ShakeIntensity = 0
		ShakeOffset = Vector3.zero
		return
	end

	-- Generate shake offset
	local shakeX = (math.random() - 0.5) * ShakeIntensity
	local shakeY = (math.random() - 0.5) * ShakeIntensity
	local shakeZ = (math.random() - 0.5) * ShakeIntensity

	ShakeOffset = Vector3.new(shakeX, shakeY, shakeZ)

	-- Apply to camera
	Camera.CFrame = Camera.CFrame * CFrame.new(ShakeOffset)
end

-- Camera modes
function CameraController.SetMode(mode: string, data: any?)
	if mode == CurrentMode then return end

	local oldMode = CurrentMode
	CurrentMode = mode

	print(`[CameraController] Mode changed: {oldMode} -&gt; {mode}`)

	if mode == "Follow" then
		Camera.CameraType = Enum.CameraType.Custom
		Camera.CameraSubject = Humanoid
		CameraController.ResetCamera()

	elseif mode == "Battle" then
		Camera.CameraType = Enum.CameraType.Scriptable
		TargetCFrame = data and data.TargetCFrame or CFrame.new(0, 0, 0)
		CameraController.TransitionToBattleCamera(data)

	elseif mode == "Cutscene" then
		Camera.CameraType = Enum.CameraType.Scriptable
		CameraController.StartCutscene(data)

	elseif mode == "Fixed" then
		Camera.CameraType = Enum.CameraType.Scriptable
		if data and data.CFrame then
			TargetCFrame = data.CFrame
			Camera.CFrame = data.CFrame
		end

	elseif mode == "Free" then
		Camera.CameraType = Enum.CameraType.Scriptable

	elseif mode == "FirstPerson" then
		Camera.CameraType = Enum.CameraType.Custom
		Camera.CameraSubject = Humanoid
		Player.CameraMinZoomDistance = 0.5
		Player.CameraMaxZoomDistance = 0.5
	end

	CameraController.OnCameraModeChanged:Fire(mode, oldMode)
end

function CameraController.TransitionToBattleCamera(data: any?)
	-- Smooth transition from follow to battle camera
	local startCFrame = Camera.CFrame
	local endCFrame = (data and data.TargetCFrame or CFrame.new(0, 0, 0)) + BattleCameraOffset

	local tween = TweenService:Create(Camera, TweenInfo.new(BattleTransitionTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		CFrame = endCFrame
	})
	tween:Play()

	tween.Completed:Wait()

	TargetCFrame = data and data.TargetCFrame or CFrame.new(0, 0, 0)
end

function CameraController.StartCutscene(data: any)
	if not data or not data.CFrames then return end

	CutsceneData = {
		CFrames = data.CFrames,
		Duration = data.Duration or 5,
		CurrentIndex = 0,
	}

	Camera.CFrame = data.CFrames[1]
end

function CameraController.EndCutscene()
	CutsceneData = nil
	CameraController.SetMode("Follow")
end

-- Camera controls
function CameraController.Zoom(delta: number)
	if CurrentMode == "FirstPerson" then return end

	CurrentDistance = math.clamp(CurrentDistance + delta * 2, MinDistance, MaxDistance)

	if CurrentMode == "Follow" then
		Player.CameraMinZoomDistance = CurrentDistance
		Player.CameraMaxZoomDistance = CurrentDistance
	end
end

function CameraController.Rotate(deltaX: number, deltaY: number)
	if CurrentMode ~= "Follow" and CurrentMode ~= "Free" then return end

	-- Rotation is handled by Roblox's default camera when in Custom mode
	-- For Free mode, we'd manually rotate
end

function CameraController.ResetCamera()
	CurrentDistance = FollowDistance
	Player.CameraMinZoomDistance = 0.5
	Player.CameraMaxZoomDistance = MaxDistance

	if RootPart then
		local targetPos = RootPart.Position + Vector3.new(0, FollowHeight, 0)
		local cameraPos = targetPos - Camera.CFrame.LookVector * FollowDistance
		Camera.CFrame = CFrame.new(cameraPos, targetPos)
	end
end

function CameraController.ToggleFirstPerson()
	if CurrentMode == "FirstPerson" then
		CameraController.SetMode("Follow")
	else
		CameraController.SetMode("FirstPerson")
	end
end

-- Focus on a specific point
function CameraController.FocusOn(position: Vector3, duration: number?)
	duration = duration or 1

	local targetCFrame = CFrame.new(Camera.CFrame.Position, position)
	local tween = TweenService:Create(Camera, TweenInfo.new(duration, Enum.EasingStyle.Quad), {
		CFrame = targetCFrame
	})
	tween:Play()
end

-- Camera shake
function CameraController.Shake(intensity: number, duration: number)
	ShakeIntensity = intensity
	ShakeDuration = duration
	CameraController.OnCameraShake:Fire(intensity, duration)
end

-- Battle camera helpers
function CameraController.SetBattleCamera(targetCFrame: CFrame, playerSide: boolean)
	TargetCFrame = targetCFrame

	if playerSide then
		-- Camera behind player's creature
		Camera.CFrame = targetCFrame * CFrame.new(0, 8, 25)
	else
		-- Camera behind enemy creature
		Camera.CFrame = targetCFrame * CFrame.new(0, 8, -25) * CFrame.Angles(0, math.pi, 0)
	end
end

function CameraController.PlayBattleCameraAnimation(animationType: "Move" | "Hit" | "Faint" | "Win", data: any)
	if animationType == "Hit" then
		CameraController.Shake(2, 0.3)
	elseif animationType == "Faint" then
		CameraController.Shake(3, 0.5)
		-- Pan down
		local tween = TweenService:Create(Camera, TweenInfo.new(1), {
			CFrame = Camera.CFrame * CFrame.Angles(math.rad(-20), 0, 0)
		})
		tween:Play()
	elseif animationType == "Win" then
		-- Victory camera sweep
		CameraController.SetMode("Fixed", {CFrame = Camera.CFrame})
		local tween = TweenService:Create(Camera, TweenInfo.new(3, Enum.EasingStyle.Quad), {
			CFrame = Camera.CFrame * CFrame.Angles(0, math.rad(360), 0)
		})
		tween:Play()
	end
end

-- Getters
function CameraController.GetCurrentMode(): string
	return CurrentMode
end

function CameraController.GetCamera(): Camera
	return Camera
end

function CameraController.GetFollowDistance(): number
	return CurrentDistance
end

return CameraController</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">CreatureController</string>
              <string name="Source">--!strict
-- CreatureController.lua - Controlador de criaturas (party, detalhes, evolução)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Types = require(ReplicatedStorage.Shared.Types)
local Config = require(ReplicatedStorage.Shared.Config)
local MathUtil = require(ReplicatedStorage.Shared.Util.Math)
local TableUtil = require(ReplicatedStorage.Shared.Util.Table)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local CreatureController = {}

-- Events
CreatureController.OnPartyChanged = Signal.New()
CreatureController.OnCreatureSelected = Signal.New()
CreatureController.OnCreatureCaptured = Signal.New()
CreatureController.OnCreatureEvolved = Signal.New()
CreatureController.OnCreatureLevelUp = Signal.New()
CreatureController.OnCreatureUpdated = Signal.New()

-- State
local CurrentParty: {Types.CreatureData} = {}
local CurrentStorage: {{Types.CreatureData}} = {}
local SelectedCreature: Types.CreatureData?
local ViewportFrames = {} :: {[string]: ViewportFrame}
local CreatureModels = {} :: {[string]: Model}

-- Initialize
function CreatureController.Initialize(playerData: Types.PlayerData)
	print("[CreatureController] Initializing...")

	-- Load initial party data
	CreatureController.RefreshParty()
	CreatureController.RefreshStorage()

	print("[CreatureController] Initialized")
end

-- Refresh party from server
function CreatureController.RefreshParty()
	-- In real implementation, this would invoke server
	-- For now, using mock data
	task.spawn(function()
		task.wait(0.5)
		CreatureController.OnPartyChanged:Fire(CurrentParty)
	end)
end

function CreatureController.RefreshStorage()
	task.spawn(function()
		task.wait(0.5)
		-- Storage refresh
	end)
end

-- Party management
function CreatureController.OnPartyChanged(partySummary: any)
	CurrentParty = partySummary.Party or {}
	CreatureController.OnPartyChanged:Fire(partySummary)
end

function CreatureController.GetParty(): {Types.CreatureData}
	return CurrentParty
end

function CreatureController.GetStorage(): {{Types.CreatureData}}
	return CurrentStorage
end

function CreatureController.GetCreatureAt(index: number): Types.CreatureData?
	return CurrentParty[index]
end

-- Creature selection
function CreatureController.SelectCreature(creature: Types.CreatureData)
	SelectedCreature = creature
	CreatureController.OnCreatureSelected:Fire(creature)
end

function CreatureController.GetSelectedCreature(): Types.CreatureData?
	return SelectedCreature
end

-- Create creature model for ViewportFrame
function CreatureController.CreateCreatureViewport(creature: Types.CreatureData, parent: Instance): ViewportFrame
	local viewport = Instance.new("ViewportFrame")
	viewport.Name = `Viewport_{creature.Id}`
	viewport.Size = UDim2.new(1, 0, 1, 0)
	viewport.BackgroundTransparency = 1
	viewport.CurrentCamera = nil
	viewport.Parent = parent

	-- Create camera
	local camera = Instance.new("Camera")
	camera.Name = "ViewportCamera"
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	-- Load creature model
	CreatureController.LoadCreatureModel(creature, viewport)

	ViewportFrames[creature.Id] = viewport

	return viewport
end

function CreatureController.LoadCreatureModel(creature: Types.CreatureData, viewport: ViewportFrame)
	-- Get model from ReplicatedStorage or create placeholder
	local modelPath = `ReplicatedStorage.Assets.Creatures.{creature.SpeciesId}`
	local model = ReplicatedStorage:FindFirstChild("Assets")
		and ReplicatedStorage.Assets:FindFirstChild("Creatures")
		and ReplicatedStorage.Assets.Creatures:FindFirstChild(creature.SpeciesId)

	if not model then
		-- Create placeholder
		model = CreatureController.CreatePlaceholderModel(creature)
	end

	local clone = model:Clone()
	clone.Name = creature.Id
	clone.Parent = viewport

	-- Position model
	local primaryPart = clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart")
	if primaryPart then
		clone:PivotTo(CFrame.new(0, 0, 0))

		-- Setup camera
		local camera = viewport.CurrentCamera
		if camera then
			local cf, size = clone:GetBoundingBox()
			camera.CFrame = CFrame.new(cf.Position + Vector3.new(0, size.Y * 0.5, size.Z * 2), cf.Position)
			camera.FieldOfView = 30
		end
	end

	-- Apply color variation based on IVs/Shiny
	CreatureController.ApplyCreatureAppearance(clone, creature)

	-- Animate
	CreatureController.PlayIdleAnimation(clone)

	CreatureModels[creature.Id] = clone

	return clone
end

function CreatureController.CreatePlaceholderModel(creature: Types.CreatureData): Model
	local model = Instance.new("Model")
	model.Name = creature.SpeciesId

	-- Create a simple colored part based on creature type
	local part = Instance.new("Part")
	part.Name = "Body"
	part.Size = Vector3.new(3, 3, 3)
	part.Shape = Enum.PartType.Ball
	part.Anchored = true
	part.CanCollide = false
	part.Material = Enum.Material.Neon
	part.Color = CreatureController.GetElementColor(creature.Element1)
	part.Parent = model

	model.PrimaryPart = part

	-- Add element indicator
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ElementIndicator"
	billboard.Size = UDim2.new(0, 100, 0, 30)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.Adornee = part
	billboard.Parent = model

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = Types.ElementDisplayNames[creature.Element1] or creature.Element1
	label.TextColor3 = CreatureController.GetElementColor(creature.Element1)
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = billboard

	return model
end

function CreatureController.GetElementColor(element: Types.ElementType): Color3
	local colors = {
		Fire = Color3.fromRGB(255, 100, 50),
		Water = Color3.fromRGB(50, 150, 255),
		Nature = Color3.fromRGB(80, 200, 80),
		Earth = Color3.fromRGB(180, 140, 80),
		Air = Color3.fromRGB(180, 200, 255),
		Shadow = Color3.fromRGB(120, 60, 180),
		Light = Color3.fromRGB(255, 240, 180),
		Metal = Color3.fromRGB(180, 180, 200),
		Crystal = Color3.fromRGB(200, 220, 255),
	}
	return colors[element] or Color3.fromRGB(200, 200, 200)
end

function CreatureController.ApplyCreatureAppearance(model: Model, creature: Types.CreatureData)
	-- Apply shiny effect
	if creature.IsShiny then
		for _, part in ipairs(model:GetDescendants()) do
			if part:IsA("BasePart") then
				part.Material = Enum.Material.Neon
				local sparkles = Instance.new("ParticleEmitter")
				sparkles.Name = "ShinySparkles"
				sparkles.Color = ColorSequence.new(Color3.fromRGB(255, 255, 200))
				sparkles.Size = NumberSequence.new(0.2)
				sparkles.Lifetime = NumberRange.new(0.5, 1)
				sparkles.Rate = 20
				sparkles.Speed = NumberRange.new(1, 3)
				sparkles.SpreadAngle = Vector2.new(180, 180)
				sparkles.Parent = part
			end
		end
	end

	-- Apply size based on stage
	local sizeMultiplier = 1
	if creature.GrowthStage == "Filhote" then
		sizeMultiplier = 0.5
	elseif creature.GrowthStage == "Juvenil" then
		sizeMultiplier = 0.75
	elseif creature.GrowthStage == "Adulto" then
		sizeMultiplier = 1.0
	elseif creature.GrowthStage == "Lendário" then
		sizeMultiplier = 1.3
	end

	model:ScaleTo(model:GetScale() * sizeMultiplier)
end

function CreatureController.PlayIdleAnimation(model: Model)
	-- Simple bobbing animation
	local primaryPart = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	if not primaryPart then return end

	local originalPos = primaryPart.Position

	task.spawn(function()
		while model.Parent do
			local t = tick() * 2
			local offset = math.sin(t) * 0.3
			if model.PrimaryPart then
				model:PivotTo(CFrame.new(originalPos + Vector3.new(0, offset, 0)))
			else
				primaryPart.CFrame = CFrame.new(originalPos + Vector3.new(0, offset, 0))
			end
			task.wait(0.03)
		end
	end)
end

-- Creature stats calculation display
function CreatureController.GetDisplayStats(creature: Types.CreatureData): {[string]: number}
	local baseStats = Config.SpeciesList[creature.SpeciesId]?.BaseStats or {}

	return {
		HP = MathUtil.CalculateHP(baseStats.HP or 50, creature.IVs.HP, creature.EVs.HP, creature.Level, creature.Nature),
		Attack = MathUtil.CalculateStat(baseStats.Attack or 50, creature.IVs.Attack, creature.EVs.Attack, creature.Level, creature.Nature, "Attack"),
		Defense = MathUtil.CalculateStat(baseStats.Defense or 50, creature.IVs.Defense, creature.EVs.Defense, creature.Level, creature.Nature, "Defense"),
		SpAttack = MathUtil.CalculateStat(baseStats.SpAttack or 50, creature.IVs.SpAttack, creature.EVs.SpAttack, creature.Level, creature.Nature, "SpAttack"),
		SpDefense = MathUtil.CalculateStat(baseStats.SpDefense or 50, creature.IVs.SpDefense, creature.EVs.SpDefense, creature.Level, creature.Nature, "SpDefense"),
		Speed = MathUtil.CalculateStat(baseStats.Speed or 50, creature.IVs.Speed, creature.EVs.Speed, creature.Level, creature.Nature, "Speed"),
	}
end

function CreatureController.GetStatBars(creature: Types.CreatureData): {[string]: number}
	local stats = CreatureController.GetDisplayStats(creature)
	local bars = {}

	for stat, value in pairs(stats) do
		bars[stat] = math.clamp(value / 255, 0, 1) -- Normalized for UI bars
	end

	return bars
end

-- Evolution
function CreatureController.OnCreatureEvolved(creature: Types.CreatureData)
	CreatureController.OnCreatureEvolved:Fire(creature)

	-- Refresh viewport if viewing this creature
	if ViewportFrames[creature.Id] then
		local viewport = ViewportFrames[creature.Id]
		local oldModel = CreatureModels[creature.Id]
		if oldModel then oldModel:Destroy() end
		CreatureController.LoadCreatureModel(creature, viewport)
	end
end

function CreatureController.CanEvolve(creature: Types.CreatureData): {CanEvolve: boolean, Method: string?, TargetSpecies: string?, TargetName: string?}
	-- This would call EvolutionSystem on server
	-- For now, return mock
	return {
		CanEvolve = false,
		Method = nil,
		TargetSpecies = nil,
		TargetName = nil,
	}
end

function CreatureController.RequestEvolution(creatureId: string)
	-- Would invoke server remote
	print("[CreatureController] Requesting evolution for:", creatureId)
end

-- Moves
function CreatureController.GetLearnableMoves(creature: Types.CreatureData): {Types.MoveData}
	local speciesData = Config.SpeciesList[creature.SpeciesId]
	if not speciesData or not speciesData.Learnset then return {} end

	local learnable = {}
	for _, moveLearn in ipairs(speciesData.Learnset) do
		if moveLearn.Level &lt;= creature.Level then
			local moveConfig = Config.Moves[moveLearn.MoveId]
			if moveConfig then
				table.insert(learnable, moveConfig)
			end
		end
	end

	return learnable
end

function CreatureController.CanLearnMove(creature: Types.CreatureData, moveId: string): boolean
	local learnable = CreatureController.GetLearnableMoves(creature)
	for _, move in ipairs(learnable) do
		if move.Id == moveId then
			return true
		end
	end
	return false
end

function CreatureController.LearnMove(creatureId: string, moveId: string, replaceIndex: number?)
	-- Would invoke server remote
	print("[CreatureController] Learning move:", moveId, "for:", creatureId)
end

-- Capture animation
function CreatureController.OnCreatureCaptured(creature: Types.CreatureData)
	CreatureController.OnCreatureCaptured:Fire(creature)
end

-- Level up
function CreatureController.OnCreatureLevelUp(creature: Types.CreatureData, oldLevel: number, newLevel: number)
	CreatureController.OnCreatureLevelUp:Fire(creature, oldLevel, newLevel)

	-- Check for new moves
	local newMoves = {}
	local speciesData = Config.SpeciesList[creature.SpeciesId]
	if speciesData and speciesData.Learnset then
		for _, moveLearn in ipairs(speciesData.Learnset) do
			if moveLearn.Level &gt; oldLevel and moveLearn.Level &lt;= newLevel then
				table.insert(newMoves, moveLearn.MoveId)
			end
		end
	end

	if #newMoves &gt; 0 then
		-- Notify UI about new moves
		CreatureController.OnCreatureUpdated:Fire(creature, {NewMoves = newMoves})
	end
end

-- Creature info for detail screen
function CreatureController.GetCreatureDetailInfo(creature: Types.CreatureData): any
	local speciesData = Config.SpeciesList[creature.SpeciesId]
	local displayStats = CreatureController.GetDisplayStats(creature)
	local statBars = CreatureController.GetStatBars(creature)
	local learnableMoves = CreatureController.GetLearnableMoves(creature)
	local evolutionInfo = CreatureController.CanEvolve(creature)

	return {
		Creature = creature,
		SpeciesData = speciesData,
		DisplayStats = displayStats,
		StatBars = statBars,
		LearnableMoves = learnableMoves,
		CurrentMoves = creature.Moves,
		EvolutionInfo = evolutionInfo,
		IVs = creature.IVs,
		EVs = creature.EVs,
		Nature = creature.Nature,
		Friendship = creature.Friendship,
		Experience = creature.Experience,
		NextLevelExp = MathUtil.GetExpForLevel(creature.Level + 1, speciesData?.GrowthRate or "MediumFast"),
	}
end

-- Create creature card for party UI
function CreatureController.CreateCreatureCard(creature: Types.CreatureData, parent: Instance, onClick: (Types.CreatureData) -&gt; ()): Frame
	local card = Instance.new("Frame")
	card.Name = `Card_{creature.Id}`
	card.Size = UDim2.new(0, 280, 0, 160)
	card.BackgroundColor3 = Color3.fromRGB(35, 35, 55)
	card.BorderSizePixel = 0
	card.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = card

	local stroke = Instance.new("UIStroke")
	stroke.Color = CreatureController.GetElementColor(creature.Element1)
	stroke.Transparency = 0.5
	stroke.Thickness = 2
	stroke.Parent = card

	-- Viewport for 3D model
	local viewport = CreatureController.CreateCreatureViewport(creature, card)
	viewport.Size = UDim2.new(0.4, 0, 1, -20)
	viewport.Position = UDim2.new(0, 10, 0, 10)

	-- Info panel
	local infoPanel = Instance.new("Frame")
	infoPanel.Name = "InfoPanel"
	infoPanel.Size = UDim2.new(0.55, 0, 1, -20)
	infoPanel.Position = UDim2.new(0.42, 0, 0, 10)
	infoPanel.BackgroundTransparency = 1
	infoPanel.Parent = card

	-- Name and level
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, 0, 0, 30)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = (creature.Nickname ~= "" and creature.Nickname or speciesData?.Name or creature.SpeciesId) .. `  Lv.{creature.Level}`
	nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	nameLabel.TextScaled = true
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Parent = infoPanel

	-- Species name if nicknamed
	if creature.Nickname ~= "" and speciesData then
		local speciesLabel = Instance.new("TextLabel")
		speciesLabel.Size = UDim2.new(1, 0, 0, 20)
		speciesLabel.Position = UDim2.new(0, 0, 0, 30)
		speciesLabel.BackgroundTransparency = 1
		speciesLabel.Text = speciesData.Name
		speciesLabel.TextColor3 = Color3.fromRGB(150, 150, 170)
		speciesLabel.TextScaled = true
		speciesLabel.Font = Enum.Font.Gotham
		speciesLabel.TextXAlignment = Enum.TextXAlignment.Left
		speciesLabel.Parent = infoPanel
	end

	-- Elements
	local elementFrame = Instance.new("Frame")
	elementFrame.Size = UDim2.new(1, 0, 0, 25)
	elementFrame.Position = UDim2.new(0, 0, 0, 55)
	elementFrame.BackgroundTransparency = 1
	elementFrame.Parent = infoPanel

	local elementLayout = Instance.new("UIListLayout")
	elementLayout.FillDirection = Enum.FillDirection.Horizontal
	elementLayout.Padding = UDim.new(0, 5)
	elementLayout.Parent = elementFrame

	for _, element in ipairs({creature.Element1, creature.Element2}) do
		if element then
			local elementTag = Instance.new("TextLabel")
			elementTag.Size = UDim2.new(0, 60, 1, 0)
			elementTag.BackgroundColor3 = CreatureController.GetElementColor(element)
			elementTag.BorderSizePixel = 0
			elementTag.Text = Types.ElementDisplayNames[element] or element
			elementTag.TextColor3 = Color3.fromRGB(255, 255, 255)
			elementTag.TextScaled = true
			elementTag.Font = Enum.Font.GothamBold
			elementTag.Parent = elementFrame

			local tagCorner = Instance.new("UICorner")
			tagCorner.CornerRadius = UDim.new(0, 4)
			tagCorner.Parent = elementTag
		end
	end

	-- HP Bar
	local hpFrame = Instance.new("Frame")
	hpFrame.Size = UDim2.new(1, 0, 0, 20)
	hpFrame.Position = UDim2.new(0, 0, 1, -45)
	hpFrame.BackgroundTransparency = 1
	hpFrame.Parent = infoPanel

	local hpLabel = Instance.new("TextLabel")
	hpLabel.Size = UDim2.new(0, 30, 1, 0)
	hpLabel.BackgroundTransparency = 1
	hpLabel.Text = "HP"
	hpLabel.TextColor3 = Color3.fromRGB(200, 200, 220)
	hpLabel.TextScaled = true
	hpLabel.Font = Enum.Font.Gotham
	hpLabel.TextXAlignment = Enum.TextXAlignment.Left
	hpLabel.Parent = hpFrame

	local hpBarBg = Instance.new("Frame")
	hpBarBg.Size = UDim2.new(1, -35, 0, 12)
	hpBarBg.Position = UDim2.new(0, 35, 0, 4)
	hpBarBg.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
	hpBarBg.BorderSizePixel = 0
	hpBarBg.Parent = hpFrame

	local hpBarCorner = Instance.new("UICorner")
	hpBarCorner.CornerRadius = UDim.new(1, 0)
	hpBarCorner.Parent = hpBarBg

	local hpBarFill = Instance.new("Frame")
	hpBarFill.Name = "Fill"
	hpBarFill.Size = UDim2.new(creature.CurrentHP / creature.MaxHP, 0, 1, 0)
	hpBarFill.BackgroundColor3 = Color3.fromRGB(60, 200, 100)
	hpBarFill.BorderSizePixel = 0
	hpBarFill.Parent = hpBarBg

	local hpFillCorner = Instance.new("UICorner")
	hpFillCorner.CornerRadius = UDim.new(1, 0)
	hpFillCorner.Parent = hpBarFill

	local hpText = Instance.new("TextLabel")
	hpText.Size = UDim2.new(1, -35, 1, 0)
	hpText.Position = UDim2.new(0, 35, 0, 0)
	hpText.BackgroundTransparency = 1
	hpText.Text = `{creature.CurrentHP}/{creature.MaxHP}`
	hpText.TextColor3 = Color3.fromRGB(255, 255, 255)
	hpText.TextScaled = true
	hpText.Font = Enum.Font.GothamBold
	hpText.TextXAlignment = Enum.TextXAlignment.Right
	hpText.Parent = hpFrame

	-- XP Bar
	local xpFrame = Instance.new("Frame")
	xpFrame.Size = UDim2.new(1, 0, 0, 15)
	xpFrame.Position = UDim2.new(0, 0, 1, -25)
	xpFrame.BackgroundTransparency = 1
	xpFrame.Parent = infoPanel

	local xpBarBg = Instance.new("Frame")
	xpBarBg.Size = UDim2.new(1, 0, 0, 6)
	xpBarBg.Position = UDim2.new(0, 0, 0, 5)
	xpBarBg.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
	xpBarBg.BorderSizePixel = 0
	xpBarBg.Parent = xpFrame

	local xpBarCorner = Instance.new("UICorner")
	xpBarCorner.CornerRadius = UDim.new(1, 0)
	xpBarCorner.Parent = xpBarBg

	local speciesData = Config.SpeciesList[creature.SpeciesId]
	local currentLevelExp = MathUtil.GetExpForLevel(creature.Level, speciesData?.GrowthRate or "MediumFast")
	local nextLevelExp = MathUtil.GetExpForLevel(creature.Level + 1, speciesData?.GrowthRate or "MediumFast")
	local expProgress = (creature.Experience - currentLevelExp) / (nextLevelExp - currentLevelExp)

	local xpBarFill = Instance.new("Frame")
	xpBarFill.Size = UDim2.new(math.clamp(expProgress, 0, 1), 0, 1, 0)
	xpBarFill.BackgroundColor3 = Color3.fromRGB(100, 150, 255)
	xpBarFill.BorderSizePixel = 0
	xpBarFill.Parent = xpBarBg

	local xpFillCorner = Instance.new("UICorner")
	xpFillCorner.CornerRadius = UDim.new(1, 0)
	xpFillCorner.Parent = xpBarFill

	-- Shiny indicator
	if creature.IsShiny then
		local shinyTag = Instance.new("TextLabel")
		shinyTag.Size = UDim2.new(0, 60, 0, 20)
		shinyTag.Position = UDim2.new(1, -65, 0, 5)
		shinyTag.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
		shinyTag.BorderSizePixel = 0
		shinyTag.Text = "✨ SHINY"
		shinyTag.TextColor3 = Color3.fromRGB(50, 40, 0)
		shinyTag.TextScaled = true
		shinyTag.Font = Enum.Font.GothamBold
		shinyTag.Parent = card

		local shinyCorner = Instance.new("UICorner")
		shinyCorner.CornerRadius = UDim.new(0, 4)
		shinyCorner.Parent = shinyTag
	end

	-- Click handler
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 1, 0)
	btn.BackgroundTransparency = 1
	btn.Text = ""
	btn.Parent = card

	btn.MouseButton1Click:Connect(function()
		onClick(creature)
	end)

	btn.MouseEnter:Connect(function()
		TweenService:Create(card, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(45, 45, 65)}):Play()
	end)

	btn.MouseLeave:Connect(function()
		TweenService:Create(card, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(35, 35, 55)}):Play()
	end)

	return card
end

-- Cleanup
function CreatureController.Cleanup()
	for _, viewport in pairs(ViewportFrames) do
		viewport:Destroy()
	end
	for _, model in pairs(CreatureModels) do
		model:Destroy()
	end
	ViewportFrames = {}
	CreatureModels = {}
end

return CreatureController</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source">--!strict
-- InputController.lua - Gerenciamento de entrada do jogador

local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local InputController = {}

-- Events
InputController.OnInput = Signal.New()
InputController.OnKeyDown = Signal.New()
InputController.OnKeyUp = Signal.New()
InputController.OnMouseMove = Signal.New()
InputController.OnTouch = Signal.New()

-- State
local KeyStates = {} :: {[Enum.KeyCode]: boolean}
local MousePosition = Vector2.zero
local MouseDelta = Vector2.zero
local GamepadConnected = false
local CurrentInputMode = "KeyboardMouse" :: "KeyboardMouse" | "Gamepad" | "Touch"

-- Key bindings (customizable)
local KeyBindings = {
	MoveForward = {Enum.KeyCode.W, Enum.KeyCode.Up},
	MoveBackward = {Enum.KeyCode.S, Enum.KeyCode.Down},
	MoveLeft = {Enum.KeyCode.A, Enum.KeyCode.Left},
	MoveRight = {Enum.KeyCode.D, Enum.KeyCode.Right},
	Jump = {Enum.KeyCode.Space},
	Sprint = {Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift},
	Interact = {Enum.KeyCode.E},
	Party = {Enum.KeyCode.P},
	Inventory = {Enum.KeyCode.I},
	Map = {Enum.KeyCode.M},
	Menu = {Enum.KeyCode.Escape},
	BattleMove1 = {Enum.KeyCode.One},
	BattleMove2 = {Enum.KeyCode.Two},
	BattleMove3 = {Enum.KeyCode.Three},
	BattleMove4 = {Enum.KeyCode.Four},
	BattleBack = {Enum.KeyCode.Backspace},
	CameraRotateLeft = {Enum.KeyCode.Q, Enum.KeyCode.Comma},
	CameraRotateRight = {Enum.KeyCode.E, Enum.KeyCode.Period},
	CameraZoomIn = {Enum.KeyCode.PageUp},
	CameraZoomOut = {Enum.KeyCode.PageDown},
	ToggleQuestTracker = {Enum.KeyCode.L}, -- L para Log de missões
}

-- Initialize
function InputController.Initialize()
	print("[InputController] Initializing...")

	-- Detect input mode
	UserInputService.LastInputTypeChanged:Connect(function(inputType)
		InputController.UpdateInputMode(inputType)
	end)

	InputController.UpdateInputMode(UserInputService:GetLastInputType())

	-- Gamepad detection
	UserInputService.GamepadConnected:Connect(function(gamepad)
		GamepadConnected = true
		CurrentInputMode = "Gamepad"
		print("[InputController] Gamepad connected")
	end)

	UserInputService.GamepadDisconnected:Connect(function(gamepad)
		if #UserInputService:GetConnectedGamepads() == 0 then
			GamepadConnected = false
			CurrentInputMode = "KeyboardMouse"
			print("[InputController] Gamepad disconnected")
		end
	end)

	-- Bind actions
	InputController.BindActions()

	-- Mouse tracking
	UserInputService.InputChanged:Connect(function(input, gameProcessed)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			MouseDelta = input.Delta
			MousePosition = input.Position
			InputController.OnMouseMove:Fire(MousePosition, MouseDelta)
		end
	end)

	-- Touch handling
	UserInputService.TouchStarted:Connect(function(touch, gameProcessed)
		if not gameProcessed then
			InputController.OnTouch:Fire(touch.Position, "Began")
		end
	end)

	UserInputService.TouchEnded:Connect(function(touch, gameProcessed)
		InputController.OnTouch:Fire(touch.Position, "Ended")
	end)

	print("[InputController] Initialized")
end

function InputController.UpdateInputMode(inputType: Enum.UserInputType)
	if inputType == Enum.UserInputType.Gamepad1 or inputType == Enum.UserInputType.Gamepad2 then
		CurrentInputMode = "Gamepad"
	elseif inputType == Enum.UserInputType.Touch then
		CurrentInputMode = "Touch"
	else
		CurrentInputMode = "KeyboardMouse"
	end
end

function InputController.BindActions()
	-- Movement actions (handled by PlayerController via ContextActionService)
	-- We just track key states here

	for actionName, keys in pairs(KeyBindings) do
		for _, key in ipairs(keys) do
			ContextActionService:BindAction(actionName .. "_" .. key.Name, function(_, state, input)
				if actionName == "ToggleQuestTracker" and state == Enum.UserInputState.Begin then
					local QuestController = require(script.Parent.QuestController)
					QuestController.ToggleTracker()
				else
					InputController.HandleKey(input.KeyCode, state)
				end
			end, false, key)
		end
	end

	-- Mouse buttons
	ContextActionService:BindAction("Mouse1", function(_, state, input)
		InputController.HandleMouseButton(Enum.UserInputType.MouseButton1, state)
	end, false, Enum.UserInputType.MouseButton1)

	ContextActionService:BindAction("Mouse2", function(_, state, input)
		InputController.HandleMouseButton(Enum.UserInputType.MouseButton2, state)
	end, false, Enum.UserInputType.MouseButton2)

	-- Gamepad bindings
	InputController.BindGamepadActions()
end

function InputController.BindGamepadActions()
	local gamepadActions = {
		Move = Enum.KeyCode.Thumbstick1,
		Camera = Enum.KeyCode.Thumbstick2,
		Jump = Enum.KeyCode.ButtonA,
		Sprint = Enum.KeyCode.ButtonL3,
		Interact = Enum.KeyCode.ButtonX,
		Menu = Enum.KeyCode.ButtonStart,
		Party = Enum.KeyCode.ButtonY,
		Inventory = Enum.KeyCode.ButtonSelect,
		BattleMove1 = Enum.KeyCode.ButtonR1,
		BattleMove2 = Enum.KeyCode.ButtonR2,
		BattleMove3 = Enum.KeyCode.ButtonL1,
		BattleMove4 = Enum.KeyCode.ButtonL2,
		DpadUp = Enum.KeyCode.DPadUp,
		DpadDown = Enum.KeyCode.DPadDown,
		DpadLeft = Enum.KeyCode.DPadLeft,
		DpadRight = Enum.KeyCode.DPadRight,
	}

	for actionName, keyCode in pairs(gamepadActions) do
		ContextActionService:BindAction("Gamepad_" .. actionName, function(_, state, input)
			InputController.HandleGamepadInput(keyCode, state, input)
		end, false, keyCode)
	end
end

function InputController.HandleKey(keyCode: Enum.KeyCode, state: Enum.UserInputState)
	local isDown = state == Enum.UserInputState.Begin
	KeyStates[keyCode] = isDown

	if isDown then
		InputController.OnKeyDown:Fire(keyCode)
	else
		InputController.OnKeyUp:Fire(keyCode)
	end

	InputController.OnInput:Fire({
		Type = "Key",
		KeyCode = keyCode,
		State = state,
	})
end

function InputController.HandleMouseButton(mouseButton: Enum.UserInputType, state: Enum.UserInputState)
	InputController.OnInput:Fire({
		Type = "MouseButton",
		Button = mouseButton,
		State = state,
		Position = MousePosition,
	})
end

function InputController.HandleGamepadInput(keyCode: Enum.KeyCode, state: Enum.UserInputState, input: InputObject)
	InputController.OnInput:Fire({
		Type = "Gamepad",
		KeyCode = keyCode,
		State = state,
		Position = input.Position,
		Delta = input.Delta,
	})

	-- Handle thumbsticks
	if keyCode == Enum.KeyCode.Thumbstick1 then
		InputController.OnInput:Fire({
			Type = "Thumbstick1",
			Position = input.Position,
		})
	elseif keyCode == Enum.KeyCode.Thumbstick2 then
		InputController.OnInput:Fire({
			Type = "Thumbstick2",
			Position = input.Position,
		})
	end
end

-- Handle input from init.client.luau
function InputController.HandleInput(input: InputObject, phase: "Began" | "Ended")
	if input.UserInputType == Enum.UserInputType.Keyboard then
		local state = phase == "Began" and Enum.UserInputState.Begin or Enum.UserInputState.End
		InputController.HandleKey(input.KeyCode, state)
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 then
		local state = phase == "Began" and Enum.UserInputState.Begin or Enum.UserInputState.End
		InputController.HandleMouseButton(input.UserInputType, state)
	elseif input.UserInputType == Enum.UserInputType.Gamepad1 then
		local state = phase == "Began" and Enum.UserInputState.Begin or Enum.UserInputState.End
		InputController.HandleGamepadInput(input.KeyCode, state, input)
	end
end

-- Getters
function InputController.IsKeyDown(keyCode: Enum.KeyCode): boolean
	return KeyStates[keyCode] == true
end

function InputController.GetMousePosition(): Vector2
	return MousePosition
end

function InputController.GetMouseDelta(): Vector2
	return MouseDelta
end

function InputController.GetInputMode(): string
	return CurrentInputMode
end

function InputController.IsGamepadConnected(): boolean
	return GamepadConnected
end

-- Check if movement keys are pressed
function InputController.GetMovementVector(): Vector2
	local x = 0
	local y = 0

	if InputController.IsKeyDown(Enum.KeyCode.W) or InputController.IsKeyDown(Enum.KeyCode.Up) then
		y += 1
	end
	if InputController.IsKeyDown(Enum.KeyCode.S) or InputController.IsKeyDown(Enum.KeyCode.Down) then
		y -= 1
	end
	if InputController.IsKeyDown(Enum.KeyCode.D) or InputController.IsKeyDown(Enum.KeyCode.Right) then
		x += 1
	end
	if InputController.IsKeyDown(Enum.KeyCode.A) or InputController.IsKeyDown(Enum.KeyCode.Left) then
		x -= 1
	end

	-- Gamepad thumbstick
	if CurrentInputMode == "Gamepad" then
		local gamepads = UserInputService:GetConnectedGamepads()
		if #gamepads &gt; 0 then
			local state = UserInputService:GetGamepadState(gamepads[1])
			for _, input in ipairs(state) do
				if input.KeyCode == Enum.KeyCode.Thumbstick1 then
					x = input.Position.X
					y = -input.Position.Y
					break
				end
			end
		end
	end

	return Vector2.new(x, y)
end

function InputController.IsSprinting(): boolean
	if CurrentInputMode == "Gamepad" then
		local gamepads = UserInputService:GetConnectedGamepads()
		if #gamepads &gt; 0 then
			return UserInputService:IsGamepadButtonDown(gamepads[1], Enum.KeyCode.ButtonL3)
		end
		return false
	end
	return InputController.IsKeyDown(Enum.KeyCode.LeftShift) or InputController.IsKeyDown(Enum.KeyCode.RightShift)
end

function InputController.IsJumpPressed(): boolean
	if CurrentInputMode == "Gamepad" then
		local gamepads = UserInputService:GetConnectedGamepads()
		if #gamepads &gt; 0 then
			return UserInputService:IsGamepadButtonDown(gamepads[1], Enum.KeyCode.ButtonA)
		end
		return false
	end
	return InputController.IsKeyDown(Enum.KeyCode.Space)
end

-- Vibration feedback (gamepad)
function InputController.Vibrate(duration: number, intensity: number?)
	local gamepads = UserInputService:GetConnectedGamepads()
	if #gamepads == 0 then return end

	intensity = intensity or 1

	for _, gamepad in ipairs(gamepads) do
		UserInputService:SetGamepadVibration(gamepad, intensity, intensity)
	end

	task.delay(duration, function()
		for _, gamepad in ipairs(gamepads) do
			UserInputService:SetGamepadVibration(gamepad, 0, 0)
		end
	end)
end

-- Custom key binding support
function InputController.SetKeyBinding(action: string, keys: {Enum.KeyCode})
	if KeyBindings[action] then
		-- Unbind old keys
		for _, oldKey in ipairs(KeyBindings[action]) do
			ContextActionService:UnbindAction(action .. "_" .. oldKey.Name)
		end

		KeyBindings[action] = keys

		-- Bind new keys
		for _, key in ipairs(keys) do
			ContextActionService:BindAction(action .. "_" .. key.Name, function(_, state, input)
				InputController.HandleKey(input.KeyCode, state)
			end, false, key)
		end
	end
end

function InputController.GetKeyBinding(action: string): {Enum.KeyCode}?
	return KeyBindings[action]
end

function InputController.ResetKeyBindings()
	for action, keys in pairs(KeyBindings) do
		for _, key in ipairs(keys) do
			ContextActionService:UnbindAction(action .. "_" .. key.Name)
		end
	end

	-- Restore defaults
	KeyBindings = {
		MoveForward = {Enum.KeyCode.W, Enum.KeyCode.Up},
		MoveBackward = {Enum.KeyCode.S, Enum.KeyCode.Down},
		MoveLeft = {Enum.KeyCode.A, Enum.KeyCode.Left},
		MoveRight = {Enum.KeyCode.D, Enum.KeyCode.Right},
		Jump = {Enum.KeyCode.Space},
		Sprint = {Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift},
		Interact = {Enum.KeyCode.E},
		Party = {Enum.KeyCode.P},
		Inventory = {Enum.KeyCode.I},
		Map = {Enum.KeyCode.M},
		Menu = {Enum.KeyCode.Escape},
		BattleMove1 = {Enum.KeyCode.One},
		BattleMove2 = {Enum.KeyCode.Two},
		BattleMove3 = {Enum.KeyCode.Three},
		BattleMove4 = {Enum.KeyCode.Four},
		BattleBack = {Enum.KeyCode.Backspace},
		CameraRotateLeft = {Enum.KeyCode.Q, Enum.KeyCode.Comma},
		CameraRotateRight = {Enum.KeyCode.E, Enum.KeyCode.Period},
		CameraZoomIn = {Enum.KeyCode.PageUp},
		CameraZoomOut = {Enum.KeyCode.PageDown},
	}

	InputController.BindActions()
end

return InputController</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">PlayerController</string>
              <string name="Source">--!strict
-- PlayerController.lua - Controle do personagem do jogador

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Types = require(ReplicatedStorage.Shared.Types)
local Config = require(ReplicatedStorage.Shared.Config)
local MathUtil = require(ReplicatedStorage.Shared.Util.Math)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local PlayerController = {}

-- Events
PlayerController.OnCharacterLoaded = Signal.New()
PlayerController.OnStateChanged = Signal.New()
PlayerController.OnMovementChanged = Signal.New()

-- State
local Player = Players.LocalPlayer
local Character: Model?
local Humanoid: Humanoid?
local RootPart: BasePart?
local Animator: Animator?

local CurrentState = "Idle" :: "Idle" | "Walking" | "Running" | "Jumping" | "Falling" | "Swimming" | "Flying"
local MoveDirection = Vector3.zero
local MoveSpeed = 16
local IsMoving = false
local IsSprinting = false
local InputVector = Vector2.zero

-- Animation tracks
local AnimationTracks = {} :: {[string]: AnimationTrack}

-- Initialize
function PlayerController.Initialize(playerData: Types.PlayerData)
	print("[PlayerController] Initializing...")

	-- Setup character handling
	if Player.Character then
		PlayerController.OnCharacterAdded(Player.Character)
	end

	Player.CharacterAdded:Connect(PlayerController.OnCharacterAdded)

	-- Setup movement input
	PlayerController.SetupMovement()

	-- Setup actions
	PlayerController.SetupActions()

	print("[PlayerController] Initialized")
end

function PlayerController.OnCharacterAdded(character: Model)
	Character = character
	Humanoid = character:WaitForChild("Humanoid") :: Humanoid
	RootPart = character:WaitForChild("HumanoidRootPart") :: BasePart

	-- Configure humanoid
	Humanoid.WalkSpeed = Config.Game.BaseWalkSpeed
	Humanoid.JumpPower = Config.Game.BaseJumpPower
	Humanoid.AutoRotate = true

	-- Get or create animator
	Animator = character:FindFirstChild("Animator") :: Animator?
	if not Animator then
		Animator = Instance.new("Animator")
		Animator.Parent = Humanoid
	end

	-- Load animations
	PlayerController.LoadAnimations()

	-- State change handler
	Humanoid.StateChanged:Connect(function(_, newState)
		PlayerController.OnHumanoidStateChanged(newState)
	end)

	-- Movement direction tracking
	RunService.RenderStepped:Connect(function()
		if RootPart and Humanoid then
			PlayerController.UpdateMovement()
		end
	end)

	PlayerController.OnCharacterLoaded:Fire(character)
	print("[PlayerController] Character loaded")
end

function PlayerController.LoadAnimations()
	if not Animator then return end

	local animIds = {
		Idle = "rbxassetid://507766666",
		Walk = "rbxassetid://507777826",
		Run = "rbxassetid://507767714",
		Jump = "rbxassetid://507765000",
		Fall = "rbxassetid://507767968",
		Swim = "rbxassetid://507784542",
		Fly = "rbxassetid://507784542",
	}

	for name, id in pairs(animIds) do
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		AnimationTracks[name] = Animator:LoadAnimation(anim)
	end

	-- Play idle by default
	if AnimationTracks.Idle then
		AnimationTracks.Idle:Play()
	end
end

function PlayerController.OnHumanoidStateChanged(newState: Enum.HumanoidStateType)
	local stateMap = {
		[Enum.HumanoidStateType.Running] = "Walking",
		[Enum.HumanoidStateType.RunningNoPhysics] = "Walking",
		[Enum.HumanoidStateType.Jumping] = "Jumping",
		[Enum.HumanoidStateType.Freefall] = "Falling",
		[Enum.HumanoidStateType.Landed] = "Idle",
		[Enum.HumanoidStateType.Swimming] = "Swimming",
		[Enum.HumanoidStateType.Flying] = "Flying",
	}

	local newStateStr = stateMap[newState] or "Idle"

	if newStateStr ~= CurrentState then
		local oldState = CurrentState
		CurrentState = newStateStr

		-- Handle animation transitions
		PlayerController.UpdateAnimation(newStateStr, oldState)

		PlayerController.OnStateChanged:Fire(CurrentState, oldState)
	end
end

function PlayerController.UpdateAnimation(newState: string, oldState: string)
	-- Stop old animation
	if AnimationTracks[oldState] then
		AnimationTracks[oldState]:Stop(0.1)
	end

	-- Play new animation
	local animName = newState
	if newState == "Walking" and IsSprinting then
		animName = "Run"
	end

	if AnimationTracks[animName] then
		AnimationTracks[animName]:Play(0.1)
	end
end

-- Setup movement input
function PlayerController.SetupMovement()
	-- WASD / Arrow keys
	ContextActionService:BindAction("MoveForward", function(_, state: Enum.UserInputState)
		if state == Enum.UserInputState.Begin then
			InputVector = Vector2.new(InputVector.X, 1)
		elseif state == Enum.UserInputState.End then
			InputVector = Vector2.new(InputVector.X, 0)
		end
	end, false, Enum.KeyCode.W, Enum.KeyCode.Up)

	ContextActionService:BindAction("MoveBackward", function(_, state: Enum.UserInputState)
		if state == Enum.UserInputState.Begin then
			InputVector = Vector2.new(InputVector.X, -1)
		elseif state == Enum.UserInputState.End then
			InputVector = Vector2.new(InputVector.X, 0)
		end
	end, false, Enum.KeyCode.S, Enum.KeyCode.Down)

	ContextActionService:BindAction("MoveLeft", function(_, state: Enum.UserInputState)
		if state == Enum.UserInputState.Begin then
			InputVector = Vector2.new(-1, InputVector.Y)
		elseif state == Enum.UserInputState.End then
			InputVector = Vector2.new(0, InputVector.Y)
		end
	end, false, Enum.KeyCode.A, Enum.KeyCode.Left)

	ContextActionService:BindAction("MoveRight", function(_, state: Enum.UserInputState)
		if state == Enum.UserInputState.Begin then
			InputVector = Vector2.new(1, InputVector.Y)
		elseif state == Enum.UserInputState.End then
			InputVector = Vector2.new(0, InputVector.Y)
		end
	end, false, Enum.KeyCode.D, Enum.KeyCode.Right)

	-- Sprint
	ContextActionService:BindAction("Sprint", function(_, state: Enum.UserInputState)
		IsSprinting = state == Enum.UserInputState.Begin
		PlayerController.UpdateWalkSpeed()
	end, false, Enum.KeyCode.LeftShift)

	-- Jump
	ContextActionService:BindAction("Jump", function(_, state: Enum.UserInputState)
		if state == Enum.UserInputState.Begin and Humanoid then
			Humanoid.Jump = true
		end
	end, false, Enum.KeyCode.Space)
end

function PlayerController.SetupActions()
	-- Interact (E)
	ContextActionService:BindAction("Interact", function(_, state: Enum.UserInputState)
		if state == Enum.UserInputState.Begin then
			PlayerController.Interact()
		end
	end, false, Enum.KeyCode.E)

	-- Party (P)
	ContextActionService:BindAction("OpenParty", function(_, state: Enum.UserInputState)
		if state == Enum.UserInputState.Begin then
			PlayerController.ToggleParty()
		end
	end, false, Enum.KeyCode.P)

	-- Inventory (I)
	ContextActionService:BindAction("OpenInventory", function(_, state: Enum.UserInputState)
		if state == Enum.UserInputState.Begin then
			PlayerController.ToggleInventory()
		end
	end, false, Enum.KeyCode.I)

	-- Map (M)
	ContextActionService:BindAction("OpenMap", function(_, state: Enum.UserInputState)
		if state == Enum.UserInputState.Begin then
			PlayerController.ToggleMap()
		end
	end, false, Enum.KeyCode.M)

	-- Menu (Escape)
	ContextActionService:BindAction("OpenMenu", function(_, state: Enum.UserInputState)
		if state == Enum.UserInputState.Begin then
			PlayerController.ToggleMenu()
		end
	end, false, Enum.KeyCode.Escape)
end

function PlayerController.UpdateWalkSpeed()
	if not Humanoid then return end

	local baseSpeed = Config.Game.BaseWalkSpeed
	if IsSprinting then
		Humanoid.WalkSpeed = baseSpeed * Config.Game.SprintMultiplier
	else
		Humanoid.WalkSpeed = baseSpeed
	end
end

function PlayerController.UpdateMovement()
	if not RootPart or not Humanoid then return end

	-- Get camera direction
	local camera = workspace.CurrentCamera
	if not camera then return end

	local cameraCFrame = camera.CFrame
	local forward = Vector3.new(cameraCFrame.LookVector.X, 0, cameraCFrame.LookVector.Z).Unit
	local right = Vector3.new(cameraCFrame.RightVector.X, 0, cameraCFrame.RightVector.Z).Unit

	-- Calculate move direction
	MoveDirection = (forward * InputVector.Y + right * InputVector.X)

	if MoveDirection.Magnitude &gt; 0 then
		MoveDirection = MoveDirection.Unit
		IsMoving = true

		-- Apply movement
		Humanoid:Move(MoveDirection, false)
	else
		IsMoving = false
		Humanoid:Move(Vector3.zero, false)
	end

	PlayerController.OnMovementChanged:Fire(MoveDirection, IsMoving, IsSprinting)
end

function PlayerController.Interact()
	-- Raycast in front of player to find interactables
	if not RootPart then return end

	local rayParams = RaycastParams.new()
	rayParams.FilterDescendantsInstances = {Character}
	rayParams.FilterType = Enum.RaycastFilterType.Exclude

	local ray = workspace:Raycast(RootPart.Position, RootPart.CFrame.LookVector * 5, rayParams)

	if ray and ray.Instance then
		-- Check for interactable objects
		local interactable = ray.Instance:FindFirstAncestorWhichIsA("Model")
		if interactable and interactable:GetAttribute("Interactable") then
			local interactionType = interactable:GetAttribute("InteractionType")

			if interactionType == "NPC" then
				-- Talk to NPC
				PlayerController.TalkToNPC(interactable)
			elseif interactionType == "HealingStation" then
				-- Heal party
				PlayerController.UseHealingStation(interactable)
			elseif interactionType == "Shop" then
				-- Open shop
				PlayerController.OpenShop(interactable)
			elseif interactionType == "Portal" then
				-- Teleport
				PlayerController.UsePortal(interactable)
			end
		end
	end
end

function PlayerController.TalkToNPC(npc: Model)
	-- Fire remote to start dialogue
	print("[PlayerController] Talking to NPC:", npc.Name)
end

function PlayerController.UseHealingStation(station: Model)
	print("[PlayerController] Using healing station")
end

function PlayerController.OpenShop(shop: Model)
	print("[PlayerController] Opening shop")
end

function PlayerController.UsePortal(portal: Model)
	print("[PlayerController] Using portal")
end

function PlayerController.ToggleParty()
	-- Handled by UIController
end

function PlayerController.ToggleInventory()
	-- Handled by UIController
end

function PlayerController.ToggleMap()
	-- Handled by UIController
end

function PlayerController.ToggleMenu()
	-- Handled by UIController
end

-- Getters
function PlayerController.GetCharacter(): Model?
	return Character
end

function PlayerController.GetHumanoid(): Humanoid?
	return Humanoid
end

function PlayerController.GetRootPart(): BasePart?
	return RootPart
end

function PlayerController.GetCurrentState(): string
	return CurrentState
end

function PlayerController.GetMoveDirection(): Vector3
	return MoveDirection
end

function PlayerController.IsMoving(): boolean
	return IsMoving
end

function PlayerController.IsSprinting(): boolean
	return IsSprinting
end

-- Teleport player
function PlayerController.TeleportTo(position: Vector3)
	if RootPart then
		RootPart.CFrame = CFrame.new(position)
	end
end

-- Set walk speed (for effects like speed boost, slow, etc.)
function PlayerController.SetWalkSpeedMultiplier(multiplier: number)
	if Humanoid then
		Humanoid.WalkSpeed = Config.Game.BaseWalkSpeed * multiplier
	end
end

return PlayerController</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">QuestController</string>
              <string name="Source">--!strict
-- QuestController.lua - Controller de missões/quests no cliente

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local RemoteClient = require(script.Parent.RemoteClient)
local UIController = require(script.Parent.UIController)
local Config = require(ReplicatedStorage.Shared.Config)
local Types = require(ReplicatedStorage.Shared.Types)

local QuestController = {}

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

-- State
local ActiveQuests = {} :: {Types.QuestData}
local AvailableQuests = {} :: {Types.QuestData}
local CurrentNPCId = ""
local QuestUIs = {} :: {[string]: ScreenGui}

-- Initialize
function QuestController.Initialize()
	print("[QuestController] Initializing...")

	-- Listen for quest progress updates
	RemoteClient.OnQuestProgress(function(quest, objective)
		QuestController.OnQuestProgress(quest, objective)
	end)

	-- Create quest UI
	QuestController.CreateQuestUI()

	print("[QuestController] Initialized")
end

-- Create main quest UI
function QuestController.CreateQuestUI()
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "QuestUI"
	screenGui.ResetOnSpawn = false
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.Parent = PlayerGui

	-- Quest Tracker (lado direito da tela)
	local trackerFrame = Instance.new("Frame")
	trackerFrame.Name = "QuestTracker"
	trackerFrame.Size = UDim2.new(0, 300, 0, 400)
	trackerFrame.Position = UDim2.new(1, -320, 0.5, -200)
	trackerFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
	trackerFrame.BackgroundTransparency = 0.1
	trackerFrame.BorderSizePixel = 0
	trackerFrame.Visible = false
	trackerFrame.Parent = screenGui

	local trackerCorner = Instance.new("UICorner")
	trackerCorner.CornerRadius = UDim.new(0, 12)
	trackerCorner.Parent = trackerFrame

	local trackerStroke = Instance.new("UIStroke")
	trackerStroke.Color = Color3.fromRGB(100, 150, 255)
	trackerStroke.Transparency = 0.5
	trackerStroke.Thickness = 2
	trackerStroke.Parent = trackerFrame

	-- Title
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.Size = UDim2.new(1, -20, 0, 40)
	titleLabel.Position = UDim2.new(0, 10, 0, 10)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = "MISSÕES ATIVAS"
	titleLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
	titleLabel.TextScaled = true
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Parent = trackerFrame

	-- Quest list
	local questList = Instance.new("ScrollingFrame")
	questList.Name = "QuestList"
	questList.Size = UDim2.new(1, -20, 1, -60)
	questList.Position = UDim2.new(0, 10, 0, 50)
	questList.BackgroundTransparency = 1
	questList.ScrollBarThickness = 6
	questList.ScrollBarImageColor3 = Color3.fromRGB(100, 150, 255)
	questList.CanvasSize = UDim2.new(0, 0, 0, 0)
	questList.Parent = trackerFrame

	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 10)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Parent = questList

	QuestUIs.Tracker = screenGui
	QuestUIs.TrackerFrame = trackerFrame
	QuestUIs.QuestList = questList

	-- Quest Detail Modal
	QuestController.CreateQuestDetailUI(screenGui)

	-- Quest NPC Dialog UI
	QuestController.CreateNPCDialogUI(screenGui)
end

-- Create quest detail modal
function QuestController.CreateQuestDetailUI(parent: ScreenGui)
	local modal = Instance.new("Frame")
	modal.Name = "QuestDetailModal"
	modal.Size = UDim2.new(0, 500, 0, 500)
	modal.Position = UDim2.new(0.5, -250, 0.5, -250)
	modal.BackgroundColor3 = Color3.fromRGB(15, 15, 25)
	modal.BackgroundTransparency = 0.05
	modal.BorderSizePixel = 0
	modal.Visible = false
	modal.ZIndex = 10
	modal.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 16)
	corner.Parent = modal

	local stroke = Instance.new("UIStroke")
