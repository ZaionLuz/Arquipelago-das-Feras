	local tabs = {"Ativas", "Disponíveis"}
	for _, tabName in ipairs(tabs) do
		local tabBtn = Instance.new("TextButton")
		tabBtn.Name = "Tab_" .. tabName
		tabBtn.Size = UDim2.new(0, 90, 1, 0)
