            <string name="Name">EvolutionSystem</string>
            <string name="Source">--!strict
-- EvolutionSystem.lua - Sistema de evolução de criaturas

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Types = require(ReplicatedStorage.Shared.Types)
local Config = require(ReplicatedStorage.Shared.Config)
local CreatureSystem = require(script.Parent.CreatureSystem)
local PartySystem = require(script.Parent.PartySystem)
local ItemSystem = require(script.Parent.ItemSystem)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local EvolutionSystem = {}

-- Events
EvolutionSystem.OnEvolutionStarted = Signal.New()
EvolutionSystem.OnEvolutionCompleted = Signal.New()
EvolutionSystem.OnEvolutionCancelled = Signal.New()

-- Evolution requirements cache
local EvolutionCache = {}

-- Initialize
function EvolutionSystem.Initialize()
	-- Build evolution lookup cache
	for speciesId, speciesData in pairs(Config.SpeciesList) do
		if speciesData.Evolutions then
			EvolutionCache[speciesId] = speciesData.Evolutions
		end
	end
	print("[EvolutionSystem] Initialized with " .. TableUtil.Length(EvolutionCache) .. " evolutions")
end

-- Check if creature can evolve
function EvolutionSystem.CanEvolve(creature: Types.CreatureData): Types.EvolutionData?
	local evolution = EvolutionCache[creature.SpeciesId]
	if not evolution then return nil end

	-- Check method
	if evolution.Method == "Level" then
		if creature.Level &gt;= evolution.Requirement then
			return evolution
		end
	elseif evolution.Method == "Friendship" then
		if creature.Friendship &gt;= evolution.Requirement then
			return evolution
		end
	elseif evolution.Method == "Item" then
		-- Check if player has the item
		-- This would be checked when item is used
		return evolution
	elseif evolution.Method == "Trade" then
		-- Trade evolution - handled during trade
		return evolution
	elseif evolution.Method == "TimeOfDay" then
		local timeOfDay = EvolutionSystem.GetTimeOfDay()
		if timeOfDay == evolution.Requirement then
			return evolution
		end
	elseif evolution.Method == "Location" then
		-- Location evolution - checked when in specific zone
		return evolution
	end

	return nil
end

-- Get time of day
function EvolutionSystem.GetTimeOfDay(): "Day" | "Night" | "Dawn" | "Dusk"
	local cycleTime = (tick() % Config.Game.DayNightCycle) / Config.Game.DayNightCycle
	if cycleTime &lt; 0.25 then return "Dawn"
	elseif cycleTime &lt; 0.5 then return "Day"
	elseif cycleTime &lt; 0.75 then return "Dusk"
	else return "Night"
	end
end

-- Attempt evolution
function EvolutionSystem.AttemptEvolution(player: Player, creatureId: string, method: string?, itemId: string?): (boolean, Types.CreatureData?)
	-- Find creature in party or storage
	local partySystem = require(script.Parent.PartySystem)
	local creature: Types.CreatureData?
	local location: "Party" | "Storage" = "Party"

	for _, c in ipairs(partySystem.GetPlayerParty(player)) do
		if c.Id == creatureId then
			creature = c
			break
		end
	end

	if not creature then
		location = "Storage"
		for _, box in ipairs(partySystem.GetPlayerStorage(player)) do
			for _, c in ipairs(box) do
				if c.Id == creatureId then
					creature = c
					break
				end
			end
			if creature then break end
		end
	end

	if not creature then
		return false, nil
	end

	-- Check evolution requirements
	local evolution = EvolutionSystem.CanEvolve(creature)

	-- Special checks for item/trade/time/location
	if evolution then
		if evolution.Method == "Item" and itemId then
			local itemConfig = Config.Items[itemId]
			if not itemConfig or itemConfig.Id ~= evolution.Requirement then
				return false, nil
			end
			-- Consume item
			ItemSystem.RemoveItem(player, itemId, 1)
		elseif evolution.Method == "Trade" then
			-- Would need trade system
			return false, nil
		elseif evolution.Method == "TimeOfDay" then
			if EvolutionSystem.GetTimeOfDay() ~= evolution.Requirement then
				return false, nil
			end
		elseif evolution.Method == "Location" then
			-- Check player's current zone
			-- Would need player zone tracking
		end
	else
		return false, nil
	end

	-- Start evolution
	EvolutionSystem.OnEvolutionStarted:Fire(player, creature, evolution.TargetSpecies)

	-- Perform evolution
	local evolvedCreature = CreatureSystem.EvolveCreature(creature, evolution.TargetSpecies)

	-- Update in party/storage
	if location == "Party" then
		-- Already updated by reference
	else
		-- In storage - already updated by reference
	end

	EvolutionSystem.OnEvolutionCompleted:Fire(player, evolvedCreature, evolution.TargetSpecies)

	return true, evolvedCreature
end

-- Get possible evolutions for a species
function EvolutionSystem.GetPossibleEvolutions(speciesId: string): {Types.EvolutionData}
	local evolutions = {}

	-- Direct evolution
	if EvolutionCache[speciesId] then
		table.insert(evolutions, EvolutionCache[speciesId])
	end

	-- Branch evolutions (if multiple)
	-- This would be expanded for complex evolution lines

	return evolutions
end

-- Get evolution chain
function EvolutionSystem.GetEvolutionChain(speciesId: string): {string}
	local chain = {speciesId}
	local current = speciesId

	while EvolutionCache[current] do
		local nextSpecies = EvolutionCache[current].TargetSpecies
		table.insert(chain, nextSpecies)
		current = nextSpecies
	end

	return chain
end

-- Get pre-evolution
function EvolutionSystem.GetPreEvolution(speciesId: string): string?
	for id, evo in pairs(EvolutionCache) do
		if evo.TargetSpecies == speciesId then
			return id
		end
	end
	return nil
end

-- Check all party creatures for evolution
function EvolutionSystem.CheckPartyForEvolutions(player: Player): {Types.CreatureData}
	local partySystem = require(script.Parent.PartySystem)
	local readyToEvolve = {}

	for _, creature in ipairs(partySystem.GetPlayerParty(player)) do
		if EvolutionSystem.CanEvolve(creature) then
			table.insert(readyToEvolve, creature)
		end
	end

	return readyToEvolve
end

-- Cancel evolution (if player presses B)
function EvolutionSystem.CancelEvolution(player: Player, creatureId: string)
	local partySystem = require(script.Parent.PartySystem)

	for _, creature in ipairs(partySystem.GetPlayerParty(player)) do
		if creature.Id == creatureId then
			EvolutionSystem.OnEvolutionCancelled:Fire(player, creature)
			return true
		end
	end

	return false
end

-- Get evolution info for UI
function EvolutionSystem.GetEvolutionInfo(creature: Types.CreatureData): {CanEvolve: boolean, Method: string?, Requirement: any?, TargetSpecies: string?, TargetName: string?}
	local evolution = EvolutionSystem.CanEvolve(creature)

	if not evolution then
		return {CanEvolve = false}
	end

	local targetData = Config.SpeciesList[evolution.TargetSpecies]

	return {
		CanEvolve = true,
		Method = evolution.Method,
		Requirement = evolution.Requirement,
		TargetSpecies = evolution.TargetSpecies,
		TargetName = targetData and targetData.Name or evolution.TargetSpecies,
	}
end

-- Helper: TableUtil.Length
local function TableUtilLength(t: {[any]: any}): number
	local count = 0
	for _ in pairs(t) do count += 1 end
	return count
end

return EvolutionSystem</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">ItemSystem</string>
            <string name="Source">--!strict
-- ItemSystem.lua - Sistema de itens (inventário, uso, crafting)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Types = require(ReplicatedStorage.Shared.Types)
local Config = require(ReplicatedStorage.Shared.Config)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local ItemSystem = {}

-- Events
ItemSystem.OnItemAdded = Signal.New()
ItemSystem.OnItemRemoved = Signal.New()
ItemSystem.OnItemUsed = Signal.New()

-- Player inventories
local PlayerInventories = {} :: {[number]: {Types.ItemData}}

-- Inventory config
local MAX_INVENTORY_SIZE = 100
local MAX_STACK_SIZE = 99

-- Initialize player inventory
function ItemSystem.InitializePlayer(player: Player)
	PlayerInventories[player.UserId] = {}

	-- Give starter items
	ItemSystem.AddItem(player, "Potion", 5)
	ItemSystem.AddItem(player, "BasicBall", 10)

	print(`[ItemSystem] Initialized inventory for {player.Name}`)
end

-- Cleanup player
function ItemSystem.CleanupPlayer(player: Player)
	PlayerInventories[player.UserId] = nil
end

-- Get player inventory
function ItemSystem.GetInventory(player: Player): {Types.ItemData}
	return PlayerInventories[player.UserId] or {}
end

-- Add item to inventory
function ItemSystem.AddItem(player: Player, itemId: string, count: number?): boolean
	count = count or 1
	local inventory = PlayerInventories[player.UserId]
	if not inventory then return false end

	local itemConfig = Config.Items[itemId]
	if not itemConfig then
		warn(`[ItemSystem] Item not found: {itemId}`)
		return false
	end

	local remaining = count

	-- Try to stack with existing items
	if itemConfig.Stackable then
		for _, item in ipairs(inventory) do
			if item.Id == itemId and item.Count &lt; (itemConfig.MaxStack or MAX_STACK_SIZE) then
				local canAdd = math.min(remaining, (itemConfig.MaxStack or MAX_STACK_SIZE) - item.Count)
				item.Count += canAdd
				remaining -= canAdd
				if remaining &lt;= 0 then
					ItemSystem.OnItemAdded:Fire(player, itemId, count)
					return true
				end
			end
		end
	end

	-- Add new stacks
	while remaining &gt; 0 do
		if #inventory &gt;= MAX_INVENTORY_SIZE then
			warn(`[ItemSystem] Inventory full for {player.Name}`)
			return false
		end

		local stackSize = math.min(remaining, itemConfig.MaxStack or MAX_STACK_SIZE)
		table.insert(inventory, {
			Id = itemId,
			Count = stackSize,
		})
		remaining -= stackSize
	end

	ItemSystem.OnItemAdded:Fire(player, itemId, count)
	return true
end

-- Remove item from inventory
function ItemSystem.RemoveItem(player: Player, itemId: string, count: number?): boolean
	count = count or 1
	local inventory = PlayerInventories[player.UserId]
	if not inventory then return false end

	local remaining = count

	-- Remove from stacks (last added first for LIFO)
	for i = #inventory, 1, -1 do
		local item = inventory[i]
		if item.Id == itemId then
			if item.Count &lt;= remaining then
				remaining -= item.Count
				table.remove(inventory, i)
			else
				item.Count -= remaining
				remaining = 0
			end

			if remaining &lt;= 0 then
				ItemSystem.OnItemRemoved:Fire(player, itemId, count)
				return true
			end
		end
	end

	return false
end

-- Check if player has item
function ItemSystem.HasItem(player: Player, itemId: string, count: number?): boolean
	count = count or 1
	local inventory = PlayerInventories[player.UserId]
	if not inventory then return false end

	local total = 0
	for _, item in ipairs(inventory) do
		if item.Id == itemId then
			total += item.Count
			if total &gt;= count then
				return true
			end
		end
	end

	return false
end

-- Get item count
function ItemSystem.GetItemCount(player: Player, itemId: string): number
	local inventory = PlayerInventories[player.UserId]
	if not inventory then return 0 end

	local total = 0
	for _, item in ipairs(inventory) do
		if item.Id == itemId then
			total += item.Count
		end
	end

	return total
end

-- Use item on target
function ItemSystem.UseItem(player: Player, itemId: string, targetCreatureId: string?): (boolean, string?)
	local inventory = PlayerInventories[player.UserId]
	if not inventory then return false, "No inventory" end

	-- Check if player has item
	if not ItemSystem.HasItem(player, itemId, 1) then
		return false, "Item not in inventory"
	end

	local itemConfig = Config.Items[itemId]
	if not itemConfig then return false, "Invalid item" end

	-- Get target creature
	local targetCreature: Types.CreatureData?
	if targetCreatureId then
		local partySystem = require(script.Parent.PartySystem)
		for _, creature in ipairs(partySystem.GetPlayerParty(player)) do
			if creature.Id == targetCreatureId then
				targetCreature = creature
				break
			end
		end

		-- Check storage if not in party
		if not targetCreature then
			for _, box in ipairs(partySystem.GetPlayerStorage(player)) do
				for _, creature in ipairs(box) do
					if creature.Id == targetCreatureId then
						targetCreature = creature
						break
					end
				end
				if targetCreature then break end
			end
		end
	else
		-- Use on first party member
		local partySystem = require(script.Parent.PartySystem)
		targetCreature = partySystem.GetFirstAlive(player)
	end

	if not targetCreature then
		return false, "No valid target"
	end

	-- Apply item effect
	local success, message = ItemSystem.ApplyItemEffect(itemConfig, targetCreature)

	if success then
		ItemSystem.RemoveItem(player, itemId, 1)
		ItemSystem.OnItemUsed:Fire(player, itemId, targetCreature)
		return true, message
	end

	return false, message
end

-- Apply item effect to creature
function ItemSystem.ApplyItemEffect(itemConfig: Types.ItemData, creature: Types.CreatureData): (boolean, string)
	local effect = itemConfig.Effect

	if effect.Type == "Heal" then
		local amount = effect.Params.Amount or 0
		if amount &lt; 0 then amount = creature.Stats.HP end -- Full heal

		local oldHP = creature.CurrentHP
		creature.CurrentHP = math.min(creature.Stats.HP, creature.CurrentHP + amount)
		local healed = creature.CurrentHP - oldHP

		return true, `Curou {healed} HP!`

	elseif effect.Type == "CureStatus" then
		local status = effect.Params.Status
		if status == "All" then
			creature.Status = "None"
			return true, `Curou todos os status!`
		elseif creature.Status == status then
			creature.Status = "None"
			return true, `Curou {status}!`
		else
			return false, `Não está com {status}`
		end

	elseif effect.Type == "PPRestore" then
		local amount = effect.Params.Amount or 0
		local allMoves = effect.Params.AllMoves or false

		if allMoves then
			for _, move in ipairs(creature.Moves) do
				if amount &lt; 0 then
					move.PP = move.MaxPP
				else
					move.PP = math.min(move.MaxPP, move.PP + amount)
				end
			end
			return true, `Restaurou PP de todos os movimentos!`
		else
			-- Would need to specify which move
			return false, "Especifique o movimento"
		end

	elseif effect.Type == "Revive" then
		if creature.CurrentHP &lt;= 0 then
			local hpPercent = effect.Params.RevivesWithHP or 0.5
			creature.CurrentHP = math.floor(creature.Stats.HP * hpPercent)
			creature.Status = "None"
			return true, `Reviveu com {creature.CurrentHP} HP!`
		else
			return false, "Já está consciente"
		end

	elseif effect.Type == "Evolve" then
		-- Evolution handled by EvolutionSystem
		return true, "Item de evolução usado!"

	elseif effect.Type == "TeachMove" then
		-- Move learning handled separately
		return true, "MT usada!"

	elseif effect.Type == "Capture" then
		-- Capture balls handled by CreatureSystem
		return true, "Bola de captura!"
	end

	return false, "Efeito não implementado"
end

-- Get item info for UI
function ItemSystem.GetItemInfo(itemId: string): Types.ItemData?
	return Config.Items[itemId]
end

-- Get all items in inventory with full info
function ItemSystem.GetInventoryWithInfo(player: Player): {{Item: Types.ItemData, Count: number}}
	local inventory = PlayerInventories[player.UserId] or {}
	local result = {}

	for _, invItem in ipairs(inventory) do
		local itemData = Config.Items[invItem.Id]
		if itemData then
			table.insert(result, {
				Item = itemData,
				Count = invItem.Count,
			})
		end
	end

	return result
end

-- Sort inventory
function ItemSystem.SortInventory(player: Player, sortType: "Name" | "Type" | "Count" | "Rarity")
	local inventory = PlayerInventories[player.UserId]
	if not inventory then return end

	table.sort(inventory, function(a, b)
		local itemA = Config.Items[a.Id]
		local itemB = Config.Items[b.Id]

		if sortType == "Name" then
			return (itemA and itemA.Name or a.Id) &lt; (itemB and itemB.Name or b.Id)
		elseif sortType == "Type" then
			return (itemA and itemA.Type or "") &lt; (itemB and itemB.Type or "")
		elseif sortType == "Count" then
			return a.Count &gt; b.Count
		elseif sortType == "Rarity" then
			-- Would need rarity field on items
			return a.Id &lt; b.Id
		end
		return a.Id &lt; b.Id
	end)
end

return ItemSystem</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">NPCSystem</string>
            <string name="Source">--!strict
-- NPCSystem.lua - Sistema de NPCs (treinadores, lojistas, curandeiros, quest givers)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local Types = require(ReplicatedStorage.Shared.Types)
local Config = require(ReplicatedStorage.Shared.Config)
local CreatureSystem = require(script.Parent.CreatureSystem)
local PartySystem = require(script.Parent.PartySystem)
local ItemSystem = require(script.Parent.ItemSystem)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local NPCSystem = {}

-- Events
NPCSystem.OnNPCTalked = Signal.New()
NPCSystem.OnTradeOpened = Signal.New()
NPCSystem.OnQuestAccepted = Signal.New()
NPCSystem.OnQuestCompleted = Signal.New()

-- State
local NPCs = {} :: {[string]: {Model: Model, Data: Types.NPCData, Connections: {RBXScriptConnection}}}
local PlayerInteractions = {} :: {[number]: {NPCId: string, InteractionType: string}}

-- Initialize
function NPCSystem.Initialize()
	print("[NPCSystem] Initializing...")

	-- Load NPCs from config
	NPCSystem.LoadNPCsFromConfig()

	-- Setup interaction detection
	NPCSystem.SetupInteractionDetection()

	-- Handle player leaving
	Players.PlayerRemoving:Connect(function(player)
		PlayerInteractions[player.UserId] = nil
	end)

	print("[NPCSystem] Initialized")
end

function NPCSystem.LoadNPCsFromConfig()
	for zoneId, zoneData in pairs(Config.Zones) do
		if zoneData.NPCs then
			for _, npcData in ipairs(zoneData.NPCs) do
				NPCSystem.SpawnNPC(npcData, zoneId)
			end
		end
	end
end

function NPCSystem.SpawnNPC(npcData: Types.NPCData, zoneId: string)
	-- Create NPC model
	local model = Instance.new("Model")
	model.Name = npcData.Id
	model.Parent = workspace

	-- Humanoid for animation/pathfinding
	local humanoid = Instance.new("Humanoid")
	humanoid.Name = "Humanoid"
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.WalkSpeed = 0 -- Stationary by default
	humanoid.Parent = model

	-- Root part - adjust position relative to island center if needed
	local zoneData = Config.Zones[zoneId]
	local npcPosition = npcData.Position
	if zoneData and zoneData.IslandPosition then
		-- If NPC position is relative to zone center, adjust
		local isRelative = (npcPosition.Position - zoneData.IslandPosition).Magnitude &lt; 500
		if isRelative then
			npcPosition = CFrame.new(zoneData.IslandPosition + npcPosition.Position)
		end
	end

	local rootPart = Instance.new("Part")
	rootPart.Name = "HumanoidRootPart"
	rootPart.Size = Vector3.new(2, 2, 1)
	rootPart.Transparency = 1
	rootPart.CanCollide = false
	rootPart.Anchored = true
	rootPart.CFrame = npcPosition
	rootPart.Parent = model

	model.PrimaryPart = rootPart

	-- Visual representation (placeholder)
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = Vector3.new(2, 4, 1)
	body.Position = npcData.Position.Position + Vector3.new(0, 2, 0)
	body.Anchored = true
	body.CanCollide = false
	body.Material = Enum.Material.Neon
	body.Color = NPCSystem.GetNPCColor(npcData.Type)
	body.Parent = model

	-- Name tag
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "NameTag"
	billboard.Size = UDim2.new(0, 200, 0, 50)
	billboard.StudsOffset = Vector3.new(0, 4, 0)
	billboard.Adornee = body
	billboard.AlwaysOnTop = true
	billboard.Parent = model

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, 0, 1, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = npcData.Name
	nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	nameLabel.TextScaled = true
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextStrokeTransparency = 0
	nameLabel.Parent = billboard

	-- Type icon
	local typeIcons = {
		Trainer = "⚔️",
		Shopkeeper = "🏪",
		Healer = "❤️",
		QuestGiver = "📜",
	}

	local iconLabel = Instance.new("TextLabel")
	iconLabel.Size = UDim2.new(0, 30, 0, 30)
	iconLabel.Position = UDim2.new(1, -35, 0, 0)
	iconLabel.BackgroundTransparency = 1
	iconLabel.Text = typeIcons[npcData.Type] or "👤"
	iconLabel.TextScaled = true
	iconLabel.Parent = billboard

	-- Proximity prompt for interaction
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = NPCSystem.GetInteractionText(npcData.Type)
	prompt.ObjectText = npcData.Name
	prompt.MaxActivationDistance = 10
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.Parent = body

	prompt.Triggered:Connect(function(player)
		NPCSystem.OnPlayerInteract(player, npcData.Id, npcData.Type)
	end)

	-- Store NPC data
	NPCs[npcData.Id] = {
		Model = model,
		Data = npcData,
		Connections = {},
	}

	-- Setup patrol if trainer
	if npcData.Type == "Trainer" and npcData.Team then
		NPCSystem.SetupTrainerBehavior(npcData.Id, npcData)
	end

	print(`[NPCSystem] Spawned NPC: {npcData.Name} ({npcData.Type}) at {npcData.Position}`)
end

function NPCSystem.GetNPCColor(npcType: string): Color3
	local colors = {
		Trainer = Color3.fromRGB(255, 100, 100),
		Shopkeeper = Color3.fromRGB(100, 255, 100),
		Healer = Color3.fromRGB(100, 200, 255),
		QuestGiver = Color3.fromRGB(255, 255, 100),
	}
	return colors[npcType] or Color3.fromRGB(200, 200, 200)
end

function NPCSystem.GetInteractionText(npcType: string): string
	local texts = {
		Trainer = "Desafiar",
		Shopkeeper = "Comprar",
		Healer = "Curar",
		QuestGiver = "Conversar",
	}
	return texts[npcType] or "Interagir"
end

function NPCSystem.SetupInteractionDetection()
	-- Global interaction handler via RemoteEvent
	local remote = ReplicatedStorage:FindFirstChild("Remotes")
	if remote then
		local interactRemote = remote:FindFirstChild("InteractNPC")
		if not interactRemote then
			interactRemote = Instance.new("RemoteFunction")
			interactRemote.Name = "InteractNPC"
			interactRemote.Parent = remote
		end

		interactRemote.OnServerInvoke = function(player: Player, npcId: string)
			local npc = NPCs[npcId]
			if not npc then return {Success = false, Error = "NPC not found"} end

			-- Check distance
			if player.Character and player.Character.PrimaryPart then
				local dist = (player.Character.PrimaryPart.Position - npc.Model.PrimaryPart.Position).Magnitude
				if dist &gt; 15 then
					return {Success = false, Error = "Too far"}
				end
			end

			return NPCSystem.HandleInteraction(player, npcId, npc.Data.Type)
		end
	end
end

function NPCSystem.OnPlayerInteract(player: Player, npcId: string, npcType: string)
	-- Called from ProximityPrompt
	NPCSystem.HandleInteraction(player, npcId, npcType)
end

function NPCSystem.HandleInteraction(player: Player, npcId: string, npcType: string): any
	local npc = NPCs[npcId]
	if not npc then return end

	PlayerInteractions[player.UserId] = {
		NPCId = npcId,
		InteractionType = npcType,
		StartTime = tick(),
	}

	NPCSystem.OnNPCTalked:Fire(player, npcId, npcType)

	if npcType == "Healer" then
		return NPCSystem.HandleHealer(player, npc)
	elseif npcType == "Shopkeeper" then
		return NPCSystem.HandleShopkeeper(player, npc)
	elseif npcType == "Trainer" then
		return NPCSystem.HandleTrainer(player, npc)
	elseif npcType == "QuestGiver" then
		return NPCSystem.HandleQuestGiver(player, npc)
	end

	return {Success = true}
end

function NPCSystem.HandleHealer(player: Player, npc: any)
	local partySystem = require(script.Parent.PartySystem)
	local party = partySystem.GetPlayerParty(player)

	local healed = 0
	for _, creature in ipairs(party) do
		if creature.CurrentHP &lt; creature.MaxHP or creature.StatusCondition ~= "None" then
			creature.CurrentHP = creature.MaxHP
			creature.StatusCondition = "None"
			healed += 1
		end
	end

	-- Also heal storage
	local storage = partySystem.GetPlayerStorage(player)
	for _, box in ipairs(storage) do
		for _, creature in ipairs(box) do
			if creature.CurrentHP &lt; creature.MaxHP or creature.StatusCondition ~= "None" then
				creature.CurrentHP = creature.MaxHP
				creature.StatusCondition = "None"
			end
		end
	end

	-- Fire client event for UI
	local remote = ReplicatedStorage:FindFirstChild("Remotes")
	if remote then
		local healRemote = remote:FindFirstChild("NPCHealComplete")
		if not healRemote then
			healRemote = Instance.new("RemoteEvent")
			healRemote.Name = "NPCHealComplete"
			healRemote.Parent = remote
		end
		healRemote:FireClient(player, healed)
	end

	return {Success = true, Healed = healed, Message = `Suas {healed} criaturas foram curadas!`}
end

function NPCSystem.HandleShopkeeper(player: Player, npc: any)
	-- Return shop inventory
	local shopInventory = npc.Data.ShopInventory or {}

	-- Get item details
	local items = {}
	for _, itemId in ipairs(shopInventory) do
		local itemConfig = Config.Items[itemId]
		if itemConfig then
			table.insert(items, {
				Id = itemConfig.Id,
				Name = itemConfig.Name,
				Description = itemConfig.Description,
				Price = itemConfig.Price,
				Type = itemConfig.Type,
			})
		end
	end

	return {Success = true, Items = items, NPCName = npc.Data.Name}
end

function NPCSystem.HandleTrainer(player: Player, npc: any)
	-- Check if already battled today
	local playerData = require(script.Parent.DataStoreSystem).LoadPlayerData(player.UserId)
	local battledTrainers = playerData.BattledTrainers or {}

	if battledTrainers[npc.Data.Id] then
		return {Success = false, Message = "Você já desafiou este treinador hoje!"}
	end

	-- Start trainer battle
	local battleSystem = require(script.Parent.BattleSystem)
	local battleData = battleSystem.StartTrainerBattle(player, {
		TrainerId = npc.Data.Id,
		TrainerName = npc.Data.Name,
		Team = npc.Data.Team,
		RewardMoney = npc.Data.RewardMoney or 500,
		RewardItems = npc.Data.RewardItems or {},
		Dialogue = npc.Data.Dialogue or {},
	})

	return {Success = true, BattleId = battleData.Id}
end

function NPCSystem.HandleQuestGiver(player: Player, npc: any)
	-- Return available quests
	local questSystem = require(script.Parent.QuestSystem)
	local availableQuests = questSystem.GetAvailableQuests(player, npc.Data.Id)

	return {Success = true, Quests = availableQuests, NPCName = npc.Data.Name}
end

-- Trainer behavior (patrol, look at player)
function NPCSystem.SetupTrainerBehavior(npcId: string, npcData: Types.NPCData)
	local model = NPCs[npcId]?.Model
	if not model then return end

	local humanoid = model:FindFirstChild("Humanoid")
	if not humanoid then return end

	-- Simple patrol
	local patrolPoints = npcData.PatrolPoints or {}
	if #patrolPoints &gt; 1 then
		task.spawn(function()
			local currentPoint = 1
			while NPCs[npcId] and model.Parent do
				local target = patrolPoints[currentPoint]
				if target then
					humanoid:MoveTo(target)
					humanoid.MoveToFinished:Wait()
				end
				currentPoint = (currentPoint % #patrolPoints) + 1
				task.wait(math.random(5, 15))
			end
		end)
	end

	-- Look at nearby players
	RunService.Heartbeat:Connect(function()
		if not model.Parent then return end

		for _, player in ipairs(Players:GetPlayers()) do
			if player.Character and player.Character.PrimaryPart then
				local dist = (player.Character.PrimaryPart.Position - model.PrimaryPart.Position).Magnitude
				if dist &lt; 20 then
					-- Face player
					local lookAt = CFrame.new(model.PrimaryPart.Position,
						Vector3.new(player.Character.PrimaryPart.Position.X, model.PrimaryPart.Position.Y, player.Character.PrimaryPart.Position.Z))
					model.PrimaryPart.CFrame = lookAt
					break
				end
			end
		end
	end)
end

-- Get NPC data
function NPCSystem.GetNPC(npcId: string): Types.NPCData?
	return NPCs[npcId]?.Data
end

function NPCSystem.GetAllNPCs(): {Types.NPCData}
	local result = {}
	for _, npc in pairs(NPCs) do
		table.insert(result, npc.Data)
	end
	return result
end

-- Cleanup
function NPCSystem.Cleanup()
	for npcId, npc in pairs(NPCs) do
		for _, conn in ipairs(npc.Connections) do
			conn:Disconnect()
		end
		npc.Model:Destroy()
	end
	NPCs = {}
	PlayerInteractions = {}
end

return NPCSystem</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">PartySystem</string>
            <string name="Source">--!strict
-- PartySystem.lua - Gerenciamento de party e storage do jogador

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Types = require(ReplicatedStorage.Shared.Types)
local Config = require(ReplicatedStorage.Shared.Config)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local PartySystem = {}

-- Events
PartySystem.OnPartyChanged = Signal.New()
PartySystem.OnStorageChanged = Signal.New()
PartySystem.OnCreatureAdded = Signal.New()
PartySystem.OnCreatureRemoved = Signal.New()

-- Player party/storage cache
local PlayerParties = {} :: {[number]: {Types.CreatureData}}
local PlayerStorage = {} :: {[number]: {{Types.CreatureData}}}

-- Initialize player
function PartySystem.InitializePlayer(player: Player, playerData: Types.PlayerData)
	PlayerParties[player.UserId] = playerData.Party or {}
	PlayerStorage[player.UserId] = playerData.Storage or {}

	-- Ensure storage has correct number of boxes
	while #PlayerStorage[player.UserId] &lt; Config.Game.MaxStorageBoxes do
		table.insert(PlayerStorage[player.UserId], {})
	end

	print(`[PartySystem] Initialized party for {player.Name}: {#PlayerParties[player.UserId]} in party, {#PlayerStorage[player.UserId]} storage boxes`)
end

-- Cleanup player
function PartySystem.CleanupPlayer(player: Player)
	PlayerParties[player.UserId] = nil
	PlayerStorage[player.UserId] = nil
end

-- Get player's party
function PartySystem.GetPlayerParty(player: Player): {Types.CreatureData}
	return PlayerParties[player.UserId] or {}
end

-- Get player's storage
function PartySystem.GetPlayerStorage(player: Player): {{Types.CreatureData}}
	return PlayerStorage[player.UserId] or {}
end

-- Get specific storage box
function PartySystem.GetStorageBox(player: Player, boxIndex: number): {Types.CreatureData}?
	local storage = PlayerStorage[player.UserId]
	if storage and storage[boxIndex] then
		return storage[boxIndex]
	end
	return nil
end

-- Add creature to party
function PartySystem.AddToParty(player: Player, creature: Types.CreatureData): boolean
	local party = PlayerParties[player.UserId]
	if not party then return false end

	if #party &gt;= Config.Game.MaxPartySize then
		return false -- Party full
	end

	creature.State = "InParty"
	table.insert(party, creature)

	PartySystem.OnPartyChanged:Fire(player, party)
	PartySystem.OnCreatureAdded:Fire(player, creature, "Party")

	return true
end

-- Remove creature from party
function PartySystem.RemoveFromParty(player: Player, creatureId: string): Types.CreatureData?
	local party = PlayerParties[player.UserId]
	if not party then return nil end

	for i, creature in ipairs(party) do
		if creature.Id == creatureId then
			table.remove(party, i)
			creature.State = "InStorage"

			PartySystem.OnPartyChanged:Fire(player, party)
			PartySystem.OnCreatureRemoved:Fire(player, creature, "Party")

			return creature
		end
	end

	return nil
end

-- Add creature to storage
function PartySystem.AddToStorage(player: Player, creature: Types.CreatureData): boolean
	local storage = PlayerStorage[player.UserId]
	if not storage then return false end

	-- Find first box with space
	for boxIndex = 1, #storage do
		local box = storage[boxIndex]
		if #box &lt; Config.Game.StorageBoxSize then
			creature.State = "InStorage"
			creature.StorageBox = boxIndex
			table.insert(box, creature)

			PartySystem.OnStorageChanged:Fire(player, boxIndex, box)
			PartySystem.OnCreatureAdded:Fire(player, creature, "Storage", boxIndex)

			return true
		end
	end

	-- All boxes full
	return false
end

-- Remove creature from storage
function PartySystem.RemoveFromStorage(player: Player, creatureId: string): Types.CreatureData?
	local storage = PlayerStorage[player.UserId]
	if not storage then return nil end

	for boxIndex, box in ipairs(storage) do
		for i, creature in ipairs(box) do
			if creature.Id == creatureId then
				table.remove(box, i)
				creature.State = "InParty"
				creature.StorageBox = nil

				PartySystem.OnStorageChanged:Fire(player, boxIndex, box)
				PartySystem.OnCreatureRemoved:Fire(player, creature, "Storage", boxIndex)

				return creature
			end
		end
	end

	return nil
end

-- Swap two creatures in party
function PartySystem.SwapPartyMembers(player: Player, index1: number, index2: number): boolean
	local party = PlayerParties[player.UserId]
	if not party then return false end

	if index1 &lt; 1 or index1 &gt; #party or index2 &lt; 1 or index2 &gt; #party then
		return false
	end

	party[index1], party[index2] = party[index2], party[index1]

	PartySystem.OnPartyChanged:Fire(player, party)
	return true
end

-- Move creature between party and storage
function PartySystem.MoveCreature(
	player: Player,
	creatureId: string,
	fromType: "Party" | "Storage",
	toType: "Party" | "Storage",
	targetBox: number?
): boolean
	local creature: Types.CreatureData?

	if fromType == "Party" then
		creature = PartySystem.RemoveFromParty(player, creatureId)
	else
		creature = PartySystem.RemoveFromStorage(player, creatureId)
	end

	if not creature then return false end

	if toType == "Party" then
		return PartySystem.AddToParty(player, creature)
	else
		return PartySystem.AddToStorage(player, creature)
	end
end

-- Get first alive creature in party
function PartySystem.GetFirstAlive(player: Player): Types.CreatureData?
	local party = PlayerParties[player.UserId]
	if not party then return nil end

	for _, creature in ipairs(party) do
		if creature.CurrentHP &gt; 0 then
			return creature
		end
	end

	return nil
end

-- Check if party has any alive creatures
function PartySystem.HasAliveCreature(player: Player): boolean
	local party = PlayerParties[player.UserId]
	if not party then return false end

	for _, creature in ipairs(party) do
		if creature.CurrentHP &gt; 0 then
			return true
		end
	end

	return false
end

-- Heal entire party
function PartySystem.HealParty(player: Player): number
	local party = PlayerParties[player.UserId]
	if not party then return 0 end

	local healedCount = 0
	for _, creature in ipairs(party) do
		if creature.CurrentHP &lt; creature.Stats.HP or creature.Status ~= "None" then
			creature.CurrentHP = creature.Stats.HP
			creature.Status = "None"
			for _, move in ipairs(creature.Moves) do
				move.PP = move.MaxPP
			end
			healedCount += 1
		end
	end

	if healedCount &gt; 0 then
		PartySystem.OnPartyChanged:Fire(player, party)
	end

	return healedCount
end

-- Get party summary for UI
function PartySystem.GetPartySummary(player: Player): {{Name: string, Level: number, HP: number, MaxHP: number, Element: string, Status: string, IsShiny: boolean}}
	local party = PlayerParties[player.UserId]
	if not party then return {} end

	local summary = {}
	for _, creature in ipairs(party) do
		local speciesData = Config.SpeciesList[creature.SpeciesId]
		table.insert(summary, {
			Id = creature.Id,
			Name = creature.Nickname or (speciesData and speciesData.Name or creature.SpeciesId),
			Level = creature.Level,
			HP = creature.CurrentHP,
			MaxHP = creature.Stats.HP,
			Element = speciesData and speciesData.Element or "Unknown",
			Status = creature.Status,
			IsShiny = creature.IsShiny,
			SpeciesId = creature.SpeciesId,
		})
	end

	return summary
end

-- Count total creatures owned
function PartySystem.GetTotalCreatureCount(player: Player): number
	local count = #(PlayerParties[player.UserId] or {})
	local storage = PlayerStorage[player.UserId]
	if storage then
		for _, box in ipairs(storage) do
			count += #box
		end
	end
	return count
end

-- Get creatures by species
function PartySystem.GetCreaturesBySpecies(player: Player, speciesId: string): {Types.CreatureData}
	local results = {}

	-- Check party
	for _, creature in ipairs(PlayerParties[player.UserId] or {}) do
		if creature.SpeciesId == speciesId then
			table.insert(results, creature)
		end
	end

	-- Check storage
	local storage = PlayerStorage[player.UserId]
	if storage then
		for _, box in ipairs(storage) do
			for _, creature in ipairs(box) do
				if creature.SpeciesId == speciesId then
					table.insert(results, creature)
				end
			end
		end
	end

	return results
end

-- Release creature (permanent)
function PartySystem.ReleaseCreature(player: Player, creatureId: string): boolean
	local creature = PartySystem.RemoveFromParty(player, creatureId)
	if creature then
		PartySystem.OnCreatureRemovedFire(player, creature)
		return true
	end

	creature = PartySystem.RemoveFromStorage(player, creatureId)
	if creature then
		PartySystem.OnCreatureReleased:Fire(player, creature)
		return true
	end

	return false
end

return PartySystem</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
