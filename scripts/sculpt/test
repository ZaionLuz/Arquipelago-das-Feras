set -euo pipefail
cd "$(dirname "$0")/../.."
bash scripts/test
"${LUNE_BIN:-lune}" run scripts/sculpt/check_rigs.luau
"${LUNE_BIN:-lune}" run scripts/sculpt/check_lod.luau
"${LUNE_BIN:-lune}" run scripts/sculpt/check_performance.luau
"${LUNE_BIN:-lune}" run scripts/sculpt/check_viewport_perf.luau
python3 scripts/sculpt/check_scope.py
