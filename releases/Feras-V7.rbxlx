  <Item class="ServerScriptService" referent="30">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="31">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">Biomes</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Decoração determinística; centro e entradas das pontes permanecem livres.
local Data = require(script.Parent.DataService)
local Progression = require(game:GetService("ReplicatedStorage").Shared.Progression)
local B = {}
local V = Vector3.new
function B.decorate(parent, origin, def)
	local folder = Instance.new("Folder")
	folder.Name = "Bioma_" .. def.id
	folder.Parent = parent
	local rng = Random.new(100 + def.idx)
	local function part(shape, size, pos, color, material, solid)
		local p = Instance.new("Part")
		p.Shape = shape
		p.Size = size
		p.Position = origin + pos
		p.Anchored = true
		p.CanCollide = solid == true
		p.CanTouch = false
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.Parent = folder
		return p
	end
	local function crystal(pos, color)
		local p = part(Enum.PartType.Block, V(1.8, 5, 1.8), pos, color, Enum.Material.Neon)
		p.CFrame *= CFrame.Angles(0.2, 0, 0.4)
	end
	for i = 1, 10 do
		local angle = i * math.pi * 2 / 10 + rng:NextNumber(-0.1, 0.1)
		local radius = rng:NextNumber(27, 31)
		local pos = V(math.cos(angle) * radius, 4, math.sin(angle) * radius)
		if def.id == "Brasa" then
			part(Enum.PartType.Ball, V(7, 6, 7), pos + V(0, 1, 0), Color3.fromRGB(40, 35, 40), Enum.Material.Basalt)
			crystal(pos + V(0, 4, 0), def.accent)
		elseif def.id == "Recife" then
			for j = 1, 3 do
				local coral = part(
					Enum.PartType.Cylinder,
					V(4, 0.7, 0.7),
					pos + V(j - 2, 2 + j * 0.4, 0),
					j % 2 == 0 and def.accent or Color3.fromRGB(240, 145, 180)
				)
				coral.CFrame *= CFrame.Angles(0, 0, math.pi / 2 + (j - 2) * 0.3)
			end
			crystal(pos + V(0, 5, 0), def.accent)
		elseif def.id == "Alvorecer" or def.id == "Floresta" or def.id == "Pantano" then
			local shadow = def.id == "Pantano"
			local trunk = part(
				Enum.PartType.Cylinder,
				V(10, 2, 2),
				pos + V(0, 5, 0),
				Color3.fromRGB(80, 57, 55),
				Enum.Material.Wood
			)
			trunk.CFrame *= CFrame.Angles(0, 0, math.pi / 2 + (shadow and 0.25 or 0))
			part(
				Enum.PartType.Ball,
				V(9, 7, 8),
				pos + V(1, 11, 0),
				shadow and Color3.fromRGB(60, 43, 82) or Color3.fromRGB(52, 120, 77),
				Enum.Material.Grass
			)
			part(Enum.PartType.Ball, V(2, 1, 2), pos + V(3, 1, 2), def.accent, Enum.Material.Neon)
		elseif def.id == "Dunas" then
			local pillar =
				part(Enum.PartType.Cylinder, V(7, 3, 3), pos + V(0, 3.5, 0), def.accent, Enum.Material.Sandstone)
			pillar.CFrame *= CFrame.Angles(0, 0, math.pi / 2 + 0.1)
			part(Enum.PartType.Block, V(5, 1, 4), pos + V(0, 7, 0), def.ground, Enum.Material.Sandstone)
		else
			part(Enum.PartType.Ball, V(10, 3, 7), pos + V(0, 5, 0), Color3.fromRGB(235, 243, 255))
			crystal(pos + V(0, 8, 0), def.accent)
		end
	end
	-- Marco maior por ilha: composição ao fundo, sem bloquear o centro ou as pontes.
	if def.id == "Brasa" then
		part(Enum.PartType.Ball, V(16, 14, 16), V(0, 7, -27), Color3.fromRGB(46, 35, 39), Enum.Material.Basalt)
		part(Enum.PartType.Cylinder, V(0.5, 8, 8), V(0, 13, -27), def.accent, Enum.Material.Neon).CFrame *= CFrame.Angles(
			0,
			0,
			math.pi / 2
		)
	elseif def.id == "Recife" then
		part(Enum.PartType.Ball, V(13, 9, 10), V(0, 8, -28), def.ground, Enum.Material.Slate)
		local fall = part(Enum.PartType.Block, V(5, 8, 0.3), V(0, 8, -22.9), def.accent, Enum.Material.Glass)
		fall.Transparency = 0.35
	elseif def.id == "Floresta" or def.id == "Alvorecer" then
		local tree =
			part(Enum.PartType.Cylinder, V(18, 4, 4), V(0, 13, -26), Color3.fromRGB(83, 62, 45), Enum.Material.Wood)
		tree.CFrame *= CFrame.Angles(0, 0, math.pi / 2)
		part(Enum.PartType.Ball, V(19, 10, 16), V(0, 23, -26), Color3.fromRGB(67, 143, 96), Enum.Material.Grass)
	elseif def.id == "Dunas" or def.id == "Pantano" then
		for _, side in { -1, 1 } do
			part(Enum.PartType.Block, V(3, 12, 3), V(side * 6, 10, -25), def.ground, Enum.Material.Slate)
		end
		part(Enum.PartType.Block, V(16, 3, 4), V(0, 16, -25), def.accent, Enum.Material.Slate)
		if def.id == "Pantano" then
			local portal = part(Enum.PartType.Ball, V(7, 9, 0.3), V(0, 9, -25), def.accent, Enum.Material.Neon)
			portal.Transparency = 0.45
		end
	else
		for _, side in { -1, 1 } do
			crystal(V(side * 7, 12, -26), def.accent)
		end
		part(Enum.PartType.Ball, V(22, 4, 14), V(0, 16, -26), Color3.fromRGB(236, 243, 255))
	end
	-- Marco de exploração e caminho radial: tudo abaixo dos pés ou sem colisão.
	local _path = part(
		Enum.PartType.Block,
		V(8, 0.15, 58),
		V(0, 4.1, 0),
		def.ground:Lerp(Color3.new(1, 1, 1), 0.2),
		Enum.Material.Cobblestone
	)
	local stone = part(Enum.PartType.Ball, V(7, 3, 7), V(24, 5, 0), def.ground, Enum.Material.Slate)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Conhecer bioma"
	prompt.ObjectText = def.name .. " • " .. def.desc
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.Parent = stone
	prompt.Triggered:Connect(function(player)
		local ch = player.Character
		local root = ch and ch:FindFirstChild("HumanoidRootPart")
		local data = Data.get(player)
		if not data or not root or (root.Position - stone.Position).Magnitude >= 16 or not data.unlocked[def.id] then
			return
		end
		if not require(script.Parent.RegionService).requireCurrent(player, def.id, "encounter").ok then
			return
		end
		if require(script.Parent.EncounterService).active(player) then
			return
		end
		local notice = game:GetService("ReplicatedStorage"):FindFirstChild("WildNotice")
		if (data.gatherAt[def.id] or 0) > os.time() then
			if notice then
				notice:FireClient(player, "Este ponto se recupera em " .. (data.gatherAt[def.id] - os.time()) .. "s")
			end
			return
		end
		data.gatherAt[def.id] = os.time() + 120
		data.materials[def.el] = math.min(10000, (data.materials[def.el] or 0) + 1)
		if not data.visited[def.id] then
			data.visited[def.id] = true
			data.gold += 30
			data.stats.explore = (data.stats.explore or 0) + 1
			Progression.award(data, 60)
		end
		player:SetAttribute("BiomaVisitado", def.id)
		if notice then
			notice:FireClient(player, "Descoberta em " .. def.name .. " • +1 essência de " .. def.el)
		end
	end)
end
return B
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">CompanionService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Data = require(script.Parent.DataService)
local S = {}
function S.sync(player)
	local d = Data.get(player)
	local pet = d and d.companion and d.creatures[d.companion]
	player:SetAttribute("CompanionSpecies", pet and pet.id or nil)
	player:SetAttribute("CompanionLevel", pet and pet.lv or nil)
	player:SetAttribute("CompanionUid", pet and d.companion or nil)
end
return S
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">CreatureGallery</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Ferramenta explícita de revisão; nunca construída em servidor publicado.
local Run = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")
local C = require(RS.Shared.Creatures)
local Factory = require(RS.Shared.ModelFactory)
local Gallery = {}
function Gallery.build()
	assert(Run:IsStudio(), "A galeria só funciona no Studio")
	local previous = workspace:FindFirstChild("GaleriaV7")
	if previous then
		previous:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "GaleriaV7"
	folder.Parent = workspace
	local function display(def, lv, index)
		local point = Vector3.new((index - 1) % 9 * 28, 110, math.floor((index - 1) / 9) * 28)
		local stand = Instance.new("Part")
		stand.Size = Vector3.new(22, 1, 22)
		stand.Position = point
		stand.Anchored = true
		stand.Color = Color3.fromRGB(40, 49, 59)
		stand.Parent = folder
		local model
		local function replace(level)
			if model then
				model:Destroy()
			end
			model = Factory.build(def, level, { preview = true })
			local cf, size = model:GetBoundingBox()
			local lift = model:GetPivot().Position.Y - (cf.Position.Y - size.Y / 2)
			model:PivotTo(CFrame.new(point + Vector3.new(0, lift + 0.5, 0)))
			model:SetAttribute("Gallery", true)
			model.Parent = folder
		end
		replace(lv)
		local label = Instance.new("BillboardGui")
		label.Size = UDim2.fromOffset(210, 54)
		label.StudsOffset = Vector3.new(0, 10, 0)
		label.MaxDistance = 160
		label.Parent = stand
		local text = Instance.new("TextLabel")
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.Text = def.name .. " · Nv." .. lv .. " · estágio " .. C.stage(lv, def.id)
		text.TextColor3 = Color3.new(1, 1, 1)
		text.TextSize = 15
		text.Font = Enum.Font.GothamBold
		text.Parent = label
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Alternar estágio"
		prompt.ObjectText = def.name
		prompt.MaxActivationDistance = 14
		prompt.Parent = stand
		local choice = table.find({ 1, 7, 15 }, lv) or 3
		prompt.Triggered:Connect(function()
			choice = choice % 3 + 1
			local level = ({ 1, 7, 15 })[choice]
			replace(level)
			text.Text = def.name .. " · Nv." .. level .. " · estágio " .. C.stage(level, def.id)
		end)
	end
	local index = 0
	for _, def in C.List do
		for _, lv in { 1, 7, 15 } do
			index += 1
			display(def, lv, index)
		end
	end
	display(C.ById.fenix, 60, 91)
	return folder
end
return Gallery
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local DSS = game:GetService("DataStoreService")
local RS = game:GetService("ReplicatedStorage")
local C = require(RS.Shared.Creatures)
local I = require(RS.Shared.Islands)
local M = require(RS.Shared.Missions)
local SR = require(RS.Shared.SanctuaryRules)
local Story = require(RS.Shared.Story)
local Migration = require(RS.Shared.Migration)
local Quest = require(RS.Shared.PhoenixQuest)
local Access = require(RS.Shared.Access)
local Grant = require(RS.Shared.CreatureGrant)
local CaptureRules = require(RS.Shared.CaptureRules)
local store = DSS:GetDataStore("ArquipelagoV1")
local D = {}
local profiles = {}
local VERSION = require(RS.Shared.Config).ProfileVersion
local sessions = {}
local Http = game:GetService("HttpService")
local LEASE = 180
local function clone(t)
	local out = {}
	for k, v in t do
		out[k] = typeof(v) == "table" and clone(v) or v
	end
	return out
end
local function default()
	local result = {
		v = VERSION,
		gold = 100,
		gems = 5,
		seals = 5,
		playerLevel = 1,
		playerXp = 0,
		sealStock = {},
		companion = nil,
		storyClaimed = {},
		guardians = {},
		visited = {},
		materials = {},
		gatherAt = {},
		sanctuary = { Alvorecer = { slot = 5, level = 1 } },
		nextId = 1,
		last = os.time(),
		wins = 0,
		creatures = {},
		eggs = {},
		stats = {},
		claimed = {},
		pass = {},
		receipts = {},
		dailyDay = 0,
		streak = 0,
		trophies = 0,
		tut = false,
		habitat = { Alvorecer = { "u1", "u2" } },
		unlocked = { Alvorecer = true },
		legacyGrandfathered = {},
		grants = {},
		phoenix = { glyphs = {}, sanctuaryOpen = false, attempts = 0, nextAttemptAt = 0, captured = false },
		legacyEggPermits = {},
		discovered = {},
	}
	assert(Grant.grant(result, "brotinho", "starter", "starter:1"))
	assert(Grant.grant(result, "folhuco", "starter", "starter:2"))
	return result
end
-- Registro corrompido é recusado. Nunca substituir um perfil real por padrões.
function D.validate(raw)
	if raw ~= nil then
		local migrated, reason = Migration.run(raw)
		assert(migrated, reason)
		raw = migrated
	end
	local d = default()
	if raw == nil then
		return d
	end
	local seeds = d
	d = clone(raw)
	for key, value in seeds do
		if d[key] == nil then
			d[key] = value
		end
	end
	local function num(x, f, _mx)
		return (typeof(x) == "number" and x == x and x >= 0 and x < math.huge) and math.floor(x) or f
	end
	d.seals = num(raw.seals, 5, 10000)
	d.sealStock = {}
	for kind in CaptureRules.Seals do
		if kind ~= "Basic" and typeof(raw.sealStock) == "table" then
			d.sealStock[kind] = num(raw.sealStock[kind], 0, 10000)
		end
	end
	d.gold = num(raw.gold, d.gold, 1e12)
	d.gems = num(raw.gems, d.gems, 1e9)
	d.wins = num(raw.wins, 0, 1e9)
	d.nextId = num(raw.nextId, d.nextId, 1e9)
	d.legacyGrandfathered = Migration.clone(raw.legacyGrandfathered or {})
	d.grants = Migration.clone(raw.grants or {})
	d.legacyEggPermits = Migration.clone(raw.legacyEggPermits or {})
	d.phoenix = Migration.clone(raw.phoenix or d.phoenix)
	d.last = math.min(num(raw.last, os.time(), 1e12), os.time())
	local cr, n = {}, 0
	for uid, c in raw.creatures do
		if typeof(uid) == "string" and typeof(c) == "table" and C.ById[c.id] then
			cr[uid] = { id = c.id, lv = math.max(num(c.lv, 1, 100), 1), xp = num(c.xp, 0, 1e9) }
			n += 1
		end
	end
	assert(n > 0, "CORRUPT_PROFILE")
	for uid in cr do
		local uidNumber = tonumber(string.match(uid, "^u(%d+)$"))
		if uidNumber then
			d.nextId = math.max(d.nextId, uidNumber + 1)
		end
	end
	d.creatures = cr
	d.discovered = {}
	for _, c in cr do
		d.discovered[c.id] = true
	end
	if typeof(raw.discovered) == "table" then
		for id in raw.discovered do
			if C.ById[id] then
				d.discovered[id] = true
			end
		end
	end
	d.unlocked = clone(raw.unlocked or {})
	d.unlocked.Alvorecer = true
	if typeof(raw.unlocked) == "table" then
		for id in I.ById do
			if raw.unlocked[id] == true then
				d.unlocked[id] = true
			end
		end
	end
	d.playerLevel = math.max(num(raw.playerLevel, 1, 100), 1)
	d.playerXp = num(raw.playerXp, 0, 1e9)
	d.companion = typeof(raw.companion) == "string" and cr[raw.companion] and raw.companion or nil
	d.guardians = {}
	d.visited = {}
	d.materials = {}
	d.gatherAt = {}
	for _, def in I.List do
		if typeof(raw.guardians) == "table" and raw.guardians[def.id] == true then
			d.guardians[def.id] = true
		end
		if typeof(raw.visited) == "table" and raw.visited[def.id] == true then
			d.visited[def.id] = true
		end
		if typeof(raw.gatherAt) == "table" then
			d.gatherAt[def.id] = num(raw.gatherAt[def.id], 0, 1e12)
		end
		if typeof(raw.materials) == "table" then
			d.materials[def.el] = num(raw.materials[def.el], 0, 10000)
		end
	end
	d.storyClaimed = clone(raw.storyClaimed or {})
	if typeof(raw.storyClaimed) == "table" then
		for id, claimed in raw.storyClaimed do
			if claimed == true and Story.ById[id] then
				d.storyClaimed[id] = true
			end
		end
	end
	if typeof(raw.sanctuary) == "table" then
		d.sanctuary = clone(raw.sanctuary)
	else -- Migração: habitats legados recebem posição própria; nenhuma criatura é removida.
		d.sanctuary = {}
		local slot = 0
		for _, def in I.List do
			if d.unlocked[def.id] then
				slot += 1
				d.sanctuary[def.id] = { slot = slot, level = 1 }
			end
		end
	end
	d.habitat = {}
	local seen = {}
	if typeof(raw.habitat) == "table" then
		for isl, list in raw.habitat do
			local def = I.ById[isl]
			if def and d.unlocked[isl] and typeof(list) == "table" then
				d.habitat[isl] = {}
				for _, uid in list do
					if typeof(uid) == "string" and cr[uid] and not seen[uid] then
						seen[uid] = true
						table.insert(d.habitat[isl], uid)
					end
				end
			end
		end
	end
	for id, list in d.habitat do
		if #list > 0 and not d.sanctuary[id] then
			for slot = 1, 9 do
				if SR.available(d.sanctuary, slot) then
					d.sanctuary[id] = { slot = slot, level = 1 }
					break
				end
			end
		end
	end
	d.stats = {}
	d.claimed = clone(raw.claimed or {})
	if typeof(raw.stats) == "table" then
		for k, v in raw.stats do
			if typeof(k) == "string" then
				d.stats[k] = num(v, 0, 1e9)
			end
		end
	end
	if typeof(raw.claimed) == "table" then
		for id, value in raw.claimed do
			if value == true and M.ById[id] then
				d.claimed[id] = true
			end
		end
	end
	d.trophies = num(raw.trophies, 0, 1e9)
	d.tut = raw.tut == true
	d.receipts = {}
	d.pass = {}
	d.dailyDay = math.min(num(raw.dailyDay, 0, 1e9), os.time() // 86400)
	d.streak = num(raw.streak, 0, 1e6)
	if typeof(raw.receipts) == "table" then
		for k, value in raw.receipts do
			if value == true and typeof(k) == "string" then
				d.receipts[k] = true
			end
		end
	end
	d.eggs = {}
	if typeof(raw.eggs) == "table" then
		for _, e in raw.eggs do
			if
				typeof(e) == "table"
				and C.ById[e.id]
				and typeof(e.ready) == "number"
				and e.ready == e.ready
				and e.ready >= 0
				and e.ready < 1e12
			then
				table.insert(
					d.eggs,
					{ id = e.id, ready = math.floor(e.ready), nonce = e.nonce, region = e.region or "Alvorecer" }
				)
			end
		end
	end
	return d
end
-- Lease gravado atomicamente no MESMO registro legado (sem trocar a chave).
function D.load(p)
	local token = Http:GenerateGUID(false)
	local raw, ok
	for attempt = 1, 3 do
		ok, raw = pcall(function()
			return store:UpdateAsync("P" .. p.UserId, function(old)
				if
					old ~= nil
					and (typeof(old) ~= "table" or typeof(old.creatures) ~= "table" or (old.v or 1) > VERSION)
				then
					error(Text.PERFIL_INVALIDO_OU_VERSAO_FUTURA_RECUPERACAO_MAN_C36F9F)
				end
				local lock = old and old._session
				if lock and typeof(lock) ~= "table" then
					error(Text.LEASE_INVALIDO_1F2C7F)
				end
				if lock and lock.token ~= token and (lock.expires or 0) > os.time() then
					return nil
				end
				local migrated
				if old ~= nil then
					local reason
					migrated, reason = Migration.run(old)
					if not migrated then
						error(reason)
					end
				end
				local data = old == nil and default() or D.validate(migrated)
				data._session = { token = token, expires = os.time() + LEASE }
				return data
			end)
		end)
		if ok then
			break
		end
		task.wait(attempt)
	end
	if not ok or not raw then
		p:Kick(Text.DADOS_INDISPONIVEIS_OU_SESSAO_AINDA_ATIVA_AGUARD_97BBDC)
		return false
	end
	profiles[p] = D.validate(raw)
	-- Uma sessão recuperada nunca retoma um encontro do processo anterior.
	profiles[p].phoenix.encounterId = nil
	sessions[p] =
		{ token = token, expires = raw._session.expires, busy = false, region = "Alvorecer", lastSafe = "Alvorecer" }
	return true
end
function D.session(p)
	return sessions[p]
end
function D.get(p)
	local session = sessions[p]
	if not session or session.expires <= os.time() or session.closing then
		return nil
	end
	return profiles[p]
end
function D.snapshot(p)
	local d = clone(profiles[p])
	d.receipts = nil
	d.grants = nil
	d.legacyEggPermits = nil
	d.phoenix = nil
	d.quest = Quest.public(profiles[p])
	d.region = sessions[p] and sessions[p].region or "Alvorecer"
	d.access = {}
	for _, island in I.List do
		local check = Access.check(profiles[p], island.id, "travel")
		local unlock = Access.check(profiles[p], island.id, "unlock")
		d.access[island.id] = { ok = check.ok, reason = check.reason, unlockReason = unlock.reason }
	end
	for _, e in d.eggs do
		e.left = math.max(0, e.ready - os.time())
	end
	local el, left = M.event(os.time())
	d.event = { el = el, left = left }
	return d
end
function D.save(p, release)
	local session = sessions[p]
	local d = profiles[p]
	if not session or not d then
		return false
	end
	while session.busy do
		task.wait()
	end
	if sessions[p] ~= session then
		return false
	end
	session.busy = true
	local payload = clone(d)
	payload.pass = nil
	payload.event = nil
	for _, egg in payload.eggs do
		egg.left = nil
	end
	local expiry = os.time() + LEASE
	payload._session = not release and { token = session.token, expires = expiry } or nil
	local ok, result = pcall(function()
		return store:UpdateAsync("P" .. p.UserId, function(old)
			if not old or not old._session or old._session.token ~= session.token then
				return nil
			end
			return payload
		end)
	end)
	session.busy = false
	if ok and result then
		session.expires = expiry
		return true
	end
	warn(Text.FALHA_AO_SALVAR_PERFIL_DE_B99672 .. p.Name)
	if ok or os.time() >= session.expires then
		session.closing = true
		p:Kick(Text.SESSAO_DE_DADOS_ENCERRADA_RECONECTE_PARA_PROTEGE_C94A14)
	end
	return false
end
function D.release(p)
	local session = sessions[p]
	if not session then
		return
	end
	session.closing = true
	for _ = 1, 3 do
		if D.save(p, true) then
			break
		end
		task.wait(1)
	end
	profiles[p] = nil
	sessions[p] = nil
end
function D.saveAll()
	for p in profiles do
		D.save(p)
	end
end
function D.closeAll()
	local pending = 0
	for p in profiles do
		pending += 1
		task.spawn(function()
			D.release(p)
			pending -= 1
		end)
	end
	local deadline = os.clock() + 25
	while pending > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
end
return D
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">EncounterService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Http = game:GetService("HttpService")
local Data = require(script.Parent.DataService)
local C = require(RS.Shared.Creatures)
local Rules = require(RS.Shared.CombatRules)
local CaptureRules = require(RS.Shared.CaptureRules)
local Progression = require(RS.Shared.Progression)
local Grant = require(RS.Shared.CreatureGrant)
local Quest = require(RS.Shared.PhoenixQuest)
local Config = require(RS.Shared.Config)
local Region = require(script.Parent.RegionService)
local Species = require(RS.Shared.SpeciesRules)
local E = {}
local opening = {}
local sessions = {}
local rng = Random.new()
local net
local events
local function snapshot(session, message)
	local s = session.state
	local party = {}
	for uid, p in s.party do
		party[uid] = { id = p.id, lv = p.lv, hp = p.hp, maxHp = p.maxHp, nextSkill = p.nextSkill }
	end
	return {
		token = session.token,
		seals = session.seals,
		sealType = session.sealType or "Basic",
		sealStock = session.sealStock or {},
		version = s.version,
		status = s.status,
		capturable = s.capturable ~= false,
		turn = s.turn,
		foe = s.foe,
		party = party,
		active = s.active,
		bond = s.bond,
		chance = Rules.chance(s),
		log = s.log,
		message = message,
		expires = session.expires,
		intro = session.special and "phoenix" or nil,
	}
end
local function finish(player, session)
	if session.released then
		return
	end
	session.released = true
	local d = Data.get(player)
	local s = session.state
	if d and s.status == "captured" then
		local origin = session.special and "phoenix_sanctuary" or "wild_capture"
		local uid, reason = Grant.grant(d, s.foe.id, origin, session.token, { level = s.foe.lv })
		if uid then
			d.stats.capture = (d.stats.capture or 0) + 1
			local pet = s.active and d.creatures[s.active]
			local reward =
				Progression.rewards(session.region, s.foe.lv, C.ById[s.foe.id].rar, pet and pet.lv or s.foe.lv)
			Progression.award(d, math.floor(reward.xp * 0.6))
		else
			s.status = "escaped"
			table.insert(s.log, { text = Text.CONCESSAO_RECUSADA_951368 .. reason, kind = "error" })
		end
	elseif d and s.status == "won" then
		local def = C.ById[s.foe.id]
		local teamLevel = 0
		for uid in s.party do
			local pet = d.creatures[uid]
			if pet then
				teamLevel = math.max(teamLevel, pet.lv)
			end
		end
		local reward = Progression.rewards(session.region, s.foe.lv, def.rar, teamLevel)
		d.gold += reward.gold
		d.wins += 1
		d.stats.win = (d.stats.win or 0) + 1
		Progression.award(d, reward.xp)
		local pet = d.creatures[s.active]
		if pet then
			Progression.awardCreature(pet, reward.creatureXp)
			local refreshed, err = pcall(require(script.Parent.World).refresh, player)
			if not refreshed then
				warn(Text.MODELO_SERA_RECONSTRUIDO_NA_PROXIMA_ATUALIZACAO_BF3624 .. tostring(err))
			end
		end
		table.insert(s.log, {
			text = "Recompensa: "
				.. reward.gold
				.. " ouro · "
				.. reward.xp
				.. " XP · "
				.. reward.creatureXp
				.. Text.XP_DA_FERA_1A37A2,
			kind = "reward",
		})
	end
	if d and s.status == "won" and session.guardian and not d.guardians[session.guardian] then
		d.guardians[session.guardian] = true
		d.stats.guardian = (d.stats.guardian or 0) + 1
		d.gold += 100
		Progression.award(d, 200)
	end
	if session.special and d then
		d.phoenix.encounterId = nil
		d.phoenix.nextAttemptAt = math.max(d.phoenix.nextAttemptAt or 0, os.time() + Config.PhoenixRetrySeconds)
		local saved = Data.save(player)
		if not saved then
			table.insert(s.log, { text = Text.SALVAMENTO_PENDENTE_AGUARDE_ANTES_DE_SAIR_5F0A13, kind = "error" })
		end
	end
	session.release(s.status == "captured" or s.status == "won")
end
function E.open(player, specimen, release)
	local d = Data.get(player)
	if not d then
		return false
	end
	if opening[player] and not specimen.special then
		return false
	end
	if not specimen.special and not Species.isGeneral(specimen.id) then
		return false
	end
	local region = specimen.region or Region.current(player, "encounter")
	if not Region.requireCurrent(player, region, "encounter").ok then
		return false
	end
	local old = sessions[player]
	if old and old.state.status == "active" then
		return false
	end
	local session = {
		token = specimen.nonce or Http:GenerateGUID(false),
		region = region,
		special = specimen.special == true,
		state = Rules.new(
			specimen.id,
			specimen.lv,
			{ statMultiplier = specimen.statMultiplier, isLegendary = specimen.special }
		),
		guardian = specimen.guardianId,
		seals = d.seals,
		origin = specimen.position,
		expires = os.time() + 150,
		release = release,
	}
	session.state.capturable = specimen.capturable ~= false
	session.state.isLegendary = session.special
	session.state.captureBase = specimen.captureBase
	session.sealType = "Basic"
	session.sealStock = d.sealStock or {}
	d.stats.fight = (d.stats.fight or 0) + 1
	sessions[player] = session
	events:FireClient(player, snapshot(session))
	return true
end
function E.startSpecial(player, id)
	if id ~= "phoenix_solar" or E.active(player) then
		return false, "ACTIVE_OR_INVALID"
	end
	local d = Data.get(player)
	local ok, reason = Quest.check(d or {}, os.time())
	if not ok then
		return false, reason
	end
	if not Region.requireCurrent(player, "Dunas", "encounter").ok then
		return false, "WRONG_REGION"
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local altar = require(script.Parent.SanctuaryBuilder).altarPosition()
	if not root or (root.Position - altar).Magnitude > 15 then
		return false, "DISTANCE"
	end
	opening[player] = true
	local nonce = Http:GenerateGUID(false)
	d.phoenix.encounterId = nonce
	d.phoenix.attempts += 1
	d.phoenix.nextAttemptAt = os.time() + Config.PhoenixRetrySeconds
	local saved = Data.save(player)
	if not saved or not Data.get(player) then
		d.phoenix.encounterId = nil
		opening[player] = nil
		return false, "SAVE_FAILED"
	end
	local opened = E.open(player, {
		id = Species.SpecialId,
		lv = 60,
		region = "Dunas",
		position = altar,
		special = true,
		nonce = nonce,
		captureBase = 0.04,
		statMultiplier = 1.3,
	}, function()
		player:SetAttribute("SolarEncounterEnded", os.time())
	end)
	opening[player] = nil
	if not opened then
		d.phoenix.encounterId = nil
	end
	return opened, opened and "OK" or "INTERRUPTED"
end
function E.active(player)
	if opening[player] then
		return true
	end
	local s = sessions[player]
	return s and s.state.status == "active"
end
function E.start()
	net = Instance.new("RemoteFunction")
	net.Name = "EncounterNet"
	net.Parent = RS
	events = Instance.new("RemoteEvent")
	events.Name = "EncounterNotice"
	events.Parent = RS
	net.OnServerInvoke = function(player, token, version, action, uid)
		local session = sessions[player]
		local d = Data.get(player)
		if not session or not d then
			return nil
		end
		-- Recuperação da própria sessão caso o evento inicial chegue antes da UI.
		if action == "Resume" then
			if session.readAt and os.clock() - session.readAt < 0.1 then
				return nil
			end
			session.readAt = os.clock()
			return snapshot(session)
		end
		if typeof(token) ~= "string" or #token > 80 or token ~= session.token then
			return nil
		end
		if typeof(action) ~= "string" or #action > 16 or (uid ~= nil and (typeof(uid) ~= "string" or #uid > 40)) then
			return snapshot(session, Text.PEDIDO_INVALIDO_C2C28F)
		end
		if action == "State" then
			if session.readAt and os.clock() - session.readAt < 0.1 then
				return nil
			end
			session.readAt = os.clock()
			return snapshot(session)
		end
		if session.state.status ~= "active" then
			return snapshot(session)
		end
		if not Region.requireCurrent(player, session.region, action == "Capture" and "capture" or "battle").ok then
			session.state.status = "escaped"
			finish(player, session)
			return snapshot(session, "REGION_ACCESS_DENIED")
		end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if
			os.time() >= session.expires
			or not root
			or not humanoid
			or humanoid.Health <= 0
			or (root.Position - session.origin).Magnitude > 40
		then
			session.state.status = "escaped"
			finish(player, session)
			return snapshot(session, Text.O_ENCONTRO_ENCERROU_DISTANCIA_TEMPO_OU_PERSONAGE_9012D6)
		end
		if typeof(version) ~= "number" or version ~= session.state.version then
			return snapshot(session, Text.ESTADO_ATUALIZADO_ESCOLHA_NOVAMENTE_CD8857)
		end
		if session.last and os.clock() - session.last < 0.25 then
			return snapshot(session, Text.AGUARDE_O_TURNO_25CBEF)
		end
		session.last = os.clock()
		if action == "ChooseSeal" then
			local seal = CaptureRules.Seals[uid]
			if not seal then
				return snapshot(session, Text.SELO_INVALIDO_51B2D9)
			end
			session.sealType = uid
			session.state.sealKind = uid
			session.state.version += 1
			session.state.log = {}
			session.seals = uid == "Basic" and d.seals or (d.sealStock or {})[uid] or 0
			return snapshot(session)
		end
		local pet = uid and d.creatures[uid]
		local count = 0
		for _ in d.creatures do
			count += 1
		end
		local ok, message = Rules.step(
			session.state,
			action,
			pet and { uid = uid, id = pet.id, lv = pet.lv },
			rng,
			session.seals,
			count < 60
		)
		if not ok then
			return snapshot(session, message)
		end
		if session.state.spentSeal then
			if session.sealType == "Basic" then
				d.seals -= 1
			else
				d.sealStock[session.sealType] -= 1
			end
		end
		session.seals = session.sealType == "Basic" and d.seals or (d.sealStock or {})[session.sealType] or 0
		if session.special and session.state.status == "active" then
			local stock = d.seals
			for _, n in d.sealStock or {} do
				stock += n
			end
			if stock <= 0 and action == "Capture" then
				session.state.status = "escaped"
				table.insert(
					session.state.log,
					{ text = Text.OS_SELOS_SE_ESGOTARAM_A_CHAMA_REPOUSARA_POR_VINT_B19B32, kind = "info" }
				)
			end
		end
		if session.state.status ~= "active" then
			finish(player, session)
		end
		return snapshot(session)
	end
	Players.PlayerRemoving:Connect(function(player)
		local s = sessions[player]
		if s then
			s.state.status = "escaped"
			finish(player, s)
		end
		sessions[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(2)
			for player, s in sessions do
				if s.state.status == "active" and (os.time() >= s.expires or not Data.get(player)) then
					s.state.status = "escaped"
					finish(player, s)
					events:FireClient(player, snapshot(s, Text.O_ENCONTRO_TERMINOU_6F159C))
				end
			end
		end
	end)
end
return E
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">GameService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local C = require(RS.Shared.Creatures)
local I = require(RS.Shared.Islands)
local B = require(RS.Shared.Breeding)
local Access = require(RS.Shared.Access)
local Grant = require(RS.Shared.CreatureGrant)
local Pools = require(RS.Shared.EncounterPools)
local Region = require(script.Parent.RegionService)
local Http = game:GetService("HttpService")
local M = require(RS.Shared.Missions)
local SR = require(RS.Shared.SanctuaryRules)
local CaptureRules = require(RS.Shared.CaptureRules)
local Story = require(RS.Shared.Story)
local Progression = require(RS.Shared.Progression)
local Combat = require(RS.Shared.CombatRules)
local Transport = require(script.Parent.Transport)
local Sanctuary = require(script.Parent.SanctuaryService)
local Data = require(script.Parent.DataService)
local World = require(script.Parent.World)
local G = {}
local rng = Random.new()
local Mon = require(script.Parent.MonetizationService)
local lastBattle = setmetatable({}, { __mode = "k" })
local Balance = require(RS.Shared.Economy)
local MAXLV, OFFLINE_CAP, BREED_COST = Balance.MaxLevel, Balance.OfflineCap, Balance.BreedCost
local function lvMul(lv)
	return 1 + 0.15 * (lv - 1)
end
local function bump(d, k)
	d.stats[k] = (d.stats[k] or 0) + 1
end
local function fail(m)
	return { ok = false, msg = m }
end
local function ok(p, m)
	return { ok = true, msg = m, data = Data.snapshot(p) }
end
-- Renda por tempo REAL do servidor (os.time), limitada a 8 h: alterar o relógio do cliente não adianta.
local function settle(p)
	local d = Data.get(p)
	local now = os.time()
	local mins = math.clamp(now - d.last, 0, OFFLINE_CAP) / 60
	local gold = 0
	local EV = M.event(now)
	for isl, list in d.habitat do
		for _, uid in list do
			local cr = d.creatures[uid]
			if cr then
				local cd = C.ById[cr.id]
				gold += cd.gpm * lvMul(cr.lv) * (cd.el == I.ById[isl].el and 1.5 or 1) * (cd.el == EV and 1.5 or 1) * (d.pass.Dobro and 2 or 1) * mins
			end
		end
	end
	gold = math.floor(gold)
	d.gold += gold
	d.last = now
	return gold
end
G.Actions = {}
local A = G.Actions
function A.Home(p)
	if not Sanctuary.home(p) then
		return fail(Text.PERSONAGEM_OU_DESTINO_INDISPONIVEL_AGUARDE_E_TEN_09997D)
	end
	return ok(p, Text.BEM_VINDO_AO_SEU_SANTUARIO_161FE8)
end
function A.Travel(p, id)
	local d = Data.get(p)
	local def = I.ById[id]
	if not Access.check(d, id, "travel").ok then
		return fail(Text.ACESSO_NEGADO_AB7F08)
	end
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if not def or not d.unlocked[id] or not root then
		return fail(Text.DESTINO_INDISPONIVEL_06B531)
	end
	if not Transport.go(p, I.pos(def.idx) + Vector3.new(0, 9, 24), id) then
		return fail(Text.DESTINO_AINDA_NAO_CARREGOU_TENTE_NOVAMENTE_005D89)
	end
	return ok(p, Text.CHEGOU_A_FAE834 .. def.name)
end
function A.Companion(p, uid)
	local d = Data.get(p)
	if uid ~= nil and not d.creatures[uid] then
		return fail(Text.ESCOLHA_UMA_FERA_SUA_E1857C)
	end
	if d.companion == uid then
		d.companion = nil
	else
		d.companion = uid
	end
	World.refresh(p)
	return ok(p, d.companion and Text.COMPANHEIRO_ESCOLHIDO_411FF1 or Text.COMPANHEIRO_GUARDADO_027BB3)
end
function A.Pet(p)
	local d = Data.get(p)
	if not d.companion then
		return fail(Text.ESCOLHA_UM_COMPANHEIRO_FBC455)
	end
	p:SetAttribute("PetHappyUntil", workspace:GetServerTimeNow() + 2)
	return ok(p, Text.SEU_COMPANHEIRO_GOSTOU_DO_CARINHO_C1382F)
end
function A.BuildHabitat(p, id, slot)
	local d = Data.get(p)
	local def = I.ById[id]
	if not Access.check(d, id, "habitat").ok or not def or d.sanctuary[id] or not SR.available(d.sanctuary, slot) then
		return fail(Text.HABITAT_POSICAO_OU_DESBLOQUEIO_INVALIDO_CC4AAD)
	end
	local cost = SR.buildCost(def)
	if d.gold < cost then
		return fail(Text.PRECISA_DE_3C22C8 .. cost .. " ouro")
	end
	d.gold -= cost
	d.sanctuary[id] = { slot = slot, level = 1 }
	bump(d, "habitatBuild")
	World.refresh(p)
	return ok(p, Text.HABITAT_CONSTRUIDO_NO_SEU_TERRENO_C7F40C)
end
function A.MoveHabitat(p, id, slot)
	local d = Data.get(p)
	if not Access.check(d, id, "habitat").ok then
		return fail(Text.ACESSO_NEGADO_AB7F08)
	end
	local entry = d.sanctuary[id]
	if not entry or not SR.available(d.sanctuary, slot, id) then
		return fail(Text.POSICAO_OCUPADA_OU_INVALIDA_5582C8)
	end
	entry.slot = slot
	World.refresh(p)
	return ok(p, Text.HABITAT_MOVIDO_2E232D)
end
function A.UpgradeHabitat(p, id)
	local d = Data.get(p)
	if not Access.check(d, id, "habitat").ok then
		return fail(Text.ACESSO_NEGADO_AB7F08)
	end
	local entry = d.sanctuary[id]
	if not entry or entry.level >= SR.MaxLevel then
		return fail(Text.HABITAT_INDISPONIVEL_OU_MAXIMO_989E00)
	end
	local cost = SR.upgradeCost(entry)
	if d.gold < cost then
		return fail(Text.PRECISA_DE_3C22C8 .. cost .. " ouro")
	end
	settle(p)
	d.gold -= cost
	entry.level += 1
	bump(d, "habitatUpgrade")
	World.refresh(p)
	return ok(p, Text.HABITAT_MELHORADO_MAIS_DUAS_VAGAS_C4EEBD)
end
function A.RemoveHabitat(p, id)
	local d = Data.get(p)
	if not Access.check(d, id, "habitat").ok then
		return fail(Text.ACESSO_NEGADO_AB7F08)
	end
	if not d.sanctuary[id] or #(d.habitat[id] or {}) > 0 then
		return fail(Text.TRANSFIRA_AS_FERAS_ANTES_DE_REMOVER_O_HABITAT_C629D5)
	end
	d.sanctuary[id] = nil
	World.refresh(p)
	return ok(p, Text.ESTRUTURA_REMOVIDA_SEM_REEMBOLSO_565589)
end
function A.ClaimStory(p, id)
	local d = Data.get(p)
	if not Story.canClaim(d, id) then
		return fail(Text.CONCLUA_O_CAPITULO_ATUAL_PRIMEIRO_3187C6)
	end
	local q = Story.ById[id]
	d.storyClaimed[id] = true
	d.gold += q.gold
	d.seals = math.min(10000, d.seals + q.seals)
	Progression.award(d, q.xp)
	return ok(
		p,
		Text.CAPITULO_CONCLUIDO_BF33C2 .. q.gold .. " ouro, +" .. q.xp .. Text.XP_E_5EFA95 .. q.seals .. " selos"
	)
end
function A.CraftSeal(p, kind)
	local d = Data.get(p)
	kind = kind or "Basic"
	local recipe = CaptureRules.Seals[kind]
	if not recipe then
		return fail(Text.TIPO_DE_SELO_INVALIDO_9B6D96)
	end
	local count = kind == "Basic" and d.seals or d.sealStock[kind] or 0
	if count >= 10000 or d.gold < recipe.cost or d.playerLevel < recipe.level then
		return fail(
			Text.PRECISA_DE_NIVEL_3806D7 .. recipe.level .. " e " .. recipe.cost .. Text.OURO_LIMITE_10_MIL_SELOS_71673A
		)
	end
	if recipe.material and (d.materials[recipe.material] or 0) < recipe.amount then
		return fail(Text.PRECISA_DE_3C22C8 .. recipe.amount .. Text.ESSENCIA_DE_0F286A .. recipe.material)
	end
	d.gold -= recipe.cost
	if recipe.material then
		d.materials[recipe.material] -= recipe.amount
	end
	if kind == "Basic" then
		d.seals += 1
	else
		d.sealStock[kind] = count + 1
	end
	return ok(p, "+1 Selo " .. recipe.name)
end
function A.Get(p)
	return ok(p)
end
function A.Collect(p)
	local g = settle(p)
	bump(Data.get(p), "collect")
	return ok(p, "+" .. g .. " ouro")
end
function A.Feed(p, uid)
	local d = Data.get(p)
	local cr = d.creatures[uid]
	if not cr then
		return fail(Text.CRIATURA_INVALIDA_3A9F3E)
	end
	if cr.lv >= MAXLV then
		return fail(Text.NIVEL_MAXIMO_8078AA)
	end
	settle(p)
	local cost = cr.lv * 20
	if d.gold < cost then
		return fail(Text.OURO_INSUFICIENTE_AF56CF .. cost .. ")")
	end
	d.gold -= cost
	cr.lv += 1
	bump(d, "feed")
	World.refresh(p)
	return ok(
		p,
		Text.SUBIU_PARA_O_NIVEL_0AB637
			.. cr.lv
			.. (C.stage(cr.lv, cr.id) > C.stage(cr.lv - 1, cr.id) and " — EVOLUIU!" or "")
	)
end
function A.Place(p, uid, isl)
	local d = Data.get(p)
	local def = I.ById[isl]
	if not d.creatures[uid] or not def or not Access.check(d, isl, "habitat").ok then
		return fail(Text.ILHA_OU_CRIATURA_INVALIDA_000968)
	end
	local structure = d.sanctuary[isl]
	if not structure then
		return fail(Text.CONSTRUA_ESSE_HABITAT_NO_SANTUARIO_6A9DF1)
	end
	local creature = C.ById[d.creatures[uid].id]
	if creature.el ~= def.el and not (creature.hybrid and table.find(creature.hybrid, def.el)) then
		return fail(Text.ELEMENTO_INCOMPATIVEL_COM_ESTE_HABITAT_30076C)
	end
	local list = d.habitat[isl] or {}
	if #list - (table.find(list, uid) and 1 or 0) >= SR.capacity(def, structure) then
		return fail(Text.HABITAT_CHEIO_1E10B0)
	end
	settle(p)
	for _, l in d.habitat do
		local i = table.find(l, uid)
		if i then
			table.remove(l, i)
		end
	end
	d.habitat[isl] = d.habitat[isl] or {}
	table.insert(d.habitat[isl], uid)
	World.refresh(p)
	return ok(p, C.ById[d.creatures[uid].id].name .. Text.AGORA_VIVE_EM_207F92 .. def.name)
end
function A.Unlock(p, isl)
	local d = Data.get(p)
	local check = Access.check(d, isl, "unlock")
	if not check.ok then
		return fail(check.reason)
	end
	if d.unlocked[isl] then
		return fail(Text.JA_DESBLOQUEADA_118724)
	end
	d.gold -= I.ById[isl].cost
	d.unlocked[isl] = true
	return ok(p, Text.REGIAO_DESBLOQUEADA_561460)
end
function A.Breed(p, a, b)
	local d = Data.get(p)
	if a == b or not d.creatures[a] or not d.creatures[b] then
		return fail(Text.ESCOLHA_DUAS_FERAS_DIFERENTES_D70C07)
	end
	if #d.eggs >= Balance.IncubatorSlots then
		return fail(Text.CHOCADEIRA_CHEIA_3D3160)
	end
	if d.gold < BREED_COST then
		return fail(Text.PRECISA_DE_3C22C8 .. BREED_COST .. " ouro")
	end
	d.gold -= BREED_COST
	bump(d, "breed")
	local id = B.pick(d.creatures[a].id, d.creatures[b].id, rng)
	local r = C.ById[id].rar
	table.insert(d.eggs, {
		id = id,
		ready = os.time() + Balance.IncubationBase * r * r,
		nonce = "egg:" .. Http:GenerateGUID(false),
		region = (Data.session(p) and Data.session(p).lastSafe) or "Alvorecer",
	})
	return ok(p, Text.OVO_MISTERIOSO_ECLODE_EM_F655A9 .. Balance.IncubationBase * r * r .. "s")
end
function A.Hatch(p, i)
	local d = Data.get(p)
	local e = typeof(i) == "number" and d.eggs[i]
	if not e then
		return fail(Text.OVO_INVALIDO_5146F8)
	end
	if os.time() < e.ready then
		return fail(Text.AINDA_NAO_ECLODIU_EB8B13)
	end
	local n = 0
	for _ in d.creatures do
		n += 1
	end
	if n >= Balance.InventoryLimit then
		return fail(Text.LIMITE_DE_60_FERAS_E2D3F3)
	end
	local check = Region.requireContext(p, e.region or "Alvorecer", "hatch", true)
	if not check.ok then
		return fail(check.reason)
	end
	local nonce = e.nonce
	if not nonce then
		return fail(Text.OVO_SEM_IDENTIFICACAO_RECONECTE_PARA_MIGRAR_D37C37)
	end
	local origin = d.legacyEggPermits and d.legacyEggPermits[nonce] and "legacy_egg" or "hatch"
	local uid, reason = Grant.grant(d, e.id, origin, nonce, { level = 1 })
	if not uid then
		return fail(reason)
	end
	table.remove(d.eggs, i)
	bump(d, "hatch")
	return ok(p, "Nasceu " .. C.ById[e.id].name .. "!")
end
function A.Battle(p, uid, isl)
	local d = Data.get(p)
	local actual = Region.current(p, "battle")
	if actual ~= isl then
		return fail("WRONG_REGION")
	end
	local cr = d.creatures[uid]
	local def = I.ById[actual]
	if not cr or not def or not d.unlocked[isl] then
		return fail(Text.BATALHA_INVALIDA_A8AE42)
	end
	if lastBattle[p] and os.clock() - lastBattle[p] < 20 then
		return fail(Text.SUAS_FERAS_DESCANSAM_6D6F29 .. math.ceil(20 - (os.clock() - lastBattle[p])) .. "s")
	end
	lastBattle[p] = os.clock()
	bump(d, "fight")
	local pool = Pools.list(actual, false)
	if #pool == 0 then
		return fail(Text.SEM_ENCONTROS_GERAIS_NESTA_REGIAO_ED1AF7)
	end
	local g = pool[rng:NextInteger(1, #pool)]
	local glv = Pools.rollLevel(actual, g.rar, rng)
	local log, win = Combat.resolve(cr.id, cr.lv, g.id, glv, rng)
	local info = { log = log, me = { id = cr.id, lv = cr.lv }, foe = { id = g.id, lv = glv }, win = win }
	if not win then
		local response =
			ok(p, Text.DERROTA_PARA_F29D4F .. g.name .. " (Nv." .. glv .. Text.TREINE_E_TENTE_DE_NOVO_74F9F0)
		response.battle = info
		return response
	end
	local reward = Progression.rewards(actual, glv, g.rar, cr.lv)
	Progression.award(d, reward.xp)
	Progression.awardCreature(cr, reward.creatureXp)
	local gold = reward.gold
	local gem = rng:NextNumber() < 0.2 and 1 or 0
	d.gold += gold
	d.gems += gem
	d.wins += 1
	bump(d, "win")
	local r = ok(p, Text.VITORIA_SOBRE_36EFE4 .. g.name .. "! +" .. gold .. " ouro" .. (gem > 0 and " +1 gema" or ""))
	r.battle = info
	return r
end

function A.Claim(p, id)
	local d = Data.get(p)
	local m = M.ById[id]
	if not m or d.claimed[id] or M.progress(d, m.stat) < m.goal then
		return fail(Text.MISSAO_INDISPONIVEL_EE2728)
	end
	d.claimed[id] = true
	d.gold += m.gold
	d.gems += m.gems
	return ok(p, "Recompensa: +" .. m.gold .. " ouro, +" .. m.gems .. " gemas")
end
function A.BuyEgg(p, isl)
	local d = Data.get(p)
	local def = I.ById[isl]
	local access = Region.requireContext(p, isl, "shop", true)
	if not def or not access.ok then
		return fail(access.reason)
	end
	if #d.eggs >= Balance.IncubatorSlots then
		return fail(Text.CHOCADEIRA_CHEIA_3D3160)
	end
	local cost = 80 * def.idx
	if d.gold < cost then
		return fail(Text.PRECISA_DE_3C22C8 .. cost .. " ouro")
	end
	local pick = Pools.pick(isl, rng, true)
	if not pick then
		return fail(Text.SEM_OVOS_GERAIS_NESTA_REGIAO_623A41)
	end
	d.gold -= cost
	table.insert(d.eggs, {
		id = pick.id,
		ready = os.time() + Balance.IncubationBase * pick.rar * pick.rar,
		nonce = "egg:" .. Http:GenerateGUID(false),
		region = isl,
	})
	return ok(p, Text.OVO_DE_763A79 .. def.name .. " comprado!")
end
function A.Speed(p, i)
	local d = Data.get(p)
	local e = typeof(i) == "number" and d.eggs[i]
	if not e then
		return fail(Text.OVO_INVALIDO_5146F8)
	end
	local left = e.ready - os.time()
	if left <= 0 then
		return fail(Text.JA_PODE_CHOCAR_035D5F)
	end
	local cost = math.max(1, math.ceil(left / 30))
	if d.gems < cost then
		return fail(Text.PRECISA_DE_3C22C8 .. cost .. " gemas")
	end
	d.gems -= cost
	e.ready = os.time()
	return ok(p, Text.OVO_ACELERADO_AB603C)
end
function A.Daily(p)
	local d = Data.get(p)
	local today = os.time() // 86400
	if d.dailyDay >= today then
		return fail(Text.VOLTE_AMANHA_E195DE)
	end
	d.streak = (d.dailyDay == today - 1) and d.streak + 1 or 1
	d.dailyDay = today
	local gold = 50 * math.min(d.streak, 7)
	local gem = d.streak % 3 == 0 and 1 or 0
	d.gold += gold
	d.gems += gem
	return ok(p, "Dia " .. d.streak .. " seguido: +" .. gold .. " ouro" .. (gem > 0 and " +1 gema" or ""))
end
function A.Buy(p, key)
	if typeof(key) ~= "string" then
		return fail(Text.ITEM_INVALIDO_96E69E)
	end
	local s, m = Mon.buy(p, key)
	if not s then
		return fail(m)
	end
	return ok(p, Text.ABRINDO_A_COMPRA_5DF77F)
end
local Players = game:GetService("Players")
local invitations = {}
local lastDuel = setmetatable({}, { __mode = "k" })
local function sim(ca, la, cb, lb)
	return Combat.resolve(ca.id, la, cb.id, lb, rng)
end
local function best(d)
	local b, bs
	for _, cr in d.creatures do
		local sc = C.ById[cr.id].rar * 10 + cr.lv
		if not bs or sc > bs then
			b, bs = cr, sc
		end
	end
	return b
end
-- Duelo online: sua melhor fera contra a melhor fera de outro jogador do servidor (o rival não perde nada).
function A.Duel(p, tid)
	local t = typeof(tid) == "number" and Players:GetPlayerByUserId(tid)
	local d = Data.get(p)
	local td = t and Data.get(t)
	if not td or t == p then
		return fail(Text.JOGADOR_INDISPONIVEL_D18F3F)
	end
	local key = tostring(p.UserId) .. ":" .. tostring(t.UserId)
	local reverse = tostring(t.UserId) .. ":" .. tostring(p.UserId)
	if not invitations[reverse] or invitations[reverse] < os.clock() then
		invitations[key] = os.clock() + 30
		return ok(p, Text.CONVITE_ENVIADO_O_RIVAL_DEVE_TOCAR_DESAFIAR_NO_S_D712DA)
	end
	invitations[reverse] = nil
	invitations[key] = nil
	if lastDuel[p] and os.clock() - lastDuel[p] < 30 then
		return fail(Text.SUAS_FERAS_DESCANSAM_6D6F29 .. math.ceil(30 - (os.clock() - lastDuel[p])) .. "s")
	end
	lastDuel[p] = os.clock()
	local a, b = best(d), best(td)
	local log, win = sim(C.ById[a.id], a.lv, C.ById[b.id], b.lv)
	local info = { log = log, me = { id = a.id, lv = a.lv }, foe = { id = b.id, lv = b.lv }, win = win }
	if not win then
		local r = ok(p, Text.DERROTA_PARA_F29D4F .. t.DisplayName .. Text.TREINE_E_TENTE_DE_NOVO_F77824)
		r.battle = info
		return r
	end
	local gold = 40 + 5 * b.lv
	d.gold += gold
	d.trophies += 1
	bump(d, "duelwin")
	local r = ok(p, Text.VITORIA_CONTRA_F35782 .. t.DisplayName .. "! +" .. gold .. Text.OURO_1_TROFEU_AC2EBF)
	r.battle = info
	return r
end
function A.Tut(p)
	Data.get(p).tut = true
	return ok(p, Text.TUTORIAL_CONCLUIDO_EE21ED)
end
return G
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">Guardians</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local I = require(RS.Shared.Islands)
local C = require(RS.Shared.Creatures)
local MF = require(RS.Shared.ModelFactory)
local Data = require(script.Parent.DataService)
local Encounters = require(script.Parent.EncounterService)
local Species = require(RS.Shared.SpeciesRules)
local Bands = require(RS.Shared.LevelBands)
local Region = require(script.Parent.RegionService)
local G = {}
function G.start()
	local folder = Instance.new("Folder")
	folder.Name = "Guardioes"
	folder.Parent = workspace
	for _, island in I.List do
		local chosen
		for _, def in C.List do
			if def.el == island.el and not def.hybrid and def.rar >= 3 and Species.isGeneral(def.id) then
				chosen = def
				break
			end
		end
		if not chosen then
			continue
		end
		local level = Bands.ById[island.id].guardian
		local model = MF.build(chosen, level)
		local box, size = model:GetBoundingBox()
		local lift = model:GetPivot().Position.Y - (box.Position.Y - size.Y / 2)
		model:PivotTo(CFrame.new(I.pos(island.idx) + Vector3.new(-20, 4 + lift, 8)))
		model.Parent = folder
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = Text.DESAFIAR_GUARDIAO_C2DC77
		prompt.ObjectText = island.name .. " • Nv." .. level
		prompt.HoldDuration = 0.8
		prompt.MaxActivationDistance = 11
		prompt.Parent = model.PrimaryPart
		prompt.Triggered:Connect(function(p)
			local d = Data.get(p)
			local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if
				not d
				or not root
				or (root.Position - model.PrimaryPart.Position).Magnitude > 13
				or not d.unlocked[island.id]
				or Encounters.active(p)
			then
				return
			end
			if not Region.requireCurrent(p, island.id, "battle").ok then
				return
			end
			if d.guardians[island.id] then
				local notice = RS:FindFirstChild("WildNotice")
				if notice then
					notice:FireClient(p, Text.VOCE_JA_CONCLUIU_ESTE_DESAFIO_DE_GUARDIAO_12DC0F)
				end
				return
			end
			Encounters.open(p, {
				id = chosen.id,
				lv = level,
				position = model.PrimaryPart.Position,
				capturable = false,
				guardianId = island.id,
				region = island.id,
				statMultiplier = 1.17,
			}, function()
				model:SetAttribute("LastChallengeEnded", os.time())
			end)
		end)
	end
end
return G
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">IslandArchitecture</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Volume e silhueta com poucas peças grandes; não altera a superfície segura y=14.
local A = {}
local V = Vector3.new
function A.build(parent, center, def)
	local group = Instance.new("Folder")
	group.Name = "Geologia_" .. def.id
	group.Parent = parent
	local rng = Random.new(718 + def.idx)
	local function rock(size, pos, color)
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Ball
		p.Size = size
		p.Position = center + pos
		p.Color = color
		p.Material = Enum.Material.Rock
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Parent = group
		return p
	end
	rock(V(76, 21, 76), V(0, -9, 0), def.ground:Lerp(Color3.fromRGB(30, 35, 45), 0.55))
	for i = 1, 7 do
		local a = i * math.pi * 2 / 7
		local radius = 33
		local p = rock(
			V(rng:NextNumber(12, 20), rng:NextNumber(12, 20), rng:NextNumber(12, 20)),
			V(math.cos(a) * radius, -5, math.sin(a) * radius),
			def.ground:Lerp(Color3.fromRGB(42, 44, 51), 0.4)
		)
		p.CFrame *= CFrame.Angles(rng:NextNumber(), rng:NextNumber(), rng:NextNumber())
	end
	-- Pequenas pedras costeiras: um grupo coeso, em vez de ruído em todo o mapa.
	for i = 1, 4 do
		rock(V(5 + i, 3, 5), V(34 + i, -0.5, (i - 2) * 5), def.ground:Lerp(Color3.fromRGB(222, 201, 156), 0.3))
	end
end
return A
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="40">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!nonstrict
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Data = require(script.Parent.DataService)
local World = require(script.Parent.World)
local G = require(script.Parent.GameService)
local Mon = require(script.Parent.MonetizationService)
local Encounters = require(script.Parent.EncounterService)
local physics = game:GetService("PhysicsService")
pcall(function()
	physics:RegisterCollisionGroup("Creatures")
end)
physics:CollisionGroupSetCollidable("Creatures", "Default", false)
physics:CollisionGroupSetCollidable("Creatures", "Creatures", false)
Encounters.start()
World.build()
require(script.Parent.RegionGuard).start()
require(script.Parent.StartingCamp).build()
require(script.Parent.Researcher).start()
require(script.Parent.Wildlife).start()
require(script.Parent.Guardians).start()
require(script.Parent.SanctuaryBuilder).build()
local Net = Instance.new("RemoteFunction")
Net.Name = "Net"
Net.Parent = RS
local last = {}
local busy = {}
local function argument(v)
	return v == nil
		or (typeof(v) == "string" and #v <= 80)
		or (typeof(v) == "number" and v == v and math.abs(v) < 1e12 and v % 1 == 0)
end
Net.OnServerInvoke = function(p, action, a, b)
	if typeof(action) ~= "string" or not argument(a) or not argument(b) then
		return
	end
	local t = os.clock()
	if last[p] and t - last[p] < 0.15 then
		return { ok = false, msg = "Calma!" }
	end
	last[p] = t
	if Encounters.active(p) and action ~= "Get" then
		return { ok = false, msg = "Termine ou abandone o encontro primeiro." }
	end
	local f = G.Actions[action]
	if not f or not Data.get(p) then
		return { ok = false, msg = "Indisponível" }
	end
	if busy[p] then
		return { ok = false, msg = "Aguarde a ação anterior" }
	end
	busy[p] = true
	local s, r = pcall(f, p, a, b)
	busy[p] = nil
	if s then
		return r
	end
	warn(r)
	return { ok = false, msg = "Erro interno" }
end
local function join(p)
	if Data.load(p) then
		require(script.Parent.RegionGuard).initialize(p)
		Mon.refresh(p)
		World.refresh(p)
	end
end
Players.PlayerAdded:Connect(join)
for _, p in Players:GetPlayers() do
	task.spawn(join, p)
end
Players.PlayerRemoving:Connect(function(p)
	while busy[p] do
		task.wait()
	end
	require(script.Parent.SanctuaryService).release(p)
	Data.release(p)
	last[p] = nil
	busy[p] = nil
	local f = workspace:FindFirstChild("Criaturas")
	local m = f and f:FindFirstChild(tostring(p.UserId))
	if m then
		m:Destroy()
	end
end)
task.spawn(function()
	while true do
		task.wait(60)
		Data.saveAll()
	end
end)
game:BindToClose(function()
	Data.closeAll()
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Só itens opcionais: gemas (pacotes), passe de ouro em dobro e aura cosmética. Nada bloqueia o jogo gratuito.
local MPS = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local Data = require(script.Parent.DataService)
-- Crie os itens em create.roblox.com e cole os IDs aqui (0 = desativado).
local Products = { Gems100 = { id = 0, gems = 100 }, Gems500 = { id = 0, gems = 500 } }
local Passes = { Dobro = 0, Aura = 0 }
local S = {}
function S.refresh(p)
	local d = Data.get(p)
	if not d then
		return
	end
	for k, id in Passes do
		if id > 0 then
			local ok, own = pcall(function()
				return MPS:UserOwnsGamePassAsync(p.UserId, id)
			end)
			if ok and own then
				d.pass[k] = true
			end
		end
	end
end
function S.buy(p, key)
	if true then
		return false, "Compras reais desativadas nesta versão de testes"
	end
	local pr = Products[key]
	if pr then
		if pr.id == 0 then
			return false, "Produto ainda não configurado"
		end
		MPS:PromptProductPurchase(p, pr.id)
		return true
	end
	if Passes[key] then
		if Passes[key] == 0 then
			return false, "Passe ainda não configurado"
		end
		MPS:PromptGamePassPurchase(p, Passes[key])
		return true
	end
	return false, "Item inválido"
end
MPS.ProcessReceipt = function(info)
	local N = Enum.ProductPurchaseDecision
	local p = Players:GetPlayerByUserId(info.PlayerId)
	local d = p and Data.get(p)
	if not d then
		return N.NotProcessedYet
	end
	local key = tostring(info.PurchaseId)
	if d.receipts[key] then
		return N.PurchaseGranted
	end
	for _, pr in Products do
		if pr.id == info.ProductId then
			d.gems += pr.gems
			d.receipts[key] = true
			if Data.save(p) then
				return N.PurchaseGranted
			end
			d.gems -= pr.gems
			d.receipts[key] = nil
			return N.NotProcessedYet
		end
	end
	return N.NotProcessedYet
end
MPS.PromptGamePassPurchaseFinished:Connect(function(p, id, bought)
	local d = Data.get(p)
	if not (d and bought) then
		return
	end
	for k, v in Passes do
		if v == id then
			d.pass[k] = true
		end
	end
end)
return S
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">RegionGuard</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local I = require(RS.Shared.Islands)
local Access = require(RS.Shared.Access)
local Data = require(script.Parent.DataService)
local Region = require(script.Parent.RegionService)
local G = {}
local spawns = {}
local lastNotice = {}
function G.best(d)
	local best = "Alvorecer"
	for _, def in I.List do
		if Access.check(d, def.id, "travel").ok then
			best = def.id
		end
	end
	return best
end
function G.inspect(d, s, position)
	local id = Region.detect(position)
	if not id then
		return { ok = true }
	end
	local access = Access.check(d, id, "travel")
	if access.ok and s.region == id then
		return { ok = true, island = id }
	end
	return { ok = false, reason = access.ok and "WRONG_REGION" or access.reason, safe = s.lastSafe or "Alvorecer" }
end
function G.initialize(p)
	local d = Data.get(p)
	local s = Data.session(p)
	if not d or not s then
		return
	end
	local best = G.best(d)
	p.RespawnLocation = spawns[best]
	s.lastSafe = best
	local function respawn(character)
		s.spawning = true
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root and Data.get(p) and p.Character == character then
			character:PivotTo(CFrame.new(Region.safePoint(s.lastSafe)))
			s.region = s.lastSafe
		end
		s.spawning = false
	end
	p.CharacterAdded:Connect(respawn)
	if p.Character then
		task.spawn(respawn, p.Character)
	end
end
function G.start()
	local root = Instance.new("Folder")
	root.Name = "PontosSeguros"
	root.Parent = workspace
	for _, def in I.List do
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = def.id
		spawn.Size = Vector3.new(8, 1, 8)
		spawn.Anchored = true
		spawn.Neutral = true
		spawn.Transparency = 1
		spawn.CanCollide = false
		spawn.Position = Region.safePoint(def.id)
		spawn.Parent = root
		spawns[def.id] = spawn
	end
	Players.PlayerRemoving:Connect(function(p)
		lastNotice[p] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			for _, p in Players:GetPlayers() do
				local d = Data.get(p)
				local s = Data.session(p)
				local char = p.Character
				local part = char and char:FindFirstChild("HumanoidRootPart")
				if not d or not s or not part or s.transporting or s.spawning then
					continue
				end
				local inspection = G.inspect(d, s, part.Position)
				local id = inspection.island
				if id or not inspection.ok then
					if inspection.ok then
						s.lastSafe = id
						p.RespawnLocation = spawns[id]
					else
						char:PivotTo(CFrame.new(Region.safePoint(s.lastSafe)))
						s.region = s.lastSafe
						if not lastNotice[p] or os.clock() - lastNotice[p] > 3 then
							local event = RS:FindFirstChild("WildNotice")
							if event then
								event:FireClient(p, Text.REGIAO_BLOQUEADA_47B5A8 .. inspection.reason)
							end
							lastNotice[p] = os.clock()
						end
					end
				end
			end
		end
	end)
end
return G
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">RegionService</string>
          <string name="Source"><![CDATA[--!nonstrict
local RS = game:GetService("ReplicatedStorage")
local I = require(RS.Shared.Islands)
local Access = require(RS.Shared.Access)
local Data = require(script.Parent.DataService)
local R = {}
function R.detect(position)
	for _, def in I.List do
		local center = I.pos(def.idx)
		if
			math.abs(position.Y - center.Y) < 100
			and (Vector3.new(position.X, 0, position.Z) - Vector3.new(center.X, 0, center.Z)).Magnitude <= 40
		then
			return def.id
		end
	end
	return nil
end
function R.current(p, purpose)
	local d = Data.get(p)
	local session = Data.session(p)
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if not d or not session or not root or session.transporting then
		return nil
	end
	local id = R.detect(root.Position)
	if id and id == session.region and Access.check(d, id, purpose or "encounter").ok then
		return id
	end
	return not id and session.region == "sanctuary" and "sanctuary" or nil
end
function R.requireCurrent(p, id, purpose)
	local data = Data.get(p)
	local access = Access.check(data, id, purpose)
	if not access.ok then
		return access
	end
	if R.current(p, purpose) ~= id then
		return { ok = false, reason = "WRONG_REGION" }
	end
	return access
end
function R.requireContext(p, id, purpose, allowHome)
	local result = Access.check(Data.get(p), id, purpose)
	if not result.ok then
		return result
	end
	if allowHome and R.current(p, purpose) == "sanctuary" then
		return result
	end
	return R.requireCurrent(p, id, purpose)
end
function R.safePoint(id)
	local def = I.ById[id] or I.ById.Alvorecer
	return I.pos(def.idx) + Vector3.new(0, 9, 24)
end
return R
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">Researcher</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local Data = require(script.Parent.DataService)
local Story = require(RS.Shared.Story)
local I = require(RS.Shared.Islands)
local R = {}
function R.start()
	local event = Instance.new("RemoteEvent")
	event.Name = "StoryNotice"
	event.Parent = RS
	local model = Instance.new("Model")
	model.Name = Text.MAIA_PESQUISADORA_1A62F7
	model.Parent = workspace
	local base = I.pos(1) + Vector3.new(19, 4, 23)
	local function part(name, size, offset, color, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Position = base + offset
		p.Color = color
		p.Shape = shape or Enum.PartType.Block
		p.Anchored = true
		p.CanCollide = false
		p.Parent = model
		return p
	end
	local torso = part("Casaco", Vector3.new(2.2, 2.5, 1), Vector3.new(0, 2.8, 0), Color3.fromRGB(62, 121, 115))
	local _head = part(
		Text.CABECA_D8228B,
		Vector3.new(1.7, 1.7, 1.7),
		Vector3.new(0, 4.7, 0),
		Color3.fromRGB(205, 159, 123),
		Enum.PartType.Ball
	)
	for _, side in { -1, 1 } do
		part("Bota", Vector3.new(0.8, 1.6, 1), Vector3.new(side * 0.6, 0.9, 0), Color3.fromRGB(65, 65, 77))
		part(
			Text.BRACO_DB4D66,
			Vector3.new(0.65, 2.2, 0.7),
			Vector3.new(side * 1.5, 2.7, 0),
			Color3.fromRGB(62, 121, 115)
		)
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = Text.CONVERSAR_AC3B38
	prompt.ObjectText = Text.MAIA_PESQUISADORA_DO_ARQUIPELAGO_38D949
	prompt.HoldDuration = 0.2
	prompt.MaxActivationDistance = 10
	prompt.Parent = torso
	prompt.Triggered:Connect(function(p)
		local d = Data.get(p)
		local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if not d or not root or (root.Position - torso.Position).Magnitude > 12 then
			return
		end
		local q = Story.current(d)
		event:FireClient(
			p,
			q
					and ("Maia: " .. q.text .. " (" .. Story.progress(d, q) .. "/" .. q.goal .. Text.VEJA_MISSOES_PARA_RECEBER_A_RECOMPENSA_8B5929)
				or Text.MAIA_VOCE_CONCLUIU_NOSSOS_PRIMEIROS_ESTUDOS_CONT_FCC227
		)
	end)
end
return R
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">SanctuaryBuilder</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local I = require(RS.Shared.Islands)
local Data = require(script.Parent.DataService)
local Quest = require(RS.Shared.PhoenixQuest)
local Region = require(script.Parent.RegionService)
local B = {}
local origin = I.pos(I.ById.Dunas.idx) + Vector3.new(0, 4, -23)
function B.altarPosition()
	return origin + Vector3.new(0, 1, 0)
end
function B.build()
	local root = Instance.new("Model")
	root.Name = "RuinasAntigas"
	root.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	root.Parent = workspace
	local function part(name, size, pos, color, material, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Position = pos
		p.Color = color
		p.Material = material or Enum.Material.Sandstone
		p.Shape = shape or Enum.PartType.Block
		p.Anchored = true
		p.CanTouch = false
		p.CanCollide = false
		p.Parent = root
		return p
	end
	local floor = part(
		"Piso",
		Vector3.new(32, 0.8, 26),
		origin - Vector3.new(0, 0.8, 0),
		Color3.fromRGB(91, 72, 63),
		Enum.Material.Basalt
	)
	floor.CanCollide = true
	for _, side in { -1, 1 } do
		local wall =
			part("Muralha", Vector3.new(1, 12, 26), origin + Vector3.new(side * 16, 5, 0), Color3.fromRGB(103, 81, 67))
		wall.CanCollide = true
	end
	local rear = part("Parede", Vector3.new(32, 12, 1), origin + Vector3.new(0, 5, -13), Color3.fromRGB(103, 81, 67))
	rear.CanCollide = true
	local roof = part("Abobada", Vector3.new(32, 1, 26), origin + Vector3.new(0, 11, 0), Color3.fromRGB(72, 60, 58))
	roof.CanCollide = true
	local gate =
		part("LajeSelada", Vector3.new(10, 10, 1), origin + Vector3.new(0, 4, 13), Color3.fromRGB(158, 111, 66))
	gate:SetAttribute("AncientGate", true)
	for _, side in { -1, 1 } do
		local front = part(
			"Entrada",
			Vector3.new(11, 12, 1),
			origin + Vector3.new(side * 10.5, 5, 13),
			Color3.fromRGB(103, 81, 67)
		)
		front.CanCollide = true
	end
	local stone = Color3.fromRGB(113, 93, 79)
	local gold = Color3.fromRGB(240, 179, 66)
	for i = 1, 12 do
		local a = i * math.pi / 6
		local p = part(
			"Fragmento",
			Vector3.new(2, 7 + i % 3, 2),
			origin + Vector3.new(math.cos(a) * 13, 3, math.sin(a) * 10),
			stone
		)
		p.CFrame *= CFrame.Angles(0, a, 0.08)
		if i % 2 == 0 then
			part("Arco", Vector3.new(6, 1.3, 2.5), p.Position + Vector3.new(0, 4, 0), stone)
		end
	end
	for i = 1, 16 do
		local a = i * math.pi / 8
		local p = part(
			Text.INSCRICAO_3A97CD,
			Vector3.new(1.2, 0.12, 2),
			origin + Vector3.new(math.cos(a) * 8, 0.15, math.sin(a) * 8),
			gold,
			Enum.Material.Neon
		)
		p.CFrame *= CFrame.Angles(0, -a, 0)
	end
	local altar = part("PedraCentral", Vector3.new(1, 6, 6), origin, gold, Enum.Material.Slate, Enum.PartType.Cylinder)
	altar.CFrame *= CFrame.Angles(0, 0, math.pi / 2)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ObjectText = Text.PEDRA_ANTIGA_ACE013
	prompt.ActionText = Text.EXAMINAR_F96563
	prompt.HoldDuration = 1
	prompt.MaxActivationDistance = 12
	prompt.Parent = altar
	prompt.Triggered:Connect(function(p)
		local d = Data.get(p)
		local event = RS:FindFirstChild("WildNotice")
		if not d then
			return
		end
		local ok, reason = require(script.Parent.EncounterService).startSpecial(p, "phoenix_solar")
		if not ok and event then
			event:FireClient(
				p,
				reason == "COOLDOWN"
						and (Text.AS_MARCAS_REPOUSAM_POR_F8A177 .. math.max(0, d.phoenix.nextAttemptAt - os.time()) .. "s")
					or Text.AS_MARCAS_AINDA_NAO_RESPONDEM_A_SUA_PRESENCA_12E579
			)
		end
	end)
	for i = 1, 8 do
		local a = i * math.pi / 4
		local rock = part(
			"Rocha",
			Vector3.new(2 + i % 2, 1.5, 2),
			origin + Vector3.new(math.cos(a) * 12, 0, math.sin(a) * 9),
			stone,
			Enum.Material.Basalt
		)
		rock.CFrame *= CFrame.Angles(0.2, a, 0.15)
		local crystal = part(
			"Cristal",
			Vector3.new(0.7, 2 + i % 3, 0.7),
			rock.Position + Vector3.new(0, 1.5, 0),
			gold,
			Enum.Material.Neon
		)
		crystal.CFrame *= CFrame.Angles(0, a, 0.2)
	end
	local glyphs = {
		{ id = "duneHidden", region = "Dunas", offset = Vector3.new(27, 5, -10) },
		{ id = "duneRuin", region = "Dunas", offset = Vector3.new(-26, 15, 10) },
		{ id = "skyPeak", region = "Picos", offset = Vector3.new(20, 16, -20) },
	}
	for _, g in glyphs do
		local p = part(
			Text.VESTIGIO_A22F5D,
			Vector3.new(1.5, 2.5, 1),
			I.pos(I.ById[g.region].idx) + g.offset,
			gold,
			Enum.Material.Neon
		)
		if g.id ~= "duneHidden" then
			for step = 1, 5 do
				local platform = part(
					"Degrau",
					Vector3.new(4, 1, 4),
					p.Position + Vector3.new((step - 5) * 3, step * 2 - 11, 0),
					stone
				)
				platform.CanCollide = true
			end
		else
			for _, side in { -1, 1 } do
				part(
					"Abrigo",
					Vector3.new(2, 5, 4),
					p.Position + Vector3.new(side * 2, -0.5, 0),
					stone,
					Enum.Material.Basalt
				)
			end
		end
		local glyphPrompt = Instance.new("ProximityPrompt")
		glyphPrompt.ObjectText = Text.MARCA_ANTIGA_9C4D11
		glyphPrompt.ActionText = Text.EXAMINAR_F96563
		glyphPrompt.HoldDuration = 0.5
		glyphPrompt.MaxActivationDistance = 10
		glyphPrompt.Parent = p
		glyphPrompt.Triggered:Connect(function(player)
			local d = Data.get(player)
			local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if
				not d
				or not hrp
				or (hrp.Position - p.Position).Magnitude > 12
				or not Region.requireCurrent(player, g.region, "encounter").ok
			then
				return
			end
			if not Quest.Glyphs[g.id] or d.phoenix.glyphs[g.id] then
				return
			end
			d.phoenix.glyphs[g.id] = true
			d.phoenix.sanctuaryOpen = Quest.stage(d) == 3
			local event = RS:FindFirstChild("WildNotice")
			if event then
				event:FireClient(player, Quest.public(d).hint)
			end
		end)
	end
	local parts = 0
	for _, obj in root:GetDescendants() do
		if obj:IsA("BasePart") then
			parts += 1
		end
	end
	assert(parts <= 400, Text.RUINAS_EXCEDEM_ORCAMENTO_6CD117)
end
return B
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">SanctuaryService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local Data = require(script.Parent.DataService)
local I = require(RS.Shared.Islands)
local Rules = require(RS.Shared.SanctuaryRules)
local S = {}
local plots = {}
local used = {}
local V = Vector3.new
local function part(parent, name, size, position, color, material, collide, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Position = position
	p.Anchored = true
	p.CanCollide = collide == true
	p.CanTouch = false
	p.Material = material or Enum.Material.SmoothPlastic
	p.Color = color
	p.Shape = shape or Enum.PartType.Block
	p.Parent = parent
	return p
end
function S.ensure(player)
	if plots[player] then
		return plots[player]
	end
	local index = 1
	while used[index] do
		index += 1
	end
	used[index] = true
	local center = V(((index - 1) % 4) * 190, 12, 850 + math.floor((index - 1) / 4) * 190)
	local root = workspace:FindFirstChild("Santuarios") or Instance.new("Folder", workspace)
	root.Name = "Santuarios"
	local folder = Instance.new("Folder")
	folder.Name = tostring(player.UserId)
	folder:SetAttribute("OwnerUserId", player.UserId)
	folder.Parent = root
	local _base = part(
		folder,
		Text.ILHA_PESSOAL_498B3B,
		V(144, 4, 144),
		center,
		Color3.fromRGB(85, 132, 106),
		Enum.Material.Grass,
		true
	)
	part(
		folder,
		Text.ROCHA_FLUTUANTE_B3C46F,
		V(142, 35, 142),
		center - V(0, 15, 0),
		Color3.fromRGB(74, 87, 92),
		Enum.Material.Rock,
		false,
		Enum.PartType.Ball
	)
	part(
		folder,
		Text.CAMINHO_CENTRAL_22B87F,
		V(9, 0.2, 125),
		center + V(0, 2.2, 0),
		Color3.fromRGB(202, 194, 165),
		Enum.Material.Cobblestone,
		false
	)
	local sign = part(
		folder,
		Text.PORTAL_DE_RETORNO_18016A,
		V(7, 9, 2),
		center + V(0, 6, 61),
		Color3.fromRGB(80, 146, 166),
		Enum.Material.Neon,
		false
	)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = Text.VOLTAR_A_AVENTURA_D7DC5A
	prompt.ObjectText = Text.PORTAL_DO_SANTUARIO_1F3781
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = 10
	prompt.Parent = sign
	prompt.Triggered:Connect(function(p)
		local d = Data.get(p)
		local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if p ~= player or not d or not hrp or (hrp.Position - sign.Position).Magnitude > 12 then
			return
		end
		if require(script.Parent.EncounterService).active(p) then
			return
		end
		require(script.Parent.Transport).go(p, I.pos(1) + V(0, 9, 24), "Alvorecer")
	end)
	local plot = { index = index, center = center, folder = folder, signature = "" }
	plots[player] = plot
	return plot
end
function S.position(player, island)
	local d = Data.get(player)
	local entry = d and d.sanctuary[island]
	if not entry then
		return nil
	end
	local x, z = Rules.slot(entry.slot)
	return S.ensure(player).center + V(x, 2, z)
end
function S.refresh(player)
	local d = Data.get(player)
	if not d then
		return
	end
	local plot = S.ensure(player)
	local keys = {}
	for id, entry in d.sanctuary do
		table.insert(keys, id .. ":" .. entry.slot .. ":" .. entry.level .. ":" .. #(d.habitat[id] or {}))
	end
	table.sort(keys)
	local signature = table.concat(keys, "|")
	if plot.signature == signature then
		return
	end
	plot.signature = signature
	local old = plot.folder:FindFirstChild("Habitats")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "Habitats"
	folder.Parent = plot.folder
	for id, entry in d.sanctuary do
		local def = I.ById[id]
		local pos = S.position(player, id)
		local zone = Instance.new("Model")
		zone.Name = def.name
		zone:SetAttribute("OwnerUserId", player.UserId)
		zone.Parent = folder
		local base = part(zone, "Habitat", V(28, 0.4, 28), pos + V(0, 0.2, 0), def.ground, Enum.Material.Slate, true)
		for _, sx in { -1, 1 } do
			for _, sz in { -1, 1 } do
				part(
					zone,
					Text.MARCO_ELEMENTAL_3DB8E3,
					V(2, 3 + entry.level, 2),
					pos + V(sx * 12, 2, sz * 12),
					def.accent,
					Enum.Material.Neon,
					false
				)
			end
		end
		local label = Instance.new("BillboardGui")
		label.Size = UDim2.fromOffset(190, 45)
		label.StudsOffset = V(0, 5, 0)
		label.MaxDistance = 70
		label.Parent = base
		local text = Instance.new("TextLabel")
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.TextColor3 = Color3.new(1, 1, 1)
		text.TextStrokeTransparency = 0.4
		text.TextSize = 14
		text.Font = Enum.Font.GothamBold
		text.Text = def.el
			.. " • Habitat "
			.. entry.level
			.. "\n"
			.. #(d.habitat[id] or {})
			.. " / "
			.. Rules.capacity(def, entry)
		text.Parent = label
	end
end
function S.home(player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	return require(script.Parent.Transport).go(player, S.ensure(player).center + V(0, 7, 55))
end
function S.release(player)
	local plot = plots[player]
	if not plot then
		return
	end
	plot.folder:Destroy()
	used[plot.index] = nil
	plots[player] = nil
end
return S
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">StartingCamp</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local I = require(game:GetService("ReplicatedStorage").Shared.Islands)
local C = {}
function C.build()
	local parent = Instance.new("Model")
	parent.Name = Text.ACAMPAMENTO_DO_ALVORECER_EBD2E1
	parent.Parent = workspace
	local center = I.pos(1)
	local function part(size, offset, color, material, shape)
		local p = Instance.new("Part")
		p.Size = size
		p.Position = center + offset
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.Color = color
		p.Material = material or Enum.Material.Wood
		p.Shape = shape or Enum.PartType.Block
		p.Parent = parent
		return p
	end
	-- Gazebo de pesquisa e fonte baixa. Centro, spawn e passagem até as pontes livres.
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			part(Vector3.new(1, 9, 1), Vector3.new(-20 + x * 5, 8, -17 + z * 5), Color3.fromRGB(91, 74, 60))
		end
	end
	local _roof = part(
		Vector3.new(15, 3, 15),
		Vector3.new(-20, 13, -17),
		Color3.fromRGB(81, 136, 130),
		Enum.Material.SmoothPlastic,
		Enum.PartType.Ball
	)
	part(Vector3.new(9, 1, 5), Vector3.new(-20, 6, -17), Color3.fromRGB(159, 128, 89))
	local _bowl = part(
		Vector3.new(8, 2, 8),
		Vector3.new(22, 5, -16),
		Color3.fromRGB(158, 177, 163),
		Enum.Material.Slate,
		Enum.PartType.Ball
	)
	local water = part(
		Vector3.new(6, 0.3, 6),
		Vector3.new(22, 6, -16),
		Color3.fromRGB(109, 199, 217),
		Enum.Material.Glass,
		Enum.PartType.Ball
	)
	water.Transparency = 0.3
	for i = 1, 5 do
		local a = i * math.pi * 2 / 5
		part(
			Vector3.new(2.5, 0.4, 1.6),
			Vector3.new(22 + math.cos(a) * 4, 4.3, -16 + math.sin(a) * 4),
			Color3.fromRGB(229, 174, 191),
			Enum.Material.SmoothPlastic,
			Enum.PartType.Ball
		)
	end
end
return C
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">Transport</string>
          <string name="Source"><![CDATA[--!nonstrict
local Data = require(script.Parent.DataService)
local T = {}
local busy = setmetatable({}, { __mode = "k" })
function T.go(player, position, region)
	region = region or "sanctuary"
	local profile = Data.get(player)
	if
		region ~= "sanctuary"
		and not require(game:GetService("ReplicatedStorage").Shared.Access).check(profile, region, "travel").ok
	then
		return false
	end
	if busy[player] or not Data.get(player) or require(script.Parent.EncounterService).active(player) then
		return false
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	busy[player] = true
	local session = Data.session(player)
	if not session then
		busy[player] = nil
		return false
	end
	session.transporting = true
	local ready = pcall(function()
		player:RequestStreamAroundAsync(position, 3)
	end)
	busy[player] = nil
	session.transporting = false
	if
		not ready
		or player.Character ~= character
		or not root.Parent
		or not Data.get(player)
		or require(script.Parent.EncounterService).active(player)
	then
		return false
	end
	session.region = region
	if region ~= "sanctuary" then
		session.lastSafe = region
	end
	local wasAnchored = root.Anchored
	root.Anchored = true
	character:PivotTo(CFrame.new(position))
	task.delay(1, function()
		if root.Parent then
			root.Anchored = wasAnchored
		end
	end)
	return true
end
return T
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">Wildlife</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local C = require(RS.Shared.Creatures)
local I = require(RS.Shared.Islands)
local MF = require(RS.Shared.ModelFactory)
local Rules = require(RS.Shared.CaptureRules)
local Data = require(script.Parent.DataService)
local Encounters = require(script.Parent.EncounterService)
local Pools = require(RS.Shared.EncounterPools)
local Region = require(script.Parent.RegionService)
local W = {}
local rng = Random.new()
local cooldown = setmetatable({}, { __mode = "k" })
local started = false
function W.start()
	if started then
		return
	end
	started = true
	local notice = Instance.new("RemoteEvent")
	notice.Name = "WildNotice"
	notice.Parent = RS
	local folder = Instance.new("Folder")
	folder.Name = "Selvagens"
	folder.Parent = workspace
	local slots = {}
	for _, island in I.List do
		for slot = 1, Rules.MaxPerIsland do
			table.insert(slots, { island = island, slot = slot, nextSpawn = 0 })
		end
	end
	local function spawn(s)
		local counts = {}
		for _, other in slots do
			if other.model then
				counts[other.id] = (counts[other.id] or 0) + 1
			end
		end
		local def = Pools.pick(s.island.id, rng, false, counts)
		if not def then
			return
		end
		local level = Pools.rollLevel(s.island.id, def.rar, rng)
		local m = MF.build(def, level)
		local cf, size = m:GetBoundingBox()
		local ground = I.pos(s.island.idx) + Vector3.new(s.slot == 1 and -11 or 11, 4, 6)
		local lift = m:GetPivot().Position.Y - (cf.Position.Y - size.Y / 2)
		s.home = ground + Vector3.new(0, lift, 0)
		s.model = m
		s.id = def.id
		s.level = level
		s.born = os.clock()
		m:PivotTo(CFrame.new(s.home))
		m.Parent = folder
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = Text.ENCONTRAR_FERA_2CE20D
		prompt.ObjectText = def.name .. " • " .. math.floor(Rules.chance(def.rar, level) * 100) .. "%"
		prompt.HoldDuration = 1
		prompt.MaxActivationDistance = 11
		prompt.RequiresLineOfSight = true
		prompt.Parent = m.PrimaryPart
		prompt.Triggered:Connect(function(player)
			local d = Data.get(player)
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if
				s.model ~= m
				or s.busy
				or not d
				or not root
				or (root.Position - m.PrimaryPart.Position).Magnitude > Rules.MaxDistance
			then
				return
			end
			if cooldown[player] and os.clock() - cooldown[player] < 1.5 then
				return
			end
			cooldown[player] = os.clock()
			local access = Region.requireCurrent(player, s.island.id, "encounter")
			if not access.ok then
				notice:FireClient(player, access.reason)
				return
			end
			if Encounters.active(player) then
				return
			end
			s.busy = true
			prompt.Enabled = false
			local opened = Encounters.open(
				player,
				{ id = def.id, lv = level, region = s.island.id, position = m.PrimaryPart.Position },
				function(remove)
					if s.model ~= m then
						return
					end
					s.busy = false
					if remove then
						s.model = nil
						m:Destroy()
						s.nextSpawn = os.clock() + Rules.RespawnSeconds
					else
						prompt.Enabled = true
						s.born = os.clock()
					end
				end
			)
			if not opened then
				s.busy = false
				prompt.Enabled = true
			end
		end)
	end
	task.spawn(function()
		while folder.Parent do
			local now = os.clock()
			for _, s in slots do
				if not s.model and now >= s.nextSpawn then
					spawn(s)
				elseif s.model and not s.busy then
					-- Movimento limitado ao trecho plano e seguro de cada ponto de encontro.
					local elapsed = now - s.born
					local pos = s.home + Vector3.new(math.sin(elapsed * 0.45) * 2, 0, math.cos(elapsed * 0.45) * 2)
					if C.ById[s.id].shape == "Bird" then
						pos += Vector3.new(0, math.max(0, math.sin(elapsed * 0.5)) * 2, 0)
					end
					s.model:SetAttribute("Moving", true)
					s.model:PivotTo(
						CFrame.lookAt(pos, pos + Vector3.new(math.cos(elapsed * 0.45), 0, -math.sin(elapsed * 0.45)))
					)
				end
			end
			task.wait(0.5)
		end
	end)
end
return W
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local I = require(RS.Shared.Islands)
local C = require(RS.Shared.Creatures)
local MF = require(RS.Shared.ModelFactory)
local Data = require(script.Parent.DataService)
local Sanctuary = require(script.Parent.SanctuaryService)
local W = {}
function W.pos(i)
	local a = (i - 1) / #I.List * math.pi * 2
	return Vector3.new(math.cos(a) * 150, 10, math.sin(a) * 150)
end
function W.build()
	local old = workspace:FindFirstChild("Arquipelago")
	if old then
		old:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = "Arquipelago"
	f.Parent = workspace
	for i, def in I.List do
		local p = W.pos(i)
		local base = Instance.new("Part")
		base.Shape = Enum.PartType.Cylinder
		base.Size = Vector3.new(8, 80, 80)
		base.CFrame = CFrame.new(p) * CFrame.Angles(0, 0, math.rad(90))
		base.Anchored = true
		base.Color = def.ground
		base.Material = Enum.Material.Slate
		base.Name = def.name
		base.Parent = f
		require(script.Parent.IslandArchitecture).build(f, p, def)
		require(script.Parent.Biomes).decorate(f, p, def)
	end
	for i = 1, #I.List do -- pontes ligam as ilhas em anel
		local p1, p2 = W.pos(i), W.pos(i % #I.List + 1)
		local mid = (p1 + p2) / 2 + Vector3.new(0, 3.6, 0)
		local b = Instance.new("Part")
		b.Anchored = true
		b.Size = Vector3.new(9, 1, (p2 - p1).Magnitude)
		b.CFrame = CFrame.lookAt(mid, mid + (p2 - p1))
		b.Material = Enum.Material.WoodPlanks
		b.Color = Color3.fromRGB(150, 105, 60)
		b.Parent = f
		-- Arcos nas duas extremidades: entrar usa Travel, nunca altera a sessão só pela posição.
		for _, target in { i, i % #I.List + 1 } do
			local destination = I.List[target]
			local center = W.pos(target)
			local other = target == i and p2 or p1
			local point = center + (other - center).Unit * 34 + Vector3.new(0, 6, 0)
			for _, side in { -1, 1 } do
				local column = Instance.new("Part")
				column.Size = Vector3.new(1.4, 9, 1.4)
				column.Position = point + Vector3.new(side * 5, 0, 0)
				column.Anchored = true
				column.Material = Enum.Material.Slate
				column.Color = destination.ground
				column.Parent = f
			end
			local arch = Instance.new("Part")
			arch.Name = "Portao_" .. destination.id
			arch.Size = Vector3.new(12, 1.5, 2)
			arch.Position = point + Vector3.new(0, 5, 0)
			arch.Anchored = true
			arch.Material = Enum.Material.Sandstone
			arch.Parent = f
			local sign = Instance.new("BillboardGui")
			sign.Size = UDim2.fromOffset(160, 48)
			sign.StudsOffset = Vector3.new(0, 2, 0)
			sign.MaxDistance = 65
			sign.Parent = arch
			local text = Instance.new("TextLabel")
			text.Size = UDim2.fromScale(1, 1)
			text.BackgroundTransparency = 1
			text.Text = destination.name .. Text.NIVEL_44C4F0 .. destination.minLevel
			text.Font = Enum.Font.GothamBold
			text.TextSize = 14
			text.TextColor3 = Color3.fromRGB(255, 222, 150)
			text.TextStrokeTransparency = 0.4
			text.Parent = sign
			local prompt = Instance.new("ProximityPrompt")
			prompt.ActionText = Text.ENTRAR_7573BA
			prompt.ObjectText = destination.name .. " · Nv." .. destination.minLevel
			prompt.MaxActivationDistance = 19
			prompt.RequiresLineOfSight = false
			prompt.Parent = arch
			prompt.Triggered:Connect(function(player)
				local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				if
					not hrp
					or (hrp.Position - arch.Position).Magnitude > 22
					or require(script.Parent.EncounterService).active(player)
				then
					return
				end
				local result = require(script.Parent.GameService).Actions.Travel(player, destination.id)
				local event = RS:FindFirstChild("WildNotice")
				if event and not result.ok then
					event:FireClient(player, result.msg)
				end
			end)
		end
	end
	local w = Instance.new("Part")
	w.Anchored = true
	w.CanCollide = false
	w.Size = Vector3.new(1200, 2, 1200)
	w.Position = Vector3.new(0, -4, 0)
	w.Material = Enum.Material.Glass
	w.Color = Color3.fromRGB(60, 140, 210)
	w.Transparency = 0.35
	w.Parent = f
	local L = game:GetService("Lighting")
	L.Brightness = 2
	L.EnvironmentDiffuseScale = 0.6
	L.EnvironmentSpecularScale = 0.4
	L.ClockTime = 14
	L.GlobalShadows = true
	local at = Instance.new("Atmosphere")
	at.Density = 0.25
	at.Haze = 1.2
	at.Color = Color3.fromRGB(200, 190, 255)
	at.Parent = L
	local bl = Instance.new("BloomEffect")
	bl.Intensity = 0.5
	bl.Size = 24
	bl.Threshold = 1.8
	bl.Parent = L
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.2
	cc.Contrast = 0.08
	cc.Parent = L
	local s = Instance.new("SpawnLocation")
	s.Anchored = true
	s.Size = Vector3.new(10, 1, 10)
	s.Position = W.pos(1) + Vector3.new(0, 5, 30)
	s.Parent = f
end
function W.refresh(p)
	local root = workspace:FindFirstChild("Criaturas") or Instance.new("Folder", workspace)
	root.Name = "Criaturas"
	local old = root:FindFirstChild(tostring(p.UserId))
	if old then
		old:Destroy()
	end
	local d = Data.get(p)
	if not d then
		return
	end
	Sanctuary.refresh(p)
	local visualCount = 0
	local occupied = 0
	for id, list in d.habitat do
		if d.sanctuary[id] and #list > 0 then
			occupied += 1
		end
	end
	local perHabitat = math.min(2, math.max(1, math.floor(12 / math.max(1, occupied))))
	local mine = Instance.new("Folder")
	mine.Name = tostring(p.UserId)
	for isl, list in d.habitat do
		local center = Sanctuary.position(p, isl)
		if not center then
			continue
		end
		for k, uid in list do
			if k > perHabitat or visualCount >= 12 then
				continue
			end -- Representantes visuais; todas as feras seguem produzindo.
			local cr = d.creatures[uid]
			if cr and uid ~= d.companion then
				visualCount += 1
				local displayed = math.min(#list, perHabitat)
				local radius = displayed == 1 and 0 or 8
				local a = k / displayed * math.pi * 2
				local m = MF.build(C.ById[cr.id], cr.lv)
				local _, dimensions = m:GetBoundingBox()
				local largest = math.max(dimensions.X, dimensions.Y, dimensions.Z)
				if largest > 9 then
					m:ScaleTo(m:GetScale() * 9 / largest)
				end
				local bc, bs = m:GetBoundingBox()
				local lift = m:GetPivot().Position.Y - (bc.Position.Y - bs.Y / 2)
				m:PivotTo(
					CFrame.new(
						center + Vector3.new(math.cos(a) * radius, 0.5 + lift, math.sin(a) * radius),
						center + Vector3.new(0, 0.5 + lift, 0)
					)
				)
				if d.pass and d.pass.Aura then
					local h = Instance.new("Highlight")
					h.FillTransparency = 1
					h.OutlineColor = Color3.fromRGB(255, 215, 0)
					h.Parent = m
				end
				m:SetAttribute("OwnerUserId", p.UserId)
				m:SetAttribute("CreatureUid", uid)
				m.Parent = mine
			end
		end
	end
	mine.Parent = root
	require(script.Parent.CompanionService).sync(p)
end
return W
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="51">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="52">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="53">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="54">
          <Properties>
            <string name="Name">Client</string>
            <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local TS = game:GetService("TweenService")
local Missions = require(RS.Shared.Missions)
local E = require(RS.Shared.Elements)
local Sounds = require(RS.Shared.Sounds)
local SS = game:GetService("SoundService")
local C = require(RS.Shared.Creatures)
local I = require(RS.Shared.Islands)
local Net = RS:WaitForChild("Net")
local gui = Instance.new("ScreenGui")
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
local S, tab, isl, pick, snapAt = nil, Text.FERAS_EF033A, "Alvorecer", {}, os.clock()
local render
local tabBtn = {}
local tutorial
local CollectionUI = require(script.Parent.CollectionUI)
local inFlight = false
local Breeding = require(RS.Shared.Breeding)
local Balance = require(RS.Shared.Economy)
local Nursery = require(script.Parent.NurseryUI)
local Journal = require(script.Parent.JournalUI)
local Theme = require(script.Parent.UITheme)
local SanctuaryUI = require(script.Parent.SanctuaryUI)
local Story = require(RS.Shared.Story)
local Progression = require(RS.Shared.Progression)
local CaptureRules = require(RS.Shared.CaptureRules)
local Strings = require(RS.Shared.Strings)
local Bands = require(RS.Shared.LevelBands)
local LocalPlayer = Players.LocalPlayer
LocalPlayer:SetAttribute("GraphicsQuality", Text.MEDIO_4F48C1)
local function mk(cls, props, parent)
	local o = Instance.new(cls)
	for k, v in props do
		o[k] = v
	end
	if cls == "TextButton" or cls == "Frame" or cls == "ScrollingFrame" then
		Instance.new("UICorner", o).CornerRadius = UDim.new(0, 12)
	end
	if (cls == "TextButton" or cls == "TextLabel") and o.TextScaled then
		Instance.new("UITextSizeConstraint", o).MaxTextSize = 28
	end
	if cls == "TextButton" then
		o.AutoButtonColor = true
		o.Selectable = true
		Theme.stroke(o)
	end
	o.Parent = parent
	return o
end
local WHITE = Color3.new(1, 1, 1)
local drawerOpen = false
