      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Migration</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Sem serviços. Só acrescenta campos: a sanitização de entrada continua no DataService.
local Config = require(script.Parent.Config)
local C = require(script.Parent.Creatures)
local M = {}
function M.clone(value)
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in value do
		out[k] = M.clone(v)
	end
	return out
end
function M.run(raw)
	if typeof(raw) ~= "table" or typeof(raw.creatures) ~= "table" or next(raw.creatures) == nil then
		return nil, "CORRUPT_PROFILE"
	end
	if typeof(raw.v) ~= "number" or raw.v % 1 ~= 0 or raw.v < 1 or raw.v > Config.ProfileVersion then
		return nil, "FUTURE_OR_INVALID_VERSION"
	end
	-- Recusa o registro inteiro antes de qualquer escrita se uma estrutura essencial estiver inválida.
	for _, key in
		{
			"unlocked",
			"eggs",
			"habitat",
			"sanctuary",
			"stats",
			"claimed",
			"phoenix",
			"grants",
			"legacyEggPermits",
			"legacyGrandfathered",
		}
	do
		if raw[key] ~= nil and type(raw[key]) ~= "table" then
			return nil, "CORRUPT_" .. key
		end
	end
	for uid, pet in raw.creatures do
		if
			type(uid) ~= "string"
			or type(pet) ~= "table"
			or not C.ById[pet.id]
			or type(pet.lv) ~= "number"
			or pet.lv ~= pet.lv
			or pet.lv < 1
			or pet.lv == math.huge
		then
			return nil, "CORRUPT_CREATURE"
		end
	end
	for _, egg in raw.eggs or {} do
		if
			type(egg) ~= "table"
			or not C.ById[egg.id]
			or type(egg.ready) ~= "number"
			or egg.ready ~= egg.ready
			or egg.ready < 0
			or egg.ready == math.huge
		then
			return nil, "CORRUPT_EGG"
		end
	end
	local function number(value, minimum)
		return value == nil
			or (
				type(value) == "number"
				and value == value
				and value >= minimum
				and value < math.huge
				and value % 1 == 0
			)
	end
	for _, key in { "gold", "gems", "seals", "playerXp", "nextId", "last", "wins", "dailyDay", "streak", "trophies" } do
		if not number(raw[key], 0) then
			return nil, "CORRUPT_NUMBER:" .. key
		end
	end
	if not number(raw.playerLevel, 1) then
		return nil, "CORRUPT_LEVEL"
	end
	for _, pet in raw.creatures do
		if not number(pet.lv, 1) or not number(pet.xp, 0) then
			return nil, "CORRUPT_CREATURE_NUMBER"
		end
	end
	for _, values in { raw.stats or {}, raw.materials or {}, raw.sealStock or {} } do
		if type(values) ~= "table" then
			return nil, "CORRUPT_COUNTERS"
		end
		for _, value in values do
			if not number(value, 0) then
				return nil, "CORRUPT_COUNTER"
			end
		end
	end
	if raw.phoenix and not number(raw.phoenix.captureCount, 0) then
		return nil, "CORRUPT_CAPTURE_COUNT"
	end
	local d = M.clone(raw)
	local old = d.v
	d.legacyGrandfathered = d.legacyGrandfathered or {}
	if old < 5 then
		for id, value in d.unlocked or {} do
			if value == true then
				d.legacyGrandfathered[id] = true
			end
		end
	end
	d.phoenix = d.phoenix or { glyphs = {}, sanctuaryOpen = false, attempts = 0, nextAttemptAt = 0, captured = false }
	d.grants = d.grants or {}
	d.legacyEggPermits = d.legacyEggPermits or {}
	for i, egg in d.eggs or {} do
		egg.nonce = egg.nonce or ("legacy:" .. tostring(egg.id) .. ":" .. tostring(egg.ready) .. ":" .. i)
		egg.region = egg.region or "Alvorecer"
		if old < 5 and egg.id == "fenix" then
			d.legacyEggPermits[egg.nonce] = egg.id
		end
	end
	for key, value in { glyphs = {}, sanctuaryOpen = false, attempts = 0, nextAttemptAt = 0, captured = false } do
		if d.phoenix[key] == nil then
			d.phoenix[key] = value
		end
	end
	if type(d.phoenix.glyphs) ~= "table" then
		return nil, "CORRUPT_GLYPHS"
	end
	for _, key in { "attempts", "nextAttemptAt" } do
		local value = d.phoenix[key]
		if type(value) ~= "number" or value ~= value or value < 0 or value == math.huge then
			return nil, "CORRUPT_PHOENIX"
		end
	end
	local existing = 0
	for _, pet in d.creatures do
		if pet.id == "fenix" then
			existing += 1
		end
	end
	d.phoenix.captureCount = math.max(d.phoenix.captureCount or (d.phoenix.captured and 1 or 0), existing)
	if existing > 0 then
		d.phoenix.captured = true
	end
	d.v = Config.ProfileVersion
	return d
end
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Missions</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(script.Parent.Strings).Text
local L = {}
local function add(id, text, stat, goal, gold, gems)
	table.insert(L, { id = id, text = text, stat = stat, goal = goal, gold = gold, gems = gems or 0 })
end
add("f1", Text.ALIMENTE_UMA_FERA_6CB80D, "feed", 1, 40)
add("f2", Text.ALIMENTE_5_VEZES_C4C1AB, "feed", 5, 120, 1)
add("f3", Text.ALIMENTE_20_VEZES_CA2277, "feed", 20, 400, 3)
add("b1", Text.CRUZE_DUAS_FERAS_539F57, "breed", 1, 60)
add("b2", Text.CRUZE_5_VEZES_E3D7DC, "breed", 5, 200, 2)
add("h1", Text.CHOQUE_UM_OVO_03D8B3, "hatch", 1, 60)
add("h2", Text.CHOQUE_5_OVOS_5ED8F1, "hatch", 5, 250, 2)
add("w1", Text.VENCA_UMA_BATALHA_A43940, "win", 1, 80)
add("w2", Text.VENCA_10_BATALHAS_CCE0E5, "win", 10, 500, 3)
add("w3", Text.VENCA_30_BATALHAS_AC517C, "win", 30, 1500, 8)
add("c1", Text.COLETE_OURO_5_VEZES_A103BB, "collect", 5, 100)
add("d1", Text.DESCUBRA_8_FERAS_F45F2C, "found", 8, 300, 3)
add("d2", Text.DESCUBRA_15_FERAS_B78B13, "found", 15, 1200, 6)
add("i1", Text.TENHA_3_ILHAS_FDA36F, "isles", 3, 400, 3)
add("i2", Text.TENHA_TODAS_AS_ILHAS_D2BB30, "isles", #require(script.Parent.Islands).List, 5000, 15)
add("p1", Text.VENCA_UM_DUELO_ONLINE_2F97C7, "duelwin", 1, 200, 3)
add("a1", Text.CONQUISTA_DESCUBRA_TODAS_AS_FERAS_8AFA2F, "found", #require(script.Parent.Creatures).List, 3000, 20)
add("a2", Text.CONQUISTA_100_VITORIAS_29C94D, "win", 100, 5000, 20)
add("a3", Text.CONQUISTA_ALIMENTE_100_VEZES_9D7566, "feed", 100, 2000, 10)
add("a4", Text.CONQUISTA_CHOQUE_25_OVOS_57A023, "hatch", 25, 2500, 10)
add("a5", Text.CONQUISTA_COLETE_50_VEZES_0CDE21, "collect", 50, 1500, 8)
local M = { List = L, ById = {} }
for _, m in L do
	M.ById[m.id] = m
end
function M.progress(d, stat)
	if stat == "found" or stat == "isles" then
		local n = 0
		for _ in (stat == "found" and d.discovered or d.unlocked) do
			n += 1
		end
		return n
	end
	return d.stats[stat] or 0
end
-- Evento rotativo: a cada 3 dias um elemento rende +50% de ouro.
local EL =
	{ Text.FOGO_F77A3C, Text.AGUA_F11A05, Text.NATUREZA_FB1ED9, Text.TERRA_16D3AE, Text.AR_B623FF, Text.SOMBRA_94B135 }
function M.event(now)
	local per = 3 * 86400
	return EL[(now // per) % 6 + 1], per - now % per
end
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">ModelFactory</string>
          <string name="Source"><![CDATA[--!nonstrict
local C = require(script.Parent.Creatures)
local D = require(script.Parent.CreatureDesigns)
local Features = require(script.Parent.CreatureFeatures)
local Factory = {}
local cache = {}
local V = Vector3.new
local A = CFrame.Angles
local function bounds(model)
	local low = V(math.huge, math.huge, math.huge)
	local high = -low
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") and p.Name ~= "Root" then
			for _, x in { -1, 1 } do
				for _, y in { -1, 1 } do
					for _, z in { -1, 1 } do
						local pos = p.CFrame:PointToWorldSpace(p.Size * V(x, y, z) * 0.5)
						low = V(math.min(low.X, pos.X), math.min(low.Y, pos.Y), math.min(low.Z, pos.Z))
						high = V(math.max(high.X, pos.X), math.max(high.Y, pos.Y), math.max(high.Z, pos.Z))
					end
				end
			end
		end
	end
	return low, high
end
Factory.bounds = bounds
function Factory.validate(model)
	assert(model.PrimaryPart and model.PrimaryPart.Name == "Root", "Raiz ausente")
	local design = D[model:GetAttribute("Species")]
	local stage = model:GetAttribute("Stage")
	assert(design and stage, "Receita ou estágio ausente")
	local count, joints, emitters, lights = 0, {}, 0, 0
	for _, obj in model:GetDescendants() do
		assert(not obj:IsA("LuaSourceContainer"), "Script dentro da criatura")
		if obj:IsA("BasePart") then
			count += 1
			for _, n in { obj.Size.X, obj.Size.Y, obj.Size.Z } do
				assert(n == n and n > 0 and n < 100, "Size inválido")
			end
			assert(
				not obj.CanCollide and not obj.CanQuery and not obj.CanTouch and obj.Massless,
				"Colisão/massa inválida"
			)
			assert(obj == model.PrimaryPart or not obj.Anchored, "Parte visual ancorada")
		elseif obj:IsA("Motor6D") then
			assert(not joints[obj.Name], "Joint duplicado")
			joints[obj.Name] = true
			assert(obj.Part0 and obj.Part1, "Motor desconectado")
		elseif obj:IsA("ParticleEmitter") then
			emitters += 1
		elseif obj:IsA("Light") then
			lights += 1
		end
	end
	assert(count <= design.budget[stage], "Orçamento excedido: " .. count)
	assert(emitters <= (design.head == "solarbeak" and 2 or 1) and lights <= 1, "Orçamento de efeitos excedido")
	local low, high = bounds(model)
	local size = high - low
	assert(
		size.Magnitude > 0.6 and size.Magnitude < (design.head == "solarbeak" and 70 or ({ 20, 30, 45 })[stage]),
		"Bounding box inválida"
	)
	return { parts = count, joints = joints, size = size, emitters = emitters, lights = lights }
end
local function template(def, stage)
	local d = D[def.id]
	assert(d, "Design ausente")
	local recipe = d.stages[stage]
	local scale = recipe.scale
	local palette = d.palette
	local m = Instance.new("Model")
	m.Name = def.name
	m.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	m:SetAttribute("Species", def.id)
	m:SetAttribute("Stage", stage)
	m:SetAttribute("Family", d.family)
	m:SetAttribute("EyeType", d.eyes)
	m:SetAttribute("HeadType", d.head)
	m:SetAttribute("TailType", d.tail)
	m:SetAttribute("LimbCount", d.limbs)
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = V(0.1, 0.1, 0.1) * scale
	root.CFrame = CFrame.new(0, 2 * scale, 0)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Massless = true
	root.CastShadow = false
	root.Parent = m
	m.PrimaryPart = root
	root.CollisionGroup = "Creatures"
	local names = {}
	local function make(name, kind, size, pos, color, rotation, motor, parent)
		names[name] = (names[name] or 0) + 1
		local suffix = names[name] > 1 and "_" .. names[name] or ""
		local p = Instance.new(kind == "wedge" and "WedgePart" or kind == "corner" and "CornerWedgePart" or "Part")
		p.Name = name .. suffix
		p.Size = size * scale
		p.CFrame = CFrame.new(pos * scale) * (rotation or CFrame.identity)
		p.Color = color
		p.Material = Enum.Material.SmoothPlastic
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Massless = true
		p.Anchored = false
		p.CastShadow = p.Size.Magnitude > 2
		p.CollisionGroup = "Creatures"
		if kind == "sphere" or kind == "head" then
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = kind == "head" and Enum.MeshType.Head or Enum.MeshType.Sphere
			mesh.Scale = kind == "head" and V(1, 0.9, 1) or V(1, 1, 1)
			mesh.Parent = p
		elseif kind == "cylinder" then
			p.Shape = Enum.PartType.Cylinder
		end
		p:SetAttribute("Feature", name:gsub("%d+", ""))
		p.Parent = m
		local anchor = parent or root
		if motor then
			local joint = Instance.new("Motor6D")
			joint.Name = "J_" .. p.Name
			joint.Part0 = anchor
			joint.Part1 = p
			joint.C0 = anchor.CFrame:ToObjectSpace(p.CFrame)
			joint.Parent = p
			joint:SetAttribute("Role", name)
			joint:SetAttribute("Phase", #m:GetChildren() * 0.27)
		else
			local weld = Instance.new("WeldConstraint")
			weld.Name = "W_" .. p.Name
			weld.Part0 = anchor
			weld.Part1 = p
			weld.Parent = p
		end
		return p
	end
	local w, h, l = d.dimensions.X, d.dimensions.Y, d.dimensions.Z
	local child = stage == 1
	local limbHeight = child and 0.55 or stage == 2 and 1 or 1.45
	local headPos
	local torso
	local family = d.family
	if family == "draconic" and d.head == "raptor" then
		torso = make(
			"Body",
			"wedge",
			V(w, h, l * 0.55),
			V(0, limbHeight + h * 0.6, 0),
			palette[1],
			A(-0.3, math.pi, 0),
			true
		)
		make(
			"Keel",
			"wedge",
			V(w * 0.6, h * 0.6, l * 0.4),
			V(0, limbHeight + h * 0.4, 0.7),
			palette[2],
			nil,
			false,
			torso
		)
		headPos = V(0, limbHeight + h * 1.15, l * 0.25)
	elseif family == "quadruped" or family == "draconic" then
		torso = make("Body", "sphere", V(w, h * 0.7, l), V(0, limbHeight + h * 0.35, 0), palette[1], nil, true)
		make(
			"Haunch",
			"sphere",
			V(w * 0.85, h * 0.65, l * 0.6),
			V(0, limbHeight + h * 0.25, -l * 0.35),
			palette[2],
			nil,
			false,
			torso
		)
		headPos = V(0, limbHeight + h * 0.7, l * 0.5)
	elseif family == "biped" or (family == "mineral" and d.limbs == 4) then
		torso =
			make("Body", "wedge", V(w, h, l * 0.65), V(0, limbHeight + h * 0.5, 0), palette[1], A(0, math.pi, 0), true)
		headPos = V(0, limbHeight + h + 0.4, 0.3)
	elseif family == "winged" then
		torso =
			make("Body", "sphere", V(w, h * 0.65, l), V(0, limbHeight + h * 0.35, 0), palette[1], A(-0.2, 0, 0), true)
		local neck = child and 0.35 or stage == 2 and 0.9 or 1.4
		make(
			"Neck",
			"sphere",
			V(w * 0.5, neck + 1, w * 0.5),
			V(0, limbHeight + h * 0.7, 0.5),
			palette[2],
			A(0.2, 0, 0),
			false,
			torso
		)
		headPos = V(0, limbHeight + h * 0.8 + neck, l * 0.35)
	elseif family == "serpentine" then
		torso = make("Body", "sphere", V(w, h, l * 0.5), V(0, h * 0.8, 0.4), palette[1], nil, true)
		headPos = V(0, h * 1.3, 1.3)
		for i = 1, stage + 1 do
			make(
				"Coil" .. i,
				"sphere",
				V(w * (1 - i * 0.1), h * 0.7, l * 0.45),
				V(math.sin(i * 0.9) * 0.8, h * 0.45, -i * 0.8),
				palette[i % 2 + 1],
				A(0, math.sin(i) * 0.3, 0),
				true,
				torso
			)
		end
	elseif family == "arthropod" then
		torso = make("Body", "sphere", V(w, h, l), V(0, 1 + h * 0.4, 0), palette[1], nil, true)
		make(
			"Carapace",
			"wedge",
			V(w * 0.9, h * 0.7, l * 0.75),
			V(0, 1 + h * 0.7, -0.2),
			palette[2],
			A(0, math.pi, 0),
			false,
			torso
		)
		headPos = V(0, 1 + h * 0.5, l * 0.5)
	elseif family == "aquatic" then
		torso = make("Body", "sphere", V(w, h, l), V(0, h * 0.6, 0), palette[1], nil, true)
		headPos = V(0, h * 0.7, l * 0.4)
		for _, s in { -1, 1 } do
			make(
				"Fin" .. s,
				"wedge",
				V(0.2, h, l * 0.55),
				V(s * w * 0.55, h * 0.5, 0),
				palette[2],
				A(0, 0, s * 0.5),
				true,
				torso
			)
		end
	elseif family == "vegetal" then
		torso = make("Body", "sphere", V(w, h, l), V(0, 1 + h * 0.4, 0), palette[1], A(0.1, 0, 0), true)
		headPos = V(0, 1 + h * 0.9, 0.3)
	elseif family == "spectral" then
		torso = make("Body", "wedge", V(w, h, l), V(0, h * 0.6, 0), palette[1], A(0, math.pi, 0), true)
		torso.Material = Enum.Material.Fabric
		headPos = V(0, h + 0.5, 0.3)
		for i = 1, stage + 1 do
			local veil = make(
				"Veil" .. i,
				"wedge",
				V(w * 0.4, 1.1, l * 0.5),
				V((i - (stage + 2) / 2) * 0.5, 0.7, -0.4),
				palette[2],
				A(0, 0, i * 0.15),
				true,
				torso
			)
			veil.Transparency = 0.2
		end
	else
		torso = make("Body", "wedge", V(w, h, l), V(0, h * 0.5 + 0.3, 0), palette[1], A(0, math.pi / 3, 0), true)
		make(
			"StoneShoulder",
			"corner",
			V(w * 0.65, h * 0.6, l * 0.6),
			V(w * 0.3, h * 0.7, 0),
			palette[2],
			nil,
			false,
			torso
		)
		headPos = V(0, h + 0.3, 0.3)
	end
	local headRatio = recipe.headRatio
	local heads = {
		embermask = { "wedge", V(1.4, 0.8, 1.2) },
		boar = { "sphere", V(1.9, 1.2, 1.7) },
		hookbeak = { "head", V(1.3, 1.4, 1.3) },
		hornjaw = { "head", V(1.8, 1.5, 1.8) },
		puffer = { "sphere", V(1.8, 1.5, 1.4) },
		narrow = { "wedge", V(0.9, 0.8, 1.8) },
		crab = { "wedge", V(1.5, 0.75, 1) },
		angler = { "sphere", V(2, 1.4, 1.8) },
		bud = { "sphere", V(1.2, 1.6, 1.2) },
		fox = { "wedge", V(1.4, 1.2, 1.8) },
		trilobe = { "head", V(1.6, 0.7, 1.2) },
		stagmask = { "head", V(1.6, 2, 1.2) },
		geode = { "corner", V(1.4, 1, 1.2) },
		mandible = { "wedge", V(1.3, 0.8, 1.5) },
		sphinx = { "head", V(1.8, 1.8, 1.5) },
		obelisk = { "wedge", V(1.1, 2, 1.2) },
		chick = { "head", V(1.7, 1.8, 1.3) },
		needlebeak = { "head", V(0.9, 1.6, 1.2) },
		raptor = { "wedge", V(1.1, 1.3, 1.7) },
		cloudcap = { "sphere", V(2, 1.4, 1.6) },
		puddle = { "sphere", V(1.8, 0.9, 1.8) },
		lanterncap = { "wedge", V(0.9, 1.6, 1) },
		mothmask = { "head", V(1.4, 0.9, 1.3) },
		royalmask = { "wedge", V(1.3, 2.1, 0.7) },
		steamcap = { "sphere", V(1.5, 1.3, 1.7) },
		armoredjaw = { "wedge", V(1.8, 1, 2) },
		crestbeak = { "head", V(1.2, 1.8, 1.4) },
		hood = { "wedge", V(1.5, 2, 1.2) },
		sweptjaw = { "wedge", V(1.3, 1, 2.2) },
		solarbeak = { "head", V(1.1, 1.7, 1.7) },
	}
	local hp = heads[d.head]
	local headSize = hp[2] * headRatio
	local head = make("Head", hp[1], headSize, headPos, palette[2], nil, true, torso)
	if family == "mineral" then
		torso.Material = Enum.Material.Granite
		head.Material = Enum.Material.Slate
	elseif family == "vegetal" then
		torso.Material = Enum.Material.Wood
		head.Material = Enum.Material.Fabric
	elseif family == "aquatic" then
		torso.Material = Enum.Material.SmoothPlastic
	elseif family == "arthropod" then
		torso.Material = Enum.Material.Sandstone
	end
	if family == "quadruped" or family == "draconic" then
		make(
			"Snout",
			"sphere",
			V(d.head == "boar" and 1.3 or 0.9, 0.6, 0.9) * headRatio,
			headPos + V(0, -0.25, 0.75),
			palette[1],
			nil,
			false,
			head
		)
	end
	if family == "winged" then
		make(
			"Beak",
			"wedge",
			V(0.55, 0.4, d.head == "needlebeak" and 1.1 or 0.8),
			headPos + V(0, -0.15, 0.9),
			palette[3],
			A(0, math.pi, 0),
			false,
			head
		)
	end
	Features.face(make, d, head, headPos, headRatio, stage, headSize)
	-- Esqueleto locomotor varia: raízes, patas articuladas, braços ou pernas de artrópode.
	local legs = family == "winged" and 2 or family == "draconic" and 4 or family == "arthropod" and d.limbs or d.limbs
	for i = 1, legs do
		local side = i % 2 == 1 and -1 or 1
		local pair = math.floor((i - 1) / 2)
		local z = legs >= 4 and ((pair - (math.ceil(legs / 2) - 1) / 2) * l * 0.45) or 0.2
		local x = side * w * 0.4
		local y = limbHeight * 0.55
		if d.head == "raptor" and i > 2 then
			y = limbHeight + h * 0.6
			z = 0.7
		end
		local shape = (family == "arthropod" or family == "vegetal") and "cylinder" or "sphere"
		local leg = make(
			"Leg" .. i,
			shape,
			V(family == "arthropod" and 0.16 or 0.45, limbHeight, 0.5),
			V(x, y, z),
			palette[1],
			family == "arthropod" and A(0, 0, side * 0.9) or nil,
			true,
			torso
		)
		if not child then
			make("Foot" .. i, "wedge", V(0.55, 0.3, 0.8), V(x, 0.2, z + 0.2), palette[3], nil, false, leg)
		end
	end
	if family == "winged" or family == "draconic" then
		local feathers = child and 1 or stage == 2 and 3 or 5
		if def.acquisition == "special" then
			feathers = 8
		end
		local rows = def.acquisition == "special" and 3 or 1
		for _, side in { -1, 1 } do
			for row = 1, rows do
				for i = 1, feathers do
					local name = "Wing" .. (side < 0 and "L" or "R") .. "_" .. row .. "_" .. i
					local wingColor = palette[math.min(4, row + 1)]
					if def.acquisition == "special" then
						wingColor = palette[row]:Lerp(palette[row + 1], 0.3 + i / feathers * 0.7)
					end
					make(
						name,
						"wedge",
						V(0.45, 0.25, child and 1 or 1.8 + i * 0.25),
						V(side * (w * 0.4 + i * 0.55), headPos.Y - 0.8 - row * 0.12, -row * 0.45 - i * 0.13),
						wingColor,
						A(
							d.feature == "stormcrown" and -0.5 or 0.1 * row,
							side * (d.feature == "stormcrown" and 0.8 or 0.25),
							side * (0.15 + i * 0.035)
						),
						true,
						torso
					)
				end
			end
		end
	end
	local tails = child and 1 or stage == 2 and 2 or 4
	if def.acquisition == "special" then
		tails = 11
	end
	for i = 1, tails do
		local feathered = family == "winged"
		local width = feathered and 0.4 or 0.55
		local pos = feathered and V((i - (tails + 1) / 2) * 0.3, h * 0.6, -l * 0.6 - i * 0.15)
			or V(math.sin(i * 0.8) * 0.35, h * 0.4 - i * 0.12, -l * 0.5 - i * 0.55)
		make(
			"Tail" .. i,
			feathered and "wedge" or "sphere",
			V(width, 0.4, feathered and (2 + i * 0.25) or 0.9),
			pos,
			palette[i % 3 + 1],
			A(feathered and -0.25 or 0, (i - (tails + 1) / 2) * 0.09, 0),
			true,
			torso
		)
	end
	if def.acquisition ~= "special" then
		local tip = V(0, h * 0.4 - tails * 0.12, -l * 0.5 - tails * 0.55 - 0.3)
		local broad = { club = true, cinder = true, gravel = true, anchor = true, stump = true, hammer = true }
		if broad[d.tail] then
			make(
				"TailTip",
				"wedge",
				V(d.tail == "hammer" and 1.5 or 0.8, 0.5, 0.7),
				tip,
				palette[3],
				A(0, 0.3, 0),
				true,
				torso
			)
		elseif d.tail == "stinger" or d.tail == "bolt" or d.tail == "spade" then
			make(
				"TailTip",
				"wedge",
				V(0.3, child and 0.25 or 1.1, 0.6),
				tip + V(0, 0.5, 0),
				palette[3],
				A(0.35, 0, 0),
				true,
				torso
			)
		elseif d.tail == "lantern" or d.tail == "glowbulb" then
			local bulb = make("TailLantern", "sphere", V(0.8, 0.7, 0.7), tip, palette[3], nil, true, torso)
			bulb.Material = Enum.Material.Neon
		elseif not (family == "winged") then
			for _, side in { -1, 1 } do
				make(
					"TailFin" .. side,
					"wedge",
					V(0.2, child and 0.3 or 0.8, 1.2),
					tip + V(side * 0.4, 0, 0),
					palette[2],
					A(0, 0, side * 0.5),
					true,
					torso
				)
			end
		end
	end
	Features.trait(make, d, headPos, stage, head, torso)
	Features.surface(make, d, V(0, h * 0.65, 0), stage, torso)
	if def.acquisition == "special" then
		for i = 1, 16 do
			local a = i * math.pi / 8
			make(
				"HaloSegment" .. i,
				"cylinder",
				V(0.14, 0.45, 0.45),
				headPos + V(math.cos(a) * 1.8, 1.3 + math.sin(a) * 1.8, -0.6),
				palette[3],
				A(0, 0, a),
				true,
				head
			)
		end
		for i = 1, 8 do
			local a = i * math.pi / 4
			make(
				"HaloRay" .. i,
				"wedge",
				V(0.18, 0.7, 0.18),
				headPos + V(math.cos(a) * 2.2, 1.3 + math.sin(a) * 2.2, -0.6),
				palette[4],
				A(0, 0, -a),
				true,
				head
			)
		end
		for i = 1, 6 do
			make(
				"ChestFeather" .. i,
				"wedge",
				V(0.8, 0.25, 0.8),
				V(0, h * 0.7 + i * 0.2, l * 0.3),
				palette[i % 3 + 2 > 4 and 4 or i % 3 + 2],
				A(0.3, 0, 0),
				false,
				torso
			)
		end
	end
	if def.acquisition == "special" then
		for i = 1, 11 do
			make(
				"TailGildedTip" .. i,
				"wedge",
				V(0.24, 0.12, 0.8),
				V((i - 6) * 0.3, h * 0.6 - 0.3, -l * 0.6 - i * 0.15 - (2 + i * 0.25) * 0.35),
				palette[3]:Lerp(palette[4], i / 11),
				A(-0.25, (i - 6) * 0.09, 0),
				false,
				m:FindFirstChild("Tail" .. i)
			)
		end
	end
	Factory.validate(m)
	return m
end
function Factory.build(def, level, options)
	options = options or {}
	local stage = C.stage(level, def.id)
	local key = def.id .. ":" .. stage
	if not cache[key] then
		cache[key] = template(def, stage)
	end
	local model = cache[key]:Clone()
	model.Name = def.name
	model:SetAttribute("Level", level)
	if not options.preview then
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(180, 32)
		gui.StudsOffset = V(0, 4, 0)
		gui.MaxDistance = 60
		gui.Parent = model.PrimaryPart
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextStrokeTransparency = 0.4
		label.TextSize = 14
		label.Font = Enum.Font.GothamBold
		label.Text = def.name .. " • Nv." .. level
		label.Parent = gui
	end
	Factory.validate(model)
	return model
end
function Factory.clearCache()
	for _, m in cache do
		m:Destroy()
	end
	cache = {}
end
return Factory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">PhoenixQuest</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(script.Parent.Strings).Text
local Config = require(script.Parent.Config)
local Q = { Glyphs = { duneHidden = true, duneRuin = true, skyPeak = true } }
function Q.stage(profile)
	local n = 0
	for id, value in (profile.phoenix and profile.phoenix.glyphs or {}) do
		if value == true and Q.Glyphs[id] then
			n += 1
		end
	end
	return math.min(3, n)
end
function Q.public(profile)
	local stage = Q.stage(profile)
	if stage == 0 then
		return { stage = 0 }
	end
	if stage == 1 then
		return {
			stage = 1,
			title = Text.ECO_DE_FOGO_ANTIGO_40525F,
			hint = Text.UMA_INSCRICAO_MENCIONA_DOIS_SINAIS_ENTRE_AREIA_E_4D4A59,
		}
	end
	if stage == 2 then
		return {
			stage = 2,
			title = Text.VESTIGIOS_513BA0,
			hint = Text.AS_RUINAS_DAS_DUNAS_RESPONDEM_AOS_SINAIS_DAS_ALT_695E0C,
		}
	end
	return {
		stage = 3,
		title = Text.VESTIGIOS_513BA0,
		hint = Text.OFERECA_UMA_CHAMA_NO_ALTAR_DAS_RUINAS_24F74A,
		nextAttemptAt = profile.phoenix.nextAttemptAt,
		captured = (profile.phoenix.captureCount or (profile.phoenix.captured and 1 or 0))
			>= Config.PhoenixMaxPerAccount,
	}
end
function Q.check(profile, now)
	if not Config.V7.PhoenixSanctuary then
		return false, "DISABLED"
	end
	if (profile.playerLevel or 1) < 45 or not (profile.unlocked and profile.unlocked.Dunas) then
		return false, "REQUIREMENTS"
	end
	if Q.stage(profile) < 3 then
		return false, "GLYPHS"
	end
	if (profile.phoenix.captureCount or (profile.phoenix.captured and 1 or 0)) >= Config.PhoenixMaxPerAccount then
		return false, "CAPTURED"
	end
	if profile.phoenix.encounterId then
		return false, "ACTIVE"
	end
	if now < (profile.phoenix.nextAttemptAt or 0) then
		return false, "COOLDOWN"
	end
	return true
end
return Q
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Progression</string>
          <string name="Source"><![CDATA[--!strict
local Bands = require(script.Parent.LevelBands)
local P = { MaxLevel = 100, EncountersPerHour = 50 }
local checkpoints = {
	{ level = 1, hours = 0 },
	{ level = 10, hours = 0.75 },
	{ level = 18, hours = 2 },
	{ level = 26, hours = 4 },
	{ level = 34, hours = 7 },
	{ level = 42, hours = 11 },
	{ level = 50, hours = 16 },
}
function P.playerCost(level: number): number
	for index = 1, #checkpoints - 1 do
		local a, b = checkpoints[index], checkpoints[index + 1]
		if level >= a.level and level < b.level then
			return math.floor((b.hours - a.hours) / (b.level - a.level) * P.EncountersPerHour * (60 + index * 10) + 0.5)
		end
	end
	return 2200 + (level - 50) * 75
end
function P.rewards(region: string, foeLevel: number, rarity: number, teamLevel: number)
	local band = assert(Bands.ById[region], "Região de recompensa desconhecida")
	local gap = teamLevel - foeLevel
	local penalty = gap >= 15 and 0.1 or gap >= 8 and 0.5 or 1
	return {
		gold = 30 * band.index ^ 2 + foeLevel * 2 + rarity * 3,
		xp = math.max(1, math.floor((60 + band.index * 10 + (rarity - 1) * 5) * penalty)),
		creatureXp = math.max(1, math.floor((45 + band.index * 8 + (rarity - 1) * 5) * penalty)),
		penalty = penalty,
	}
end
function P.creatureCost(level: number): number
	return 35 + level * 15
end
function P.award(data: any, amount: number)
	data.playerXp = math.min(1e9, (data.playerXp or 0) + math.max(0, math.floor(amount)))
	data.playerLevel = data.playerLevel or 1
	while data.playerLevel < P.MaxLevel and data.playerXp >= P.playerCost(data.playerLevel) do
		data.playerXp -= P.playerCost(data.playerLevel)
		data.playerLevel += 1
	end
end
function P.awardCreature(creature: any, amount: number)
	creature.xp = math.min(1e9, (creature.xp or 0) + math.max(0, math.floor(amount)))
	while creature.lv < P.MaxLevel and creature.xp >= P.creatureCost(creature.lv) do
		creature.xp -= P.creatureCost(creature.lv)
		creature.lv += 1
	end
end
return P
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">SanctuaryRules</string>
          <string name="Source"><![CDATA[--!nonstrict
local R = { MaxLevel = 3, Slots = 9, BuildBase = 120 }
function R.slot(index)
	if typeof(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > 9 then
		return nil
	end
	return ((index - 1) % 3 - 1) * 36, (math.floor((index - 1) / 3) - 1) * 36
end
function R.available(structures, slot, ignore)
	if not R.slot(slot) then
		return false
	end
	for id, entry in structures do
		if id ~= ignore and entry.slot == slot then
			return false
		end
	end
	return true
end
function R.capacity(def, entry)
	return def.slots + ((entry and entry.level or 1) - 1) * 2
end
function R.buildCost(def)
	return R.BuildBase * def.idx
end
function R.upgradeCost(entry)
	return 180 * entry.level
end
function R.validate(raw, unlocked, islands)
	local out = {}
	local occupied = {}
	if typeof(raw) == "table" then
		for _, def in islands do
			local entry = raw[def.id]
			if unlocked[def.id] and typeof(entry) == "table" and R.slot(entry.slot) and not occupied[entry.slot] then
				local level = typeof(entry.level) == "number"
						and entry.level == entry.level
						and math.clamp(math.floor(entry.level), 1, 3)
					or 1
				out[def.id] = { slot = entry.slot, level = level }
				occupied[entry.slot] = true
			end
		end
	end
	return out
end
return R
]]></string>
        </Properties>
      </Item>
