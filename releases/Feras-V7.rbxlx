      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">CreatureDesigns</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Receitas anatômicas reais; o ID não é usado para inventar métricas de diferença.
local rows = {
	-- id,família,cabeça,olhos,cauda,membros,traço exclusivo,superfície,dimensões,cores
	{
		"cinzelo",
		"mineral",
		"embermask",
		"emberslit",
		"cinder",
		2,
		"chimney",
		"cracks",
		{ 2.2, 1.7, 2.0 },
		{ 0x523A38, 0xD57943, 0xFFD58D, 0x322B32 },
	},
	{
		"magmarau",
		"quadruped",
		"boar",
		"vertical",
		"club",
		4,
		"tusks",
		"plates",
		{ 2.5, 2.5, 4.0 },
		{ 0x873E37, 0xD99552, 0xEBCB8A, 0x372D39 },
	},
	{
		"fenixfuligem",
		"winged",
		"hookbeak",
		"emberslit",
		"fan",
		4,
		"ashcrest",
		"feathers",
