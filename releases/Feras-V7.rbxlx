		"comet",
		6,
		"ashwings",
		"ash",
		{ 2.2, 3.5, 5.4 },
		{ 0x655466, 0xB07769, 0xD8B99F, 0x969CB8 },
	},
	{
		"fenix",
		"winged",
		"solarbeak",
		"solar",
		"solartrain",
		4,
		"solarcrest",
		"layeredplumage",
		{ 2.3, 4.5, 3.6 },
		{ 0x8F263C, 0xE86435, 0xF4B846, 0xFFF1CA },
	},
}
local D = {}
for _, r in rows do
	local palette = {}
	for _, hex in r[10] do
		table.insert(palette, Color3.fromRGB(math.floor(hex / 65536) % 256, math.floor(hex / 256) % 256, hex % 256))
	end
	D[r[1]] = {
		family = r[2],
		bodyPlan = r[2] .. ":" .. r[3],
		appendages = { r[7], r[5] },
		elementalMotif = r[8],
		head = r[3],
		eyes = r[4],
		tail = r[5],
		limbs = r[6],
		feature = r[7],
		surface = r[8],
		dimensions = Vector3.new(table.unpack(r[9])),
		palette = palette,
		stages = {
			{
				scale = 0.65,
				headRatio = 1.2,
				detail = 1,
				keep = { "face", "body" },
				replace = { "shortlimbs" },
				add = {
					"bud",
				},
			},
			{
				scale = 1,
				headRatio = 1,
				detail = 2,
				keep = { "face" },
				replace = { "limbs" },
				add = { "tail", "pattern" },
			},
			{
				scale = 1.35,
				headRatio = 0.9,
				detail = 3,
				keep = { "palette" },
				replace = { "posture", "appendages" },
				add = {
					"armor",
					"crest",
				},
			},
		},
		budget = { 28, 48, 80 },
		anim = r[2],
		lod = { near = 70, mid = 150, hide = 300 },
	}
end
D.fenix.budget = { 170, 170, 170 }
return D
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">CreatureFeatures</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Biblioteca de componentes sem IDs de assets. O factory fornece make(name,kind,size,pos,color,rotation,joint,parent).
local F = {}
local V = Vector3.new
local A = CFrame.Angles
function F.face(make, d, head, position, scale, stage, headSize)
	local p = d.palette
	local kind = d.eyes
	local front = headSize.Z / scale * 0.5 + 0.04
	local sideWidth = headSize.X / scale * 0.5 + 0.03
	local sizes = {
		vertical = V(0.5, 0.65, 0.1),
		emberslit = V(0.55, 0.14, 0.1),
		fish = V(0.48, 0.55, 0.12),
		compound = V(0.48, 0.5, 0.18),
		crystal = V(0.5, 0.6, 0.12),
		blindmarks = V(0.6, 0.12, 0.1),
		barkmarks = V(0.35, 0.6, 0.1),
		electric = V(0.55, 0.36, 0.1),
		solar = V(0.6, 0.65, 0.13),
	}
	if kind == "cyclops" or kind == "lantern" then
		local eye = make(
			"EyeCenter",
			"sphere",
			V(0.9, 0.65, 0.16) * scale,
			position + V(0, 0.12, front) * scale,
			p[3],
			nil,
			true,
			head
		)
		make(
			"IrisCenter",
			"wedge",
			V(0.15, 0.4, 0.08) * scale,
			position + V(0, 0.12, front + 0.1) * scale,
			p[1],
			nil,
			false,
			eye
		)
	else
		for _, side in { -1, 1 } do
			local pos = position + V(side * 0.5, 0.15, front) * scale
			if kind == "fish" then
				pos = position + V(side * sideWidth, 0.12, 0.2) * scale
			end
			local shape = (kind == "crystal" or kind == "electric" or kind == "emberslit") and "wedge" or "sphere"
			local eye = make(
				"Eye" .. (side < 0 and "L" or "R"),
				shape,
				(sizes[kind] or V(0.6, 0.65, 0.13)) * scale,
				pos,
				p[3],
				kind == "fish" and A(0, side * math.pi / 2, 0) or nil,
				true,
				head
			)
			if kind == "compound" then
				for i = 1, 2 do
					make(
						"Facet" .. side .. i,
						"wedge",
						V(0.13, 0.18, 0.05) * scale,
						pos + V((i - 1.5) * 0.15, 0.05, 0.1) * scale,
						p[4],
						nil,
						false,
						eye
					)
				end
			elseif kind ~= "blindmarks" and kind ~= "barkmarks" and kind ~= "emberslit" then
				make(
					"Iris" .. side,
					"sphere",
					V(kind == "vertical" and 0.1 or 0.23, 0.34, 0.06) * scale,
					pos + V(0, 0, 0.09) * scale,
					p[1],
					nil,
					false,
					eye
				)
			end
		end
	end
	if stage >= 2 then
		make(
			"Mouth",
			"wedge",
			V(0.5, 0.1, 0.12) * scale,
			position + V(0, -0.38, front + 0.04) * scale,
			p[1],
			nil,
			false,
			head
		)
	end
end
function F.trait(make, d, position, stage, parent, body)
	local feature = d.feature
	local p = d.palette
	local rank = stage == 1 and 1 or stage == 2 and 2 or 4
	if feature == "stormcrown" then
		for _, side in { -1, 1 } do
			make(
				"StormFork" .. side,
				stage == 1 and "sphere" or "wedge",
				V(0.25, 0.4 + stage * 0.45, 0.35),
				position + V(side * 0.7, 1.0, -0.3),
				p[3],
				A(0, 0, side * 0.65),
				true,
				parent
			)
			if stage >= 2 then
				make(
					"StormCollar" .. side,
					"wedge",
					V(1.2, 0.25, 0.7),
					position + V(side * 0.7, -0.7, 0.2),
					p[4],
					A(0, 0, side * 0.4),
					false,
					body
				)
			end
		end
	elseif feature == "ribboncrest" then
		for _, side in { -1, 1 } do
			make(
				"RibbonStreamer" .. side,
				"wedge",
				V(0.2, 0.16, stage == 1 and 0.8 or 1.8 + stage * 0.7),
				position + V(side * 0.35, 0.65, -1),
				p[4],
				A(-0.3, side * 0.3, side * 0.2),
				true,
				parent
			)
		end
	elseif feature == "gillfans" then
		for _, side in { -1, 1 } do
			make(
				"GillFan" .. side,
				"wedge",
				V(0.14, 0.6 + stage * 0.25, 0.8),
				position + V(side * 1, 0.05, -0.3),
				p[2],
				A(0, side * 0.4, side * 0.3),
				true,
				parent
			)
		end
	elseif feature == "dorsalsail" then
		make(
			"DorsalSail",
			"wedge",
			V(0.15, stage == 1 and 0.4 or 1.3, 2),
			position + V(0, 0.5, -1.3),
			p[3],
			A(0.3, 0, 0),
			true,
			body
		)
	elseif feature == "chimney" then
		make(
			"FurnaceVent",
			"cylinder",
			V(0.5, 0.55, stage == 1 and 0.4 or 1.1),
			position + V(0, 0.7, -0.4),
			p[1],
			A(math.pi / 2, 0, 0),
			false,
			parent
		)
		if stage >= 2 then
			make("CoalCore", "sphere", V(0.3, 0.15, 0.3), position + V(0, 1.1, -0.4), p[3], nil, false, parent).Material =
				Enum.Material.Neon
		end
	elseif feature == "rockplates" then
		for i = 1, rank do
			make(
				"BasaltPlate" .. i,
				"corner",
				V(0.9, 0.5, 0.8),
				position + V(0, -0.3, -i * 0.7),
				p[2],
				A(0.2, 0, i % 2 * 0.3),
				false,
				body
			)
		end
	elseif feature == "royalcrown" then
		for i = 1, rank do
			make(
				"CrownLobe" .. i,
				stage == 1 and "sphere" or "corner",
				V(0.4, 0.4 + stage * 0.3, 0.3),
				position + V((i - (rank + 1) / 2) * 0.5, 1.2, -0.15),
				p[3],
				A(0, 0, (i - (rank + 1) / 2) * 0.2),
				true,
				parent
			)
		end
	elseif feature == "ashwings" then
		for _, side in { -1, 1 } do
			make(
				"AshSickle" .. side,
				"wedge",
				V(0.3, 1.1, 2.2),
				position + V(side * 1.1, 0.3, -1.3),
				p[4],
				A(-0.4, side * 0.4, side * 0.6),
				true,
				body
			)
		end
	elseif feature == "tusks" then
		for _, side in { -1, 1 } do
			make(
				"Tusk" .. side,
				stage == 1 and "sphere" or "wedge",
				V(0.25, stage == 1 and 0.25 or 0.8 + stage * 0.15, 0.3),
				position + V(side * 0.7, -0.1, 1),
				p[3],
				A(-0.3, 0, -side * 0.2),
				true,
				parent
			)
		end
	elseif feature == "antlers" or feature == "lichenantlers" then
		for _, side in { -1, 1 } do
			local antler = make(
				"Antler" .. side,
				stage == 1 and "sphere" or "cylinder",
				V(0.2, stage == 1 and 0.3 or 1.3, 0.25),
				position + V(side * 0.65, stage == 1 and 0.6 or 1.1, -0.3),
				p[2],
				A(0, 0, side * 0.35),
				true,
				parent
			)
			if stage >= 2 then
				make(
					"Branch" .. side,
					"wedge",
					V(0.8, 0.2, 0.25),
					position + V(side * 0.95, 1.5, -0.3),
					p[3],
					A(0, 0, side * 0.3),
					false,
					antler
				)
			end
		end
	elseif feature == "headdress" or feature == "shoulderarches" then
		for _, side in { -1, 1 } do
			make(
				"Panel" .. side,
				"wedge",
				V(stage == 1 and 0.4 or 0.7, 0.6 + stage * 0.35, 0.55),
				position + V(side * 1.0, -0.2, -0.35),
				p[3],
				A(0, 0, side * 0.15),
				false,
				parent
			)
		end
	elseif feature == "pincers" or feature == "pearlclaws" then
		for _, s in { -1, 1 } do
			make(
				"Claw" .. s,
				"wedge",
				V(0.7, stage == 1 and 0.5 or 1, 1.3),
				position + V(s * 1.7, -0.6, 1.3),
				p[2],
				A(0, s * 0.3, 0),
				true,
				parent
			)
		end
	elseif feature == "flower" or feature == "seedleaves" or feature == "leafears" or feature == "lichenantlers" then
		for i = 1, rank + 1 do
			local a = i * math.pi * 2 / (rank + 1)
			make(
				"Petal" .. i,
				"wedge",
				V(0.5, 0.9, 0.18),
				position + V(math.cos(a) * 0.7, 0.7 + math.sin(a) * 0.4, -0.1),
				p[i % 2 + 2],
				A(0, 0, -a),
				true,
				parent
			)
		end
	elseif feature == "lure" or feature == "antennalure" then
		make("LureStem", "cylinder", V(0.13, 1.3, 0.13), position + V(0, 0.95, 0.3), p[2], A(0.3, 0, 0), false, parent)
		make("LureGlow", "sphere", V(0.4, 0.5, 0.4), position + V(0, 1.6, 0.6), p[3], nil, true, parent)
	elseif feature == "cloudcollar" or feature == "steamvents" or feature == "mossmantle" then
		for i = 1, rank do
			make(
				"Cloud" .. i,
				"sphere",
				V(0.6, 0.35, 0.8),
				position + V((i - (rank + 1) / 2) * 0.45, 0.4, -0.7),
				p[i % 2 + 2],
				nil,
				false,
				parent
			)
		end
	elseif feature == "mothwings" then
		for _, s in { -1, 1 } do
			make(
				"MothWing" .. s,
				"wedge",
				V(0.2, 1.3 + stage * 0.4, 1.6),
				position + V(s * 1.4, 0.2, -0.5),
				p[2],
				A(0, 0, s * 0.7),
				true,
				parent
			)
		end
	else
		-- Chifres não aparecem no filhote; ele recebe apenas uma crista macia/placa.
		for i = 1, rank do
			local x = (i - (rank + 1) / 2) * 0.55
			make(
				"Crest" .. i,
				stage == 1 and "sphere" or "wedge",
				V(0.35, stage == 1 and 0.3 or 0.6 + stage * 0.25, 0.45),
				position + V(x, 0.75, -0.2),
				p[i % 2 + 2],
				A(0, 0, -x * 0.3),
				true,
				parent
			)
		end
	end
end
function F.surface(make, d, position, stage, parent)
	if stage == 1 then
		return
	end
	local p = d.palette
	local count = stage == 2 and 2 or 4
	local surface = d.surface
	for i = 1, count do
		local angle = i * 2.4
		local kind = "sphere"
		local size = V(0.3, 0.4, 0.12)
		local rotation = A(0, 0, angle * 0.3)
		local offset = V(math.cos(angle) * 0.8, math.sin(angle) * 0.5, 0.8)
		local material = Enum.Material.SmoothPlastic
		if surface == "cracks" or surface == "zigzag" then
			kind = "wedge"
			size = V(0.08, 0.7, 0.08)
			material = Enum.Material.Neon
		elseif surface == "plates" or surface == "scales" or surface == "ridges" then
			kind = "wedge"
			size = V(0.65, 0.25, 0.8)
			offset = V(0, 0.6, -i * 0.35)
			material = Enum.Material.Slate
		elseif surface == "runes" or surface == "facets" then
			kind = "corner"
			size = V(0.3, 0.5, 0.2)
			material = Enum.Material.Glass
		elseif surface == "bands" or surface == "rain" then
			kind = "block"
			size = V(0.12, 0.8, 0.1)
			rotation = A(0, 0, surface == "rain" and 0.3 or math.pi / 2)
		elseif surface == "leaves" or surface == "veins" or surface == "moss" then
			kind = "wedge"
			size = V(0.2, 0.65, 0.13)
			material = Enum.Material.Fabric
		elseif surface == "bark" then
			kind = "block"
			size = V(0.15, 0.8, 0.18)
			material = Enum.Material.Wood
		elseif surface == "clouds" then
			size = V(0.7, 0.4, 0.65)
			offset = V((i - (count + 1) / 2) * 0.4, 0.5, -0.5)
		elseif surface == "pearls" then
			size = V(0.35, 0.35, 0.35)
			material = Enum.Material.Glass
		elseif surface == "spirals" then
			kind = "cylinder"
			size = V(0.1, 0.4 + i * 0.1, 0.4 + i * 0.1)
			rotation = A(0, math.pi / 2, 0)
		elseif surface == "feathers" or surface == "layeredplumage" then
			kind = "wedge"
			size = V(0.3, 0.18, 0.7)
			offset = V((i - (count + 1) / 2) * 0.3, 0, 0.8)
		elseif surface == "ash" then
			size = V(0.5, 0.16, 0.3)
			material = Enum.Material.Basalt
		end
		local mark = make("Pattern" .. i, kind, size, position + offset, p[i % 2 + 2], rotation, false, parent)
		mark.Material = material
	end
end
return F
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">CreatureGrant</string>
          <string name="Source"><![CDATA[--!nonstrict
local Species = require(script.Parent.SpeciesRules)
local Config = require(script.Parent.Config)
local G = {}
function G.grant(profile, id, origin, nonce, options)
	options = options or {}
	local def = Species.get(id)
	if not def or typeof(nonce) ~= "string" or #nonce == 0 or #nonce > 100 or typeof(origin) ~= "string" then
		return nil, "INVALID_GRANT"
	end
	profile.grants = profile.grants or {}
	if profile.grants[nonce] then
		local uid = profile.grants[nonce]
		if not profile.creatures[uid] or profile.creatures[uid].id ~= id then
			return nil, "NONCE_CONFLICT"
		end
		return uid, "REPLAY"
	end
	local legacy = origin == "legacy_egg" and profile.legacyEggPermits and profile.legacyEggPermits[nonce] == id
	if not Species.isGeneral(id) and not legacy then
		if origin ~= "phoenix_sanctuary" or not profile.phoenix or profile.phoenix.encounterId ~= nonce then
			return nil, "SPECIAL_SOURCE"
		end
		local owned = 0
		for _, c in profile.creatures do
			if c.id == id then
				owned += 1
			end
		end
		if
			owned >= Config.PhoenixMaxPerAccount
			or (profile.phoenix.captureCount or (profile.phoenix.captured and 1 or 0))
				>= Config.PhoenixMaxPerAccount
		then
			return nil, "SPECIAL_LIMIT"
		end
	end
	local count = 0
	for _ in profile.creatures do
		count += 1
	end
	if count >= 60 then
		return nil, "INVENTORY_FULL"
	end
	profile.nextId = math.max(profile.nextId or 1, 1)
	while profile.creatures["u" .. profile.nextId] do
		profile.nextId += 1
	end
	local uid = "u" .. profile.nextId
	profile.nextId += 1
	profile.creatures[uid] = { id = id, lv = math.clamp(math.floor(options.level or 1), 1, 100), xp = 0 }
	profile.discovered = profile.discovered or {}
	profile.discovered[id] = true
	profile.grants[nonce] = uid
	if not Species.isGeneral(id) then
		profile.phoenix.captured = true
		profile.phoenix.captureCount = (profile.phoenix.captureCount or 0) + 1
		profile.phoenix.encounterId = nil
	end
	if legacy then
		profile.legacyEggPermits[nonce] = nil
	end
	return uid, "GRANTED"
end
return G
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Creatures</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(script.Parent.Strings).Text
-- Catálogo de feras. Para criar uma nova, basta uma linha add(...). Estatísticas derivam da raridade.
local C =
	{ List = {}, ById = {}, Rarity = { Text.COMUM_CA938E, Text.RARO_851816, Text.EPICO_7BC392, Text.LENDARIO_52178E } }
local function add(id, name, el, rar, island, shape, hybrid)
	local d = {
		id = id,
		name = name,
		el = el,
		rar = rar,
		island = island,
		shape = shape,
		hybrid = hybrid,
		hp = 30 + rar * 25,
		atk = 6 + rar * 5,
		gpm = rar * rar * 2 + 2,
	}
	table.insert(C.List, d)
	C.ById[id] = d
end
add("cinzelo", Text.CINZELO_540AA2, Text.FOGO_F77A3C, 1, "Brasa", "Blob")
add("magmarau", Text.MAGMARAU_66D92B, Text.FOGO_F77A3C, 2, "Brasa", "Beast")
add("fenixfuligem", Text.FENIX_FULIGEM_64EF6D, Text.FOGO_F77A3C, 3, "Brasa", "Bird")
add("vulcanodrago", Text.VULCANODRAGO_CEB8E4, Text.FOGO_F77A3C, 4, "Brasa", "Dragon")
add("bolhinho", Text.BOLHINHO_2BE987, Text.AGUA_F11A05, 1, "Recife", "Blob")
add("marilisco", Text.MARILISCO_BFD916, Text.AGUA_F11A05, 2, "Recife", "Serpent")
add("carangueperola", Text.CARANGUEPEROLA_08BAB3, Text.AGUA_F11A05, 3, "Recife", "Insect")
add("abissauro", Text.ABISSAURO_04225F, Text.AGUA_F11A05, 4, "Recife", "Dragon")
add("brotinho", Text.BROTINHO_57925C, Text.NATUREZA_FB1ED9, 1, "Floresta", "Blob")
add("folhuco", Text.FOLHUCO_22B5C1, Text.NATUREZA_FB1ED9, 2, "Floresta", "Beast")
add("aracnoflora", Text.ARACNOFLORA_43AC5A, Text.NATUREZA_FB1ED9, 3, "Floresta", "Insect")
add("ancestravore", Text.ANCESTRAVORE_146E5C, Text.NATUREZA_FB1ED9, 4, "Floresta", "Beast")
add("graozinho", Text.GRAOZINHO_D0C3F0, Text.TERRA_16D3AE, 1, "Dunas", "Blob")
add("escorpiodra", Text.ESCORPIODRA_B79E74, Text.TERRA_16D3AE, 2, "Dunas", "Insect")
add("esfingeolito", Text.ESFINGEOLITO_728F92, Text.TERRA_16D3AE, 3, "Dunas", "Beast")
add("colossodune", Text.COLOSSODUNE_3B3CE0, Text.TERRA_16D3AE, 4, "Dunas", "Dragon")
add("penugem", Text.PENUGEM_D3A3F3, Text.AR_B623FF, 1, "Picos", "Bird")
add("ventanil", Text.VENTANIL_D7000E, Text.AR_B623FF, 2, "Picos", "Bird")
add("trovoraptor", Text.TROVORAPTOR_3E8543, Text.AR_B623FF, 3, "Picos", "Dragon")
add("aeronimbo", Text.AERONIMBO_2E256F, Text.AR_B623FF, 4, "Picos", "Serpent")
add("lodinho", Text.LODINHO_03ED97, Text.SOMBRA_94B135, 1, "Pantano", "Blob")
add("caudalume", Text.CAUDALUME_26609C, Text.SOMBRA_94B135, 2, "Pantano", "Serpent")
add("vagalumorte", Text.VAGALUMORTE_40C1CE, Text.SOMBRA_94B135, 3, "Pantano", "Insect")
add("reinevoento", Text.REI_NEVOENTO_691E87, Text.SOMBRA_94B135, 4, "Pantano", "Beast")
-- Híbridos: só nascem de cruzamentos entre dois elementos específicos.
add(
	"vaporino",
	Text.VAPORINO_6940A2,
	Text.FOGO_F77A3C,
	3,
	Text.HIBRIDO_9CB40A,
	"Serpent",
	{ Text.FOGO_F77A3C, Text.AGUA_F11A05 }
)
add(
	"magmaterra",
	Text.MAGMATERRA_ACDB93,
	Text.FOGO_F77A3C,
	3,
	Text.HIBRIDO_9CB40A,
	"Beast",
	{ Text.FOGO_F77A3C, Text.TERRA_16D3AE }
)
add(
	"tempestalia",
	Text.TEMPESTALIA_27599D,
	Text.AR_B623FF,
	3,
	Text.HIBRIDO_9CB40A,
	"Bird",
	{ Text.AR_B623FF, Text.AGUA_F11A05 }
)
add(
	"nevoamusgo",
	Text.NEVOAMUSGO_8FDC87,
	Text.SOMBRA_94B135,
	3,
	Text.HIBRIDO_9CB40A,
	"Beast",
	{ Text.SOMBRA_94B135, Text.NATUREZA_FB1ED9 }
)
add(
	"cinzavento",
	Text.CINZAVENTO_982DC1,
	Text.FOGO_F77A3C,
	4,
	Text.HIBRIDO_9CB40A,
	"Dragon",
	{ Text.FOGO_F77A3C, Text.AR_B623FF }
)
-- Fênix é uma espécie adicional; Fênix Fuligem e seus IDs permanecem intactos.
add("fenix", Text.FENIX_A08C9E, Text.FOGO_F77A3C, 4, "Brasa", "Bird")
C.ById.fenix.acquisition = "special"
C.ById.fenix.minStage = 3
C.ById.fenix.futureStage = { target = 4, enabled = false, mechanic = Text.RENASCIMENTO_FUTURO_EE24AE }
function C.stage(lv, id)
	local normal = lv >= 15 and 3 or lv >= 7 and 2 or 1
	return math.max(normal, (id and C.ById[id] and C.ById[id].minStage) or 1)
end
return C
]]></string>
