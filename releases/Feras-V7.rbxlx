}, panel)
local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(255, 230, 80)
stroke.Thickness = 2
stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
stroke.Thickness = 2
local finishing = false
local function finish()
	if not finishing then
		finishing = true
		task.spawn(call, "Tut")
	end
end
skip.Activated:Connect(finish)
tutorial = function()
	if drawerOpen or not S or S.tut then
		panel.Visible = false
		stroke.Parent = nil
		return
	end
	local step
	for _, t in TUT do
		if not t[3](S) then
			step = t
			break
		end
	end
	if not step then
		finish()
		return
	end
	panel.Visible = true
	ptxt.Text = step[1]
	stroke.Parent = step[2]()
end
-- Entrada pode preceder o término de UpdateAsync/consulta de passes.
task.spawn(function()
	for _ = 1, 20 do
		call("Get")
		if S then
			return
		end
		msg.Text = Text.CARREGANDO_SEU_SANTUARIO_53DAC6
		task.wait(0.75)
	end
	msg.Text = Text.NAO_FOI_POSSIVEL_OBTER_O_PERFIL_RECONECTE_PARA_T_9B595C
end)

require(script.Parent.EncounterUI).start(gui, function()
	return S and S.creatures or {}
end, function()
	task.defer(function()
		if not inFlight then
			call("Get")
		end
	end)
end, function()
	setDrawer(false)
	panel.Visible = false
	stroke.Parent = nil
end)
