	TextScaled = true,
	Font = Enum.Font.GothamBold,
	BackgroundColor3 = Theme.Card,
	TextColor3 = WHITE,
}, gui)
mb.Activated:Connect(function()
	muted = not muted
	mb.Text = muted and Text.SOM_OFF_D3D9A2 or Text.SOM_ON_ACD88F
	if music then
