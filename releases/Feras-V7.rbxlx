}, panel)
local skip = mk("TextButton", {
	Size = UDim2.fromOffset(76, 44),
	Position = UDim2.new(1, -80, 0.5, -18),
	Text = Text.PULAR_6EC317,
	TextScaled = true,
	Font = Enum.Font.GothamBold,
