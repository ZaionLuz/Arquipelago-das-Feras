P.Grids.flee = {
	"................",
	"..........aa....",
	".........abba...",
	".........abba...",
	"....aaa..abba...",
	"...abbbaabba....",
	"....abbccba.....",
	".....abccba.....",
	"....abccbcba....",
	"...abcb.abba....",
	"..abba..abba....",
	"..abba...abba...",
	".abbba...abbba..",
	".aaaaa...aaaaa..",
	"................",
	"................",
}
P.Grids.bond = P.Grids.Heart
P.Grids.capture = P.Grids.Seal
P.Grids.gold = P.Grids.Coin
P.Grids.gem = P.Grids.Gem
P.Grids.seal = P.Grids.Seal
P.Grids.heart = P.Grids.Heart
P.Grids["Água"] = P.Grids.Agua
P.Patterns = P.Grids
-- Authoring grids stay 16×16; spaces are empty ink and rows are deterministically padded.
for name, grid in P.Grids do
	for index, row in grid do
		grid[index] = string.sub((row:gsub(" ", ".")) .. string.rep(".", 16), 1, 16)
	end
	assert(#grid == 16, name)
end
function P.draw(parent, name, size, ramp)
	local scale = math.max(1, math.floor(size and (size > 8 and size / 16 or size) or 2))
	local grid = P.Grids[name] or P.Grids.Fera
	if typeof(ramp) == "Color3" then
		ramp = {
			Tokens.Shadow,
			Tokens.nearest(ramp:Lerp(Tokens.Shadow, 0.4)),
			ramp,
			ramp,
			Tokens.nearest(ramp:Lerp(Tokens.Ink, 0.5)),
		}
	end
	ramp = ramp or Tokens.Ramps.Sand
	local ink = { a = Tokens.Shadow, b = ramp[2], c = ramp[4], d = ramp[5] }
	local canvas = Instance.new("Frame")
	canvas.Name = "PixelIcon_" .. name
	canvas.BackgroundTransparency = 1
	canvas.Size = UDim2.fromOffset(16 * scale, 16 * scale)
	canvas.Parent = parent
	for y, row in grid do
		local x = 1
		while x <= 16 do
			local symbol = row:sub(x, x)
			local stop = x
			while stop < 16 and row:sub(stop + 1, stop + 1) == symbol do
				stop += 1
			end
			if ink[symbol] then
				local run = Instance.new("Frame")
				run.Name = "Ink"
				run.BorderSizePixel = 0
				run.BackgroundColor3 = ink[symbol]
				run.Position = UDim2.fromOffset((x - 1) * scale, (y - 1) * scale)
				run.Size = UDim2.fromOffset((stop - x + 1) * scale, scale)
				run.ZIndex = canvas.ZIndex
				run.Parent = canvas
			end
			x = stop + 1
		end
	end
	return canvas
end
return P
]]></string>
