end)
local music
if Sounds.Music ~= "" then
	music = Instance.new("Sound")
	music.SoundId = Sounds.Music
	music.Looped = true
	music.Volume = 0.25
	music.Parent = SS
	music:Play()
end
local notifications = RS:WaitForChild("WildNotice")
notifications.OnClientEvent:Connect(function(message, position, success)
	if typeof(position) == "Vector3" then
		local ring = Instance.new("Part")
		ring.Shape = Enum.PartType.Ball
		ring.Size = Vector3.one * 2
		ring.Position = position
		ring.Anchored = true
		ring.CanCollide = false
		ring.CanTouch = false
		ring.CanQuery = false
		ring.Material = Enum.Material.Neon
		ring.Color = success and Theme.Accent or Theme.Tokens.Ramps.Veil[4]
		ring.Transparency = 0.4
		ring.Parent = workspace
		TS:Create(ring, TweenInfo.new(0.6), { Size = Vector3.one * 8, Transparency = 1 }):Play()
		game:GetService("Debris"):AddItem(ring, 0.7)
		sfx(success and "Win" or "Lose")
	end
	msg.Text = message
	if S then
		task.delay(0.2, function()
			if not inFlight then
				call("Get")
			end
		end)
	end
end)
local lastMessage = ""
task.spawn(function()
	while true do
		task.wait(4)
		if msg.Text == lastMessage then
			msg.Text = ""
		end
		lastMessage = msg.Text
	end
end)
local mb = mk("TextButton", {
	Position = UDim2.new(1, -96, 1, -52),
	Size = UDim2.fromOffset(88, 44),
	Text = Text.SOM_ON_ACD88F,
	TextScaled = true,
	Font = Theme.Font,
	BackgroundColor3 = Theme.Card,
	TextColor3 = WHITE,
}, gui)
mb.Activated:Connect(function()
	muted = not muted
	mb.Text = muted and Text.SOM_OFF_D3D9A2 or Text.SOM_ON_ACD88F
	if music then
		music.Volume = muted and 0 or 0.25
	end
end)
-- Feras respiram e se viram devagar (animação local, só visual).
require(script.Parent.CreatureAnimator).start()
require(script.Parent.CompanionClient).start()
require(script.Parent.EnvironmentArt).start()
require(script.Parent.SolarPresentation).start(function()
	return S
end)
RS:WaitForChild("StoryNotice").OnClientEvent:Connect(function(message)
	msg.Text = message
	tab = Text.MISSOES_FAE2D2
	setDrawer(true)
end)
msg:GetPropertyChangedSignal("Text"):Connect(function()
	loading.message(msg.Text)
	objective.Visible = not drawerOpen and msg.Text == ""
end)
-- Clima e hora do dia mudam conforme a ilha mais próxima.
local cur
task.spawn(function()
	while true do
		task.wait(1)
		local ch = Players.LocalPlayer.Character
		local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		if hrp then
			local best, bd = nil, 1e9
			for _, d in I.List do
				local dist = (I.pos(d.idx) - hrp.Position).Magnitude
				if dist < bd then
					best, bd = d, dist
				end
			end
			if best and best ~= cur then
				cur = best
				TS:Create(
					Lighting,
					TweenInfo.new(3),
					{ Ambient = best.ambient, OutdoorAmbient = best.ambient, ClockTime = best.clock }
				):Play()
			end
		end
	end
end)
-- Tutorial guiado: cada passo some quando o objetivo é cumprido; o progresso vem dos stats salvos.
local TUT = {
	{
		"Abra o Mapa e siga por um caminho. Todas as regiões podem ser exploradas.",
		function()
			return collect
		end,
		function(s)
			return (s.stats.regionVisit or 1) >= 2
		end,
	},
	{
		"Escolha um companheiro na aba Equipe para acompanhar sua jornada.",
		function()
			return tabBtn.Feras
		end,
		function(s)
			return s.companion ~= nil
		end,
	},
	{
		"Aproxime-se de uma fera e experimente a batalha ou captura.",
		function()
			return toggle
		end,
		function(s)
			return (s.stats.fight or 0) >= 1
		end,
	},
	{
		"Use seus selos para conquistar seu primeiro vínculo selvagem.",
		function()
			return toggle
		end,
		function(s)
			return (s.stats.capture or 0) >= 1
		end,
	},
	{
		Text.EM_MISSOES_RESGATE_SUA_PRIMEIRA_RECOMPENSA_AB00E0,
		function()
			return tabBtn[Text.MISSOES_FAE2D2]
		end,
		function(s)
			return next(s.claimed) ~= nil
		end,
	},
}
local panel = mk("Frame", {
	Position = UDim2.new(0.02, 0, 0, 132),
	Size = UDim2.new(0.72, 0, 0, 66),
	BackgroundColor3 = Theme.Card,
	Visible = false,
}, gui)
local ptxt = mk("TextLabel", {
	Size = UDim2.new(1, -90, 1, 0),
	Position = UDim2.fromOffset(8, 0),
	BackgroundTransparency = 1,
	TextScaled = true,
	Font = Theme.Font,
	TextColor3 = Theme.Ink,
	TextXAlignment = Enum.TextXAlignment.Left,
}, panel)
local skip = mk("TextButton", {
	Size = UDim2.fromOffset(76, 44),
	Position = UDim2.new(1, -80, 0.5, -22),
	Text = Text.PULAR_6EC317,
	TextScaled = true,
	Font = Theme.Font,
	BackgroundColor3 = Theme.Tokens.Ramps.Ember[2],
	TextColor3 = WHITE,
}, panel)
local stroke = Instance.new("UIStroke")
stroke.Color = Theme.Accent
stroke.Thickness = 2
stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
stroke.Thickness = 2
local finishing = false
local function finish()
	if not finishing then
		finishing = true
		task.spawn(call, "Tut")
	end
end
skip.Activated:Connect(finish)
tutorial = function()
	if drawerOpen or not S or S.tut then
		panel.Visible = false
		stroke.Parent = nil
		return
	end
	local step
	for _, t in TUT do
		if not t[3](S) then
			step = t
			break
		end
	end
	if not step then
		finish()
		return
	end
	panel.Visible = true
	ptxt.Text = step[1]
	stroke.Parent = step[2]()
end
-- Entrada pode preceder o término de UpdateAsync/consulta de passes.
task.spawn(function()
	for _ = 1, 20 do
		call("Get")
		if S then
			return
		end
		msg.Text = Text.CARREGANDO_SEU_SANTUARIO_53DAC6
		task.wait(0.75)
	end
	msg.Text = Text.NAO_FOI_POSSIVEL_OBTER_O_PERFIL_RECONECTE_PARA_T_9B595C
end)

require(script.Parent.EncounterUI).start(gui, function()
	return S and S.creatures or {}
end, function()
	task.defer(function()
		if not inFlight then
			call("Get")
		end
	end)
end, function()
	setDrawer(false)
	panel.Visible = false
	stroke.Parent = nil
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">CollectionUI</string>
            <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local C = require(RS.Shared.Creatures)
local MF = require(RS.Shared.ModelFactory)
local Animator = require(script.Parent.CreatureAnimator)
local Theme = require(script.Parent.UITheme)
local Icons = require(script.Parent.PixelIcons)
local UI = { rebuilds = 0 }
local function rect(object)
	local available, size, pos = pcall(function()
		return object.AbsoluteSize, object.AbsolutePosition
	end)
	if available and size and pos and size.X > 0 and size.Y > 0 then
		return pos.X, pos.Y, pos.X + size.X, pos.Y + size.Y
	end
	return nil
end
function UI.visible(object)
	local left, top, right, bottom
	if object and object:IsA("GuiObject") then
		left, top, right, bottom = rect(object)
	end
	while object do
		if object:IsA("GuiObject") then
			if not object.Visible then
				return false
			end
			if left and object.ClipsDescendants then
				local clipLeft, clipTop, clipRight, clipBottom = rect(object)
				if clipLeft then
					left, top = math.max(left, clipLeft), math.max(top, clipTop)
					right, bottom = math.min(right, clipRight), math.min(bottom, clipBottom)
					if right <= left or bottom <= top then
						return false
					end
				end
			end
		end
		if object:IsA("ScreenGui") and not object.Enabled then
			return false
		end
		object = object.Parent
	end
	return true
end
local function label(parent, text, pos, size)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Position = pos
	t.Size = size
	t.Text = text
	t.TextWrapped = true
	t.Font = Theme.Font
	t.TextSize = 16
	t.TextColor3 = Theme.Ink
	t.Parent = parent
	return t
end
function UI.preview(parent, def, lv, unknown)
	if not parent then
		return nil
	end
	local v = parent:FindFirstChild("CreaturePreview")
	-- A visualização só é montada quando o contêiner está visível.
	if not UI.visible(parent) then
		return v
	end
	local detail = MF.detailKey()
	local key = def.id .. ":" .. C.stage(lv, def.id) .. ":" .. tostring(unknown) .. ":" .. detail
	if v and v:GetAttribute("PreviewKey") == key then
		return v
	end
	if not v then
		v = Instance.new("ViewportFrame")
		v.Name = "CreaturePreview"
		v.Size = UDim2.fromScale(1, 0.65)
		v.BackgroundTransparency = 1
		v.Ambient = Theme.Tokens.Ramps.Metal[3]
		v.LightDirection = Vector3.new(-1, -1, -1)
		v.LightColor = Theme.Tokens.Ink
		v.Parent = parent
	else
		v:ClearAllChildren()
	end
	v:SetAttribute("PreviewKey", key)
	local world = Instance.new("WorldModel")
	world.Parent = v
	local model = MF.build(
		unknown and def.acquisition == "special" and C.ById.cinzelo or def,
		lv,
		{ preview = true, detail = detail }
	)
	UI.rebuilds += 1
	for _, obj in model:GetDescendants() do
		if obj:IsA("BillboardGui") then
			obj:Destroy()
		elseif unknown and obj:IsA("BasePart") then
			obj.Color = Theme.Tokens.Ramps.Veil[1]
			obj.Material = Enum.Material.SmoothPlastic
		end
	end
	model.Parent = world
	local low, high = MF.bounds(model)
	local size = high - low
	local center = (low + high) * 0.5
	local ramp = Theme.Tokens.Elements[def.el] or Theme.Tokens.Ramps.Metal
	local width = math.max(size.X, size.Z) * 0.85
	for index = 1, 2 do
		local floor = Instance.new("Part")
		floor.Name = "SpecimenPlinth" .. index
		floor.Size = Vector3.new(width + (2 - index) * 0.5, 0.18, width * 0.65 + (2 - index) * 0.5)
		floor.CFrame = CFrame.new(center.X, low.Y - 0.4 + index * 0.18, center.Z)
		floor.Color = ramp[index == 1 and 1 or 2]
		floor.Material = Enum.Material.SmoothPlastic
		floor.Anchored = true
		floor.CanCollide = false
		floor.CanQuery = false
		floor.CanTouch = false
		floor.CastShadow = false
		floor.Parent = world
	end
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	local distance = math.max(size.X, size.Y, size.Z) * 2
	camera.CFrame = CFrame.lookAt(center + Vector3.new(distance * 0.55, distance * 0.25, distance), center)
	camera.Parent = v
	v.CurrentCamera = camera
	Animator.register(model, function()
		return model.Parent ~= nil and v.Parent ~= nil and UI.visible(v)
	end, { camera = camera, center = center, distance = distance })
	return v
end
function UI.card(parent, def, lv, known, order)
	local card = Instance.new("Frame")
	card.Name = "CollectionCard"
	card.LayoutOrder = order
	card.Size = UDim2.new(1, -12, 0, 190)
	card.BackgroundColor3 = known and Theme.Tokens.Elements[def.el][1] or Theme.Panel
	card.Parent = parent
	Theme.panel(card, known and Theme.Tokens.Elements[def.el][3] or Theme.Edge)
	local emblem = Icons.draw(card, def.el, 16, Theme.Tokens.Elements[def.el])
	emblem.Position = UDim2.fromOffset(8, 8)
	local preview
	local function visible()
		if not card.Parent then
			return
		end
		local y = card.AbsolutePosition.Y
		local top = parent.AbsolutePosition.Y
		local shown = UI.visible(card) and y + card.AbsoluteSize.Y >= top and y <= top + parent.AbsoluteSize.Y
		if shown then
			preview = UI.preview(card, def, lv, not known)
		elseif not shown and preview then
			preview:Destroy()
			preview = nil
		end
	end
	local connection = parent:GetPropertyChangedSignal("CanvasPosition"):Connect(visible)
	local resize = parent:GetPropertyChangedSignal("AbsoluteSize"):Connect(visible)
	card.Destroying:Connect(function()
		connection:Disconnect()
		resize:Disconnect()
	end)
	task.defer(visible)
	label(
		card,
		known and def.name or Text.ESPECIE_DESCONHECIDA_6C9CF9,
		UDim2.fromScale(0, 0.65),
		UDim2.fromScale(1, 0.15)
	)
	label(
		card,
		known and (def.el .. " • " .. C.Rarity[def.rar] .. Text.NV_9D89AA .. lv) or Text.DESCUBRA_NOVOS_OVOS_38146F,
		UDim2.fromScale(0, 0.8),
		UDim2.fromScale(1, 0.18)
	).TextSize =
		12
	return card
end
function UI.discovery(gui, def, lv, evolved)
	local overlay = Instance.new("Frame")
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundColor3 = Theme.Panel
	overlay.BackgroundTransparency = 0.08
	overlay.ZIndex = 30
	overlay.Parent = gui
	local panel = Instance.new("Frame")
	panel.Size = UDim2.fromScale(0.8, 0.8)
	panel.Position = UDim2.fromScale(0.1, 0.1)
	panel.BackgroundColor3 = Theme.Tokens.Elements[def.el][1]
	panel.Parent = overlay
	Theme.panel(panel, Theme.Tokens.Elements[def.el][4])
	UI.preview(panel, def, lv, false)
	label(
		panel,
		evolved and Text.SUA_FERA_EVOLUIU_0ACEF1
			or (def.rar >= 3 and Text.ECLOSAO_EXTRAORDINARIA_EA7909 or Text.UMA_FERA_NASCEU_A8EB6A),
		UDim2.fromScale(0, 0),
		UDim2.fromScale(1, 0.12)
	)
	label(
		panel,
		def.name .. " • " .. C.Rarity[def.rar] .. Text.NV_9D89AA .. lv,
		UDim2.fromScale(0, 0.68),
		UDim2.fromScale(1, 0.12)
	)
	label(
		panel,
		Text.VIDA_41EF99
			.. def.hp
			.. Text.ATAQUE_4EE034
			.. def.atk
			.. Text.OURO_MIN_BASE_C8313A
			.. def.gpm
			.. Text.ESTAGIO_D2FEE2
			.. C.stage(lv, def.id),
		UDim2.fromScale(0.05, 0.77),
		UDim2.fromScale(0.9, 0.06)
	).TextSize =
		12
	local close = Instance.new("TextButton")
	close.Size = UDim2.new(0.8, 0, 0, 44)
	close.Position = UDim2.new(0.1, 0, 1, -56)
	close.Text = Text.CONTINUAR_AVENTURA_E2F9B1
	close.TextSize = 18
	close.Font = Theme.Font
	close.BackgroundColor3 = Theme.Tokens.Elements[def.el][2]
	close.Parent = panel
	close.Active = true
	close.Selectable = true
	Theme.bind(close)
	close.Activated:Connect(function()
		overlay:Destroy()
	end)
	-- Segurança: nunca bloquear permanentemente por menu fechado ou controle perdido.
	task.delay(20, function()
		if overlay.Parent then
			overlay:Destroy()
		end
	end)
	return overlay
end
return UI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">CompanionClient</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Run = game:GetService("RunService")
local C = require(RS.Shared.Creatures)
local MF = require(RS.Shared.ModelFactory)
local U = {}
function U.start()
	local folder = Instance.new("Folder")
	folder.Name = "Companheiros"
	folder.Parent = workspace
	local models = {}
	local timer = 0
	Run.Heartbeat:Connect(function(dt)
		timer += dt
		if timer < 0.05 then
			return
		end
		local step = timer
		timer = 0
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local active = {}
		local candidates = {}
		for _, p in Players:GetPlayers() do
			local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			local id = p:GetAttribute("CompanionSpecies")
			if root and id and C.ById[id] and (root.Position - camera.CFrame.Position).Magnitude < 110 then
				table.insert(candidates, { p = p, root = root, id = id })
			end
		end
		table.sort(candidates, function(a, b)
			return (a.root.Position - camera.CFrame.Position).Magnitude
				< (b.root.Position - camera.CFrame.Position).Magnitude
		end)
		local quality = Players.LocalPlayer:GetAttribute("GraphicsQuality") or "Médio"
		for index = 1, math.min(quality == "Baixo" and 3 or quality == "Alto" and 6 or 4, #candidates) do
			local item = candidates[index]
			local p, root, id = item.p, item.root, item.id
			active[p] = true
			local lv = p:GetAttribute("CompanionLevel") or 1
			local key = id .. ":" .. lv
			local entry = models[p]
			if not entry or entry.key ~= key then
				if entry then
					entry.model:Destroy()
				end
				local m = MF.build(C.ById[id], lv, { preview = true })
				local _, size = m:GetBoundingBox()
				if math.max(size.X, size.Y, size.Z) > 7 then
					m:ScaleTo(m:GetScale() * 7 / math.max(size.X, size.Y, size.Z))
				end
				local cf, scaled = m:GetBoundingBox()
				local lift = m:GetPivot().Position.Y - (cf.Position.Y - scaled.Y / 2)
				m.Parent = folder
				entry = { model = m, key = key, lift = lift, position = root.Position }
				models[p] = entry
			end
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { folder, p.Character }
			local desired = root.Position - root.CFrame.LookVector * 5 + root.CFrame.RightVector * 4
			local recalc = not entry.rayAt or os.clock() - entry.rayAt >= 0.2
			if recalc then
				entry.obstructed = workspace:Raycast(root.Position, desired - root.Position, params) ~= nil
			end
			if entry.obstructed then
				desired = root.Position + root.CFrame.RightVector * 4
			end
			if recalc then
				local ground = workspace:Raycast(desired + Vector3.new(0, 12, 0), Vector3.new(0, -70, 0), params)
				entry.floor = ground and ground.Position.Y or root.Position.Y - 3
				entry.rayAt = os.clock()
			end
			local floor = entry.floor
			local hover = C.ById[id].shape == "Bird" and 1.8 or 0
			local happy = not Players.LocalPlayer:GetAttribute("MotionReduced")
				and (p:GetAttribute("PetHappyUntil") or 0) > workspace:GetServerTimeNow()
			desired = Vector3.new(
				desired.X,
				floor + entry.lift + hover + (happy and math.abs(math.sin(os.clock() * 6)) * 0.6 or 0),
				desired.Z
			)
			if (entry.position - desired).Magnitude > 50 then
				entry.position = desired
			else
				entry.position = entry.position:Lerp(desired, math.min(1, step * 5))
			end
			local direction = root.CFrame.LookVector
			entry.model:SetAttribute("Moving", (entry.position - desired).Magnitude > 0.4)
			entry.model:PivotTo(CFrame.lookAt(entry.position, entry.position - direction))
		end
		for p, entry in models do
			if not active[p] then
				entry.model:Destroy()
				models[p] = nil
			end
		end
	end)
end
return U
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">CreatureAnimator</string>
            <string name="Source"><![CDATA[--!nonstrict
local Run = game:GetService("RunService")
local Players = game:GetService("Players")
local Art = require(game:GetService("ReplicatedStorage").Shared.ArtTokens)
local Performance = require(game:GetService("ReplicatedStorage").Shared.CreaturePerformance)
local A = {}
local records = setmetatable({}, { __mode = "k" })
local started = false
function A.register(model, visible, orbit)
	if not records[model] then
		local record = {
			base = model:GetAttribute("Gallery") and model:GetPivot() or nil,
			joints = {},
			parts = {},
			effects = {},
			visible = visible,
			orbit = orbit,
			last = 0,
			body = model:FindFirstChild("Body"),
			baseColor = model:FindFirstChild("Body") and model.Body.Color or nil,
		}
		for _, obj in model:GetDescendants() do
			if obj:IsA("Motor6D") then
				table.insert(record.joints, obj)
			elseif obj:IsA("BasePart") then
				table.insert(record.parts, obj)
			elseif obj:IsA("ParticleEmitter") or obj:IsA("Light") then
				table.insert(record.effects, obj)
			end
		end
		records[model] = record
	elseif visible then
		records[model].visible = visible
	end
end
function A.play(model, pose, duration)
	A.register(model)
	local record = records[model]
	record.poseStart = os.clock()
	record.poseDuration = duration or 0.5
	record.pose = pose
	record.untilTime = os.clock() + (duration or 0.5)
end
local function apply(model, record, time, full, reduced)
	if record.base and not reduced then
		model:PivotTo(record.base * CFrame.Angles(0, time * 0.25, 0))
	end
	if record.orbit and record.orbit.camera.Parent and not reduced then
		local orbit = record.orbit
		local angle = time * 0.25
		orbit.camera.CFrame = CFrame.lookAt(
			orbit.center
				+ Vector3.new(math.sin(angle) * orbit.distance, orbit.distance * 0.3, math.cos(angle) * orbit.distance),
			orbit.center
		)
	end
	local family = model:GetAttribute("Family")
	local moving = full and model:GetAttribute("Moving") == true
	local pose = record.pose == "faint" and "faint"
		or record.untilTime and time < record.untilTime and record.pose
		or "idle"
	-- Six authored idle keyposes are interpolated, retaining the pixel-art cadence without stepping the camera.
	local keyposes = { 0, 0.8, 1, 0.1, -0.8, -1 }
	local sample = (time * 0.9) % 6
	local index = math.floor(sample) + 1
	local alpha = sample % 1
	local idle = keyposes[index] + (keyposes[index % 6 + 1] - keyposes[index]) * alpha
	local lift = idle * (family == "spectral" and 0.22 or family == "mineral" and 0.015 or 0.045)
	local progress = record.poseStart and math.clamp((time - record.poseStart) / record.poseDuration, 0, 1) or 0
	if record.body and record.body.Parent and record.baseColor then
		local flash = pose == "damage" and not reduced and progress < 0.4 and (1 - progress / 0.4) * 0.65 or 0
		record.body.Color = record.baseColor:Lerp(Art.Ink, flash)
	end
	for _, joint in record.joints do
		if not joint.Parent then
			continue
		end
		local role = joint:GetAttribute("Role") or joint.Name
		local phase = joint:GetAttribute("Phase") or 0
		local transform = CFrame.identity
		if not reduced then
			if role == "Body" then
				transform = CFrame.new(0, lift, 0) * CFrame.Angles(0, math.sin(time * 0.6) * 0.04, 0)
				if pose == "attack" then
					local anticipation = progress < 0.25 and -math.sin(progress / 0.25 * math.pi / 2) * 0.16
						or math.sin((progress - 0.25) / 0.75 * math.pi) * 0.28
					transform *= CFrame.new(0, -math.abs(anticipation) * 0.2, anticipation * 0.8) * CFrame.Angles(
						anticipation,
						0,
						0
					)
				elseif pose == "damage" then
					transform *= CFrame.new(0, 0, -math.sin(progress * math.pi) * 0.16) * CFrame.Angles(
						0,
						0,
						math.sin(progress * math.pi * 4) * (1 - progress) * 0.12
					)
				elseif pose == "faint" then
					transform *= CFrame.new(0, -progress * 0.45, 0) * CFrame.Angles(0.18 * progress, 0, progress * 1.2)
				elseif pose == "victory" then
					transform *= CFrame.new(0, math.abs(math.sin(time * 7)) * 0.3, 0)
				end
				if moving and (family == "serpentine" or family == "aquatic") then
					transform *= CFrame.Angles(0, math.sin(time * 4) * 0.1, 0)
				end
				if family == "vegetal" then
					transform *= CFrame.Angles(0, 0, math.sin(time) * 0.06)
				end
			elseif role == "Head" then
				transform = CFrame.Angles(idle * 0.035, math.sin(time * 0.8 + phase) * 0.075, 0)
				if pose == "attack" then
					transform *= CFrame.Angles(-math.sin(progress * math.pi) * 0.18, 0, 0)
				elseif pose == "faint" then
					transform *= CFrame.Angles(progress * 0.5, 0, 0)
				end
			elseif role:find("Eye") then
				transform =
					CFrame.Angles((time + (model:GetAttribute("BlinkOffset") or 0)) % 4.8 < 0.13 and 1.35 or 0, 0, 0)
			elseif role:find("Wing") then
				local side = joint.C0.Position.X < 0 and -1 or 1
				local pivot = CFrame.new(side * 0.5, 0, 0)
				local amplitude = pose == "faint" and 0 or (full and 0.35 or 0.12)
				local flap = CFrame.Angles(
					0,
					0,
					side * math.sin(time * (pose == "attack" and 6 or 2) + phase * 0.4) * amplitude
						+ (pose == "faint" and side * progress * 0.6 or 0)
				)
				transform = joint.C0:Inverse() * pivot * flap * pivot:Inverse() * joint.C0
			elseif role:find("Tail") or role:find("Coil") or role:find("Veil") then
				transform = CFrame.Angles(0, math.sin(time * 2 + phase) * 0.12, math.sin(time + phase) * 0.04)
			elseif role:find("Leg") and moving then
				transform = CFrame.Angles(math.sin(time * (family == "arthropod" and 8 or 5) + phase) * 0.3, 0, 0)
			elseif role:find("Halo") then
				local scale = model.PrimaryPart.Size.Y / 0.1
				local center = CFrame.new(0, 1.3 * scale, -0.6 * scale)
				transform = joint.C0:Inverse() * center * CFrame.Angles(0, 0, time * 0.18) * center:Inverse() * joint.C0
			end
		end
		joint.Transform = transform
	end
end
function A.start()
	if started then
		return
	end
	started = true
	local accumulated, scan = 0, 0
	local adaptive = Performance.new()
	Run.Heartbeat:Connect(function(dt)
		if type(dt) ~= "number" or dt ~= dt or dt <= 0 or dt > 0.5 then
			return
		end
		local player = Players.LocalPlayer
		local quality = player:GetAttribute("GraphicsQuality") or "Médio"
		local changed = Performance.step(adaptive, dt, quality)
		if changed ~= nil then
			player:SetAttribute("AdaptiveDetailLow", changed)
		end
		local budget = Performance.settings(quality, player:GetAttribute("AdaptiveDetailLow"))
		accumulated += dt
		scan += dt
		local tickInterval = 1 / budget.nearRate
		if accumulated + 1e-6 < tickInterval then
			return
		end
		-- Mantém a fração restante: descartar o resto tornava o modo15Hz irregular.
		local ticks = math.floor((accumulated + 1e-6) / tickInterval)
		accumulated = math.max(0, accumulated - ticks * tickInterval)
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		if scan > (budget.detailLow and 1 or 0.5) then
			scan = 0
			for _, name in
				{ "Criaturas", "Selvagens", "Companheiros", "Guardioes", Run:IsStudio() and "GaleriaV7" or "" }
			do
				local folder = workspace:FindFirstChild(name)
				if folder then
					for _, obj in folder:GetDescendants() do
						if obj:IsA("Model") and obj.PrimaryPart and obj:GetAttribute("Species") then
							A.register(obj)
						end
					end
				end
			end
		end
		local reduced = player:GetAttribute("MotionReduced")
		local candidates = {}
		local time = os.clock()
		for model, record in records do
			if not model.Parent or not model.PrimaryPart then
				records[model] = nil
				continue
			end
			local distance = record.visible and 0 or (model.PrimaryPart.Position - camera.CFrame.Position).Magnitude
			local shown = not record.visible or record.visible()
			local hidden = distance > budget.hideDistance or not shown
			if record.hidden ~= hidden or record.detailLow ~= budget.detailLow then
				record.hidden = hidden
				record.detailLow = budget.detailLow
				for _, part in record.parts do
					if part.Parent then
						part.LocalTransparencyModifier = (
							hidden or budget.detailLow and part:GetAttribute("LODDetail") == true
						)
								and 1
							or 0
					end
				end
			end
			local effectsOn = not budget.detailLow and distance < budget.nearDistance and shown
			if record.effectsOn ~= effectsOn then
				record.effectsOn = effectsOn
				for _, effect in record.effects do
					if effect.Parent then
						effect.Enabled = effectsOn
					end
				end
			end
			if shown and distance < budget.animationDistance then
				table.insert(candidates, { model = model, record = record, distance = distance })
			end
		end
		table.sort(candidates, function(a, b)
			return a.distance < b.distance
		end)
		for index = 1, math.min(budget.animateLimit, #candidates) do
			local item = candidates[index]
			local interval = item.distance < budget.nearDistance and 1 / budget.nearRate or 1 / budget.farRate
			local elapsed = time - item.record.last
			if elapsed + 1e-6 >= interval then
				-- Uma atualização por pulso, sem rajadas de catch-up após travadas.
				item.record.last += math.floor((elapsed + 1e-6) / interval) * interval
				apply(item.model, item.record, time, item.distance < budget.nearDistance, reduced)
			end
		end
	end)
end
return A
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">EncounterUI</string>
            <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local TS = game:GetService("TweenService")
local C = require(RS.Shared.Creatures)
local MF = require(RS.Shared.ModelFactory)
local Theme = require(script.Parent.UITheme)
local CaptureRules = require(RS.Shared.CaptureRules)
local Skills = require(RS.Shared.Skills)
local CAS = game:GetService("ContextActionService")
local Solar = require(script.Parent.SolarPresentation)
local Animator = require(script.Parent.CreatureAnimator)
local Stage = require(script.Parent.BattleStage)
local Art = require(RS.Shared.ArtTokens)
local Icons = require(script.Parent.PixelIcons)
local visible = require(script.Parent.CollectionUI).visible
local UI = {}
function UI.start(gui, getOwned, onClose, onOpen)
	local net = RS:WaitForChild("EncounterNet")
	local state
	local busy = false
	local presenting = false
	local animation = 0
	local root
	local panel
	local viewport
	local figures
	local foeModel
	local foeKey
	local allyModel
	local allyKey
	local actions
	local roster
	local title
	local status
	local hpMine
	local hpFoe
	local chance
	local resize
	local function destroy()
		CAS:UnbindAction("FerasEncounterMovement")
		if resize then
			resize:Disconnect()
			resize = nil
		end
		if root then
			root:Destroy()
			root = nil
		end
		animation += 1
		state = nil
		busy = false
		presenting = false
		onClose()
	end
	gui.Destroying:Once(function()
		CAS:UnbindAction("FerasEncounterMovement")
		if resize then
			resize:Disconnect()
			resize = nil
		end
		-- Respostas atrasadas não remontam modelos dentro de um GUI removido.
		root = nil
		state = nil
		animation += 1
	end)
	local function pose(model, x)
		local cf, size = model:GetBoundingBox()
		local lift = model:GetPivot().Position.Y - (cf.Position.Y - size.Y / 2)
		model:PivotTo(CFrame.new(x, lift + 0.42, 0) * CFrame.Angles(0, x < 0 and math.pi / 2 or -math.pi / 2, 0))
	end
	local function impact(element, position)
		if
			game:GetService("Players").LocalPlayer:GetAttribute("MotionReduced")
			or game:GetService("Players").LocalPlayer:GetAttribute("GraphicsQuality") == "Baixo"
			or game:GetService("Players").LocalPlayer:GetAttribute("AdaptiveDetailLow") == true
		then
			return
		end
		local orb = figures:FindFirstChild("ElementImpact")
		if not orb then
			orb = Instance.new("Part")
			orb.Name = "ElementImpact"
			orb.Shape = Enum.PartType.Block
			orb.Anchored = true
			orb.CanCollide = false
			orb.CanQuery = false
			orb.CanTouch = false
			orb.Material = Enum.Material.Neon
			orb.Parent = figures
		end
		orb.Color = Art.Elements[element][4]
		orb.Position = position
		orb.Size = Vector3.new(0.5, 0.5, 0.25)
		orb.Transparency = 0.2
		TS:Create(orb, TweenInfo.new(0.35), { Size = Vector3.new(6, 6, 0.25), Transparency = 1 }):Play()
	end
	local render
	local function request(action, uid)
		if busy or presenting or not state then
			return
		end
		busy = true
		status.Text = Text.RESOLVENDO_TURNO_8CA931
		task.spawn(function()
			local ok, response = pcall(net.InvokeServer, net, state.token, state.version, action, uid)
			busy = false
			if not root then
				return
			end
			if ok and response then
				local changed = response.version ~= state.version
				state = response
				render(changed)
			else
				status.Text = Text.CONEXAO_INDISPONIVEL_TOQUE_ATUALIZAR_PARA_RECUPE_DAB864
			end
		end)
	end
	local function health(label, unit, name)
		label.Text = name
			.. "\n"
			.. (
				unit and (unit.hp .. " / " .. unit.maxHp .. Text.PV_33D16B)
				or Text.ESCOLHA_UMA_FERA_PARA_BATALHAR_462F3D
			)
		label.TextColor3 = unit and unit.hp <= unit.maxHp * 0.3 and Art.Ramps.Ember[4] or Theme.Ink
		local track = label:FindFirstChild("Meter")
		if not track then
			track = Instance.new("Frame")
			track.Name = "Meter"
			track.Position = UDim2.new(0.04, 0, 1, -10)
			track.Size = UDim2.new(0.92, 0, 0, 8)
			track.BackgroundColor3 = Theme.Card
			track.Parent = label
			Theme.stroke(track)
			for i = 1, 7 do
				local tick = Instance.new("Frame")
				tick.Name = "Tick"
				tick.Size = UDim2.new(0, 2, 1, 0)
				tick.Position = UDim2.fromScale(i / 8, 0)
				tick.BackgroundColor3 = Art.Panel
				tick.BorderSizePixel = 0
				tick.ZIndex = 3
				tick.Parent = track
			end
			local fill = Instance.new("Frame")
			fill.Name = "Fill"
			fill.Size = UDim2.fromScale(1, 1)
			fill.BorderSizePixel = 0
			fill.Parent = track
			local shine = Instance.new("Frame")
			shine.Size = UDim2.new(1, 0, 0, 2)
			shine.BackgroundColor3 = Art.Ink
			shine.BackgroundTransparency = 0.5
			shine.BorderSizePixel = 0
			shine.Parent = fill
		end
		track.Fill.BackgroundColor3 = label.TextColor3 == Theme.Ink and Theme.Mint or Art.Ramps.Ember[3]
		TS:Create(track.Fill, TweenInfo.new(0.3), { Size = UDim2.fromScale(unit and unit.hp / unit.maxHp or 0, 1) })
			:Play()
	end
	render = function(animate)
		if
			not root
			or not root.Parent
			or not viewport
			or not viewport.Parent
			or not figures
			or not figures.Parent
			or not visible(viewport)
		then
			return
		end
		animation += 1
		local job = animation
		presenting = false
		if game:GetService("Players").LocalPlayer:GetAttribute("MotionReduced") then
			animate = false
		end
		title.Text = C.ById[state.foe.id].name
			.. Text.NV_9D89AA
			.. state.foe.lv
			.. " • "
			.. C.Rarity[C.ById[state.foe.id].rar]
		chance.Text = Text.CAPTURA_9BC665
			.. math.floor(state.chance * 100)
			.. Text.SELOS_D7B365
			.. (state.seals or 0)
			.. Text.VINCULO_80DA3F
			.. state.bond
			.. "/3"
		if state.capturable == false then
			chance.Text = Text.DESAFIO_DO_GUARDIAO_NAO_PERMITE_CAPTURA_1198C8
		end
		local pet = state.active and state.party[state.active]
		health(hpFoe, state.foe, Text.SELVAGEM_959EBB)
		health(hpMine, pet, pet and C.ById[pet.id].name or Text.SUA_EQUIPE_C6DEB4)
		local detail = MF.detailKey()
		local newFoeKey = state.foe.id .. ":" .. C.stage(state.foe.lv, state.foe.id) .. ":" .. detail
		if newFoeKey ~= foeKey or not foeModel or not foeModel.Parent then
			if foeModel then
				foeModel:Destroy()
			end
			foeModel = MF.build(C.ById[state.foe.id], state.foe.lv, { preview = true, detail = detail })
			foeModel.Parent = figures
			pose(foeModel, 8)
			Animator.register(foeModel, function()
				return root ~= nil
					and root.Parent ~= nil
					and viewport ~= nil
					and viewport.Parent ~= nil
					and visible(viewport)
			end)
			foeKey = newFoeKey
		end
		foeModel:SetAttribute("Level", state.foe.lv)
		local foe = foeModel
		local key = pet and pet.id .. ":" .. C.stage(pet.lv, pet.id) .. ":" .. detail or "none"
		if key ~= allyKey or (pet and (not allyModel or not allyModel.Parent)) then
			if allyModel then
				allyModel:Destroy()
				allyModel = nil
			end
			if pet then
				allyModel = MF.build(C.ById[pet.id], pet.lv, { preview = true, detail = detail })
				allyModel.Parent = figures
				pose(allyModel, -8)
				Animator.register(allyModel, function()
					return root ~= nil
						and root.Parent ~= nil
						and viewport ~= nil
						and viewport.Parent ~= nil
						and visible(viewport)
				end)
			end
			allyKey = key
		end
		if allyModel and pet then
			allyModel:SetAttribute("Level", pet.lv)
		end
		local ally = allyModel
		local teamLevel = pet and pet.lv or 1
		for _, owned in getOwned() do
			teamLevel = math.max(teamLevel, owned.lv)
		end
		local delta = state.foe.lv - teamLevel
		title.TextColor3 = delta < 0 and Theme.Mint
			or delta < 4 and Art.Ramps.Sand[4]
			or delta < 8 and Art.Ramps.Ember[4]
			or Art.Ramps.Ember[3]
		if delta >= 8 then
			title.Text ..= Text.PERIGO_DC2EAE .. delta
		end
		if state.intro == "phoenix" then
			title.Text = Text.FENIX_LENDARIA_NV_60_A1FE17
		end
		if animate and #state.log > 0 then
			presenting = true
			task.spawn(function()
				for _, event in state.log do
					if not root or not foe.Parent or animation ~= job or not visible(viewport) then
						break
					end
					status.Text = event.text
					local target = event.kind == "hit" and ally or event.kind == "foe" and foe
					if target then
						Animator.play(target, "attack", 0.4)
						local defender = target == ally and foe or ally
						if defender then
							Animator.play(defender, "damage", 0.4)
							local number = Theme.label(viewport, event.text:match("(%d+) de dano") or "", 24)
							number.Name = "ImpactNumber"
							number.Position = UDim2.new(target == ally and 0.62 or 0.18, 0, 0.2, 0)
							number.Size = UDim2.fromOffset(100, 44)
							number.TextColor3 = Art.Ramps.Ember[5]
							number.TextStrokeColor3 = Art.Ramps.Veil[1]
							number.TextStrokeTransparency = 0
							number.ZIndex = 12
							TS:Create(number, TweenInfo.new(0.65), {
								Position = number.Position - UDim2.fromOffset(0, 24),
								TextTransparency = 1,
								TextStrokeTransparency = 1,
							}):Play()
							task.delay(0.7, function()
								number:Destroy()
							end)
							impact(C.ById[target:GetAttribute("Species")].el, defender:GetPivot().Position)
							local viewStart = viewport.CurrentCamera.CFrame
							viewport.CurrentCamera.CFrame = viewStart * CFrame.new(0.18, 0, 0)
							TS:Create(viewport.CurrentCamera, TweenInfo.new(0.12), { CFrame = viewStart }):Play()
						end
						local start = target:GetPivot()
						local toward = event.kind == "hit" and 2 or -2
						local pivot = Instance.new("CFrameValue")
						pivot.Value = start
						local connection = pivot.Changed:Connect(function(v)
							if target.Parent then
								target:PivotTo(v)
							end
						end)
						local tween = TS:Create(
							pivot,
							TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true),
							{ Value = start + CFrame.new(toward, 0, 0).Position }
						)
						tween:Play()
						tween.Completed:Wait()
						connection:Disconnect()
						pivot:Destroy()
					elseif event.kind == "faint" and ally then
						Animator.play(ally, "faint", 0.6)
					elseif event.kind == "win" and state.intro ~= "phoenix" then
						if ally then
							Animator.play(ally, "victory", 0.8)
						end
						Animator.play(foe, "faint", 0.6)
					elseif
						(event.kind == "win" or state.status == "escaped")
						and state.intro == "phoenix"
						and foe.Parent
					then
						local start = foe:GetPivot()
						local value = Instance.new("CFrameValue")
						value.Value = start
						local change = value.Changed:Connect(function(cf)
							if foe.Parent then
								foe:PivotTo(cf)
							end
						end)
						local tween = TS:Create(value, TweenInfo.new(0.6), { Value = start + Vector3.new(0, 16, 0) })
						tween:Play()
						tween.Completed:Wait()
						change:Disconnect()
						value:Destroy()
					elseif event.kind == "capture" or event.kind == "miss" or event.kind == "bond" then
						local seal = Icons.draw(viewport, event.kind == "bond" and "heart" or "seal", 32, Art.Accent)
						seal.Position = UDim2.new(0.2, -16, 0.55, -16)
						seal.ZIndex = 14
						TS:Create(seal, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
							Position = UDim2.new(0.72, -16, 0.35, -16),
							Rotation = event.kind == "bond" and 15 or 180,
						}):Play()
						task.wait(0.4)
						seal:Destroy()
					end
					task.wait(0.25)
				end
				if animation == job then
					presenting = false
				end
			end)
		end
		if not animate and #state.log > 0 then
			status.Text = state.log[#state.log].text
		end
		if state.message then
			status.Text = state.message
		elseif #state.log == 0 then
			status.Text = Text.CAPTURE_DIRETAMENTE_OU_ESCOLHA_UMA_FERA_PARA_ENF_DF3AFD
		end
		for _, o in actions:GetChildren() do
			if o:IsA("GuiButton") then
				o:Destroy()
			end
		end
		local buttons = state.status == "active"
				and {
					{ Text.GOLPE_EF9EC5, "Strike" },
					{ pet and Skills[C.ById[pet.id].shape].name or Text.HABILIDADE_8425E4, "Skill" },
					{ Text.PROTEGER_RECUPERAR_0A724A, "Guard" },
					{ Text.CRIAR_VINCULO_A663E9, "Bond" },
					{ Text.LANCAR_SELO_CDEDAC, "Capture" },
					{ Text.SELO_0B67C2 .. CaptureRules.Seals[state.sealType or "Basic"].name, "ChooseSeal" },
					{ Text.FUGIR_2C0D38, "Flee" },
					{ Text.ATUALIZAR_7ED81F, "State" },
				}
			or {
				{
					state.status == "captured" and Text.CAPTUROU_CONTINUAR_7DA1D5
						or state.status == "won" and Text.VITORIA_CONTINUAR_52F863
						or Text.VOLTAR_A_EXPLORACAO_8F4A4A,
					"Close",
				},
			}
		for _, entry in buttons do
			if
				state.capturable == false and (entry[2] == "Capture" or entry[2] == "Bond" or entry[2] == "ChooseSeal")
			then
				continue
			end
			local available = true
			if state.status == "active" then
				if entry[2] == "Strike" or entry[2] == "Guard" or entry[2] == "Skill" then
					available = pet ~= nil and pet.hp > 0
				end
				if entry[2] == "Skill" and pet and state.turn < (pet.nextSkill or 0) then
					available = false
					entry[1] ..= Text.RECARREGANDO_C160E2
				end
				if entry[2] == "Capture" and (state.seals or 0) < 1 then
					available = false
				end
			end
			local b = Theme.button(actions, entry[1], function()
				if entry[2] == "Close" then
					destroy()
				elseif entry[2] == "ChooseSeal" then
					local index = table.find(CaptureRules.SealOrder, state.sealType or "Basic") or 1
					request("ChooseSeal", CaptureRules.SealOrder[index % #CaptureRules.SealOrder + 1])
				else
					request(entry[2])
				end
			end)
			b.Active = available
			b.Selectable = available
			b.BackgroundTransparency = available and 0 or 0.6
			local iconName = ({
				Strike = "strike",
				Skill = "skill",
				Guard = "guard",
				Bond = "bond",
				Capture = "capture",
				Flee = "flee",
				State = "refresh",
				ChooseSeal = "seal",
				Close = "close",
			})[entry[2]] or "skill"
			local icon = Icons.draw(b, iconName, 16, available and Art.Accent or Art.Muted)
			icon.Position = UDim2.new(0, 8, 0.5, -8)
			b.TextXAlignment = Enum.TextXAlignment.Center
			if not available then
				b.TextColor3 = Art.Muted
			end
		end
		for _, o in roster:GetChildren() do
			if o:IsA("GuiButton") then
				o:Destroy()
			end
		end
		if state.status == "active" then
			local owned = getOwned()
			local ids = {}
			for uid in owned do
				table.insert(ids, uid)
			end
			table.sort(ids)
			for _, uid in ids do
				local creature = owned[uid]
				local unit = state.party[uid]
				local b = Theme.button(
					roster,
					(uid == state.active and "> " or "")
						.. C.ById[creature.id].name
						.. " • "
						.. (unit and unit.hp .. Text.PV_33D16B or "Nv." .. creature.lv),
					function()
						request("Select", uid)
					end
				)
				b.Size = UDim2.fromOffset(155, 44)
			end
		end
	end
	local function show(data)
		if root then
			destroy()
		end
		onOpen()
		state = data
		CAS:BindActionAtPriority("FerasEncounterMovement", function()
			return Enum.ContextActionResult.Sink
		end, false, 3000, table.unpack(Enum.PlayerActions:GetEnumItems()))
		foeModel = nil
		foeKey = nil
		allyModel = nil
		allyKey = nil
		root = Instance.new("Frame")
		root.Size = UDim2.fromScale(1, 1)
		root.BackgroundColor3 = Art.Panel
		root.BackgroundTransparency = 1
		TS:Create(root, TweenInfo.new(0.18), { BackgroundTransparency = 0.16 }):Play()
		root.ZIndex = 50
		root.Active = true
		root.Parent = gui
		panel = Instance.new("Frame")
		panel.AnchorPoint = Vector2.new(0.5, 0.5)
		panel.Position = UDim2.fromScale(0.5, 0.5)
		panel.BackgroundColor3 = Theme.Panel
		panel.Parent = root
		Theme.round(panel, 18)
		Theme.stroke(panel)
		local function layout()
			local size = gui.AbsoluteSize
			local w = math.min(860, size.X - 16)
			local h = math.min(720, size.Y - 16)
			panel.Size = UDim2.fromOffset(w, h)
		end
		layout()
		resize = gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
		title = Theme.label(panel, "", 18)
		title.Position = UDim2.new(0.03, 0, 0, 10)
		title.Size = UDim2.new(0.94, 0, 0, 32)
		viewport = Instance.new("ViewportFrame")
		viewport.Position = UDim2.fromScale(0.02, 0.16)
		viewport.Size = UDim2.fromScale(0.96, 0.36)
		viewport.BackgroundColor3 = Art.Ramps.Sky[2]
		viewport.Ambient = Art.Ramps.Sky[4]
		viewport.LightDirection = Vector3.new(-1, -1, -1)
		viewport.Parent = panel
		Theme.round(viewport)
		local world = Instance.new("WorldModel")
		world.Parent = viewport
		figures = Instance.new("Folder")
		figures.Parent = world
		Stage.build(world, Stage.resolve(C.ById[state.foe.id]))
		local cam = Instance.new("Camera")
		cam.FieldOfView = 48
		cam.CFrame = CFrame.lookAt(Vector3.new(0, 14, 37), Vector3.new(0, 5, 0))
		cam.Parent = viewport
		viewport.CurrentCamera = cam
		hpMine = Theme.label(panel, "", 14)
		hpMine.Position = UDim2.fromScale(0.03, 0.07)
		hpMine.Size = UDim2.fromScale(0.44, 0.09)
		hpFoe = Theme.label(panel, "", 14)
		hpFoe.Position = UDim2.fromScale(0.53, 0.07)
		hpFoe.Size = UDim2.fromScale(0.44, 0.09)
		chance = Theme.label(panel, "", 13)
		chance.Position = UDim2.fromScale(0.03, 0.52)
		chance.Size = UDim2.fromScale(0.94, 0.05)
		status = Theme.label(panel, "", 14)
		status.Position = UDim2.fromScale(0.03, 0.57)
		status.Size = UDim2.fromScale(0.94, 0.08)
		roster = Instance.new("ScrollingFrame")
		roster.BackgroundTransparency = 1
		roster.Position = UDim2.fromScale(0.03, 0.65)
		roster.Size = UDim2.new(0.94, 0, 0, 48)
		roster.AutomaticCanvasSize = Enum.AutomaticSize.X
		roster.CanvasSize = UDim2.new()
		roster.ScrollBarThickness = 3
		roster.Parent = panel
		local rl = Instance.new("UIListLayout")
		rl.FillDirection = Enum.FillDirection.Horizontal
		rl.Padding = UDim.new(0, 8)
		rl.Parent = roster
		actions = Instance.new("ScrollingFrame")
		actions.Position = UDim2.new(0.03, 0, 0.65, 54)
		actions.Size = UDim2.new(0.94, 0, 0.35, -62)
		actions.BackgroundTransparency = 1
		actions.CanvasSize = UDim2.new()
		actions.AutomaticCanvasSize = Enum.AutomaticSize.Y
		actions.ScrollBarThickness = 3
		actions.Parent = panel
		local grid = Instance.new("UIGridLayout")
		grid.CellSize = UDim2.new(0.5, -5, 0, 44)
		grid.CellPadding = UDim2.fromOffset(8, 8)
		grid.Parent = actions
		render(false)
		if state.intro == "phoenix" and foeModel and foeModel.Parent and visible(viewport) then
			presenting = true
			local introJob = animation
			task.spawn(function()
				Solar.intro(panel, viewport, foeModel, function()
					return root ~= nil and animation == introJob
				end)
				if animation == introJob then
					presenting = false
				end
			end)
		end
	end
	RS:WaitForChild("EncounterNotice").OnClientEvent:Connect(show)
	task.spawn(function()
		local ok, data = pcall(net.InvokeServer, net, "", 0, "Resume")
		if ok and data and not root then
			show(data)
		end
	end)
end
return UI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">EnvironmentArt</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Micro-animação cenográfica e vestuário local: não altera Humanoid, saves ou colisão.
local Run = game:GetService("RunService")
local Players = game:GetService("Players")
local T = require(game:GetService("ReplicatedStorage").Shared.ArtTokens)
local E = {}
local started = false
local records = setmetatable({}, { __mode = "k" })
local function dress(character)
	local torso = character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")
		or character:WaitForChild("UpperTorso", 2)
	if not torso then
		return
	end
	local old = character:FindFirstChild("ArteExplorador")
	if old then
		old:Destroy()
	end
	local model = Instance.new("Model")
	model.Name = "ArteExplorador"
	model.Parent = character
	local function cloth(name, size, offset, color)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = torso.CFrame * CFrame.new(offset)
		p.Color = color
		p.Material = Enum.Material.SmoothPlastic
		p.Anchored = false
		p.Massless = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.CastShadow = false
		p.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = torso
		weld.Part1 = p
		weld.Parent = p
	end
	local front = -torso.Size.Z * 0.5 - 0.06
	cloth(
		"Lenco",
		Vector3.new(torso.Size.X * 0.9, 0.18, 0.1),
		Vector3.new(0, torso.Size.Y * 0.35, front),
		T.Ramps.Tidal[3]
	)
	cloth(
		"PontaDoLenco",
		Vector3.new(0.3, 0.5, 0.1),
		Vector3.new(torso.Size.X * 0.26, torso.Size.Y * 0.1, front - 0.02),
		T.Ramps.Tidal[4]
	)
	cloth(
		"BaseDaBussola",
		Vector3.new(0.32, 0.32, 0.08),
		Vector3.new(-torso.Size.X * 0.24, 0, front - 0.01),
		T.Ramps.Sand[2]
	)
	cloth(
		"AgulhaDaBussola",
		Vector3.new(0.08, 0.22, 0.05),
		Vector3.new(-torso.Size.X * 0.24, 0, front - 0.07),
		T.Ramps.Sand[5]
	)
end
local function watch(player)
	player.CharacterAdded:Connect(function(character)
		task.defer(function()
			character:WaitForChild("HumanoidRootPart", 10)
			if character.Parent then
				dress(character)
			end
		end)
	end)
	if player.Character then
		task.defer(dress, player.Character)
	end
end
-- Público apenas para o construtor e a inspeção headless do figurino cosmético.
E.dress = dress
function E.start()
	if started then
		return
	end
	started = true
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerAdded:Connect(watch)
	local elapsed, scan = 0, 0
	Run.Heartbeat:Connect(function(dt)
		elapsed += dt
		scan += dt
		if elapsed < 1 / 15 then
			return
		end
		elapsed = 0
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local player = Players.LocalPlayer
		local quality = player:GetAttribute("GraphicsQuality") or "Médio"
		local reduced = player:GetAttribute("MotionReduced") == true
		if scan >= 1 then
			scan = 0
			for _, name in { "Arquipelago", "Santuarios" } do
				local root = workspace:FindFirstChild(name)
				if root then
					for _, obj in root:GetDescendants() do
						if obj:IsA("BasePart") and obj:GetAttribute("ArtMotion") and not records[obj] then
							records[obj] = {
								cf = obj.CFrame,
								transparency = obj.Transparency,
								kind = obj:GetAttribute("ArtMotion"),
								phase = obj:GetAttribute("ArtPhase") or 0,
							}
						end
					end
				end
			end
		end
		local time = math.floor(os.clock() * 6) / 6
		local candidates = {}
		for part, record in records do
			if not part.Parent then
				records[part] = nil
				continue
			end
			local distance = (record.cf.Position - camera.CFrame.Position).Magnitude
			if reduced or quality == "Baixo" or distance > 170 then
				if record.active then
					part.CFrame = record.cf
					part.Transparency = record.transparency
					record.active = false
				end
			else
				table.insert(candidates, { part = part, record = record, distance = distance })
			end
		end
		table.sort(candidates, function(a, b)
			return a.distance < b.distance
		end)
		local limit = quality == "Alto" and 96 or 48
		for index, item in candidates do
			local p, r = item.part, item.record
			if index > limit then
				if r.active then
					p.CFrame = r.cf
					p.Transparency = r.transparency
					r.active = false
				end
				continue
			end
			r.active = true
			local phase = time + r.phase
			if r.kind == "grass" then
				p.CFrame = r.cf * CFrame.Angles(0, 0, math.sin(phase * 2) * 0.1)
			elseif r.kind == "leaf" then
				p.CFrame = r.cf * CFrame.Angles(0.02 * math.sin(phase), 0, 0.025 * math.sin(phase * 1.3))
			elseif r.kind == "cloud" then
				p.CFrame = r.cf * CFrame.new(0, math.sin(phase * 0.7) * 0.15, 0)
			elseif r.kind == "water" then
				p.CFrame = r.cf * CFrame.new(math.sin(phase * 0.6) * 0.3, 0, 0)
				p.Transparency = math.clamp(r.transparency + math.sin(phase) * 0.1, 0, 0.8)
			elseif r.kind == "spark" then
				p.CFrame = r.cf * CFrame.new(0, math.sin(phase * 1.3) * 0.25, 0)
				p.Transparency = 0.12 + math.abs(math.sin(phase)) * 0.25
			end
		end
	end)
end
return E
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">JournalUI</string>
            <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local C = require(RS.Shared.Creatures)
local I = require(RS.Shared.Islands)
local E = require(RS.Shared.Elements)
local Preview = require(script.Parent.CollectionUI)
local Theme = require(script.Parent.UITheme)
local Lore = require(RS.Shared.SpeciesLore)
local J = {}
local selected = "cinzelo"
local rarity = 0
local island = 0
local element = 0
local search = ""
function J.select(id)
	if not C.ById[id] then
		return false
	end
	selected = id
	rarity = 0
	island = 0
	element = 0
	search = ""
	return true
end
local function frame(parent, height)
	local f = Instance.new("Frame")
	f.Size = UDim2.new(1, -8, 0, height)
	f.BackgroundColor3 = Theme.Card
	f.Parent = parent
	Theme.panel(f)
	return f
end
function J.render(parent, s, render)
	local container = parent:FindFirstChild("BestiaryPanel")
	if not container then
		container = frame(parent, 500)
		container.Name = "BestiaryPanel"
		container.BackgroundTransparency = 1
		local layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0, 8)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = container
	end
	for _, child in container:GetChildren() do
		if child:IsA("Frame") and child.Name ~= "MainPreview" then
			child:Destroy()
		end
	end
	local filters = frame(container, 100)
	filters.LayoutOrder = 1
	filters.BackgroundTransparency = 1
	local choices = {
		{
			Text.RARIDADE_9F174D .. (C.Rarity[rarity] or "Todas"),
			function()
				rarity = (rarity + 1) % 5
				render()
			end,
		},
		{
			Text.BIOMA_94C907 .. (island == 0 and "Todos" or I.List[island].name),
			function()
				island = (island + 1) % (#I.List + 1)
				render()
			end,
		},
		{
			Text.ELEMENTO_BB6BA8 .. (E.List[element] or "Todos"),
			function()
				element = (element + 1) % 7
				render()
			end,
		},
	}
	for index, entry in choices do
		local b = Theme.button(filters, entry[1], entry[2])
		b.Position = UDim2.new((index - 1) % 2 * 0.5, 2, 0, math.floor((index - 1) / 2) * 50)
		b.Size = UDim2.new(0.5, -4, 0, 46)
	end
	local box = Instance.new("TextBox")
	box.PlaceholderText = Text.BUSCAR_ESPECIE_09F339
	box.Text = search
	box.TextSize = 16
	box.Font = Theme.Font
	box.ClearTextOnFocus = false
	box.Size = UDim2.new(0.5, -4, 0, 46)
	box.Position = UDim2.new(0.5, 2, 0, 50)
	box.BackgroundColor3 = Theme.Card
	box.TextColor3 = Theme.Ink
	box.PlaceholderColor3 = Theme.Muted
	box.Parent = filters
	Theme.round(box)
	box.FocusLost:Connect(function()
		search = string.sub(box.Text, 1, 40)
		render()
	end)
	local def = C.ById[selected]
	local known = s.discovered[selected]
	local lv, count = 1, 0
	for _, cr in s.creatures do
		if cr.id == selected then
			count += 1
			lv = math.max(lv, cr.lv)
		end
	end
	local card = container:FindFirstChild("MainPreview") or frame(container, 360)
	card.Name = "MainPreview"
	card.LayoutOrder = 2
	for _, child in card:GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	Preview.preview(card, def, lv, not known)
	local info = Theme.label(card, "", 14)
	info.Position = UDim2.fromScale(0.03, 0.66)
	info.Size = UDim2.fromScale(0.94, 0.33)
	info.TextXAlignment = Enum.TextXAlignment.Left
	info.TextYAlignment = Enum.TextYAlignment.Top
	info.Text = known
			and (def.name .. " • " .. def.el .. " • " .. C.Rarity[def.rar] .. "\n" .. (I.ById[def.island] and I.ById[def.island].name or Text.HIBRIDO_9CB40A) .. Text.COLECAO_57798D .. count .. Text.NV_AE0838 .. lv .. Text.ESTAGIO_D2FEE2 .. C.stage(
				lv,
				def.id
			) .. (def.id == "fenix" and Text.RENASCIMENTO_FUTURO_9236DA or Text.EVOLUI_EM_7_15_75E2ED))
		or (
			def.acquisition == "special" and Text.VESTIGIOS_DE_UMA_ESPECIE_DESCONHECIDA_B8DB43
			or Text.ESPECIE_MISTERIOSA_EXPLORE_CAPTURE_OU_CRUZE_FERA_6D0C6C
		)
	if known and Lore[def.id] then
		info.Text ..= "\n" .. Lore[def.id].description .. " • " .. Lore[def.id].personality
	end
	local matches = {}
	for _, entry in C.List do
		local found = s.discovered[entry.id]
		if
			(rarity == 0 or entry.rar == rarity)
			and (island == 0 or entry.island == I.List[island].id)
			and (element == 0 or entry.el == E.List[element])
			and (search == "" or (found and string.find(string.lower(entry.name), string.lower(search), 1, true)))
		then
			table.insert(matches, entry)
		end
	end
	if #matches == 0 then
		local f = frame(container, 50)
		container.Size = UDim2.new(1, -8, 0, 540)
		local l = Theme.label(f, Text.NENHUMA_ESPECIE_CORRESPONDE_AOS_FILTROS_7AC10E, 14)
		l.Size = UDim2.fromScale(1, 1)
		return
	end
	local columns = parent.AbsoluteSize.X >= 390 and 3 or 2
	container.Size = UDim2.new(1, -8, 0, 480 + math.ceil(#matches / columns) * 148)
	local grid = frame(container, math.ceil(#matches / columns) * 148)
	grid.LayoutOrder = 3
	grid.BackgroundTransparency = 1
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.new(1 / columns, -7, 0, 140)
	layout.CellPadding = UDim2.fromOffset(7, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = grid
	for index, entry in matches do
		local found = s.discovered[entry.id]
		local tile = Instance.new("Frame")
		tile.LayoutOrder = index
		tile.BackgroundColor3 = entry.id == selected and Theme.Tokens.Elements[entry.el][1] or Theme.Card
		tile.Parent = grid
		Theme.panel(tile, entry.id == selected and Theme.Tokens.Elements[entry.el][4] or Theme.Edge)
		local mini
		local function visibility()
			if not tile.Parent then
				return
			end
			local top = parent.AbsolutePosition.Y
			local y = tile.AbsolutePosition.Y
			local visible = Preview.visible(tile) and y + 140 >= top and y < top + parent.AbsoluteSize.Y
			if visible then
				mini = Preview.preview(tile, entry, 1, not found)
				if mini then
					mini.Size = UDim2.fromScale(1, 0.72)
				end
			elseif not visible and mini then
				mini:Destroy()
				mini = nil
			end
		end
		local scroll = parent:GetPropertyChangedSignal("CanvasPosition"):Connect(visibility)
		local visible = parent:GetPropertyChangedSignal("Visible"):Connect(visibility)
		local pos = tile:GetPropertyChangedSignal("AbsolutePosition"):Connect(visibility)
		tile.Destroying:Connect(function()
			scroll:Disconnect()
			visible:Disconnect()
			pos:Disconnect()
		end)
		task.defer(visibility)
		local choose = Theme.button(tile, found and entry.name or "???", function()
			selected = entry.id
			render()
		end)
		choose.Position = UDim2.new(0, 0, 1, -44)
		choose.Size = UDim2.new(1, 0, 0, 44)
		choose.TextSize = 12
	end
end
return J
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">NurseryUI</string>
            <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local C = require(RS.Shared.Creatures)
local Balance = require(RS.Shared.Economy)
local Preview = require(script.Parent.CollectionUI)
local Theme = require(script.Parent.UITheme)
local Icons = require(script.Parent.PixelIcons)
local N = {}
local function frame(parent, height)
	local f = Instance.new("Frame")
	f.Size = UDim2.new(1, -12, 0, height)
	f.BackgroundColor3 = Theme.Card
	f.Parent = parent
	Theme.panel(f)
	return f
end
local function text(parent, name, value, pos, size)
	local t = Instance.new("TextLabel")
	t.Name = name
	t.Text = value
	t.Position = pos
	t.Size = size
	t.BackgroundTransparency = 1
	t.TextColor3 = Theme.Ink
	t.TextSize = 14
	t.TextWrapped = true
	t.Font = Theme.Font
	t.Parent = parent
	return t
end
local function button(parent, name, value, x, callback)
	local b = Instance.new("TextButton")
	b.Name = name
	b.Text = value
	b.Position = UDim2.fromScale(x, 0.72)
	b.Size = UDim2.new(0.31, 0, 0, 44)
	b.BackgroundColor3 = Theme.Tokens.Ramps.Sand[2]
	b.TextColor3 = Theme.Ink
	b.Font = Theme.Font
	b.TextSize = 14
	b.Parent = parent
	b.Activated:Connect(callback)
	b.Active = true
	b.Selectable = true
	Theme.bind(b)
	return b
end
local function enabled(b, yes)
	b.Active = yes
	b.Selectable = yes
	b.AutoButtonColor = yes
	b.BackgroundTransparency = yes and 0 or 0.65
end
function N.egg(parent, def, left, hatch, speed)
	local f = frame(parent, 176)
	f.Name = "IncubatingEgg"
	f:SetAttribute("ReadyClock", os.clock() + left)
	local v = Instance.new("ViewportFrame")
	v.Size = UDim2.fromScale(0.3, 1)
	v.BackgroundTransparency = 1
	v.Ambient = Theme.Tokens.Ramps.Metal[3]
	v.LightColor = Theme.Ink
	v.LightDirection = Vector3.new(-1, -1, -1)
	v.Parent = f
	local egg = Instance.new("Part")
	egg.Shape = Enum.PartType.Ball
	egg.Size = Vector3.new(3, 4, 3)
	egg.Anchored = true
	egg.CanCollide = false
	egg.Color = Theme.Tokens.Elements[def.el][4]
	egg.Material = Enum.Material.SmoothPlastic
	egg.Parent = v
	for index = 1, 4 do
		local mark = Instance.new("Part")
		mark.Size = Vector3.new(0.32, 0.32, 0.08)
		mark.CFrame = CFrame.new((index % 2 == 0 and 1 or -1) * 0.55, (math.floor((index - 1) / 2) - 0.5) * 1.0, 1.4)
		mark.Anchored = true
		mark.CanCollide = false
		mark.CanQuery = false
		mark.CanTouch = false
		mark.Color = Theme.Tokens.Elements[def.el][2]
		mark.Parent = v
	end
	local icon = Icons.draw(f, "Egg", 16, Theme.Tokens.Elements[def.el])
	icon.Position = UDim2.fromOffset(8, 8)
	local gem = Instance.new("Part")
	gem.Shape = Enum.PartType.Ball
	gem.Size = Vector3.new(0.8, 1, 0.5)
	gem.Position = Vector3.new(0, 0.3, 1.4)
	gem.Anchored = true
	gem.Color = def.hybrid and Theme.Tokens.Elements[def.hybrid[2]][3] or Theme.Ink
	gem.Parent = v
	local camera = Instance.new("Camera")
	camera.CFrame = CFrame.lookAt(Vector3.new(4, 2, 9), Vector3.zero)
	camera.Parent = v
	v.CurrentCamera = camera
	text(f, "Element", Text.OVO_DE_763A79 .. def.el, UDim2.fromScale(0.32, 0.04), UDim2.fromScale(0.65, 0.22))
	text(f, "Countdown", "", UDim2.fromScale(0.32, 0.28), UDim2.fromScale(0.65, 0.36))
	button(f, "Hatch", "Chocar", 0.33, function()
		if os.clock() >= f:GetAttribute("ReadyClock") then
			hatch()
		end
	end)
	button(f, "Speed", "Acelerar", 0.66, speed)
	N.tick(parent)
	return f
end
function N.tick(parent)
	for _, f in parent:GetChildren() do
		if f.Name ~= "IncubatingEgg" then
			continue
		end
		local left = math.max(0, math.ceil(f:GetAttribute("ReadyClock") - os.clock()))
		f.Countdown.Text = left == 0 and Text.PRONTO_PARA_ECLODIR_379A20
			or (
				Text.INCUBANDO_75EABA
				.. left
				.. Text.S_ACELERAR_8DABB8
				.. math.max(1, math.ceil(left / 30))
				.. Text.GEMAS_BEE5F6
			)
		enabled(f.Hatch, left == 0)
		enabled(f.Speed, left > 0)
	end
end
function N.parents(parent, a, b, outcomes, available, breed)
	local f = frame(parent, 360)
	f.Name = "BreedingPreview"
	local names = {}
	for index, def in { a, b } do
		local holder = Instance.new("Frame")
		holder.Size = UDim2.fromScale(0.5, 0.52)
		holder.Position = UDim2.fromScale((index - 1) * 0.5, 0)
		holder.BackgroundTransparency = 1
		holder.Parent = f
		Preview.preview(holder, def, 1, false)
		text(holder, "Name", def.name .. " • " .. def.el, UDim2.fromScale(0, 0.65), UDim2.fromScale(1, 0.3))
	end
	for _, def in C.List do
		local chance = outcomes[def.id]
		if chance then
			table.insert(names, def.name .. " " .. string.format("%.1f%%", chance * 100))
		end
	end
	text(f, "Outcomes", table.concat(names, " • "), UDim2.fromScale(0.03, 0.5), UDim2.fromScale(0.94, 0.2)).TextSize =
		12
	text(
		f,
		"Cost",
		Text.CUSTO_805D21
			.. Balance.BreedCost
			.. Text.OURO_INCUBACAO_30480S_E8C4B8
			.. (available and Text.CHOCADEIRA_DISPONIVEL_F42230 or Text.PRECISA_DE_OURO_E_VAGA_NA_CHOCADEIRA_7FC4F9),
		UDim2.fromScale(0.03, 0.7),
		UDim2.fromScale(0.94, 0.14)
	)
	local start = button(f, "Breed", "Cruzar", 0.33, breed)
	start.Position = UDim2.new(0.15, 0, 1, -52)
	start.Size = UDim2.new(0.7, 0, 0, 44)
	enabled(start, available)
	return f
end
return N
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">PixelIcons</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Original 16px glyphs rendered as integer-sized runs; no external images or emoji.
local Tokens = require(game:GetService("ReplicatedStorage").Shared.ArtTokens)
local P = { Size = 16 }
P.Grids = {
	Coin = {
		"................",
