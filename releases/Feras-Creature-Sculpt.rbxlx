      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Migration</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Sem serviços. Só acrescenta campos: a sanitização de entrada continua no DataService.
local Config = require(script.Parent.Config)
local C = require(script.Parent.Creatures)
local Bands = require(script.Parent.LevelBands)
local M = {}
function M.clone(value)
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in value do
		out[k] = M.clone(v)
	end
	return out
end
function M.run(raw)
	if typeof(raw) ~= "table" or typeof(raw.creatures) ~= "table" or next(raw.creatures) == nil then
		return nil, "CORRUPT_PROFILE"
	end
	if typeof(raw.v) ~= "number" or raw.v % 1 ~= 0 or raw.v < 1 or raw.v > Config.ProfileVersion then
		return nil, "FUTURE_OR_INVALID_VERSION"
	end
	-- Recusa o registro inteiro antes de qualquer escrita se uma estrutura essencial estiver inválida.
	for _, key in
		{
			"unlocked",
			"eggs",
			"habitat",
			"sanctuary",
			"stats",
			"claimed",
			"phoenix",
			"grants",
			"legacyEggPermits",
			"legacyGrandfathered",
		}
	do
		if raw[key] ~= nil and type(raw[key]) ~= "table" then
			return nil, "CORRUPT_" .. key
		end
	end
	for uid, pet in raw.creatures do
		if
			type(uid) ~= "string"
			or type(pet) ~= "table"
			or not C.ById[pet.id]
			or type(pet.lv) ~= "number"
			or pet.lv ~= pet.lv
			or pet.lv < 1
			or pet.lv == math.huge
		then
			return nil, "CORRUPT_CREATURE"
		end
	end
	for _, egg in raw.eggs or {} do
		if
			type(egg) ~= "table"
			or not C.ById[egg.id]
			or type(egg.ready) ~= "number"
			or egg.ready ~= egg.ready
			or egg.ready < 0
			or egg.ready == math.huge
		then
			return nil, "CORRUPT_EGG"
		end
	end
	local function number(value, minimum)
		return value == nil
			or (
				type(value) == "number"
				and value == value
				and value >= minimum
				and value < math.huge
				and value % 1 == 0
			)
	end
	for _, key in { "gold", "gems", "seals", "playerXp", "nextId", "last", "wins", "dailyDay", "streak", "trophies" } do
		if not number(raw[key], 0) then
			return nil, "CORRUPT_NUMBER:" .. key
		end
	end
	if not number(raw.playerLevel, 1) then
		return nil, "CORRUPT_LEVEL"
	end
	for _, pet in raw.creatures do
		if not number(pet.lv, 1) or not number(pet.xp, 0) then
			return nil, "CORRUPT_CREATURE_NUMBER"
		end
	end
	for _, values in { raw.stats or {}, raw.materials or {}, raw.sealStock or {} } do
		if type(values) ~= "table" then
			return nil, "CORRUPT_COUNTERS"
		end
		for _, value in values do
			if not number(value, 0) then
				return nil, "CORRUPT_COUNTER"
			end
		end
	end
	if raw.phoenix and not number(raw.phoenix.captureCount, 0) then
		return nil, "CORRUPT_CAPTURE_COUNT"
	end

	for _, key in
		{
			"discovered",
			"guardians",
			"visited",
			"storyClaimed",
			"legacyGrandfathered",
			"gatherAt",
			"sealStock",
			"materials",
		}
	do
		if raw[key] ~= nil and type(raw[key]) ~= "table" then
			return nil, "CORRUPT_MAP:" .. key
		end
	end
	for _, key in { "unlocked", "discovered", "guardians", "visited", "claimed", "storyClaimed", "legacyGrandfathered" } do
		for _, value in raw[key] or {} do
			if type(value) ~= "boolean" then
				return nil, "CORRUPT_FLAG:" .. key
			end
		end
	end
	for id, entry in raw.sanctuary or {} do
		if
			not Bands.ById[id]
			or type(entry) ~= "table"
			or not number(entry.slot, 1)
			or not entry.slot
			or entry.slot > 9
			or not number(entry.level, 1)
			or not entry.level
		then
			return nil, "CORRUPT_HABITAT_STRUCTURE"
		end
	end
	local assigned = {}
	for id, list in raw.habitat or {} do
		if not Bands.ById[id] or type(list) ~= "table" then
			return nil, "CORRUPT_HABITAT"
		end
		for _, uid in list do
			if type(uid) ~= "string" or not raw.creatures[uid] or assigned[uid] then
				return nil, "CORRUPT_HABITAT_UID"
			end
			assigned[uid] = true
		end
	end
	for _, egg in raw.eggs or {} do
		if
			not number(egg.ready, 0)
			or (egg.region ~= nil and not Bands.ById[egg.region])
			or (egg.nonce ~= nil and type(egg.nonce) ~= "string")
		then
			return nil, "CORRUPT_EGG_FIELDS"
		end
	end
	if raw.phoenix then
		for _, key in { "captured", "sanctuaryOpen" } do
			if raw.phoenix[key] ~= nil and type(raw.phoenix[key]) ~= "boolean" then
				return nil, "CORRUPT_PHOENIX_FLAG"
			end
		end
	end
	local d = M.clone(raw)
	local old = d.v
	d.legacyGrandfathered = d.legacyGrandfathered or {}
	if old < 5 then
		for id, value in d.unlocked or {} do
			if value == true then
				d.legacyGrandfathered[id] = true
			end
		end
	end
	d.phoenix = d.phoenix or { glyphs = {}, sanctuaryOpen = false, attempts = 0, nextAttemptAt = 0, captured = false }
	d.grants = d.grants or {}
	d.legacyEggPermits = d.legacyEggPermits or {}
	for i, egg in d.eggs or {} do
		egg.nonce = egg.nonce or ("legacy:" .. tostring(egg.id) .. ":" .. tostring(egg.ready) .. ":" .. i)
		egg.region = egg.region or "Alvorecer"
		if old < 5 and egg.id == "fenix" then
			d.legacyEggPermits[egg.nonce] = egg.id
		end
	end
	for key, value in { glyphs = {}, sanctuaryOpen = false, attempts = 0, nextAttemptAt = 0, captured = false } do
		if d.phoenix[key] == nil then
			d.phoenix[key] = value
		end
	end
	if type(d.phoenix.glyphs) ~= "table" then
		return nil, "CORRUPT_GLYPHS"
	end
	for _, key in { "attempts", "nextAttemptAt" } do
		local value = d.phoenix[key]
		if type(value) ~= "number" or value ~= value or value < 0 or value == math.huge then
			return nil, "CORRUPT_PHOENIX"
		end
	end
	local existing = 0
	for _, pet in d.creatures do
		if pet.id == "fenix" then
			existing += 1
		end
	end
	d.phoenix.captureCount = math.max(d.phoenix.captureCount or (d.phoenix.captured and 1 or 0), existing)
	if existing > 0 then
		d.phoenix.captured = true
	end

	if d.navigation ~= nil and type(d.navigation) ~= "table" then
		return nil, "CORRUPT_NAVIGATION"
	end
	if not d.navigation then
		local visited = { Alvorecer = true }
		for id, value in d.visited or {} do
			if Bands.ById[id] and value == true then
				visited[id] = true
			end
		end
		d.navigation = { visited = visited, checkpoint = "Alvorecer" }
	end
	if type(d.navigation.visited) ~= "table" or not Bands.ById[d.navigation.checkpoint] then
		return nil, "CORRUPT_NAVIGATION"
	end
	for id, value in d.navigation.visited do
		if not Bands.ById[id] or type(value) ~= "boolean" then
			return nil, "CORRUPT_NAVIGATION"
		end
	end
	if d.sanctuary == nil then
		d.sanctuary = {}
		local slot = 0
		for _, id in Bands.Order do
			if (d.unlocked and d.unlocked[id]) or #(d.habitat and d.habitat[id] or {}) > 0 then
				slot += 1
				d.sanctuary[id] = { slot = slot, level = 1 }
			end
		end
	end
	if Config.World.FreeExploration then
		d.unlocked = d.unlocked or {}
		for _, id in Bands.Order do
			d.unlocked[id] = true
		end
	end
	d.v = Config.ProfileVersion
	return d
end
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Missions</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(script.Parent.Strings).Text
local L = {}
local function add(id, text, stat, goal, gold, gems)
	table.insert(L, { id = id, text = text, stat = stat, goal = goal, gold = gold, gems = gems or 0 })
end
add("f1", Text.ALIMENTE_UMA_FERA_6CB80D, "feed", 1, 40)
add("f2", Text.ALIMENTE_5_VEZES_C4C1AB, "feed", 5, 120, 1)
add("f3", Text.ALIMENTE_20_VEZES_CA2277, "feed", 20, 400, 3)
add("b1", Text.CRUZE_DUAS_FERAS_539F57, "breed", 1, 60)
add("b2", Text.CRUZE_5_VEZES_E3D7DC, "breed", 5, 200, 2)
add("h1", Text.CHOQUE_UM_OVO_03D8B3, "hatch", 1, 60)
add("h2", Text.CHOQUE_5_OVOS_5ED8F1, "hatch", 5, 250, 2)
add("w1", Text.VENCA_UMA_BATALHA_A43940, "win", 1, 80)
add("w2", Text.VENCA_10_BATALHAS_CCE0E5, "win", 10, 500, 3)
add("w3", Text.VENCA_30_BATALHAS_AC517C, "win", 30, 1500, 8)
add("c1", Text.COLETE_OURO_5_VEZES_A103BB, "collect", 5, 100)
add("d1", Text.DESCUBRA_8_FERAS_F45F2C, "found", 8, 300, 3)
add("d2", Text.DESCUBRA_15_FERAS_B78B13, "found", 15, 1200, 6)
add("i1", Text.TENHA_3_ILHAS_FDA36F, "isles", 3, 400, 3)
add("i2", Text.TENHA_TODAS_AS_ILHAS_D2BB30, "isles", #require(script.Parent.Islands).List, 5000, 15)
add("p1", Text.VENCA_UM_DUELO_ONLINE_2F97C7, "duelwin", 1, 200, 3)
add("a1", Text.CONQUISTA_DESCUBRA_TODAS_AS_FERAS_8AFA2F, "found", #require(script.Parent.Creatures).List, 3000, 20)
add("a2", Text.CONQUISTA_100_VITORIAS_29C94D, "win", 100, 5000, 20)
add("a3", Text.CONQUISTA_ALIMENTE_100_VEZES_9D7566, "feed", 100, 2000, 10)
add("a4", Text.CONQUISTA_CHOQUE_25_OVOS_57A023, "hatch", 25, 2500, 10)
add("a5", Text.CONQUISTA_COLETE_50_VEZES_0CDE21, "collect", 50, 1500, 8)
local M = { List = L, ById = {} }
for _, m in L do
	M.ById[m.id] = m
end
function M.progress(d, stat)
	if stat == "found" or stat == "isles" then
		local n = 0
		for _ in (stat == "found" and d.discovered or d.unlocked) do
			n += 1
		end
		return n
	end
	return d.stats[stat] or 0
end
-- Evento rotativo: a cada 3 dias um elemento rende +50% de ouro.
local EL =
	{ Text.FOGO_F77A3C, Text.AGUA_F11A05, Text.NATUREZA_FB1ED9, Text.TERRA_16D3AE, Text.AR_B623FF, Text.SOMBRA_94B135 }
function M.event(now)
	local per = 3 * 86400
	return EL[(now // per) % 6 + 1], per - now % per
end
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">ModelFactory</string>
          <string name="Source"><![CDATA[--!nonstrict
local C = require(script.Parent.Creatures)
local D = require(script.Parent.CreatureDesigns)
local Context = require(script.Parent.SculptContext)
local LOD = require(script.Parent.SculptLOD)
local builders = {}
for _, family in
	{
		require(script.Parent.SculptOrganic),
		require(script.Parent.SculptTidal),
		require(script.Parent.SculptSky),
		require(script.Parent.SculptMystic),
		require(script.Parent.SculptDrakes),
	}
do
	for id, build in family do
		assert(not builders[id], "Escultura duplicada: " .. id)
		builders[id] = build
	end
end
local Art = require(script.Parent.ArtTokens)
local Factory = {}
local cache = {}
local V = Vector3.new
local function bounds(model)
	local low = V(math.huge, math.huge, math.huge)
	local high = -low
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") and p.Name ~= "Root" then
			for _, x in { -1, 1 } do
				for _, y in { -1, 1 } do
					for _, z in { -1, 1 } do
						local pos = p.CFrame:PointToWorldSpace(p.Size * V(x, y, z) * 0.5)
						low = V(math.min(low.X, pos.X), math.min(low.Y, pos.Y), math.min(low.Z, pos.Z))
						high = V(math.max(high.X, pos.X), math.max(high.Y, pos.Y), math.max(high.Z, pos.Z))
					end
				end
			end
		end
	end
	return low, high
end
Factory.bounds = bounds
function Factory.validate(model)
	assert(model.PrimaryPart and model.PrimaryPart.Name == "Root", "Raiz ausente")
	local design = D[model:GetAttribute("Species")]
	local stage = model:GetAttribute("Stage")
	assert(design and stage, "Receita ou estágio ausente")
	local count, joints, emitters, lights = 0, {}, 0, 0
	local parents = {}
	for _, obj in model:GetDescendants() do
		assert(not obj:IsA("LuaSourceContainer"), "Script dentro da criatura")
		if obj:IsA("BasePart") then
			count += 1
			for _, n in { obj.Size.X, obj.Size.Y, obj.Size.Z } do
				assert(n == n and n > 0 and n < 100, "Size inválido")
			end
			assert(
				not obj.CanCollide and not obj.CanQuery and not obj.CanTouch and obj.Massless,
				"Colisão/massa inválida"
			)
			for _, component in { obj.CFrame:GetComponents() } do
				assert(component == component and math.abs(component) < 1000000, "Transform inválido: " .. obj.Name)
			end
			assert(obj == model.PrimaryPart or not obj.Anchored, "Parte visual ancorada")
		elseif obj:IsA("Motor6D") then
			assert(not joints[obj.Name], "Joint duplicado")
			joints[obj.Name] = true
			assert(obj.Part0 and obj.Part1, "Motor desconectado")
			parents[obj.Part1] = obj.Part0
		elseif obj:IsA("WeldConstraint") then
			assert(obj.Part0 and obj.Part1, "Weld desconectado")
			parents[obj.Part1] = obj.Part0
		elseif obj:IsA("ParticleEmitter") then
			emitters += 1
		elseif obj:IsA("Light") then
			lights += 1
		end
	end
	for part in parents do
		local cursor, seen = part, {}
		while cursor ~= model.PrimaryPart do
			assert(cursor and cursor:IsDescendantOf(model) and not seen[cursor], "Rig inválido ou cíclico")
			seen[cursor] = true
			cursor = parents[cursor]
		end
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part ~= model.PrimaryPart then
			assert(parents[part], "Parte solta: " .. part.Name)
		end
	end
	assert(count <= design.budget[stage], "Orçamento excedido: " .. count)
	assert(emitters <= (design.head == "solarbeak" and 2 or 1) and lights <= 1, "Orçamento de efeitos excedido")
	local low, high = bounds(model)
	local size = high - low
	assert(
		size.Magnitude > 0.6 and size.Magnitude < (design.head == "solarbeak" and 70 or ({ 20, 30, 45 })[stage]),
		"Bounding box inválida"
	)
	return { parts = count, joints = joints, size = size, emitters = emitters, lights = lights }
end
local function template(def, stage)
	local d = assert(D[def.id], "Design ausente")
	local m = Instance.new("Model")
	m.Name = def.name
	m.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	for key, value in
		{
			Species = def.id,
			Stage = stage,
			Family = d.family,
			EyeType = d.eyes,
			HeadType = d.head,
			TailType = d.tail,
			LimbCount = d.limbs,
			ArtStyle = "StorybookSculpt3D",
			Expression = d.expression.mouth,
			BlinkOffset = #def.id * 0.2,
		}
	do
		m:SetAttribute(key, value)
	end
	local context = Context.new(m, d, stage)
	local builder = assert(builders[def.id], "Escultura exclusiva ausente: " .. def.id)
	local anatomy = builder(context)
	assert(anatomy and anatomy.body and anatomy.head, "Estrutura anatômica ausente")
	assert(anatomy.body.Name == "Body" and anatomy.head.Name == "Head", "Corpo/cabeça não identificados")
	LOD.annotate(m)
	Factory.validate(m)
	return m
end
function Factory.detailKey(options)
	if options and options.detail then
		return options.detail == "low" and "low" or "full"
	end
	local success, detail = pcall(function()
		if not game:GetService("RunService"):IsClient() then
			return "full"
		end
		local p = game:GetService("Players").LocalPlayer
		local quality = p and p:GetAttribute("GraphicsQuality")
		return p and (quality == "Baixo" or quality ~= "Alto" and p:GetAttribute("AdaptiveDetailLow") == true) and "low"
			or "full"
	end)
	return success and detail or "full"
end
function Factory.build(def, level, options)
	options = options or {}
	local stage = C.stage(level, def.id)
	local base = def.id .. ":" .. stage .. ":"
	local detail = Factory.detailKey(options)
	local key = base .. detail
	if not cache[key] then
		local made = template(def, stage)
		if detail == "low" then
			LOD.reduce(made)
			Factory.validate(made)
		end
		-- Uma variante por espécie/estágio: mudar qualidade não duplica a memória dos templates.
		local other = base .. (detail == "low" and "full" or "low")
		if cache[other] then
			cache[other]:Destroy()
			cache[other] = nil
		end
		cache[key] = made
	end
	local model = cache[key]:Clone()
	model.Name = def.name
	model:SetAttribute("Level", level)
	if not options.preview then
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(180, 32)
		gui.StudsOffset = V(0, 4, 0)
		gui.MaxDistance = 60
		gui.Parent = model.PrimaryPart
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.TextColor3 = Art.Ink
		label.TextStrokeTransparency = 0
		label.TextStrokeColor3 = Art.Shadow
		label.TextSize = 16
		label.Font = Art.Font
		label.Text = def.name .. " • Nv." .. level
		label.Parent = gui
	end
	Factory.validate(model)
	return model
end
function Factory.clearCache()
	for _, m in cache do
		m:Destroy()
	end
	cache = {}
end
function Factory.cacheStats()
	local templates, parts = 0, 0
	for _, model in cache do
		templates += 1
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") then
				parts += 1
			end
		end
	end
	return { templates = templates, parts = parts }
end
return Factory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">PhoenixQuest</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(script.Parent.Strings).Text
local Config = require(script.Parent.Config)
local Q = { Glyphs = { duneHidden = true, duneRuin = true, skyPeak = true } }
function Q.stage(profile)
	local n = 0
	for id, value in (profile.phoenix and profile.phoenix.glyphs or {}) do
		if value == true and Q.Glyphs[id] then
			n += 1
		end
	end
	return math.min(3, n)
end
function Q.public(profile)
	local stage = Q.stage(profile)
	if stage == 0 then
		return { stage = 0 }
	end
	if stage == 1 then
		return {
			stage = 1,
			title = Text.ECO_DE_FOGO_ANTIGO_40525F,
			hint = Text.UMA_INSCRICAO_MENCIONA_DOIS_SINAIS_ENTRE_AREIA_E_4D4A59,
		}
	end
	if stage == 2 then
		return {
			stage = 2,
			title = Text.VESTIGIOS_513BA0,
			hint = Text.AS_RUINAS_DAS_DUNAS_RESPONDEM_AOS_SINAIS_DAS_ALT_695E0C,
		}
	end
	return {
		stage = 3,
		title = Text.VESTIGIOS_513BA0,
		hint = Text.OFERECA_UMA_CHAMA_NO_ALTAR_DAS_RUINAS_24F74A,
		nextAttemptAt = profile.phoenix.nextAttemptAt,
		captured = (profile.phoenix.captureCount or (profile.phoenix.captured and 1 or 0))
			>= Config.PhoenixMaxPerAccount,
	}
end
function Q.check(profile, now)
	if not Config.V7.PhoenixSanctuary then
		return false, "DISABLED"
	end
	if (profile.playerLevel or 1) < 45 or not require(script.Parent.Access).check(profile, "Dunas", "encounter").ok then
		return false, "REQUIREMENTS"
	end
	if Q.stage(profile) < 3 then
		return false, "GLYPHS"
	end
	if (profile.phoenix.captureCount or (profile.phoenix.captured and 1 or 0)) >= Config.PhoenixMaxPerAccount then
		return false, "CAPTURED"
	end
	if profile.phoenix.encounterId then
		return false, "ACTIVE"
	end
	if now < (profile.phoenix.nextAttemptAt or 0) then
		return false, "COOLDOWN"
	end
	return true
end
return Q
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Progression</string>
          <string name="Source"><![CDATA[--!strict
local Bands = require(script.Parent.LevelBands)
local P = { MaxLevel = 100, EncountersPerHour = 50 }
local checkpoints = {
	{ level = 1, hours = 0 },
	{ level = 10, hours = 0.75 },
	{ level = 18, hours = 2 },
	{ level = 26, hours = 4 },
	{ level = 34, hours = 7 },
	{ level = 42, hours = 11 },
	{ level = 50, hours = 16 },
}
function P.playerCost(level: number): number
	for index = 1, #checkpoints - 1 do
		local a, b = checkpoints[index], checkpoints[index + 1]
		if level >= a.level and level < b.level then
			return math.floor((b.hours - a.hours) / (b.level - a.level) * P.EncountersPerHour * (60 + index * 10) + 0.5)
		end
	end
	return 2200 + (level - 50) * 75
end
function P.rewards(region: string, foeLevel: number, rarity: number, teamLevel: number)
	local band = assert(Bands.ById[region], "Região de recompensa desconhecida")
	local gap = teamLevel - foeLevel
	local penalty = gap >= 15 and 0.1 or gap >= 8 and 0.5 or 1
	return {
		gold = 30 * band.index ^ 2 + foeLevel * 2 + rarity * 3,
		xp = math.max(1, math.floor((60 + band.index * 10 + (rarity - 1) * 5) * penalty)),
		creatureXp = math.max(1, math.floor((45 + band.index * 8 + (rarity - 1) * 5) * penalty)),
		penalty = penalty,
	}
end
function P.creatureCost(level: number): number
	return 35 + level * 15
end
function P.award(data: any, amount: number)
	data.playerXp = math.min(1e9, (data.playerXp or 0) + math.max(0, math.floor(amount)))
	data.playerLevel = data.playerLevel or 1
	while data.playerLevel < P.MaxLevel and data.playerXp >= P.playerCost(data.playerLevel) do
		data.playerXp -= P.playerCost(data.playerLevel)
		data.playerLevel += 1
	end
end
function P.awardCreature(creature: any, amount: number)
	creature.xp = math.min(1e9, (creature.xp or 0) + math.max(0, math.floor(amount)))
	while creature.lv < P.MaxLevel and creature.xp >= P.creatureCost(creature.lv) do
		creature.xp -= P.creatureCost(creature.lv)
		creature.lv += 1
	end
end
return P
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">SanctuaryRules</string>
          <string name="Source"><![CDATA[--!nonstrict
local R = { MaxLevel = 3, Slots = 9, BuildBase = 120 }
function R.slot(index)
	if typeof(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > 9 then
		return nil
	end
	return ((index - 1) % 3 - 1) * 36, (math.floor((index - 1) / 3) - 1) * 36
end
function R.available(structures, slot, ignore)
	if not R.slot(slot) then
		return false
	end
	for id, entry in structures do
		if id ~= ignore and entry.slot == slot then
			return false
		end
	end
	return true
end
function R.capacity(def, entry)
	return def.slots + ((entry and entry.level or 1) - 1) * 2
end
function R.buildCost(def)
	return R.BuildBase * def.idx
end
function R.upgradeCost(entry)
	return 180 * entry.level
end
function R.validate(raw, unlocked, islands)
	local out = {}
	local occupied = {}
	if typeof(raw) == "table" then
		for _, def in islands do
			local entry = raw[def.id]
			if unlocked[def.id] and typeof(entry) == "table" and R.slot(entry.slot) and not occupied[entry.slot] then
				local level = typeof(entry.level) == "number"
						and entry.level == entry.level
						and math.clamp(math.floor(entry.level), 1, 3)
					or 1
				out[def.id] = { slot = entry.slot, level = level }
				occupied[entry.slot] = true
			end
		end
	end
	return out
end
return R
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">SculptContext</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Vocabulário de volumes; anatomia e proporções são desenhadas por espécie.
local Context = {}
Context.__index = Context
local V, A = Vector3.new, CFrame.Angles
function Context.new(model, design, stage)
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = V(0.1, 0.1, 0.1) * design.stages[stage].scale
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide, root.CanTouch, root.CanQuery = false, false, false
	root.Massless, root.CastShadow = true, false
	root.CollisionGroup = "Creatures"
	root.Parent = model
	model.PrimaryPart = root
	return setmetatable({
		model = model,
		root = root,
		stage = stage,
		young = stage == 1,
		adult = stage == 3,
		p = design.palette,
		cream = Color3.fromRGB(255, 235, 192),
		dark = Color3.fromRGB(36, 38, 65),
		gold = Color3.fromRGB(244, 184, 70),
		V = V,
		A = A,
		scale = design.stages[stage].scale,
		names = {},
	}, Context)
end
function Context:_make(name, kind, size, position, color, parent, motor, rotation)
	assert(
		typeof(size) == "Vector3" and typeof(position) == "Vector3" and typeof(color) == "Color3",
		"Volume inválido: " .. name
	)
	self.names[name] = (self.names[name] or 0) + 1
	local unique = name .. (self.names[name] > 1 and "_" .. self.names[name] or "")
	local part = Instance.new(kind == "wedge" and "WedgePart" or kind == "corner" and "CornerWedgePart" or "Part")
	part.Name, part.Size = unique, size * self.scale
	part.CFrame = CFrame.new(position * self.scale) * (rotation or CFrame.identity)
	part.Color, part.Material = color, Enum.Material.SmoothPlastic
	part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
	part.Massless, part.Anchored, part.Reflectance = true, false, 0
	part.CastShadow, part.CollisionGroup = size.Magnitude > 0.8, "Creatures"
	part:SetAttribute("Feature", name:gsub("%d+", ""))
	part.Parent = self.model
	if kind == "sphere" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType, mesh.Scale = Enum.MeshType.Sphere, V(1, 1, 1)
		mesh.Parent = part
	elseif kind == "cylinder" then
		part.Shape = Enum.PartType.Cylinder
	end
	parent = parent or self.root
	if motor then
		local joint = Instance.new("Motor6D")
		joint.Name, joint.Part0, joint.Part1 = "J_" .. unique, parent, part
		joint.C0 = parent.CFrame:ToObjectSpace(part.CFrame)
		joint:SetAttribute("Role", name)
		joint:SetAttribute("Phase", self.names[name] * 0.57 + position.X * 1.6 + position.Z * 0.3)
		joint.Parent = part
	else
		local weld = Instance.new("WeldConstraint")
		weld.Name, weld.Part0, weld.Part1 = "W_" .. unique, parent, part
		weld.Parent = part
	end
	return part
end
function Context:sphere(name, size, pos, color, parent, motor, rotation)
	return self:_make(name, "sphere", size, pos, color, parent, motor, rotation)
end
function Context:block(name, size, pos, color, parent, motor, rotation)
	return self:_make(name, "block", size, pos, color, parent, motor, rotation)
end
function Context:wedge(name, size, pos, color, parent, motor, rotation)
	return self:_make(name, "wedge", size, pos, color, parent, motor, rotation)
end
function Context:segment(name, from, to, width, depth, color, parent, motor)
	local distance = (to - from).Magnitude
	assert(distance > 0.001, "Segmento vazio: " .. name)
	local direction = (to - from).Unit
	local up = math.abs(direction.Y) > 0.95 and V(0, 0, 1) or V(0, 1, 0)
	local rotation = CFrame.lookAt(V(0, 0, 0), direction, up) * A(-math.pi / 2, 0, 0)
	return self:sphere(
		name,
		V(width, distance + math.min(width, depth) * 0.65, depth),
		(from + to) * 0.5,
		color,
		parent,
		motor,
		rotation
	)
end
function Context:leaf(name, from, to, width, color, parent, motor)
	local direction = (to - from).Unit
	local normal = V(0, 0, 1) - direction * direction:Dot(V(0, 0, 1))
	if normal.Magnitude < 0.05 then
		normal = V(0, 1, 0) - direction * direction:Dot(V(0, 1, 0))
	end
	normal = normal.Unit
	local right = direction:Cross(normal).Unit
	local rotation = CFrame.fromMatrix(V(0, 0, 0), right, direction, normal)
	return self:sphere(
		name,
		V(width, (to - from).Magnitude, width * 0.26),
		(from + to) * 0.5,
		color,
		parent,
		motor,
		rotation
	)
end
function Context:eyes(head, center, spacing, radius, iris, tilt)
	iris, tilt = iris or self.gold, tilt or 0
	for _, side in { -1, 1 } do
		local label = side < 0 and "L" or "R"
		local pos = center + V(side * spacing * 0.5, 0, 0)
		local eye = self:sphere(
			"Eye" .. label,
			V(radius * 2, radius * 2.28, radius * 0.8),
			pos,
			self.cream,
			head,
			true,
			A(0, side * 0.11, side * tilt)
		)
		self:sphere(
			"Iris" .. label,
			V(radius * 1.5, radius * 1.8, radius * 0.48),
			pos + V(0, -radius * 0.03, radius * 0.35),
			iris,
			eye
		)
		self:sphere(
			"Pupil" .. label,
			V(radius * 0.97, radius * 1.43, radius * 0.3),
			pos + V(0, -radius * 0.04, radius * 0.57),
			self.dark,
			eye
		)
		self:sphere(
			"EyeGlint" .. label,
			V(radius * 0.46, radius * 0.5, radius * 0.2),
			pos + V(-radius * 0.21, radius * 0.38, radius * 0.74),
			Color3.fromRGB(255, 249, 229),
			eye
		)
		self:sphere(
			"EyeGlintSmall" .. label,
			V(radius * 0.21, radius * 0.23, radius * 0.15),
			pos + V(radius * 0.25, -radius * 0.25, radius * 0.74),
			self.cream,
			eye
		)
	end
end
return Context
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">SculptDrakes</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Anatomias autorais: volumes sobrepostos, membros articulados e detalhes presos ao esqueleto.
local V = Vector3.new
local A = CFrame.Angles
local C = Color3.fromRGB
local D = {}

local function palette(a, b, d, e)
	return { C(table.unpack(a)), C(table.unpack(b)), C(table.unpack(d)), C(table.unpack(e)) }
end
local function foot(c, name, hip, knee, ankle, width, color, claw, parent, digits)
	local upper = c:segment("Leg" .. name, hip, knee, width, width * 0.95, color, parent, true)
	local lower = c:segment("Shin" .. name, knee, ankle, width * 0.65, width * 0.7, color, upper)
	local paw = c:sphere(
		"Paw" .. name,
		V(width * 1.2, width * 0.55, width * 1.65),
		ankle + V(0, -width * 0.12, width * 0.38),
		color,
		lower
	)
	for i = 1, digits do
		c:leaf(
			"Toe" .. name .. i,
			ankle + V((i - (digits + 1) / 2) * width * 0.28, -width * 0.13, width * 0.8),
			ankle + V((i - (digits + 1) / 2) * width * 0.32, -width * 0.19, width * 1.12),
			width * 0.19,
			claw,
			paw
		)
	end
	return upper
end
local function smile(c, head, center, width, color)
	c:segment("SmileL", center + V(-width, 0.05, 0), center + V(0, -0.03, 0.045), 0.055, 0.04, color, head)
	c:segment("SmileR", center + V(0, -0.03, 0.045), center + V(width, 0.05, 0), 0.055, 0.04, color, head)
end

D.vulcanodrago = function(c)
	local s, young, adult = c.stage, c.young, c.adult
	local p = palette({ 97, 56, 75 }, { 177, 75, 59 }, { 246, 155, 71 }, { 255, 227, 167 })
	local length = young and 2.65 or adult and 4.35 or 3.55
	local shoulder = young and 1.35 or adult and 2.05 or 1.7
	local body = c:sphere("Body", V(2.4, 1.9, length), V(0, shoulder, -0.25), p[1], nil, true)
	c:sphere("Chest", V(1.9, 2.1, 2.05), V(0, shoulder + 0.25, length * 0.24), p[2], body)
	c:sphere("Belly", V(1.4, 1.4, 1.85), V(0, shoulder + 0.02, length * 0.32), p[4], body)
	local neck = c:segment(
		"Neck",
		V(0, shoulder + 0.4, length * 0.22),
		V(0, shoulder + 1.15, length * 0.42),
		young and 1.1 or 1.3,
		1.25,
		p[2],
		body
	)
	local headY, headZ = shoulder + (young and 1 or 1.45), length * 0.43
	local ratio = young and 1.16 or 1
	local head = c:sphere("Head", V(2.05, 1.65, 1.95) * ratio, V(0, headY, headZ), p[2], neck, true)
	c:sphere("Jaw", V(1.8, 0.48, 1.55) * ratio, V(0, headY - 0.58, headZ + 0.65), p[4], head)
	c:sphere("Muzzle", V(1.52, 0.65, 1.3) * ratio, V(0, headY - 0.27, headZ + 0.85), p[2], head)
	c:eyes(head, V(0, headY + 0.2, headZ + 0.87 * ratio), 1.12 * ratio, young and 0.29 or 0.25, p[3], 0.1)
	for _, side in { -1, 1 } do
		c:sphere(
			"Nostril" .. side,
			V(0.14, 0.1, 0.08),
			V(side * 0.38, headY - 0.05, headZ + 1.47 * ratio),
			c.dark,
			head
		)
		c:leaf(
			"Horn" .. side,
			V(side * 0.72, headY + 0.55, headZ - 0.25),
			V(side * (young and 0.8 or 1.18), headY + (young and 0.82 or 1.5), headZ - 0.5),
			young and 0.25 or 0.42,
			p[4],
			head
		)
		if adult then
			c:leaf(
				"CheekHorn" .. side,
				V(side * 0.87, headY - 0.15, headZ - 0.1),
				V(side * 1.38, headY + 0.15, headZ - 0.65),
				0.35,
				p[1],
				head
			)
		end
		for _, front in { true, false } do
			local z = front and length * 0.22 or -length * 0.3
			foot(
				c,
				(front and "Fore" or "Hind") .. side,
				V(side * 0.88, shoulder - 0.15, z),
				V(side * 1.25, 0.8, z - 0.23),
				V(side * 1.22, 0.3, z + 0.15),
				young and 0.49 or 0.66,
				p[2],
				p[4],
				body,
				young and 2 or 3
			)
		end
	end
	smile(c, head, V(0, headY - 0.39, headZ + 1.42 * ratio), 0.55, c.dark)
	local tailParent = body
	local from = V(0, shoulder - 0.25, -length * 0.48)
	for i = 1, s + 2 do
		local to = V(math.sin(i * 0.55) * i * 0.17, shoulder - 0.35 + i * 0.08, -length * 0.48 - i * 0.7)
		tailParent = c:segment(
			"Tail" .. i,
			from,
			to,
			math.max(0.25, 0.95 - i * 0.16),
			math.max(0.2, 0.9 - i * 0.16),
			p[1],
			tailParent,
			i == 1
		)
		from = to
	end
	c:leaf("TailSpade", from - V(0, 0, 0.15), from + V(0, 0.4, -0.85), 0.9, p[3], tailParent)
	for i = 1, s + 2 do
		local z = length * 0.25 - i * length / (s + 3)
		c:leaf(
			"BasaltSpine" .. i,
			V(0, shoulder + 0.8, z),
			V(0, shoulder + 1.35 + (adult and 0.15 or 0), z - 0.38),
			0.62,
			i % 2 == 0 and p[3] or p[1],
			body
		)
	end
	if not young then
		for _, side in { -1, 1 } do
			local wing = c:segment(
				"Wing" .. side,
				V(side * 0.8, shoulder + 0.7, -0.1),
				V(side * 2.1, shoulder + 1.15, -0.7),
				0.32,
				0.32,
				p[1],
				body,
				true
			)
			for i = 1, adult and 4 or 2 do
				c:leaf(
					"WingMembrane" .. side .. i,
					V(side * 1.6, shoulder + 1, -0.5),
					V(side * (2.6 + i * 0.32), shoulder + 1.65 - i * 0.22, -0.25 - i * 0.52),
					0.85,
					p[2],
					wing
				)
			end
		end
	end
	return { body = body, head = head }
end

D.trovoraptor = function(c)
	local s, young, adult = c.stage, c.young, c.adult
	local p = palette({ 56, 96, 136 }, { 103, 165, 191 }, { 255, 211, 102 }, { 245, 231, 194 })
	local hipY = young and 1.05 or adult and 2.25 or 1.65
	local body = c:sphere(
		"Body",
		V(1.75, young and 1.4 or 2.15, young and 2.1 or 2.85),
		V(0, hipY + 0.65, -0.5),
		p[1],
		nil,
		true,
		A(-0.25, 0, 0)
	)
	c:sphere("Chest", V(1.27, 1.55, 1.65), V(0, hipY + 0.95, 0.35), p[4], body, false, A(-0.23, 0, 0))
	local neckTop = V(0, hipY + (young and 1.05 or 1.85), 1.03)
	local neck = c:segment("Neck", V(0, hipY + 0.85, 0.3), neckTop, young and 0.8 or 0.93, 0.86, p[2], body)
	local head = c:sphere(
		"Head",
		V(young and 1.7 or 1.45, young and 1.4 or 1.2, young and 1.7 or 1.9),
		neckTop,
		p[2],
		neck,
		true
	)
	c:sphere("Muzzle", V(1.1, 0.65, 1.45), neckTop + V(0, -0.2, 0.85), p[2], head)
	c:sphere("Jaw", V(1.02, 0.25, 1.3), neckTop + V(0, -0.48, 0.83), p[4], head)
	c:eyes(head, neckTop + V(0, 0.22, 0.75), young and 1.04 or 0.9, young and 0.26 or 0.21, p[3], 0.16)
	smile(c, head, neckTop + V(0, -0.29, 1.48), 0.38, c.dark)
	for _, side in { -1, 1 } do
		foot(
			c,
			"Hind" .. side,
			V(side * 0.65, hipY + 0.1, -0.8),
			V(side * 1.02, hipY * 0.7, 0.05),
			V(side * 0.97, 0.25, -0.32),
			young and 0.55 or 0.78,
			p[1],
			p[3],
			body,
			3
		)
		local arm = c:segment(
			"Forearm" .. side,
			V(side * 0.62, hipY + 1.1, 0.4),
			V(side * 1.05, hipY + 0.65, 0.95),
			0.3,
			0.3,
			p[2],
			body,
			true
		)
		for digit = 1, young and 1 or 2 do
			c:leaf(
				"ForeClaw" .. side .. digit,
				V(side * (1 + digit * 0.08), hipY + 0.66, 0.92),
				V(side * (1.05 + digit * 0.1), hipY + 0.48, 1.25),
				0.13,
				p[3],
				arm
			)
		end
		c:leaf(
			"LightningEar" .. side,
			neckTop + V(side * 0.55, 0.35, -0.25),
			neckTop + V(side * 0.92, young and 0.95 or 1.35, -0.55),
			0.38,
			p[3],
			head
		)
		if not young then
			c:leaf(
				"LightningProng" .. side,
				neckTop + V(side * 0.8, 0.7, -0.42),
				neckTop + V(side * 1.22, 0.98, -0.2),
				0.27,
				p[4],
				head
			)
		end
	end
	local tail, from = body, V(0, hipY + 0.3, -1.65)
	for i = 1, s + 2 do
		local to = V(math.sin(i * 0.45) * 0.6, hipY + 0.25 + i * 0.09, -1.65 - i * 0.72)
		tail = c:segment(
			"Tail" .. i,
			from,
			to,
			math.max(0.12, 0.67 - i * 0.12),
			math.max(0.12, 0.67 - i * 0.12),
			p[1],
			tail,
			i == 1
		)
		from = to
	end
	c:leaf("TailBoltA", from, from + V(0.5, 0.48, -0.65), 0.46, p[3], tail)
	c:leaf("TailBoltB", from + V(0.4, 0.35, -0.55), from + V(0.1, 0.8, -1), 0.35, p[3], tail)
	for i = 1, s + 1 do
		c:leaf("DorsalBolt" .. i, V(0, hipY + 1.3, 0.5 - i * 0.48), V(0, hipY + 1.9, 0.2 - i * 0.48), 0.5, p[3], body)
	end
	if adult then
		for _, side in { -1, 1 } do
			for i = 1, 3 do
				c:leaf(
					"HipQuill" .. side .. i,
					V(side * 0.7, hipY + 0.4, -1.25),
					V(side * (1.5 + i * 0.15), hipY + 0.8 - i * 0.2, -1.5 - i * 0.25),
					0.4,
					p[2],
					body
				)
			end
		end
	end
	return { body = body, head = head }
end

D.caudalume = function(c)
	local young, adult = c.young, c.adult
	local p = palette({ 93, 77, 127 }, { 163, 135, 178 }, { 124, 205, 188 }, { 255, 220, 137 })
	local body = c:sphere(
		"Body",
		V(young and 1.65 or 1.8, young and 1.45 or 1.9, 2.2),
		V(0, young and 1.2 or 1.65, 0.45),
		p[1],
		nil,
		true
	)
	local hy = young and 1.9 or adult and 2.85 or 2.35
	local head =
		c:sphere("Head", V(young and 1.85 or 1.75, young and 1.7 or 1.85, 1.6), V(0, hy, 1.15), p[2], body, true)
	c:sphere("FaceMask", V(1.37, 1.2, 0.5), V(0, hy - 0.03, 1.84), p[4], head)
	c:eyes(head, V(0, hy + 0.13, 2.02), young and 0.96 or 0.88, young and 0.27 or 0.24, p[3], -0.1)
	c:sphere("Nose", V(0.2, 0.14, 0.12), V(0, hy - 0.18, 2.13), c.dark, head)
	smile(c, head, V(0, hy - 0.34, 2.1), 0.3, p[1])
	for _, side in { -1, 1 } do
		c:leaf(
			"EarFin" .. side,
			V(side * 0.66, hy + 0.38, 1.05),
			V(side * (young and 1.25 or 1.55), hy + 0.85, 0.8),
			young and 0.55 or 0.8,
			p[3],
			head
		)
		if not young then
			c:leaf(
				"CheekFrill" .. side,
				V(side * 0.65, hy - 0.35, 1.2),
				V(side * 1.18, hy - 0.65, 0.85),
				0.55,
				p[2],
				head
			)
		end
	end
	local tail, from = body, V(0, young and 0.9 or 1.25, -0.35)
	local segments = young and 4 or adult and 8 or 6
	for i = 1, segments do
		local t = i / segments
		local to = V(
			math.sin(t * math.pi * 1.4) * (young and 0.7 or 1.3),
			0.5 + t * t * (young and 1.7 or 3.6),
			-0.35 - math.sin(t * math.pi * 0.75) * (young and 2.3 or 4.6)
		)
		local width = 1.25 * (1 - t * 0.78)
		tail = c:segment("Tail" .. i, from, to, width, width * 1.05, p[1], tail, i == 1)
		if i % 2 == 0 then
			c:sphere("LuminousSpot" .. i, V(width * 0.5, width * 0.45, 0.12), to + V(0, 0.04, width * 0.46), p[3], tail)
		end
		from = to
	end
	local bulb = c:sphere(
		"TailLantern",
		V(young and 0.75 or 1.1, young and 0.92 or 1.4, young and 0.75 or 1.1),
		from + V(0, 0.4, 0),
		p[4],
		tail
	)
	for _, side in { -1, 1 } do
		c:leaf(
			"LanternPetal" .. side,
			from + V(side * 0.25, -0.1, 0),
			from + V(side * (adult and 0.85 or 0.6), 0.65, -0.1),
			adult and 0.55 or 0.4,
			p[3],
			bulb
		)
	end
	local antenna = c:segment("AntennaStem", V(0, hy + 0.55, 1.15), V(0.15, hy + 1.15, 1.45), 0.12, 0.12, p[1], head)
	c:sphere("AntennaPearl", V(0.3, 0.34, 0.3), V(0.15, hy + 1.2, 1.45), p[4], antenna)
	if adult then
		for i = 1, 3 do
			c:leaf(
				"NeckRuff" .. i,
				V((i - 2) * 0.45, hy - 0.75, 1.45),
				V((i - 2) * 0.7, hy - 1.3, 1.55),
				0.55,
				p[3],
				body
			)
		end
	end
	return { body = body, head = head }
end

D.vagalumorte = function(c)
	local young, adult = c.young, c.adult
	local p = palette({ 72, 67, 105 }, { 143, 116, 169 }, { 175, 217, 179 }, { 255, 220, 160 })
	local height = young and 1.4 or adult and 2.65 or 1.85
	local body = c:sphere(
		"Body",
		V(1.2, adult and 1.3 or 1.05, young and 1.7 or adult and 2.85 or 2.4),
		V(0, height, -0.25),
		p[1],
		nil,
		true,
		adult and A(-0.12, 0, 0) or nil
	)
	local abdomen = c:sphere(
		"Abdomen",
		V(young and 1.35 or adult and 1.85 or 1.6, adult and 1.35 or 1.05, young and 1.5 or adult and 2.9 or 2.1),
		V(0, height - 0.15, adult and -1.65 or -1.35),
		p[2],
		body
	)
	local bulb = c:sphere(
		"GlowBulb",
		V(adult and 1.22 or 0.85, adult and 1.05 or 0.7, adult and 1.25 or 0.85),
		V(0, height - 0.12, young and -1.9 or adult and -2.8 or -2.25),
		p[3],
		abdomen
	)
	if adult then
		-- O adulto ganha casulo-lanterna, com nervuras luminosas entre as placas.
		for rib = 1, 4 do
			c:sphere(
				"LanternRib" .. rib,
				V(1.6 - rib * 0.09, 0.17, 0.62),
				V(0, height + 0.43 - rib * 0.025, -0.85 - rib * 0.4),
				p[4],
				abdomen
			)
		end
		for _, side in { -1, 1 } do
			c:leaf(
				"LanternCalyx" .. side,
				V(side * 0.25, height - 0.15, -2.45),
				V(side * 0.6, height + 0.35, -3.25),
				0.42,
				p[4],
				bulb
			)
		end
	end
	local head = c:sphere("Head", V(1.65, 1.35, 1.25), V(0, height + 0.25, 0.95), p[2], body, true)
	c:sphere("FaceMask", V(1.45, 1.1, 0.4), V(0, height + 0.24, 1.48), p[4], head)
	c:eyes(head, V(0, height + 0.35, 1.63), 0.97, young and 0.28 or 0.25, p[3], -0.08)
	c:sphere("MothNose", V(0.19, 0.16, 0.12), V(0, height + 0.05, 1.74), p[1], head)
	for _, side in { -1, 1 } do
		local antenna = c:segment(
			"Antenna" .. side,
			V(side * 0.43, height + 0.8, 0.87),
			V(side * 0.86, height + 1.5, 0.96),
			0.1,
			0.1,
			p[1],
			head
		)
		for branch = 1, young and 2 or 4 do
			local t = branch / 5
			c:leaf(
				"AntennaComb" .. side .. branch,
				V(side * (0.43 + t * 0.43), height + 0.8 + t * 0.7, 0.91),
				V(side * (0.69 + t * 0.43), height + 0.92 + t * 0.7, 0.92),
				0.12,
				p[4],
				antenna
			)
		end
		local spread = young and 1.6 or adult and 4.1 or 2.8
		local wing = c:segment(
			"Wing" .. side,
			V(side * 0.38, height + 0.25, 0.05),
			V(side * spread * 0.5, height + 0.75, -0.4),
			0.22,
			0.22,
			p[1],
			body,
			true
		)
		c:leaf(
			"ForeWing" .. side,
			V(side * 0.65, height + 0.35, 0.1),
			V(side * spread, height + (adult and 1.7 or 1.1), 0.55),
			spread * 0.69,
			p[2],
			wing
		)
		c:leaf(
			"HindWing" .. side,
			V(side * 0.5, height + 0.15, -0.45),
			V(side * spread * 0.83, height - 0.35, -1.95),
			spread * 0.57,
			p[3],
			wing
		)
		local mark = V(side * spread * 0.72, height + (adult and 1.05 or 0.72), adult and 1.02 or 0.79)
		c:sphere(
			"WingEyespot" .. side,
			V(young and 0.48 or 0.8, young and 0.58 or 0.95, 0.16),
			mark,
			p[1],
			wing,
			false,
			A(0, 0, side * -0.55)
		)
		c:sphere(
			"WingMoon" .. side,
			V(young and 0.28 or 0.48, young and 0.36 or 0.62, 0.18),
			mark + V(0, 0.02, 0.08),
			p[4],
			wing
		)
		for leg = 1, 3 do
			local from = V(side * 0.45, height - 0.1, 0.6 - leg * 0.58)
			local elbow = from + V(side * 0.65, -0.25, 0.18)
			local upper = c:segment("Leg" .. side .. leg, from, elbow, 0.13, 0.13, p[1], body, true)
			c:segment("MothTarsus" .. side .. leg, elbow, elbow + V(side * 0.13, -0.5, 0.25), 0.09, 0.1, p[4], upper)
		end
		if adult then
			-- Três lobos e nervuras dão desenho próprio à asa adulta, além do crescimento.
			for lobe = 1, 3 do
				local start = V(side * (0.8 + lobe * 0.25), height + 0.4, -0.2)
				local finish = V(side * (spread - lobe * 0.38), height + 2.6 - lobe * 0.62, 0.8 - lobe * 0.45)
				c:leaf(
					"MoonWingLobe" .. side .. lobe,
					start,
					finish,
					1.45 - lobe * 0.1,
					lobe % 2 == 0 and p[3] or p[2],
					wing
				)
				c:segment(
					"MoonWingVein" .. side .. lobe,
					start + V(0, 0, 0.72),
					finish + V(0, -0.12, 0.72),
					0.075,
					0.09,
					p[4],
					wing
				)
			end
			local lowerMark = V(side * spread * 0.55, height - 0.18, -0.7)
			c:sphere("HindMoonRim" .. side, V(0.6, 0.7, 0.18), lowerMark, p[1], wing)
			c:sphere("HindMoonPearl" .. side, V(0.38, 0.48, 0.2), lowerMark + V(0, 0.03, 0.1), p[4], wing)
			c:leaf(
				"WingRibbon" .. side,
				V(side * 1.35, height - 0.25, -1.6),
				V(side * 1.8, height - 0.75, -3),
				0.45,
				p[2],
				wing
			)
			c:sphere("RibbonPearl" .. side, V(0.28, 0.35, 0.28), V(side * 1.8, height - 0.7, -3), p[3], wing)
		end
	end
	if adult then
		for i = 1, 5 do
			local x = (i - 3) * 0.27
			c:leaf(
				"MoonMothRuff" .. i,
				V(x * 0.7, height + 0.35, 0.65),
				V(x * 1.45, height - 0.52 + math.abs(x) * 0.2, 1.1),
				0.48,
				p[4],
				body
			)
		end
	end
	return { body = body, head = head }
end

D.reinevoento = function(c)
	local s, young, adult = c.stage, c.young, c.adult
	local p = palette({ 68, 58, 94 }, { 136, 117, 168 }, { 193, 204, 173 }, { 241, 218, 166 })
	local top = young and 2.35 or adult and 4.5 or 3.5
	local body = c:sphere(
		"Body",
		V(young and 1.9 or 2.65, top * 0.62, young and 1.15 or 1.7),
		V(0, top * 0.48 + 0.5, -0.2),
		p[1],
		nil,
		true
	)
	local head =
		c:sphere("Head", V(young and 1.85 or 1.9, young and 1.6 or 1.85, 1.3), V(0, top, 0.18), p[2], body, true)
	c:sphere("RoyalMask", V(1.5, 1.45, 0.45), V(0, top - 0.02, 0.72), p[4], head)
	c:eyes(head, V(0, top + 0.08, 0.91), 0.88, young and 0.24 or 0.2, p[3], 0.04)
	c:sphere("NoseBridge", V(0.22, 0.35, 0.18), V(0, top - 0.12, 1), p[2], head)
	c:segment("RoyalMouth", V(-0.2, top - 0.42, 0.98), V(0.2, top - 0.42, 0.98), 0.045, 0.04, p[1], head)
	for _, side in { -1, 1 } do
		local shoulder = V(side * (young and 0.75 or 1.25), top - 1.05, -0.12)
		local veil = c:segment(
			"VeilShoulder" .. side,
			shoulder,
			V(side * (young and 1.1 or 1.75), top - 1.7, -0.25),
			0.75,
			0.7,
			p[2],
			body,
			true
		)
		c:leaf(
			"MantlePanel" .. side,
			shoulder,
			V(side * (young and 0.85 or 1.55), 0.45, -0.6),
			young and 1.1 or 1.65,
			p[2],
			veil
		)
		c:leaf(
			"IvoryMantleTrim" .. side,
			shoulder + V(side * 0.13, -0.2, 0.3),
			V(side * (young and 0.9 or 1.6), 0.55, -0.2),
			0.18,
			p[4],
			veil
		)
		c:sphere(
			"SpectralHand" .. side,
			V(0.52, 0.68, 0.5),
			V(side * (young and 1.12 or 1.8), top - 1.95, 0.1),
			p[3],
			veil
		)
		if not young then
			c:leaf(
				"RoyalCollar" .. side,
				V(side * 0.5, top - 0.72, 0.1),
				V(side * 1.28, top - 0.28, -0.25),
				0.7,
				p[4],
				body
			)
		end
	end
	for i = 1, young and 3 or adult and 7 or 5 do
		local x = (i - (young and 2 or adult and 4 or 3)) * (young and 0.38 or 0.42)
		c:leaf(
			"VeilHem" .. i,
			V(x * 0.7, 1.4, -0.2),
			V(x, 0.2 + math.abs(x) * 0.1, -0.9 - math.cos(i) * 0.3),
			0.7,
			i % 2 == 0 and p[1] or p[2],
			body
		)
	end
	local crownBase = c:sphere("CrownCirclet", V(1.65, 0.2, 1.05), V(0, top + 0.7, 0.05), p[4], head)
	for i = 1, young and 3 or adult and 7 or 5 do
		local n = young and 3 or adult and 7 or 5
		local x = (i - (n + 1) / 2) * 0.23
		c:leaf(
			"CrownProng" .. i,
			V(x, top + 0.72, 0.35),
			V(x * 1.25, top + 1.05 + (1 - math.abs(x)) * (adult and 0.7 or 0.35), 0.27),
			0.25,
			p[4],
			crownBase
		)
	end
	for i = 1, s + 1 do
		c:sphere(
			"MantleStar" .. i,
			V(0.13, 0.22, 0.1),
			V((i % 2 == 0 and 1 or -1) * 0.35, top - 1.1 - i * 0.35, 0.67),
			p[4],
			body
		)
	end
	if adult then
		c:sphere("HeartJewelRim", V(0.7, 0.85, 0.3), V(0, top - 1.2, 0.7), p[4], body)
		c:sphere("HeartJewel", V(0.44, 0.57, 0.31), V(0, top - 1.18, 0.86), p[3], body)
	end
	return { body = body, head = head }
end

D.cinzavento = function(c)
	local s, young, adult = c.stage, c.young, c.adult
	local p = palette({ 99, 76, 117 }, { 179, 123, 122 }, { 237, 193, 155 }, { 166, 180, 204 })
	local h = young and 1.3 or adult and 2.4 or 1.8
	local body = c:sphere("Body", V(young and 1.8 or 2.2, 1.65, young and 2.5 or 3.5), V(0, h, -0.45), p[1], nil, true)
	c:sphere("Chest", V(1.5, 1.6, 1.8), V(0, h + 0.15, 0.55), p[3], body)
	local neck = c:segment("Neck", V(0, h + 0.45, 0.7), V(0, h + 1.15, 1.6), 1.1, 1, p[2], body)
	local headPos = V(0, h + 1.35, 1.7)
	local head = c:sphere("Head", V(young and 1.9 or 1.7, young and 1.6 or 1.4, 1.8), headPos, p[2], neck, true)
	c:sphere("SweptMuzzle", V(1.3, 0.68, 1.5), headPos + V(0, -0.3, 0.8), p[2], head)
	c:sphere("LowerJaw", V(1.2, 0.26, 1.4), headPos + V(0, -0.57, 0.82), p[3], head)
	c:eyes(head, headPos + V(0, 0.17, 0.82), 1.02, young and 0.27 or 0.22, p[4], 0.06)
	smile(c, head, headPos + V(0, -0.36, 1.48), 0.4, c.dark)
	for _, side in { -1, 1 } do
		c:leaf(
			"SweptHorn" .. side,
			headPos + V(side * 0.56, 0.45, -0.15),
			headPos + V(side * 0.9, young and 0.9 or 1.22, -0.95),
			0.4,
			p[3],
			head
		)
		c:leaf(
			"CheekStreamer" .. side,
			headPos + V(side * 0.7, -0.2, -0.15),
			headPos + V(side * 1.1, -0.05, -1.05),
			0.5,
			p[4],
			head
		)
		foot(
			c,
			"Hind" .. side,
			V(side * 0.75, h - 0.1, -1.2),
			V(side * 1.1, 0.8, -0.65),
			V(side * 1, 0.25, -0.9),
			young and 0.5 or 0.64,
			p[2],
			p[3],
			body,
			young and 2 or 3
		)
		local spread = young and 1.7 or adult and 4.4 or 3.2
		local shoulder = V(side * 0.8, h + 0.45, 0.3)
		local elbow = V(side * spread * 0.6, h + 1.05, 0.1)
		local tip = V(side * spread, h + 1.6, -1.1)
		local wing = c:segment("Wing" .. side, shoulder, elbow, 0.38, 0.38, p[1], body, true)
		c:segment("WingForearm" .. side, elbow, tip, 0.27, 0.3, p[2], wing)
		for i = 1, young and 3 or adult and 6 or 4 do
			local t = i / (young and 3 or adult and 6 or 4)
			local from = elbow:Lerp(tip, t)
			local to = V(side * (spread * (0.5 + t * 0.5)), h + 0.25 - t * 0.18, -1.2 - t * (adult and 1.65 or 0.9))
			c:leaf("AshWingMembrane" .. side .. i, from, to, young and 0.65 or 0.95, i % 2 == 0 and p[4] or p[2], wing)
		end
		c:leaf("WingThumb" .. side, elbow, elbow + V(side * 0.25, 0.55, 0.4), 0.23, p[3], wing)
	end
	local tail, from = body, V(0, h - 0.1, -1.75)
	for i = 1, s + 3 do
		local to = V(math.sin(i * 0.52) * 0.65, h - 0.2 + math.sin(i * 0.6) * 0.35, -1.75 - i * 0.65)
		tail = c:segment(
			"Tail" .. i,
			from,
			to,
			math.max(0.16, 0.8 - i * 0.12),
			math.max(0.15, 0.8 - i * 0.12),
			p[1],
			tail,
			i == 1
		)
		from = to
	end
	for i = 1, young and 2 or adult and 5 or 3 do
		c:leaf(
			"CometTail" .. i,
			from,
			from + V((i - (young and 1.5 or adult and 3 or 2)) * 0.35, 0.3 + i * 0.1, -1.05 - math.sin(i) * 0.3),
			0.52,
			i % 2 == 0 and p[3] or p[4],
			tail
		)
	end
	for i = 1, s + 1 do
		c:leaf("NapeCrest" .. i, V(0, h + 0.8, 0.9 - i * 0.5), V(0, h + 1.4, 0.7 - i * 0.5), 0.55, p[4], body)
	end
	return { body = body, head = head }
end

return D
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">SculptLOD</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Retira apenas ornamentos. Todo ancestral de um volume essencial permanece no rig.
local L = {}
local function decorative(part)
	local name = part.Name
	if name:find("EyeGlintSmall") or name:match("^Iris[LR]") then
		return true
	end
	local index = tonumber(name:match("(%d+)$")) or 1
	if name:find("FeatherMiddle") or name:find("FeatherInner") or name:find("WingCover") then
		return index % 2 == 0
	end
	if name:find("HaloRay") then
		return index % 4 ~= 0
	end
	if name:find("Toe") then
		return index ~= 1
	end
	for _, token in
		{
			"Nostril",
			"Pollen",
			"Vein",
			"Inlay",
			"WaterSpot",
			"RimPearl",
			"CrownBead",
			"PatinaBand",
			"ShellBand",
			"GoldenShoulderFeather",
			"GlowingRib",
			"EmberDot",
			"ChimneyBand",
			"Brick",
			"Whisker",
			"RunicStud",
			"BarkLine",
			"Spore",
		}
	do
		if name:find(token) then
			return true
		end
	end
	return false
end
function L.annotate(model)
	local parts, parents, keep = {}, {}, {}
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") then
			table.insert(parts, item)
		elseif item:IsA("Motor6D") or item:IsA("WeldConstraint") then
			parents[item.Part1] = item.Part0
		end
	end
	for _, part in parts do
		if part == model.PrimaryPart or not decorative(part) then
			local cursor = part
			while cursor and not keep[cursor] do
				keep[cursor] = true
				cursor = parents[cursor]
			end
		end
	end
	local removed = 0
	for _, part in parts do
		local detail = not keep[part]
		part:SetAttribute("LODDetail", detail)
		if detail then
			removed += 1
		end
	end
	model:SetAttribute("SculptDetail", "full")
	model:SetAttribute("FullPartCount", #parts)
	model:SetAttribute("LowPartCount", #parts - removed)
	return removed
end
function L.reduce(model)
	local removed = 0
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") and item:GetAttribute("LODDetail") == true then
			item:Destroy()
			removed += 1
		end
	end
	model:SetAttribute("SculptDetail", "low")
	return removed
end
return L
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">SculptMystic</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Anatomias autorais de sementes, pedra, musgo e vapor. Coordenadas locais; frente = +Z.
local M = {}

local function smile(c, head, y, z, width)
	local V = c.V
	c:segment("SmileL", V(-width, y + 0.035, z), V(0, y - 0.025, z + 0.025), 0.045, 0.045, c.dark, head)
	c:segment("SmileR", V(0, y - 0.025, z + 0.025), V(width, y + 0.035, z), 0.045, 0.045, c.dark, head)
end

local function cyclops(c, head, center, radius, iris)
	local V = c.V
	local eye = c:sphere("EyeCenter", V(radius * 2.15, radius * 2.3, radius * 0.78), center, c.cream, head, true)
	c:sphere("IrisCenter", V(radius * 1.44, radius * 1.63, radius * 0.36), center + V(0, 0, radius * 0.35), iris, eye)
	c:sphere(
		"PupilCenter",
		V(radius * 0.77, radius * 1.14, radius * 0.24),
		center + V(0.025, -0.015, radius * 0.52),
		c.dark,
		eye
	)
	c:sphere(
		"EyeGlintCenter",
		V(radius * 0.42, radius * 0.46, radius * 0.16),
		center + V(-radius * 0.3, radius * 0.37, radius * 0.66),
		c.cream,
		eye
	)
	c:sphere(
		"EyeGlintSmall",
		V(radius * 0.18, radius * 0.18, radius * 0.12),
		center + V(radius * 0.22, -radius * 0.31, radius * 0.65),
		c.cream,
		eye
	)
	return eye
end

function M.brotinho(c)
	local V, A = c.V, c.A
	local s = c.stage
	local jade = Color3.fromRGB(86, 132, 76)
	local leaf = Color3.fromRGB(160, 190, 94)
	local bud = Color3.fromRGB(225, 150, 142)
	local bark = Color3.fromRGB(142, 106, 70)
	local height = ({ 0.96, 1.25, 1.5 })[s]
	local body = c:sphere("Body", V(1.48 + s * 0.14, height * 1.35, 1.36), V(0, height, -0.12), jade, c.root, true)
	c:sphere("SeedBelly", V(1.08, height * 1.05, 0.64), V(0, height - 0.08, 0.48), c.cream, body)
	local headY = height + (s == 1 and 0.72 or 0.9)
	local head = c:sphere("Head", V(s == 1 and 1.75 or 1.61, 1.4, 1.3), V(0, headY, 0.38), leaf, body, true)
	c:sphere("FaceMask", V(1.36, 0.97, 0.62), V(0, headY - 0.15, 0.88), c.cream, head)
	c:eyes(head, V(0, headY + 0.1, 1.08), 0.8, s == 1 and 0.25 or 0.225, jade, -0.08)
	smile(c, head, headY - 0.34, 1.18, 0.18)
	for _, side in { -1, 1 } do
		c:sphere("Cheek" .. side, V(0.27, 0.14, 0.12), V(side * 0.52, headY - 0.22, 1.14), bud, head)
		for _, front in { -1, 1 } do
			local hip = V(side * 0.56, height - 0.22, front * 0.39)
			local toe = V(side * (s == 1 and 0.78 or 0.94), 0.15, front * 0.62 + 0.12)
			local knee = V(side * 0.77, 0.42, front * 0.48)
			local upper = c:segment("LegRoot" .. side .. front, hip, knee, 0.31, 0.34, bark, body, true)
			c:segment("RootAnkle" .. side .. front, knee, toe, 0.2, 0.24, bark, upper)
			c:sphere("RootToe" .. side .. front, V(0.4, 0.22, 0.54), toe, bark, upper)
		end
		local arm = c:segment(
			"LeafArm" .. side,
			V(side * 0.67, height + 0.12, 0),
			V(side * 1.08, height - 0.05, 0.27),
			0.22,
			0.24,
			jade,
			body,
			true
		)
		c:leaf(
			"LeafHand" .. side,
			V(side * 1.02, height - 0.05, 0.26),
			V(side * 1.33, height + 0.26, 0.4),
			0.51,
			leaf,
			arm
		)
		c:leaf(
			"LeafEar" .. side,
			V(side * 0.55, headY + 0.43, 0.23),
			V(side * (0.92 + s * 0.08), headY + 1.12, 0.11),
			0.64,
			jade,
			head,
			true
		)
		c:segment(
			"EarVein" .. side,
			V(side * 0.58, headY + 0.52, 0.33),
			V(side * 0.88, headY + 1, 0.24),
			0.04,
			0.04,
			leaf,
			head
		)
	end
	local crownBase = V(0, headY + 0.54, 0.14)
	local stem = c:segment("SeedStem", crownBase, crownBase + V(0.06, 0.63 + s * 0.09, -0.12), 0.16, 0.16, bark, head)
	if s == 1 then
		c:leaf("UnfurledBud", crownBase + V(0, 0.43, -0.1), crownBase + V(0.42, 1.1, -0.12), 0.58, leaf, stem)
		c:sphere("SleepingSeed", V(0.32, 0.44, 0.34), crownBase + V(-0.12, 0.81, -0.16), bud, stem)
	else
		for n = 1, s == 3 and 7 or 4 do
			local angle = n / (s == 3 and 7 or 4) * math.pi * 2
			local start = crownBase + V(0.04, 0.61, -0.12)
			local finish = start + V(math.cos(angle) * 0.62, 0.22, math.sin(angle) * 0.62)
			c:leaf("FlowerPetal" .. n, start, finish, 0.48, n % 2 == 0 and bud or c.cream, stem)
		end
		c:sphere("PollenHeart", V(0.35, 0.3, 0.35), crownBase + V(0.04, 0.76, -0.12), c.gold, stem)
		for n = 1, 5 do
			local angle = n * math.pi * 2 / 5
			c:leaf(
				"LeafCollar" .. n,
				V(0, height + 0.51, -0.12),
				V(math.cos(angle) * 1.03, height + 0.12, math.sin(angle) * 0.79 - 0.12),
				0.44,
				n % 2 == 0 and leaf or jade,
				body
			)
		end
	end
	if s == 3 then
		for n = 1, 4 do
			local angle = n * math.pi / 2
			c:leaf(
				"BackFrond" .. n,
				V(0, height + 0.2, -0.47),
				V(math.cos(angle) * 0.9, height + 0.6, -1.03 - math.sin(angle) * 0.21),
				0.48,
				jade,
				body,
				false,
				A(0, 0, 0)
			)
		end
	end
	return { body = body, head = head }
end

function M.ancestravore(c)
	local V = c.V
	local s = c.stage
	local wood = Color3.fromRGB(115, 88, 65)
	local ridge = Color3.fromRGB(165, 130, 84)
	local moss = Color3.fromRGB(117, 151, 87)
	local leaf = Color3.fromRGB(174, 189, 112)
	local hipY = ({ 1.05, 1.85, 2.35 })[s]
	local chestY = hipY + (s == 1 and 0.7 or 1.2)
	local body =
		c:sphere("Body", V(1.65 + s * 0.24, s == 1 and 1.8 or 2.6, 1.43), V(0, chestY, -0.06), wood, c.root, true)
	c:sphere("RootPelvis", V(1.7 + s * 0.2, 1.1, 1.6), V(0, hipY + 0.13, -0.1), wood, body)
	c:sphere("ChestHeartwood", V(1.32, 1.92, 0.37), V(0, chestY - 0.12, 0.68), ridge, body)
	for n = 1, 3 do
		c:segment(
			"GrainRidge" .. n,
			V((n - 2) * 0.3, chestY - 0.82, 0.87),
			V((n - 2) * 0.26, chestY + 0.78, 0.84),
			0.085,
			0.075,
			wood,
			body
		)
	end
	local neckTop = chestY + (s == 1 and 1.12 or 1.43)
	c:segment("Neck", V(0, chestY + 0.64, 0.08), V(0, neckTop, 0.35), 0.93, 0.84, wood, body)
	local head = c:sphere("Head", V(s == 1 and 1.52 or 1.43, 1.73, 1.36), V(0, neckTop + 0.48, 0.42), ridge, body, true)
	c:sphere("StagMuzzle", V(0.91, 0.62, 1.23), V(0, neckTop + 0.13, 1.04), c.cream, head)
	c:sphere("VelvetNose", V(0.5, 0.27, 0.27), V(0, neckTop + 0.19, 1.58), wood, head)
	c:eyes(head, V(0, neckTop + 0.74, 1.04), 0.91, s == 1 and 0.255 or 0.225, moss, 0.12)
	for _, side in { -1, 1 } do
		local shoulder = V(side * (0.92 + s * 0.07), chestY + 0.59, -0.05)
		local elbow = V(side * (1.23 + s * 0.1), hipY + 0.43, 0.09)
		local handPos = V(side * (1.3 + s * 0.1), hipY - 0.04, 0.63)
		c:sphere("Shoulder" .. side, V(0.85, 1.1, 0.94), shoulder, moss, body)
		local arm = c:segment("ArmBough" .. side, shoulder, elbow, 0.58, 0.64, wood, body, true)
		c:segment("ForearmRoot" .. side, elbow, handPos, 0.47, 0.52, ridge, arm)
		c:sphere("Palm" .. side, V(0.68, 0.63, 0.56), handPos, wood, arm)
		for digit = 1, 3 do
			local base = handPos + V((digit - 2) * 0.2, -0.12, 0.09)
			c:segment("RootFinger" .. side .. digit, base, base + V(side * 0.08, -0.27, 0.26), 0.15, 0.17, ridge, arm)
		end
		local hip = V(side * 0.65, hipY + 0.08, -0.1)
		local knee = V(side * 0.76, hipY * 0.48, 0.03)
		local footPos = V(side * 0.87, 0.23, 0.34)
		local leg = c:segment("LegTrunk" .. side, hip, knee, 0.72, 0.84, wood, body, true)
		c:segment("RootShin" .. side, knee, footPos, 0.54, 0.64, ridge, leg)
		c:sphere("RootFoot" .. side, V(0.96, 0.43, 1.14), footPos, wood, leg)
		for toe = 1, 3 do
			c:segment(
				"FootRoot" .. side .. toe,
				footPos + V((toe - 2) * 0.25, -0.02, 0.2),
				footPos + V((toe - 2) * 0.34, -0.09, 0.74),
				0.18,
				0.22,
				ridge,
				leg
			)
		end
		c:leaf(
			"StagEar" .. side,
			V(side * 0.52, neckTop + 0.77, 0.31),
			V(side * 1.15, neckTop + 1.12, 0.15),
			0.52,
			moss,
			head,
			true
		)
		local antlerRoot = V(side * 0.43, neckTop + 1.1, 0.22)
		local main = c:segment(
			"AntlerStem" .. side,
			antlerRoot,
			antlerRoot + V(side * 0.2, s == 1 and 0.48 or 1.15, -0.1),
			0.19,
			0.2,
			ridge,
			head
		)
		if s >= 2 then
			local first = antlerRoot + V(side * 0.2, 0.78, -0.08)
			local tip = first + V(side * 0.7, 0.68 + (s - 2) * 0.3, -0.1)
			c:segment("AntlerCrown" .. side, first, tip, 0.16, 0.18, ridge, main)
			for branch = 1, s == 3 and 3 or 2 do
				local point = first:Lerp(tip, branch / (s == 3 and 4 or 3))
				local endPos = point + V(-side * 0.38, 0.48 + branch * 0.08, 0.07)
				c:segment("AntlerFork" .. side .. branch, point, endPos, 0.13, 0.14, ridge, main)
				c:leaf(
					"AntlerLeaf" .. side .. branch,
					endPos - V(0, 0.13, 0),
					endPos + V(side * 0.22, 0.24, 0.09),
					0.32,
					leaf,
					main
				)
			end
		end
		if s == 3 then
			for frond = 1, 3 do
				c:leaf(
					"ShoulderMoss" .. side .. frond,
					shoulder + V(0, 0.18, 0),
					shoulder + V(side * (0.27 + frond * 0.13), -0.55, (frond - 2) * 0.24),
					0.47,
					frond % 2 == 0 and leaf or moss,
					body
				)
			end
		end
	end
	if s == 3 then
		c:sphere("HeartwoodCore", V(0.45, 0.5, 0.15), V(0, chestY + 0.25, 0.89), c.gold, body)
		for n = 1, 4 do
			local angle = n * math.pi / 2
			c:leaf(
				"BackCanopy" .. n,
				V(0, chestY + 0.25, -0.64),
				V(math.cos(angle) * 1.25, chestY + 1, -0.9 + math.sin(angle) * 0.55),
				0.75,
				moss,
				body
			)
		end
	end
	return { body = body, head = head }
end

function M.graozinho(c)
	local V, A = c.V, c.A
	local s = c.stage
	local sand = Color3.fromRGB(180, 151, 110)
	local edge = Color3.fromRGB(218, 190, 145)
	local violet = Color3.fromRGB(142, 137, 184)
	local crystal = Color3.fromRGB(190, 196, 222)
	local y = s == 1 and 0.83 or s == 2 and 1 or 1.23
	local width = 1.8 + s * 0.34
	local length = 1.7 + s * 0.38
	local body = c:sphere("Body", V(width, 1.3 + s * 0.12, length), V(0, y, -0.28), sand, c.root, true)
	c:sphere("GeodeUnderside", V(width * 0.84, 0.67, length * 0.87), V(0, y - 0.44, -0.17), edge, body)
	local head =
		c:sphere("Head", V(s == 1 and 1.51 or 1.35, 1.18, 1.12), V(0, y + 0.03, length * 0.34), edge, body, true)
	c:sphere("StoneSnout", V(0.91, 0.47, 0.62), V(0, y - 0.18, length * 0.34 + 0.5), c.cream, head)
	c:eyes(head, V(0, y + 0.23, length * 0.34 + 0.47), 0.76, s == 1 and 0.245 or 0.21, violet, -0.13)
	smile(c, head, y - 0.26, length * 0.34 + 0.8, 0.17)
	for _, side in { -1, 1 } do
		for n = 1, 2 do
			local foot = V(side * width * 0.41, 0.22, n == 1 and length * 0.22 or -length * 0.54)
			c:sphere("PebbleFoot" .. side .. n, V(0.64, 0.42, 0.85), foot, sand, body)
			c:wedge(
				"ToeFacet" .. side .. n,
				V(0.43, 0.22, 0.43),
				foot + V(0, 0.09, 0.23),
				edge,
				body,
				false,
				A(0, 0, side * 0.1)
			)
		end
		for plate = 1, s == 1 and 3 or 5 do
			local z = -length * 0.61 + plate * length * 0.17
			c:sphere(
				"ShellBand" .. side .. plate,
				V(width * 0.54, 0.5, 0.46),
				V(side * width * 0.25, y + 0.48, z),
				plate % 2 == 0 and edge or sand,
				body,
				false,
				A(0, 0, side * 0.27)
			)
		end
	end
	local count = ({ 3, 5, 7 })[s]
	for n = 1, count do
		local z = -length * 0.49 + n / (count + 1) * length * 0.84
		local rise = s == 1 and 0.32 or 0.49 + math.sin(n * 1.9) * 0.2 + (s == 3 and 0.26 or 0)
		local base = V((n % 2 == 0 and -1 or 1) * 0.13, y + 0.56, z)
		c:wedge(
			"GeodeCrystal" .. n,
			V(0.34 + s * 0.035, rise * 1.5, 0.43),
			base + V(0, rise * 0.5, 0),
			n % 2 == 0 and violet or crystal,
			body,
			false,
			A(0.12, n * 0.8, n % 2 == 0 and -0.2 or 0.2)
		)
	end
	if s == 3 then
		for _, side in { -1, 1 } do
			local first = V(side * 0.7, y + 0.36, length * 0.2)
			local horn =
				c:segment("StoneHornBase" .. side, first, first + V(side * 0.49, 0.5, -0.18), 0.45, 0.43, sand, head)
			c:segment(
				"StoneHornCurl" .. side,
				first + V(side * 0.49, 0.5, -0.18),
				first + V(side * 0.55, 0.17, -0.6),
				0.32,
				0.31,
				edge,
				horn
			)
			c:wedge("HornGem" .. side, V(0.19, 0.36, 0.29), first + V(side * 0.55, 0.17, -0.66), violet, horn)
		end
	end
	local tailStart = V(0, y - 0.22, -length * 0.58)
	local tail =
		c:segment("Tail1", tailStart, tailStart + V(0.1, -0.13, -0.55 - s * 0.15), 0.36, 0.35, sand, body, true)
	c:wedge(
		"TailFacet",
		V(0.44, 0.4, 0.51),
		tailStart + V(0.1, -0.13, -0.7 - s * 0.15),
		edge,
		tail,
		false,
		A(0, math.pi, 0)
	)
	return { body = body, head = head }
end

function M.colossodune(c)
	local V, A = c.V, c.A
	local s = c.stage
	local stone = Color3.fromRGB(157, 130, 94)
	local edge = Color3.fromRGB(213, 183, 132)
	local teal = Color3.fromRGB(88, 143, 145)
	local shadow = Color3.fromRGB(95, 89, 105)
	if s == 1 then
		-- A semente de ruína ainda é maciça e redonda. Os arcos só se abrem na forma juvenil.
		local body = c:sphere("Body", V(2.34, 1.67, 1.86), V(0, 1.04, -0.1), stone, c.root, true)
		c:sphere("InfantFoundation", V(2.03, 0.49, 1.65), V(0, 0.44, -0.01), edge, body)
		local head = c:sphere("Head", V(1.68, 1.39, 1.17), V(0, 1.55, 0.61), edge, body, true)
		cyclops(c, head, V(0, 1.64, 1.13), 0.36, teal)
		c:sphere("InfantChin", V(0.87, 0.37, 0.5), V(0, 1.13, 1.04), stone, head)
		smile(c, head, 1.14, 1.31, 0.15)
		for _, side in { -1, 1 } do
			local hand =
				c:sphere("PebbleArm" .. side, V(0.66, 0.91, 0.75), V(side * 1.16, 0.97, 0.18), stone, body, true)
			c:sphere("InfantPalm" .. side, V(0.64, 0.43, 0.68), V(side * 1.25, 0.61, 0.4), edge, hand)
			c:sphere("LegPebble" .. side, V(0.78, 0.48, 0.96), V(side * 0.69, 0.27, 0.28), stone, body, true)
			c:wedge(
				"CrownSeed" .. side,
				V(0.43, 0.52, 0.61),
				V(side * 0.55, 2.18, 0.17),
				stone,
				head,
				false,
				A(0, side * 0.18, side * -0.15)
			)
			c:sphere("DormantArchGlyph" .. side, V(0.15, 0.25, 0.1), V(side * 0.61, 1.03, 0.78), teal, body)
		end
		c:sphere("CrownSeedGem", V(0.33, 0.3, 0.24), V(0, 2.19, 0.62), teal, head)
		return { body = body, head = head }
	end
	local hips = ({ 1.02, 1.7, 2.2 })[s]
	local chest = hips + (s == 1 and 0.82 or s == 2 and 1.4 or 1.9)
	local body = c:block("Body", V(1.8 + s * 0.28, 0.9, 1.55), V(0, hips + 0.26, 0), stone, c.root, true)
	c:wedge("PelvisKeystone", V(0.94, 0.83, 0.55), V(0, hips + 0.18, 0.94), edge, body, false, A(0, math.pi, 0))
	for _, side in { -1, 1 } do
		local hip = V(side * (0.55 + s * 0.09), hips + 0.08, 0)
		local knee = V(side * (0.69 + s * 0.09), hips * 0.47, 0.08)
		local footPos = V(side * (0.79 + s * 0.1), 0.26, 0.38)
		local leg = c:block(
			"LegPillar" .. side,
			V(0.85, hips * 0.65, 0.97),
			(hip + knee) * 0.5,
			stone,
			body,
			true,
			A(0, 0, side * 0.1)
		)
		c:block("ShinPlinth" .. side, V(0.73, math.max(0.5, hips * 0.52), 0.88), (knee + footPos) * 0.5, edge, leg)
		c:sphere("StoneFoot" .. side, V(1.18, 0.55, 1.46), footPos, stone, leg)
		for toe = 1, 3 do
			c:block(
				"SandstoneToe" .. side .. toe,
				V(0.27, 0.24, 0.43),
				footPos + V((toe - 2) * 0.3, -0.06, 0.56),
				edge,
				leg
			)
		end
		local lower = V(side * (0.8 + s * 0.12), hips + 0.56, 0)
		local curve = V(side * (1.08 + s * 0.1), chest - 0.22, -0.04)
		local top = V(side * 0.61, chest + 0.32, -0.04)
		local arch = c:segment("TorsoArch" .. side, lower, curve, 0.56, 0.72, stone, body)
		c:segment("ArchUpper" .. side, curve, top, 0.63, 0.76, edge, arch)
		c:block("ArchJoint" .. side, V(0.76, 0.62, 0.9), curve, stone, arch, false, A(0, 0, side * -0.28))
		local shoulder = V(side * (1.39 + s * 0.15), chest - 0.07, -0.04)
		c:segment("ShoulderBridge" .. side, curve, shoulder, 0.7, 0.73, edge, body)
		local elbow = shoulder + V(side * 0.24, -0.78, 0.13)
		local hand = elbow + V(side * 0.13, -0.75, 0.42)
		local arm = c:block(
			"ArmBastion" .. side,
			V(0.82, 0.9, 0.95),
			(shoulder + elbow) * 0.5,
			stone,
			body,
			true,
			A(0, 0, side * 0.17)
		)
		c:segment("ArmAxle" .. side, elbow, hand, 0.63, 0.71, shadow, arm)
		c:block("Gauntlet" .. side, V(0.95, 0.75, 1), hand, edge, arm, false, A(-0.18, 0, side * -0.08))
		for digit = 1, 3 do
			c:block(
				"StoneFinger" .. side .. digit,
				V(0.24, 0.42, 0.36),
				hand + V((digit - 2) * 0.28, -0.36, 0.35),
				stone,
				arm,
				false,
				A(0.12, 0, 0)
			)
		end
		c:sphere("ArchGem" .. side, V(0.23, 0.29, 0.12), curve + V(0, 0.04, 0.47), teal, body)
	end
	-- O peito tem um vão real entre dois pilares; o núcleo fica suspenso no arco.
	c:segment("ChestLintel", V(-0.61, chest + 0.32, -0.04), V(0.61, chest + 0.32, -0.04), 0.64, 0.76, edge, body)
	c:segment("CoreHanger", V(0, chest + 0.22, -0.06), V(0, chest - 0.3, -0.06), 0.16, 0.2, shadow, body)
	c:sphere("GeodeHeart", V(0.64, 0.82, 0.54), V(0, chest - 0.62, -0.06), teal, body)
	c:wedge("HeartFacet", V(0.34, 0.45, 0.12), V(0, chest - 0.59, 0.23), c.cream, body)
	local head = c:sphere("Head", V(s == 1 and 1.63 or 1.5, 1.65, 1.37), V(0, chest + 1.13, 0.04), stone, body, true)
	c:block("PharaohBrow", V(1.84, 0.28, 0.72), V(0, chest + 1.61, 0.52), edge, head, false, A(0, 0, 0))
	c:sphere("MaskChin", V(1.05, 0.57, 0.85), V(0, chest + 0.67, 0.58), edge, head)
	c:eyes(head, V(0, chest + 1.22, 0.69), 0.94, s == 1 and 0.255 or 0.22, teal, 0.08)
	c:block("NoseKeystone", V(0.24, 0.41, 0.22), V(0, chest + 1, 0.85), edge, head)
	for _, side in { -1, 1 } do
		c:wedge(
			"CrownPanel" .. side,
			V(0.46, s == 1 and 0.65 or 1.12, 0.87),
			V(side * 0.81, chest + 1.43, -0.03),
			edge,
			head,
			false,
			A(0, 0, side * -0.13)
		)
		if s >= 2 then
			c:block("RoyalStripe" .. side, V(0.12, 0.67, 0.12), V(side * 0.83, chest + 1.44, 0.43), teal, head)
		end
	end
	if s == 3 then
		for _, side in { -1, 1 } do
			local base = V(side * 1.4, chest + 0.18, -0.28)
			local peak = base + V(side * 0.42, 0.93, -0.24)
			local shoulderArch = c:segment("ShoulderArchRise" .. side, base, peak, 0.34, 0.4, edge, body)
			c:segment(
				"ShoulderArchFall" .. side,
				peak,
				base + V(side * 0.85, 0.1, -0.28),
				0.34,
				0.4,
				edge,
				shoulderArch
			)
			c:wedge("CrownSpire" .. side, V(0.29, 0.93, 0.45), V(side * 0.4, chest + 2.06, 0.03), edge, head)
		end
		c:block("CrownCenter", V(0.43, 0.57, 0.48), V(0, chest + 1.94, 0.13), teal, head)
		for n = 1, 3 do
			c:block("BackRune" .. n, V(0.43, 0.18, 0.12), V(0, hips + 0.45 + n * 0.25, -0.82), teal, body)
		end
	end
	return { body = body, head = head }
end

function M.lodinho(c)
	local V, A = c.V, c.A
	local s = c.stage
	local mud = Color3.fromRGB(111, 109, 126)
	local belly = Color3.fromRGB(164, 151, 166)
	local moss = Color3.fromRGB(133, 163, 104)
	local sprout = Color3.fromRGB(182, 197, 133)
	local length = 1.6 + s * 0.42
	local y = 0.68 + s * 0.12
	local body = c:sphere("Body", V(1.9 + s * 0.18, 1.13 + s * 0.13, length), V(0, y, -0.24), mud, c.root, true)
	c:sphere("SlimeSole", V(2.1 + s * 0.15, 0.42, length * 1.07), V(0, 0.26, -0.13), belly, body)
	for side = -1, 1, 2 do
		for n = 1, s == 1 and 2 or 3 do
			local z = -length * 0.55 + n * length * 0.3
			c:sphere("PuddleLobe" .. side .. n, V(0.6, 0.25, 0.8), V(side * (0.88 + s * 0.07), 0.2, z), mud, body)
		end
	end
	local headY = y + (s == 1 and 0.25 or 0.47)
	local head = c:sphere("Head", V(s == 1 and 1.65 or 1.69, 1.41, 1.24), V(0, headY, length * 0.28), mud, body, true)
	c:sphere("SoftMuzzle", V(1.17, 0.59, 0.61), V(0, headY - 0.35, length * 0.28 + 0.49), belly, head)
	cyclops(c, head, V(0, headY + 0.15, length * 0.28 + 0.52), s == 1 and 0.42 or 0.38, moss)
	smile(c, head, headY - 0.43, length * 0.28 + 0.8, 0.22)
	for _, side in { -1, 1 } do
		c:sphere(
			"MuddyCheek" .. side,
			V(0.24, 0.12, 0.1),
			V(side * 0.57, headY - 0.25, length * 0.28 + 0.66),
			belly,
			head
		)
		local antennaBase = V(side * 0.5, headY + 0.46, length * 0.24)
		local tip = antennaBase + V(side * 0.33, 0.4 + s * 0.13, -0.15)
		local stalk = c:segment("MossAntenna" .. side, antennaBase, tip, 0.18, 0.17, moss, head, true)
		c:sphere("DewBud" .. side, V(0.32, 0.39, 0.3), tip, sprout, stalk)
	end
	local tailStart = V(0, y - 0.13, -length * 0.48)
	local tailMid = tailStart + V(0.35, -0.15, -0.65)
	local tailEnd = tailMid + V(0.44, 0.22, -0.43 - s * 0.13)
	local tail = c:segment("Tail1", tailStart, tailMid, 0.65, 0.6, mud, body, true)
	c:segment("TailCurl", tailMid, tailEnd, 0.37, 0.4, mud, tail)
	c:leaf("TailSprout", tailEnd, tailEnd + V(0.28, 0.41, 0.06), 0.52, moss, tail)
	local stones = ({ 3, 5, 7 })[s]
	for n = 1, stones do
		local angle = n * 2.4
		local point = V(math.cos(angle) * 0.59, y + 0.58, math.sin(angle) * length * 0.28 - 0.33)
		c:sphere("MossCushion" .. n, V(0.66, 0.35, 0.7), point, n % 2 == 0 and sprout or moss, body)
		if s >= 2 and n % 2 == 1 then
			local stem = c:segment("MushroomStem" .. n, point, point + V(0, 0.39, 0), 0.12, 0.14, c.cream, body)
			c:sphere(
				"MushroomCap" .. n,
				V(0.48, 0.23, 0.45),
				point + V(0, 0.42, 0),
				belly,
				stem,
				false,
				A(0, 0, n * 0.06)
			)
		end
	end
	return { body = body, head = head }
end

function M.vaporino(c)
	local V, A = c.V, c.A
	local s = c.stage
	local copper = Color3.fromRGB(191, 130, 101)
	local patina = Color3.fromRGB(111, 170, 171)
	local darkCopper = Color3.fromRGB(139, 98, 94)
	local steam = Color3.fromRGB(226, 221, 205)
	local y = 0.88 + s * 0.11
	local body = c:sphere("Body", V(1.75 + s * 0.18, 1.62, 2.12), V(0, y, -0.25), copper, c.root, true)
	c:sphere("BoilerBelly", V(1.52, 1.12, 0.52), V(0, y - 0.13, 0.75), c.cream, body)
	local coilPoints = {
		V(0, y - 0.05, -0.85),
		V(-0.72, y - 0.2, -1.6),
		V(-1.22, y - 0.28, -1.95),
		V(-1.52, y - 0.15, -2.6),
		V(-1.17, y + 0.28, -3.15),
		V(-0.56, y + 0.64, -3.1),
	}
	local count = ({ 2, 4, 5 })[s]
	local parent = body
	for n = 1, count do
		local width = 1.1 - n * 0.14
		local piece = c:segment(
			"Tail" .. n,
			coilPoints[n],
			coilPoints[n + 1],
			width,
			width * 1.05,
			n % 2 == 0 and darkCopper or copper,
			parent,
			n == 1
		)
		local bandPoint = coilPoints[n]:Lerp(coilPoints[n + 1], 0.65)
		c:sphere(
			"PatinaBand" .. n,
			V(width * 1.02, width * 0.94, 0.22),
			bandPoint,
			patina,
			piece,
			false,
			A(0.13, -0.35, 0.1)
		)
		parent = piece
	end
	local last = coilPoints[count + 1]
	c:leaf("SteamTailFin", last, last + V(0.1, 0.53, -0.5), 0.62, patina, parent)
	local neckBase = V(0, y + 0.33, 0.44)
	local neckTop = V(0, y + (s == 1 and 0.98 or 1.4), 0.62)
	c:segment("KettleNeck", neckBase, neckTop, 0.98, 0.92, darkCopper, body)
	local headY = neckTop.Y + 0.35
	local head = c:sphere("Head", V(s == 1 and 1.7 or 1.57, 1.38, 1.4), V(0, headY, 0.7), copper, body, true)
	c:sphere("PorcelainMuzzle", V(1.11, 0.61, 0.83), V(0, headY - 0.24, 1.29), c.cream, head)
	c:eyes(head, V(0, headY + 0.13, 1.26), 0.9, s == 1 and 0.26 or 0.23, patina, -0.08)
	c:sphere("CopperNose", V(0.34, 0.18, 0.19), V(0, headY - 0.17, 1.69), darkCopper, head)
	smile(c, head, headY - 0.39, 1.68, 0.2)
	for _, side in { -1, 1 } do
		local armBase = V(side * 0.72, y + 0.22, 0.13)
		local armEnd = V(side * 1.1, y - 0.12, 0.63)
		local fin = c:segment("SteamFin" .. side, armBase, armEnd, 0.3, 0.4, patina, body, true)
		c:leaf("FinPalm" .. side, armEnd - V(0, 0.08, 0.12), armEnd + V(side * 0.3, 0.16, 0.28), 0.52, patina, fin)
		local lid = c:segment(
			"KettleEar" .. side,
			V(side * 0.56, headY + 0.37, 0.46),
			V(side * 0.91, headY + 0.74, 0.27),
			0.28,
			0.29,
			patina,
			head,
			true
		)
		c:sphere("EarRivet" .. side, V(0.19, 0.19, 0.11), V(side * 0.7, headY + 0.51, 0.53), c.gold, lid)
	end
	local ventTop = V(0, headY + 0.94, 0.49)
	c:sphere("BoilerLid", V(1.32, 0.28, 1.12), V(0, headY + 0.66, 0.62), patina, head)
	c:segment("SteamVent", V(0, headY + 0.68, 0.49), ventTop, 0.37, 0.4, darkCopper, head)
	c:sphere("VentLip", V(0.53, 0.19, 0.52), ventTop, copper, head)
	local plumeCount = ({ 2, 3, 5 })[s]
	for n = 1, plumeCount do
		local swirl = V(math.sin(n * 1.4) * (0.14 + n * 0.03), n * 0.27, math.cos(n * 1.1) * 0.1)
		local puff = c:sphere(
			"SteamPuff" .. n,
			V(0.32 + n * 0.06, 0.34 + n * 0.055, 0.32 + n * 0.06),
			ventTop + swirl,
			steam,
			head
		)
		puff.Transparency = 0.16 + n * 0.035
	end
	if s >= 2 then
		for _, side in { -1, 1 } do
			local start = V(side * 0.88, y + 0.48, -0.3)
			local corner = start + V(side * 0.45, 0.42, -0.18)
			local loop = c:segment("BoilerHandleLower" .. side, start, corner, 0.18, 0.2, darkCopper, body)
			c:segment(
				"BoilerHandleUpper" .. side,
				corner,
				start + V(0.05 * side, 0.76, -0.25),
				0.18,
				0.2,
				darkCopper,
				loop
			)
		end
	end
	if s == 3 then
		local vent = V(0.58, y + 0.65, -0.71)
		c:segment("BackVent", vent, vent + V(0.12, 0.7, -0.2), 0.32, 0.35, copper, body)
		c:sphere("BackVentLip", V(0.48, 0.19, 0.45), vent + V(0.12, 0.71, -0.2), patina, body)
		for n = 1, 3 do
			local puff = c:sphere(
				"BackSteam" .. n,
				V(0.26 + n * 0.1, 0.3 + n * 0.09, 0.3 + n * 0.09),
				vent + V(0.11 + n * 0.06, 0.65 + n * 0.24, -0.2 - n * 0.13),
				steam,
				body
			)
			puff.Transparency = 0.18 + n * 0.04
		end
	end
	return { body = body, head = head }
end

return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">SculptOrganic</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Anatomias autorais: volumes contínuos, focinhos construídos e apêndices com raízes físicas.
-- +Z é a frente. O contexto aplica escala, rig e propriedades de colisão.
local V = Vector3.new
local A = CFrame.Angles
local rgb = Color3.fromRGB
local S = {}

local function paw(c, name, pos, size, color, parent, claws, clawColor)
	local foot = c:sphere(name, size, pos, color, parent, false)
	if claws then
		for toe = -1, 1 do
			c:sphere(
				name .. "Toe" .. toe,
				V(size.X * 0.22, size.Y * 0.38, size.Z * 0.38),
				pos + V(toe * size.X * 0.24, -size.Y * 0.08, size.Z * 0.4),
				clawColor,
				foot,
				false
			)
		end
	end
	return foot
end

local function smile(c, parent, center, width, color)
	c:segment("SmileL", center + V(-width, 0.06, 0), center + V(0, -0.02, 0.035), 0.055, 0.045, color, parent)
	c:segment("SmileR", center + V(0, -0.02, 0.035), center + V(width, 0.06, 0), 0.055, 0.045, color, parent)
end

-- Cinzelo: salamandra barriguda cuja carapaça é um forno de alvenaria.
function S.cinzelo(c)
	local s = c.stage
	local young = s == 1
	local plum, copper, amber = rgb(72, 47, 70), rgb(174, 95, 64), rgb(249, 177, 75)
	local skin, cream, dark = rgb(111, 73, 88), c.cream, c.dark
	local length = young and 2.6 or s == 2 and 3.3 or 3.8
	local body = c:sphere("Body", V(young and 2.6 or 3.3, 1.45, length), V(0, 1.02, -0.15), skin, c.root, true)
	c:sphere("WarmBelly", V(young and 2.2 or 2.9, 0.72, length * 0.86), V(0, 0.75, 0.04), cream, body)
	local head = c:sphere("Head", V(young and 2.15 or 2.6, 1.3, 1.8), V(0, 1.18, length * 0.44), skin, body, true)
	c:sphere("CheekL", V(0.8, 0.75, 1.02), V(-0.83, 0.96, length * 0.44 + 0.34), copper, head)
	c:sphere("CheekR", V(0.8, 0.75, 1.02), V(0.83, 0.96, length * 0.44 + 0.34), copper, head)
	c:sphere("LowerJaw", V(young and 1.9 or 2.45, 0.55, 1.45), V(0, 0.77, length * 0.44 + 0.39), cream, head)
	c:sphere("Snout", V(young and 2 or 2.5, 0.65, 1.15), V(0, 1.03, length * 0.44 + 0.69), skin, head)
	local front = length * 0.44 + 1.12
	c:eyes(head, V(0, 1.48, front - 0.27), young and 1.14 or 1.5, young and 0.29 or 0.27, amber, -0.12)
	for _, side in { -1, 1 } do
		c:sphere("Nostril" .. side, V(0.12, 0.08, 0.06), V(side * 0.47, 1.15, front + 0.04), dark, head)
		for _, back in { -1, 1 } do
			local start = V(side * (young and 1.03 or 1.38), 0.85, back * length * 0.24)
			local endPos = start + V(side * 0.42, -0.37, 0.18)
			local leg = c:segment("Leg" .. side .. "_" .. back, start, endPos, 0.55, 0.58, skin, body, true)
			paw(
				c,
				"Paw" .. side .. "_" .. back,
				endPos + V(0, -0.1, 0.13),
				V(0.78, 0.38, 0.83),
				copper,
				leg,
				s == 3,
				cream
			)
		end
	end
	smile(c, head, V(0, 0.92, front + 0.08), young and 0.58 or 0.83, dark)
	local tail = {
		V(0, 0.93, -length * 0.4),
		V(0.35, 0.79, -length * 0.65 - 0.3),
		V(0.87, 0.72, -length * 0.72 - 0.8),
		V(1.35, 0.94, -length * 0.7 - 1.18),
	}
	for i = 1, young and 2 or 3 do
		c:segment("Tail" .. i, tail[i], tail[i + 1], 0.92 - i * 0.19, 0.75 - i * 0.12, skin, body, true)
	end
	local shell = c:sphere(
		"KilnCarapace",
		V(young and 2.2 or 2.9, young and 1.55 or 2.15, length * 0.83),
		V(0, 1.85, -0.28),
		plum,
		body
	)
	local windowY = young and 2.05 or 2.35
	local windowZ = length * 0.34 - 0.08
	c:sphere("KilnArch", V(1.25, 1.44, 0.2), V(0, windowY, windowZ), copper, shell)
	c:sphere("KilnGlow", V(0.93, 1.1, 0.14), V(0, windowY, windowZ + 0.11), amber, shell)
	for bar = -1, 1 do
		c:segment(
			"WindowBar" .. bar,
			V(bar * 0.27, windowY - 0.4, windowZ + 0.2),
			V(bar * 0.27, windowY + 0.39, windowZ + 0.2),
			0.07,
			0.065,
			plum,
			shell
		)
	end
	if not young then
		for _, side in { -1, 1 } do
			c:sphere("SideKilnArch" .. side, V(0.18, 0.83, 0.86), V(side * 1.3, 2.03, -0.37), copper, shell)
			c:sphere("SideKilnGlow" .. side, V(0.15, 0.54, 0.56), V(side * 1.39, 2.06, -0.34), amber, shell)
			for brick = 1, 3 do
				c:block(
					"Brick" .. side .. "_" .. brick,
					V(0.23, 0.24, 0.62),
					V(side * (1.31 - brick * 0.1), 1.95 + brick * 0.3, -0.5 + (brick % 2) * 0.2),
					copper,
					shell,
					false,
					A(0, 0, side * 0.15)
				)
			end
		end
	end
	local chimneyHeight = young and 0.65 or s == 2 and 1.04 or 1.5
	local chimneyBase = young and 2.3 or 2.7
	c:block("Chimney", V(0.68, chimneyHeight, 0.72), V(0.2, chimneyBase + chimneyHeight * 0.5, -0.85), plum, shell)
	c:block("ChimneyLip", V(0.95, 0.22, 0.97), V(0.2, chimneyBase + chimneyHeight, -0.85), copper, shell)
	c:block("ChimneyOpening", V(0.61, 0.08, 0.63), V(0.2, chimneyBase + chimneyHeight + 0.13, -0.85), dark, shell)
	if s == 3 then
		for puff = 1, 3 do
			c:sphere(
				"SoftSmoke" .. puff,
				V(0.35 + puff * 0.13, 0.34 + puff * 0.1, 0.36 + puff * 0.12),
				V(0.18 + puff * 0.14, chimneyBase + chimneyHeight + 0.17 + puff * 0.31, -0.85 - puff * 0.12),
				cream,
				shell
			)
		end
		c:leaf("TailEmber", tail[4] - V(0.03, 0.05, 0), tail[4] + V(0.38, 0.47, -0.11), 0.62, amber, body)
	end
	return { body = body, head = head }
end

-- Magmarau: épaulas de javali, casco fendido, presas curvas e crina de brasa.
function S.magmarau(c)
	local s, young = c.stage, c.stage == 1
	local bodyColor, mane, glow = rgb(137, 67, 64), rgb(84, 47, 64), rgb(237, 135, 66)
	local cream, dark = c.cream, c.dark
	local body = c:sphere(
		"Body",
		V(young and 2.4 or 3.3, young and 1.9 or 2.55, young and 2.9 or 4.05),
		V(0, young and 1.5 or 1.96, -0.18),
		bodyColor,
		c.root,
		true
	)
	c:sphere(
		"Haunch",
		V(young and 2.1 or 2.6, young and 1.65 or 2.15, 2.25),
		V(0, young and 1.43 or 1.73, -1.37),
		bodyColor,
		body
	)
	c:sphere(
		"ShoulderMantle",
		V(young and 2.5 or 3.55, young and 1.7 or 2.4, 1.55),
		V(0, young and 1.64 or 2.26, 0.73),
		mane,
		body
	)
	local hy = young and 1.65 or 2.15
	local hz = young and 1.38 or 2.02
	local head =
		c:sphere("Head", V(young and 1.9 or 2.37, young and 1.65 or 1.94, 1.8), V(0, hy, hz), bodyColor, body, true)
	c:sphere("LowerJaw", V(1.72, 0.64, 1.25), V(0, hy - 0.5, hz + 0.54), cream, head)
	c:sphere("Muzzle", V(young and 1.58 or 2, 0.97, 1.18), V(0, hy - 0.2, hz + 0.8), glow, head)
	c:sphere("SnoutDisc", V(1.43, 0.72, 0.25), V(0, hy - 0.13, hz + 1.36), bodyColor, head)
	for _, side in { -1, 1 } do
		c:sphere("Nostril" .. side, V(0.2, 0.2, 0.065), V(side * 0.33, hy - 0.1, hz + 1.49), dark, head)
		local earRoot = V(side * 0.78, hy + 0.54, hz - 0.24)
		c:leaf("Ear" .. side, earRoot, earRoot + V(side * 0.62, young and 0.65 or 0.92, -0.32), 0.66, mane, head, true)
		c:leaf(
			"EarInner" .. side,
			earRoot + V(0, 0.11, 0.08),
			earRoot + V(side * 0.4, young and 0.58 or 0.79, -0.15),
			0.38,
			glow,
			head
		)
		local tuskBase = V(side * 0.78, hy - 0.34, hz + 0.9)
		local tuskMid = tuskBase + V(side * 0.3, 0.14, 0.34)
		local tuskEnd = tuskMid + V(side * 0.13, young and 0.26 or s == 2 and 0.52 or 0.85, -0.08)
		c:segment("TuskRoot" .. side, tuskBase, tuskMid, young and 0.2 or 0.31, 0.28, cream, head)
		c:segment("TuskTip" .. side, tuskMid, tuskEnd, young and 0.13 or 0.21, 0.18, cream, head)
		for _, back in { -1, 1 } do
			local hip = V(side * (young and 0.88 or 1.14), young and 1.15 or 1.53, back * (young and 0.83 or 1.24))
			local knee = hip + V(side * 0.12, young and -0.57 or -0.78, back * 0.1)
			local ankle = knee + V(0, young and -0.18 or -0.39, -0.08)
			local leg =
				c:segment("Leg" .. side .. "_" .. back, hip, knee, young and 0.64 or 0.8, 0.73, bodyColor, body, true)
			if not young then
				c:segment("Shin" .. side .. "_" .. back, knee, ankle, 0.49, 0.51, glow, leg)
			end
			for cleft = -1, 1, 2 do
				c:block(
					"ClovenHoof" .. side .. "_" .. back .. "_" .. cleft,
					V(0.29, 0.35, 0.65),
					ankle + V(cleft * 0.17, -0.1, 0.1),
					mane,
					leg
				)
			end
		end
	end
	c:eyes(head, V(0, hy + 0.32, hz + 0.71), young and 1.05 or 1.34, young and 0.28 or 0.25, glow, 0.2)
	smile(c, head, V(0, hy - 0.43, hz + 1.25), 0.52, dark)
	for tuft = 1, young and 2 or s == 2 and 4 or 6 do
		local z = 0.88 - tuft * 0.53
		c:wedge(
			"EmberMane" .. tuft,
			V(0.82 - tuft * 0.045, young and 0.4 or 0.7 + (tuft % 2) * 0.25, 0.96),
			V(0, (young and 2.38 or 3.05) - tuft * 0.055, z),
			tuft % 2 == 0 and glow or mane,
			body,
			false,
			A(-0.1, math.pi, 0)
		)
	end
	if not young then
		for _, side in { -1, 1 } do
			for plate = 1, s == 3 and 3 or 2 do
				c:wedge(
					"ShoulderPlate" .. side .. "_" .. plate,
					V(0.32, 0.8, 0.83),
					V(side * 1.53, 2.25 + plate * 0.17, 1.13 - plate * 0.43),
					glow,
					body,
					false,
					A(0.15, side * 0.24, side * 0.25)
				)
			end
		end
	end
	local tailBase = V(0, young and 1.7 or 2.03, young and -1.47 or -2.03)
	c:segment("Tail1", tailBase, tailBase + V(0.42, 0.32, -0.62), 0.3, 0.29, bodyColor, body, true)
	c:segment("Tail2", tailBase + V(0.42, 0.32, -0.62), tailBase + V(0.65, 0.75, -0.45), 0.21, 0.2, mane, body, true)
	if s == 3 then
		c:leaf("TailFlame", tailBase + V(0.65, 0.64, -0.45), tailBase + V(0.9, 1.27, -0.65), 0.57, glow, body)
	end
	return { body = body, head = head }
end

-- Folhuco: raposa de orelhas folhosas, peitoral fofo e grande cauda que faz um S.
function S.folhuco(c)
	local s, young = c.stage, c.stage == 1
	local orange, rust, green = rgb(218, 131, 66), rgb(169, 82, 62), rgb(91, 147, 82)
	local lightGreen, cream, dark = rgb(159, 190, 97), c.cream, c.dark
	local by = young and 1.1 or 1.65
	local length = young and 2.3 or 3.2
	local body =
		c:sphere("Body", V(young and 1.8 or 2.1, young and 1.55 or 1.7, length), V(0, by, -0.3), orange, c.root, true)
	c:sphere("Haunch", V(young and 1.7 or 1.95, 1.65, 1.7), V(0, by + 0.04, -1.1), rust, body)
	local chestY = by + (young and 0.2 or 0.45)
	c:sphere("ChestRuff", V(young and 1.4 or 1.7, young and 1.55 or 2.08, 1.32), V(0, chestY, 0.73), cream, body)
	local hy = young and 2.05 or s == 2 and 2.7 or 3.03
	local head =
		c:sphere("Head", V(young and 1.92 or 2.04, young and 1.62 or 1.52, 1.62), V(0, hy, 1.05), orange, body, true)
	for _, side in { -1, 1 } do
		c:sphere("MuzzlePad" .. side, V(0.91, 0.65, 0.92), V(side * 0.36, hy - 0.34, 1.72), cream, head)
		c:leaf("CheekTuft" .. side, V(side * 0.67, hy - 0.25, 1.28), V(side * 1.14, hy - 0.03, 0.96), 0.61, cream, head)
		local earRoot = V(side * 0.64, hy + 0.48, 0.88)
		local earTip = earRoot + V(side * (young and 0.36 or 0.57), young and 0.76 or s == 2 and 1.0 or 1.24, -0.16)
		local direction = (earTip - earRoot).Unit
		local normal = (V(0, 0, 1) - direction * direction:Dot(V(0, 0, 1))).Unit
		local right = direction:Cross(normal).Unit
		local orientation = CFrame.fromMatrix(V(0, 0, 0), right, direction, normal)
		local height, width = (earTip - earRoot).Magnitude, young and 0.9 or 1.14
		local ear = c:sphere(
			"LeafEar" .. side,
			V(width, 0.65, 0.33),
			earRoot + direction * 0.22,
			green,
			head,
			true,
			orientation
		)
		-- Duas metades triangulares formam uma ponta real, em vez de outra orelha oval de coelho.
		for half = -1, 1, 2 do
			c:wedge(
				"LeafEarPoint" .. side .. "_" .. half,
				V(0.25, height - 0.25, width * 0.5),
				earRoot + direction * (0.25 + (height - 0.25) * 0.5) + right * half * width * 0.25,
				green,
				ear,
				false,
				orientation * A(0, -half * math.pi / 2, 0)
			)
		end
		c:leaf(
			"LeafEarInner" .. side,
			earRoot + direction * 0.16 + normal * 0.17,
			earTip - direction * 0.2 + normal * 0.17,
			young and 0.42 or 0.53,
			lightGreen,
			ear
		)
		c:segment(
			"EarVein" .. side,
			earRoot + direction * 0.17 + normal * 0.23,
			earTip - direction * 0.24 + normal * 0.23,
			0.04,
			0.035,
			cream,
			ear
		)
		for _, back in { -1, 1 } do
			local hip = V(side * 0.61, by - 0.34, back * (young and 0.72 or 1.05))
			local knee = hip + V(side * 0.05, young and -0.39 or -0.65, back == -1 and -0.1 or 0.08)
			local footPos = knee + V(0, young and -0.12 or -0.35, 0.14)
			local leg =
				c:segment("Leg" .. side .. "_" .. back, hip, knee, young and 0.36 or 0.46, 0.49, rust, body, true)
			if not young then
				c:segment("LowerLeg" .. side .. "_" .. back, knee, footPos, 0.31, 0.33, cream, leg)
			end
			paw(c, "FoxPaw" .. side .. "_" .. back, footPos, V(0.49, 0.3, 0.68), cream, leg, s == 3, rust)
		end
	end
	c:sphere("Nose", V(0.42, 0.29, 0.3), V(0, hy - 0.2, 2.23), dark, head)
	c:eyes(head, V(0, hy + 0.17, 1.76), young and 1.1 or 1.19, young and 0.29 or 0.255, green, -0.12)
	smile(c, head, V(0, hy - 0.49, 2.1), 0.31, dark)
	for tuft = -1, 1 do
		local front = tuft == 0 and 0.18 or 0
		local drop = young and 0.43 or 0.66
		local from = V(tuft * 0.45, chestY - 0.12, 1.12 + front)
		local middle = V(tuft * 0.46, chestY - drop * 0.58, 1.12 + front)
		local tip = V(tuft * 0.42, chestY - drop, 1.06 + front)
		c:segment("RuffCurveRoot" .. tuft, from, middle, young and 0.35 or 0.45, 0.32, cream, body)
		c:segment("RuffCurveTip" .. tuft, middle, tip, young and 0.26 or 0.33, 0.28, cream, body)
	end
	local tail = young
			and {
				V(0, 1.14, -1.25),
				V(0.53, 1.58, -2.05),
				V(0.97, 2.22, -2.29),
				V(1.09, 2.84, -2.05),
			}
		or {
			V(0, 1.68, -1.63),
			V(0.56, 2.16, -2.52),
			V(1.12, 3.05, -3.0),
			V(1.29, 4.08, -2.93),
		}
	for i = 1, 3 do
		c:segment(
			"Tail" .. i,
			tail[i],
			tail[i + 1],
			young and 0.88 or 1.3 - i * 0.07,
			young and 0.91 or 1.46 - i * 0.08,
			i == 3 and cream or orange,
			body,
			true
		)
	end
	c:leaf(
		"TailBrushTip",
		tail[4] - V(0.03, 0.42, 0.03),
		tail[4] + V(0.07, young and 0.4 or 0.69, 0.18),
		young and 0.61 or 0.77,
		cream,
		body
	)
	if not young then
		for leaf = 1, s == 3 and 5 or 3 do
			local base = tail[1]:Lerp(tail[3], leaf / 7)
			local side = leaf % 2 == 0 and -1 or 1
			c:leaf(
				"TailLeaf" .. leaf,
				base + V(0, 0, 0.48),
				base + V(side * 0.6, 0.53, 0.57),
				0.55,
				leaf % 2 == 0 and lightGreen or green,
				body
			)
		end
		local flowerCenter = V(-0.73, hy + 0.61, 1.1)
		for petal = 1, s == 3 and 5 or 3 do
			local angle = petal * math.pi * 2 / (s == 3 and 5 or 3)
			c:sphere(
				"EarFlower" .. petal,
				V(0.26, 0.39, 0.13),
				flowerCenter + V(math.sin(angle) * 0.21, math.cos(angle) * 0.21, 0),
				cream,
				head,
				false,
				A(0, 0, -angle)
			)
		end
		c:sphere("EarFlowerHeart", V(0.24, 0.24, 0.15), flowerCenter + V(0, 0, 0.08), c.gold, head)
	end
	return { body = body, head = head }
end

-- Esfingeolito: felino guardião sentado, com patas monumentais e toucado de lápis-lazúli.
function S.esfingeolito(c)
	local s, young = c.stage, c.stage == 1
	local sand, ochre, lapis = rgb(220, 184, 121), rgb(174, 133, 88), rgb(60, 118, 139)
	local turquoise, cream, dark = rgb(112, 178, 171), c.cream, c.dark
	local by = young and 1.16 or 1.61
	local body = c:sphere(
		"Body",
		V(young and 1.95 or 2.7, young and 1.9 or 2.3, young and 2.45 or 3.9),
		V(0, by, -0.55),
		ochre,
		c.root,
		true
	)
	local chestY = young and 1.55 or s == 2 and 2.1 or 2.42
	c:sphere(
		"UprightChest",
		V(young and 1.65 or 2.18, young and 2 or s == 2 and 2.7 or 3.4, 1.63),
		V(0, chestY, 0.83),
		sand,
		body
	)
	local hy = young and 2.51 or s == 2 and 3.47 or 4.18
	local head = c:sphere("Head", V(young and 1.87 or 2.12, 1.78, 1.72), V(0, hy, 1.1), sand, body, true)
	for _, side in { -1, 1 } do
		c:sphere("WhiskerPad" .. side, V(0.79, 0.55, 0.72), V(side * 0.31, hy - 0.37, 1.8), cream, head)
		local ear = V(side * 0.76, hy + 0.57, 0.98)
		c:leaf("CatEar" .. side, ear, ear + V(side * 0.11, young and 0.69 or 0.86, -0.1), 0.69, ochre, head, true)
		c:leaf("CatEarInner" .. side, ear + V(0, 0.12, 0.09), ear + V(side * 0.07, 0.61, -0.01), 0.36, lapis, head)
		local hip = V(side * (young and 0.77 or 1.02), by, young and -1.08 or -1.5)
		c:sphere(
			"SeatedHaunch" .. side,
			V(young and 1.05 or 1.42, young and 1.38 or 1.87, young and 1.32 or 1.83),
			hip,
			sand,
			body
		)
		local foreTop = V(side * (young and 0.62 or 0.77), young and 1.79 or 2.47, 1.0)
		local foreBottom = V(side * (young and 0.65 or 0.84), 0.43, 1.44)
		local foreleg =
			c:segment("LegFore" .. side, foreTop, foreBottom, young and 0.52 or 0.63, 0.67, sand, body, true)
		paw(
			c,
			"ForePaw" .. side,
			foreBottom + V(0, -0.09, 0.21),
			V(young and 0.79 or 1.01, 0.51, young and 1.1 or 1.43),
			sand,
			foreleg,
			s >= 2,
			cream
		)
		paw(
			c,
			"RearPaw" .. side,
			V(side * (young and 0.86 or 1.13), 0.29, young and -0.61 or -0.66),
			V(young and 0.79 or 1.04, 0.45, young and 1.2 or 1.58),
			ochre,
			body,
			s == 3,
			cream
		)
		if not young then
			c:leaf(
				"NemesFlap" .. side,
				V(side * 0.87, hy + 0.46, 0.7),
				V(side * 1.4, hy - 1.04, 0.73),
				0.8,
				lapis,
				head
			)
			for stripe = 1, s == 3 and 4 or 3 do
				c:block(
					"HeaddressStripe" .. side .. "_" .. stripe,
					V(0.52, 0.11, 0.17),
					V(side * (1.04 + stripe * 0.057), hy + 0.18 - stripe * 0.26, 1.0),
					sand,
					head,
					false,
					A(0, 0, side * -0.15)
				)
			end
		end
	end
	c:eyes(head, V(0, hy + 0.11, 1.83), young and 1.04 or 1.16, young and 0.29 or 0.255, turquoise, 0.04)
	c:wedge("Nose", V(0.31, 0.23, 0.25), V(0, hy - 0.2, 2.12), dark, head, false, A(0, 0, math.pi))
	smile(c, head, V(0, hy - 0.47, 2.08), 0.31, dark)
	c:sphere("CrownCap", V(young and 1.97 or 2.26, 0.68, 1.77), V(0, hy + 0.64, 0.95), lapis, head)
	c:leaf(
		"CrownCobra",
		V(0, hy + 0.48, 1.86),
		V(0, hy + (young and 1.1 or 1.48), 1.8),
		young and 0.39 or 0.56,
		c.gold,
		head
	)
	c:sphere("BrowGem", V(0.34, 0.4, 0.18), V(0, hy + 0.41, 1.98), turquoise, head)
	for collar = 1, young and 1 or 3 do
		c:sphere(
			"NeckCollar" .. collar,
			V(young and 1.79 or 2.32, 0.18, 1.63),
			V(0, hy - 0.74 - collar * 0.19, 0.93),
			collar % 2 == 0 and c.gold or lapis,
			body
		)
	end
	local base = V(0.25, by - 0.12, young and -1.57 or -2.37)
	local points = {
		base,
		base + V(1.16, -0.15, -0.3),
		base + V(1.91, 0.64, 0.04),
		base + V(1.9, young and 1.4 or 2.33, 0.5),
		base + V(1.45, young and 1.63 or 2.62, 0.72),
	}
	for segment = 1, young and 3 or 4 do
		c:segment(
			"Tail" .. segment,
			points[segment],
			points[segment + 1],
			young and 0.29 or 0.37,
			0.35,
			ochre,
			body,
			true
		)
	end
	local tip = points[young and 4 or 5]
	c:leaf("TailLotus", tip - V(0, 0.1, 0), tip + V(0.05, 0.61, 0.1), 0.61, lapis, body)
	if s == 3 then
		for rune = 1, 3 do
			c:wedge(
				"HaunchRune" .. rune,
				V(0.2, 0.43, 0.23),
				V(1.73, 1.31 + rune * 0.23, -1.18),
				turquoise,
				body,
				false,
				A(0, 0, rune % 2 == 0 and 0.45 or -0.45)
			)
		end
	end
	return { body = body, head = head }
end

-- Magmaterra: tartaruga maciça, placas em degraus e caldeira vazada no dorso.
function S.magmaterra(c)
	local s, young = c.stage, c.stage == 1
	local basalt, clay, lava = rgb(78, 60, 75), rgb(154, 99, 76), rgb(241, 150, 69)
	local skin, cream, dark = rgb(121, 95, 79), c.cream, c.dark
	local width, length = young and 2.55 or 3.65, young and 2.7 or 4.1
	local body = c:sphere("Body", V(width, 1.62, length), V(0, 1.04, -0.16), skin, c.root, true)
	c:sphere("Plastron", V(width * 0.92, 0.55, length * 0.91), V(0, 0.67, -0.1), cream, body)
	local shell = c:sphere(
		"BasaltShell",
		V(width + 0.56, young and 1.77 or 2.67, length + 0.32),
		V(0, young and 1.75 or 2.04, -0.28),
		basalt,
		body
	)
	for _, side in { -1, 1 } do
		for _, back in { -1, 1 } do
			local hip = V(side * width * 0.39, 0.98, back * length * 0.31)
			local endPos = hip + V(side * 0.43, -0.47, back * 0.11)
			local leg = c:segment(
				"Leg" .. side .. "_" .. back,
				hip,
				endPos,
				young and 0.65 or 0.86,
				young and 0.66 or 0.95,
				skin,
				body,
				true
			)
			paw(
				c,
				"TortoiseFoot" .. side .. "_" .. back,
				endPos + V(0, -0.08, 0.13),
				V(young and 0.76 or 1.01, 0.51, young and 0.83 or 1.09),
				clay,
				leg,
				s >= 2,
				cream
			)
		end
	end
	local hz = length * 0.5 + 0.25
	local head = c:sphere("Head", V(young and 1.59 or 1.89, 1.35, 1.68), V(0, 1.16, hz), skin, body, true)
	c:sphere("LowerJaw", V(young and 1.49 or 1.79, 0.51, 1.22), V(0, 0.85, hz + 0.4), cream, head)
	c:wedge("TurtleBeak", V(0.8, 0.56, 0.65), V(0, 1.03, hz + 0.88), clay, head, false, A(0.12, 0, 0))
	c:eyes(head, V(0, 1.44, hz + 0.6), young and 1.02 or 1.22, young and 0.275 or 0.24, lava, 0.1)
	for _, side in { -1, 1 } do
		c:sphere("Nostril" .. side, V(0.1, 0.08, 0.055), V(side * 0.22, 1.13, hz + 1.15), dark, head)
		c:segment(
			"JawCorner" .. side,
			V(side * 0.36, 0.93, hz + 1.05),
			V(side * 0.69, 1.0, hz + 0.7),
			0.05,
			0.045,
			dark,
			head
		)
	end
	local plates = young and 5 or s == 2 and 8 or 10
	for plate = 1, plates do
		local angle = plate * math.pi * 2 / plates
		local x, z = math.cos(angle) * width * 0.4, math.sin(angle) * length * 0.38
		c:wedge(
			"Scute" .. plate,
			V(young and 0.7 or 1, young and 0.55 or 0.83, young and 0.83 or 1.16),
			V(x, young and 1.95 or 2.4, z - 0.3),
			plate % 2 == 0 and clay or basalt,
			shell,
			false,
			A(0.18, -angle + math.pi / 2, math.cos(angle) * 0.13)
		)
	end
	if not young then
		for seam = 1, 3 do
			local from = V((seam - 2) * 0.48, 3.43, 0.35)
			local middle = from + V((seam - 2) * 0.18, -0.3, 0.9)
			local tip = middle + V((seam - 2) * 0.16, -0.52, 0.55)
			c:segment("LavaVeinA" .. seam, from, middle, 0.095, 0.085, lava, shell)
			c:segment("LavaVeinB" .. seam, middle, tip, 0.08, 0.07, lava, shell)
		end
	end
	local volcanoY = young and 2.8 or s == 2 and 3.55 or 3.94
	local radius = young and 0.52 or s == 2 and 0.73 or 0.96
	if s == 3 then
		for tier = 1, 2 do
			c:sphere(
				"VolcanoTerrace" .. tier,
				V(2.95 - tier * 0.57, 0.58, 2.67 - tier * 0.49),
				V(0, 2.74 + tier * 0.36, -0.45),
				tier == 1 and clay or basalt,
				shell
			)
		end
	end
	c:sphere("CraterInterior", V(radius * 1.62, 0.11, radius * 1.62), V(0, volcanoY - 0.1, -0.42), lava, shell)
	for rim = 1, young and 6 or 8 do
		local angle = rim * math.pi * 2 / (young and 6 or 8)
		c:wedge(
			"CraterRim" .. rim,
			V(radius * 0.73, young and 0.37 or 0.52, radius * 0.56),
			V(math.cos(angle) * radius, volcanoY, -0.42 + math.sin(angle) * radius),
			rim % 2 == 0 and basalt or clay,
			shell,
			false,
			A(0, -angle + math.pi / 2, 0)
		)
	end
	local tail = V(0, 0.92, -length * 0.5)
	c:segment("Tail1", tail, tail + V(0.13, -0.1, -0.8), 0.67, 0.63, skin, body, true)
	c:segment("Tail2", tail + V(0.13, -0.1, -0.8), tail + V(0.35, 0.16, -1.43), 0.39, 0.4, clay, body, true)
	if s == 3 then
		c:wedge("TailHammer", V(1.13, 0.73, 0.86), tail + V(0.39, 0.18, -1.48), basalt, body, false, A(0, 0.24, 0.1))
	end
	return { body = body, head = head }
end

-- Nevoamusgo: cervídeo de bosque, longo pescoço, galhadas de líquen e manto vegetal.
function S.nevoamusgo(c)
	local s, young = c.stage, c.stage == 1
	local bark, moss, light = rgb(85, 107, 86), rgb(124, 155, 100), rgb(178, 195, 132)
	local mist, cream, dark = rgb(173, 157, 189), c.cream, c.dark
	local by = young and 1.42 or s == 2 and 2.03 or 2.4
	local body = c:sphere(
		"Body",
		V(young and 1.96 or 2.62, young and 1.75 or 2, young and 2.54 or 3.47),
		V(0, by, -0.37),
		bark,
		c.root,
		true
	)
	local hy = young and 2.43 or s == 2 and 3.56 or 4.18
	c:segment("WoodlandNeck", V(0, by + 0.28, 0.69), V(0, hy - 0.32, 1.14), young and 1.04 or 1.31, 1.24, cream, body)
	local head =
		c:sphere("Head", V(young and 1.65 or 1.85, young and 1.78 or 2.05, 1.63), V(0, hy, 1.1), moss, body, true)
	c:sphere("Muzzle", V(young and 1.2 or 1.29, 0.82, 1.09), V(0, hy - 0.57, 1.73), cream, head)
	c:sphere("Nose", V(0.51, 0.28, 0.22), V(0, hy - 0.43, 2.26), bark, head)
	c:eyes(head, V(0, hy + 0.15, 1.85), young and 0.99 or 1.12, young and 0.29 or 0.25, mist, -0.12)
	smile(c, head, V(0, hy - 0.77, 2.14), 0.32, dark)
	for _, side in { -1, 1 } do
		c:leaf(
			"Ear" .. side,
			V(side * 0.68, hy + 0.39, 0.96),
			V(side * (young and 1.32 or 1.52), hy + 0.72, 0.62),
			0.69,
			bark,
			head,
			true
		)
		c:leaf(
			"EarInner" .. side,
			V(side * 0.77, hy + 0.42, 1.03),
			V(side * (young and 1.19 or 1.36), hy + 0.66, 0.74),
			0.39,
			light,
			head
		)
		for _, back in { -1, 1 } do
			local hip = V(side * (young and 0.66 or 0.89), by - 0.23, back * (young and 0.81 or 1.13))
			local knee = hip + V(side * 0.05, young and -0.67 or -1.02, back == -1 and -0.16 or 0.14)
			local ankle = knee + V(side * 0.03, young and -0.29 or -0.73, back == -1 and 0.19 or -0.09)
			local leg = c:segment(
				"Leg" .. side .. "_" .. back,
				hip,
				knee,
				young and 0.36 or 0.45,
				young and 0.4 or 0.49,
				bark,
				body,
				true
			)
			c:segment("LowerLeg" .. side .. "_" .. back, knee, ankle, young and 0.26 or 0.31, 0.33, cream, leg)
			c:sphere(
				"Hoof" .. side .. "_" .. back,
				V(young and 0.42 or 0.51, 0.35, 0.62),
				ankle + V(0, -0.08, 0.12),
				bark,
				leg
			)
		end
		local root = V(side * 0.58, hy + 0.75, 0.88)
		local main = root + V(side * (young and 0.14 or 0.4), young and 0.57 or s == 2 and 1.22 or 1.72, -0.18)
		local antler = c:segment("AntlerRoot" .. side, root, main, young and 0.2 or 0.26, 0.25, bark, head)
		if young then
			c:sphere("AntlerBud" .. side, V(0.43, 0.47, 0.43), main, light, antler)
		else
			for branch = 1, s == 3 and 3 or 2 do
				local base = root:Lerp(main, 0.3 + branch * 0.16)
				local tip = base
					+ V(side * (0.49 + branch * 0.12), 0.51 + branch * 0.05, branch % 2 == 0 and -0.44 or 0.1)
				c:segment("AntlerBranch" .. side .. "_" .. branch, base, tip, 0.18, 0.16, bark, antler)
				c:leaf(
					"LichenLeaf" .. side .. "_" .. branch,
					tip - V(0, 0.08, 0),
					tip + V(side * 0.16, 0.34, 0.07),
					0.46,
					branch % 2 == 0 and light or moss,
					antler
				)
				if s == 3 and branch % 2 == 1 then
					c:segment(
						"HangingLichen" .. side .. "_" .. branch,
						tip + V(0, -0.06, 0),
						tip + V(side * 0.13, -0.62, 0.03),
						0.12,
						0.1,
						mist,
						antler
					)
				end
			end
			c:sphere("AntlerMossTip" .. side, V(0.65, 0.47, 0.55), main, light, antler)
		end
	end
	local mantle = c:sphere(
		"MossMantle",
		V(young and 2.1 or 2.97, young and 1.04 or 1.34, young and 2.27 or 3.16),
		V(0, by + 0.65, -0.39),
		moss,
		body
	)
	for tuft = 1, young and 3 or s == 2 and 5 or 7 do
		local angle = tuft * math.pi * 2 / (young and 3 or s == 2 and 5 or 7)
		local start =
			V(math.cos(angle) * (young and 0.79 or 1.13), by + 0.66, -0.39 + math.sin(angle) * (young and 0.83 or 1.12))
		c:leaf(
			"MantleFrond" .. tuft,
			start,
			start + V(math.cos(angle) * 0.24, -0.69, math.sin(angle) * 0.24),
			young and 0.47 or 0.62,
			tuft % 2 == 0 and light or moss,
			mantle
		)
	end
	local tailBase = V(0, by, young and -1.5 or -1.96)
	c:segment("Tail1", tailBase, tailBase + V(0.45, 0.06, -0.63), 0.36, 0.32, bark, body, true)
	c:segment("Tail2", tailBase + V(0.45, 0.06, -0.63), tailBase + V(0.78, 0.52, -0.65), 0.25, 0.24, moss, body, true)
	c:leaf("TailFrond", tailBase + V(0.7, 0.38, -0.64), tailBase + V(1, 0.92, -0.53), 0.65, light, body)
	if s == 3 then
		for spot = 1, 3 do
			c:sphere(
				"MossSpore" .. spot,
				V(0.31, 0.26, 0.3),
				V(-0.73 + spot * 0.45, by + 1.26, -0.65 - spot * 0.31),
				cream,
				mantle
			)
		end
	end
	return { body = body, head = head }
end

return S
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">SculptSky</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Seis anatomias de céu: volumes conectados, olhos legíveis e asas com uma raiz articulada.
local S = {}
local V = Vector3.new
local A = CFrame.Angles
local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end
local navy = rgb(43, 46, 79)
local gold = rgb(247, 184, 75)

local function feet(c, body, y, spread, z, color, heavy)
	for _, side in { -1, 1 } do
		local x = side * spread
		local ankle = V(x, 0.34, z + 0.07)
		local hip = V(x * 0.8, y, z - 0.12)
		local knee = V(x * 0.9, 0.34 + (y - 0.34) * 0.45, z - 0.03)
		local thigh = c:segment(
			"FeatheredThigh" .. side,
			hip,
			knee,
			heavy and 0.66 or 0.48,
			heavy and 0.72 or 0.56,
			heavy and rgb(255, 222, 151) or body.Color,
			body
		)
		for tuft = 1, 2 do
			local from = hip:Lerp(knee, 0.2 + tuft * 0.12) + V(side * 0.12, 0, 0.22)
			c:leaf(
				"HockFeather" .. side .. "_" .. tuft,
				from,
				from + V(side * 0.15, -0.48, 0.09),
				heavy and 0.32 or 0.25,
				heavy and rgb(247, 184, 75) or body.Color,
				thigh
			)
		end
		c:segment("Leg" .. side, knee, ankle, heavy and 0.25 or 0.15, heavy and 0.3 or 0.19, color, body)
		local foot = c:sphere("Foot" .. side, V(heavy and 0.48 or 0.34, 0.22, 0.56), ankle, color, body)
		for toe = 1, 3 do
			c:segment(
				"Toe" .. side .. "_" .. toe,
				ankle + V((toe - 2) * 0.1, -0.05, 0.12),
				ankle + V((toe - 2) * (heavy and 0.28 or 0.18), -0.07, 0.48),
				0.1,
				0.12,
				color,
				foot
			)
		end
	end
end

local function beak(c, head, center, width, length, color)
	c:wedge("UpperBeak", V(width, width * 0.6, length), center, color, head, false, A(0, math.pi, 0))
	c:sphere("LowerBeak", V(width * 0.8, width * 0.2, length * 0.72), center + V(0, -width * 0.24, -0.04), color, head)
	for _, side in { -1, 1 } do
		c:sphere(
			"Nostril" .. side,
			V(0.05, 0.055, 0.07),
			center + V(side * width * 0.22, width * 0.12, length * 0.14),
			navy,
			head
		)
	end
end

-- Leques de penas sobrepostos no plano frontal; ombro e antebraço ficam sob a plumagem.
local function broadWing(c, body, side, shoulder, span, sweep, primary, cover, lining, count, lifted)
	local wing = c:sphere("Wing" .. (side < 0 and "L" or "R"), V(0.42, 0.5, 0.52), shoulder, cover, body, true)
	local folded = lifted <= 0
	local elbow = shoulder + V(side * span * (folded and 0.24 or 0.35), folded and -0.33 or lifted * 0.26, -0.13)
	local wrist = shoulder + V(side * span * (folded and 0.3 or 0.69), folded and -0.78 or lifted * 0.8, -0.25)
	c:segment("WingUpper", shoulder, elbow, 0.48, 0.5, cover, wing)
	c:segment("WingForearm", elbow, wrist, 0.34, 0.4, cover, wing)
	for feather = 1, count do
		local t = (feather - 1) / math.max(1, count - 1)
		local from, tip, width
		if folded then
			from = shoulder + V(side * span * (0.05 + t * 0.18), -0.02 - t * 0.12, 0.02)
			tip = shoulder + V(side * span * (0.16 + t * 0.32), -sweep * (0.67 + t * 0.2), -0.2 - t * 0.15)
			width = math.max(0.42, span * 0.42)
		else
			from = shoulder + V(side * span * (0.05 + t * 0.11), 0.04 + t * 0.28, -0.04 - t * 0.1)
			tip = shoulder
				+ V(
					side * span * (0.4 + math.sin(t * math.pi * 0.5) * 0.62),
					-sweep * 0.25 + t ^ 1.25 * (lifted * 1.6 + sweep * 0.25),
					-0.21 - t * 0.15
				)
			width = math.max(0.45, span * 0.13 + 0.15)
		end
		local featherPart = c:leaf("PrimaryFeather" .. feather, from, tip, width, primary, wing)
		local middleFrom = from + V(0, 0.01, 0.13)
		c:leaf(
			"FeatherMiddle" .. feather,
			middleFrom,
			from:Lerp(tip, 0.77) + V(0, 0.01, 0.13),
			width * 0.82,
			cover,
			featherPart
		)
		c:leaf(
			"FeatherInner" .. feather,
			from + V(0, 0.02, 0.24),
			from:Lerp(tip, 0.42) + V(0, 0.02, 0.24),
			width * 0.63,
			lining,
			featherPart
		)
	end
	for feather = 1, math.max(2, count - 2) do
		local t = feather / math.max(2, count - 2)
		local from = shoulder + V(side * (0.12 + t * span * (folded and 0.12 or 0.27)), t * lifted * 0.25 + 0.1, 0.28)
		local to = from + V(side * 0.15, folded and -0.43 or -0.27, 0.02)
		c:leaf("WingCover" .. feather, from, to, folded and 0.48 or 0.58, cover, wing)
	end
	return wing
end

local function curvedTail(c, body, origin, paths, mainColor, tipColor, width)
	local root = c:sphere("Tail1", V(width * 1.2, width, width), origin, mainColor, body, true)
	for strand, path in paths do
		local previous = origin + V((strand - (#paths + 1) * 0.5) * width * 0.3, 0, 0)
		for index, point in path do
			local overlap = (point - previous) * 0.12
			c:leaf(
				"TailRibbon" .. strand .. "_" .. index,
				previous - overlap,
				point + overlap,
				width * (1 - index / (#path + 2) * 0.4),
				mainColor,
				root
			)
			if index == #path then
				c:leaf(
					"TailTip" .. strand,
					previous:Lerp(point, 0.72),
					point + overlap * 0.3,
					width * 0.43,
					tipColor,
					root
				)
			end
			previous = point
		end
	end
	return root
end

function S.fenixfuligem(c)
	local stage = c.stage
	local soot, wingColor, warm = rgb(66, 51, 75), rgb(108, 72, 91), rgb(230, 120, 79)
	local height = stage == 1 and 1.45 or stage == 2 and 1.8 or 2.15
	local body = c:sphere(
		"Body",
		V(stage == 1 and 1.65 or 1.8, stage == 1 and 1.55 or 2.05, 1.5),
		V(0, height, 0),
		soot,
		c.root,
		true
	)
	c:sphere("WarmBreast", V(1.15, 1.45, 0.46), V(0, height - 0.05, 0.67), warm, body)
	local neck = V(0, height + 0.8, 0.36)
	c:segment("Neck", V(0, height + 0.35, 0.16), neck, 0.94, 0.9, soot, body)
	local head = c:sphere("Head", V(stage == 1 and 1.5 or 1.3, 1.2, 1.16), neck + V(0, 0.4, 0.18), soot, body, true)
	c:eyes(head, neck + V(0, 0.5, 0.7), 0.72, stage == 1 and 0.29 or 0.24, gold, -0.09)
	beak(c, head, neck + V(0, 0.13, 1.0), 0.46, 0.67, rgb(214, 157, 91))
	for _, side in { -1, 1 } do
		c:segment(
			"AshBrow" .. side,
			neck + V(side * 0.3, 0.77, 0.66),
			neck + V(side * 0.59, 0.9, 0.45),
			0.17,
			0.15,
			wingColor,
			head
		)
		local crownBase = neck + V(side * 0.29, 0.86, 0.03)
		c:leaf("AshCrest" .. side, crownBase, crownBase + V(side * 0.32, 0.55 + stage * 0.15, -0.32), 0.25, warm, head)
		local shoulder = V(side * 0.76, height + 0.25, 0.02)
		broadWing(
			c,
			body,
			side,
			shoulder,
			stage == 1 and 1.0 or stage == 2 and 1.7 or 2.6,
			stage == 1 and 0.9 or 1.4,
			soot,
			wingColor,
			warm,
			stage + 2,
			stage == 3 and 0.62 or -0.4
		)
	end
	feet(c, body, height - 0.35, stage == 1 and 0.38 or 0.47, 0.08, rgb(181, 116, 75), false)
	local tailOrigin = V(0, height - 0.45, -0.58)
	local paths = {}
	for strand = 1, stage + 1 do
		local x = (strand - (stage + 2) / 2) * 0.35
		paths[strand] = { V(x, height - 0.68, -1.3), V(x * 1.7, height - 0.8, -1.7 - stage * 0.27) }
	end
	curvedTail(c, body, tailOrigin, paths, soot, warm, 0.35)
	if stage >= 2 then
		for i = 1, stage + 1 do
			c:sphere(
				"EmberBreast" .. i,
				V(0.11, 0.16, 0.05),
				V((i - (stage + 2) / 2) * 0.21, height - 0.22, 0.93),
				gold,
				body
			)
		end
	end
	return { body = body, head = head }
end

function S.penugem(c)
	local stage = c.stage
	local down, blue, buff = rgb(246, 232, 199), rgb(135, 170, 192), rgb(222, 174, 126)
	local y = stage == 1 and 1.1 or stage == 2 and 1.3 or 1.5
	local body = c:sphere(
		"Body",
		V(stage == 1 and 1.9 or 2.05, stage == 1 and 1.7 or 2.05, 1.65),
		V(0, y, 0),
		blue,
		c.root,
		true
	)
	c:sphere("DownApron", V(1.48, 1.55, 0.55), V(0, y - 0.08, 0.67), down, body)
	local headCenter = V(0, y + 0.88, 0.23)
	local head = c:sphere("Head", V(stage == 1 and 1.8 or 1.88, 1.52, 1.48), headCenter, blue, body, true)
	for _, side in { -1, 1 } do
		c:sphere("FaceDisk" .. side, V(0.88, 1.08, 0.32), headCenter + V(side * 0.43, -0.02, 0.61), down, head)
		c:leaf(
			"EarTuft" .. side,
			headCenter + V(side * 0.58, 0.48, -0.02),
			headCenter + V(side * 0.87, stage == 1 and 0.89 or 1.22, -0.18),
			stage == 1 and 0.32 or 0.43,
			blue,
			head
		)
		c:leaf(
			"InnerTuft" .. side,
			headCenter + V(side * 0.6, 0.58, 0.05),
			headCenter + V(side * 0.82, stage == 1 and 0.89 or 1.09, -0.1),
			0.18,
			down,
			head
		)
		local shoulder = V(side * 0.82, y + 0.27, -0.05)
		if stage == 1 then
			local wing =
				c:sphere("Wing" .. side, V(0.6, 0.93, 0.58), shoulder + V(side * 0.06, -0.24, 0.12), down, body, true)
			c:sphere("WingTip", V(0.33, 0.51, 0.39), shoulder + V(side * 0.07, -0.61, 0.23), blue, wing)
		else
			broadWing(
				c,
				body,
				side,
				shoulder,
				stage == 2 and 1.4 or 2.0,
				1.3,
				blue,
				down,
				buff,
				stage == 2 and 3 or 4,
				-0.26
			)
		end
	end
	c:eyes(head, headCenter + V(0, 0.06, 0.84), 0.88, stage == 1 and 0.3 or 0.28, rgb(91, 126, 151), -0.04)
	beak(c, head, headCenter + V(0, -0.29, 1.03), 0.26, 0.36, buff)
	feet(c, body, 0.65, 0.39, 0.13, buff, false)
	curvedTail(c, body, V(0, y - 0.44, -0.6), {
		{ V(-0.35, y - 0.48, -1.1), V(-0.55, y - 0.32, -1.42) },
		{ V(0, y - 0.48, -1.28), V(0, y - 0.12, -1.65) },
		{ V(0.35, y - 0.48, -1.1), V(0.55, y - 0.32, -1.42) },
	}, blue, down, 0.32)
	if stage == 3 then
		for i = 1, 3 do
			c:sphere("ApronScallop" .. i, V(0.37, 0.28, 0.12), V((i - 2) * 0.35, y - 0.38, 0.97), buff, body)
		end
	end
	return { body = body, head = head }
end

function S.ventanil(c)
	local stage = c.stage
	local teal, pale, lavender = rgb(74, 149, 171), rgb(208, 233, 220), rgb(150, 133, 190)
	local y = stage == 1 and 1.3 or stage == 2 and 1.7 or 2.05
	local body = c:sphere(
		"Body",
		V(stage == 1 and 1.45 or 1.5, 1.5, stage == 1 and 1.7 or 2.25),
		V(0, y, -0.2),
		teal,
		c.root,
		true,
		A(-0.12, 0, 0)
	)
	c:sphere("Breast", V(1.05, 1.2, 0.48), V(0, y + 0.05, 0.73), pale, body)
	local neckTop = V(0, y + (stage == 1 and 0.8 or 1.5), 0.75)
	c:segment("NeckBase", V(0, y + 0.4, 0.47), V(0, y + 0.88, 0.63), 0.68, 0.7, pale, body)
	c:segment("NeckArch", V(0, y + 0.72, 0.62), neckTop, stage == 1 and 0.55 or 0.48, 0.54, pale, body)
	local head = c:sphere("Head", V(1.0, 0.93, 1.17), neckTop + V(0, 0.18, 0.1), teal, body, true)
	c:eyes(head, neckTop + V(0, 0.24, 0.65), 0.59, 0.2, lavender, -0.04)
	beak(
		c,
		head,
		neckTop + V(0, -0.02, stage == 1 and 0.92 or 1.07),
		0.27,
		stage == 1 and 0.55 or 0.96,
		rgb(227, 179, 116)
	)
	for _, side in { -1, 1 } do
		local from = neckTop + V(side * 0.2, 0.54, -0.15)
		c:leaf(
			"WindCrest" .. side,
			from,
			from + V(side * (0.1 + stage * 0.12), 0.18, -0.65 - stage * 0.12),
			0.18,
			pale,
			head
		)
		broadWing(
			c,
			body,
			side,
			V(side * 0.61, y + 0.2, 0),
			stage == 1 and 1.05 or stage == 2 and 1.9 or 3.0,
			stage == 1 and 1.0 or 1.6,
			teal,
			pale,
			lavender,
			stage + 2,
			stage == 3 and 0.7 or -0.1
		)
	end
	feet(c, body, y - 0.3, stage == 1 and 0.3 or 0.37, 0.3, rgb(174, 135, 125), false)
	local paths = {}
	for strand = 1, stage == 1 and 2 or 3 do
		local x = (strand - (stage == 1 and 1.5 or 2)) * 0.32
		paths[strand] = {
			V(x, y - 0.15, -1.48),
			V(x * 1.7, y - 0.38, -2.0 - stage * 0.15),
			V(x * 2 + 0.35, y + 0.08, -2.6 - stage * 0.2),
		}
	end
	curvedTail(c, body, V(0, y - 0.2, -0.98), paths, pale, lavender, 0.24)
	return { body = body, head = head }
end

function S.aeronimbo(c)
	local stage = c.stage
	local blue, cloud, mauve = rgb(133, 162, 193), rgb(245, 235, 211), rgb(180, 152, 199)
	local y = stage == 1 and 1.1 or stage == 2 and 1.5 or 1.8
	local body = c:sphere("Body", V(1.45, 1.35, stage == 1 and 1.8 or 2.0), V(0, y, 0), blue, c.root, true)
	local tail = c:sphere("Tail1", V(0.9, 0.85, 0.9), V(0, y, -0.72), blue, body, true)
	local steps = stage == 1 and 3 or stage == 2 and 5 or 7
	local previous = V(0, y, -0.5)
	for i = 1, steps do
		local t = i / steps
		local point = V(
			math.sin(t * math.pi * 1.65) * (0.45 + stage * 0.24),
			y + math.sin(t * math.pi) * 0.35,
			-0.55 - t * (1.5 + stage * 0.82)
		)
		c:segment("Coil" .. i, previous, point, 1.05 - t * 0.7, 1.1 - t * 0.7, blue, tail)
		if i % 2 == 0 then
			c:sphere("CloudBack" .. i, V(0.78 - t * 0.25, 0.44, 0.65), point + V(0, 0.38, 0), cloud, tail)
		end
		previous = point
	end
	for _, side in { -1, 1 } do
		c:leaf(
			"CloudTailFin" .. side,
			previous,
			previous + V(side * (0.5 + stage * 0.1), 0.22, -0.8),
			0.55,
			mauve,
			tail
		)
	end
	local headCenter = V(0, y + (stage == 1 and 0.75 or 1.15), 1.0)
	c:segment("CloudNeck", V(0, y + 0.35, 0.4), headCenter + V(0, -0.15, -0.12), 1.0, 1.04, blue, body)
	local head = c:sphere("Head", V(stage == 1 and 1.8 or 1.9, 1.3, 1.55), headCenter, blue, body, true)
	c:sphere("CreamMuzzle", V(1.2, 0.69, 0.74), headCenter + V(0, -0.26, 0.74), cloud, head)
	c:sphere("Nose", V(0.33, 0.2, 0.19), headCenter + V(0, -0.1, 1.1), mauve, head)
	c:eyes(head, headCenter + V(0, 0.15, 0.71), 1.02, stage == 1 and 0.26 or 0.23, rgb(95, 121, 165), -0.1)
	for _, side in { -1, 1 } do
		local earBase = headCenter + V(side * 0.63, 0.35, -0.2)
		c:leaf(
			"CloudEar" .. side,
			earBase,
			earBase + V(side * 0.42, stage == 1 and 0.5 or 0.75, -0.42),
			0.48,
			mauve,
			head
		)
		c:leaf(
			"CloudEarInner" .. side,
			earBase + V(0, 0.06, 0.05),
			earBase + V(side * 0.3, 0.58, -0.22),
			0.27,
			cloud,
			head
		)
		c:sphere("CollarCloud" .. side, V(1.04, 0.72, 0.87), V(side * 0.69, y + 0.44, 0.29), cloud, body)
		c:sphere("CheekCloud" .. side, V(0.61, 0.48, 0.49), headCenter + V(side * 0.78, -0.28, 0.34), cloud, head)
		if stage >= 2 then
			local whisker = headCenter + V(side * 0.62, -0.18, 0.91)
			c:segment("CloudWhisker" .. side, whisker, whisker + V(side * 0.63, 0.16, -0.13), 0.11, 0.12, gold, head)
			c:segment(
				"WhiskerCurl" .. side,
				whisker + V(side * 0.61, 0.16, -0.13),
				whisker + V(side * 0.76, 0.43, -0.23),
				0.08,
				0.09,
				gold,
				head
			)
		end
		if stage == 3 then
			local horn = headCenter + V(side * 0.49, 0.55, -0.35)
			c:segment("CloudAntler" .. side, horn, horn + V(side * 0.2, 0.9, -0.43), 0.16, 0.18, gold, head)
			c:segment(
				"CloudAntlerBranch" .. side,
				horn + V(side * 0.1, 0.46, -0.2),
				horn + V(side * 0.58, 0.7, -0.43),
				0.11,
				0.12,
				gold,
				head
			)
		end
	end
	for i = 1, 3 do
		c:sphere(
			"CloudCrown" .. i,
			V(0.77, 0.55 + (i == 2 and 0.16 or 0), 0.82),
			headCenter + V((i - 2) * 0.5, 0.62, -0.13),
			cloud,
			head
		)
	end
	if stage >= 2 then
		for _, side in { -1, 1 } do
			for limb = 1, 2 do
				local start = V(side * 0.57, y - 0.15, limb == 1 and 0.39 or -0.51)
				c:segment("Leg" .. side .. limb, start, start + V(side * 0.17, -0.65, 0.22), 0.27, 0.3, blue, body)
				c:sphere(
					"CloudPaw" .. side .. limb,
					V(0.45, 0.28, 0.56),
					start + V(side * 0.17, -0.65, 0.34),
					cloud,
					body
				)
			end
		end
	end
	return { body = body, head = head }
end

function S.tempestalia(c)
	local stage = c.stage
	local storm, sky, lilac = rgb(66, 91, 137), rgb(150, 204, 219), rgb(151, 109, 173)
	local y = stage == 1 and 1.35 or stage == 2 and 1.75 or 2.05
	local body = c:sphere("Body", V(1.75, stage == 1 and 1.55 or 2.1, 1.62), V(0, y, 0), storm, c.root, true)
	c:sphere("StormBreast", V(1.2, 1.45, 0.5), V(0, y - 0.04, 0.69), sky, body)
	local headCenter = V(0, y + 1.05, 0.35)
	c:segment("Neck", V(0, y + 0.48, 0.12), headCenter, 0.97, 0.95, storm, body)
	local head = c:sphere("Head", V(1.4, 1.23, 1.34), headCenter, sky, body, true)
	c:eyes(head, headCenter + V(0, 0.13, 0.64), 0.81, stage == 1 and 0.26 or 0.22, gold, 0.07)
	beak(c, head, headCenter + V(0, -0.2, 0.94), 0.35, 0.62, gold)
	for _, side in { -1, 1 } do
		c:leaf(
			"StormCheek" .. side,
			headCenter + V(side * 0.47, -0.12, 0.27),
			headCenter + V(side * 0.86, 0.05, -0.35),
			0.36,
			lilac,
			head
		)
		local shoulder = V(side * 0.72, y + 0.4, -0.02)
		broadWing(
			c,
			body,
			side,
			shoulder,
			stage == 1 and 1.1 or stage == 2 and 2.0 or 3.1,
			stage == 1 and 1.0 or 1.8,
			storm,
			sky,
			lilac,
			stage + 3,
			stage == 3 and 1.25 or 0.12
		)
		if stage >= 2 then
			c:leaf(
				"StormMantle" .. side,
				V(side * 0.45, y + 0.65, 0.42),
				V(side * 0.76, y - 0.38, 0.8),
				0.42,
				lilac,
				body
			)
		end
	end
	for crown = 1, stage == 1 and 3 or 5 do
		local t = crown - (stage == 1 and 2 or 3)
		local start = headCenter + V(t * 0.18, 0.49, -0.15)
		local peak = start + V(t * 0.18, 0.55 + (2 - math.abs(t)) * 0.18, -0.31)
		c:leaf("StormCrown" .. crown, start, peak, 0.2, gold, head)
		c:sphere("CrownBead" .. crown, V(0.14, 0.18, 0.14), peak, sky, head)
	end
	feet(c, body, y - 0.4, 0.44, 0.12, rgb(183, 144, 111), false)
	local tailOrigin = V(0, y - 0.5, -0.68)
	local paths = {}
	for strand = 1, stage + 2 do
		local x = (strand - (stage + 3) / 2) * 0.25
		paths[strand] = { V(x, y - 0.65, -1.5), V(x * 1.6, y - 0.9, -2.0 - (1 - math.abs(x)) * 0.5) }
	end
	local tail = curvedTail(c, body, tailOrigin, paths, lilac, sky, 0.31)
	if stage == 3 then
		for _, side in { -1, 1 } do
			c:segment(
				"RainStripe" .. side,
				V(side * 0.23, y - 0.6, -1.5),
				V(side * 0.39, y - 0.82, -2.35),
				0.1,
				0.07,
				gold,
				tail
			)
		end
	end
	return { body = body, head = head }
end

function S.fenix(c)
	-- A Fênix já nasce adulta: não se cria uma forma infantil para a espécie lendária.
	local crimson, scarlet, orange = rgb(143, 39, 70), rgb(209, 64, 72), rgb(239, 117, 61)
	local cream, sunlight = rgb(255, 233, 171), rgb(255, 196, 72)
	local body = c:sphere("Body", V(2.05, 2.85, 1.95), V(0, 2.6, 0), crimson, c.root, true, A(-0.13, 0, 0))
	c:sphere("SolarBreast", V(1.52, 2.34, 0.72), V(0, 2.78, 0.86), cream, body, false, A(-0.12, 0, 0))
	c:segment("NeckLower", V(0, 3.5, 0.26), V(0, 4.2, 0.74), 1.04, 1.08, cream, body)
	c:segment("NeckSwan", V(0, 4.04, 0.7), V(0, 4.84, 0.63), 0.78, 0.86, cream, body)
	local headCenter = V(0, 5.01, 0.85)
	local head = c:sphere("Head", V(1.32, 1.23, 1.52), headCenter, scarlet, body, true, A(-0.06, 0, 0))
	c:sphere("SolarMask", V(1.09, 0.79, 0.35), headCenter + V(0, -0.05, 0.68), orange, head)
	c:eyes(head, headCenter + V(0, 0.15, 0.76), 0.77, 0.21, sunlight, 0.08)
	beak(c, head, headCenter + V(0, -0.16, 1.16), 0.35, 0.9, sunlight)
	for _, side in { -1, 1 } do
		local jaw = headCenter + V(side * 0.43, -0.27, 0.2)
		c:leaf("SolarCheek" .. side, jaw, jaw + V(side * 0.32, -0.11, -0.51), 0.26, cream, head)
		local crest = headCenter + V(side * 0.22, 0.43, -0.17)
		c:leaf("SolarCrest" .. side, crest, crest + V(side * 0.34, 1.01, -0.64), 0.3, sunlight, head)
		c:leaf(
			"SolarCrestFlame" .. side,
			crest + V(0, 0.05, -0.15),
			crest + V(side * 0.51, 0.64, -0.97),
			0.29,
			scarlet,
			head
		)
		local shoulder = V(side * 0.88, 3.47, -0.05)
		local wing = broadWing(c, body, side, shoulder, 4.7, 2.65, scarlet, orange, sunlight, 8, 2.5)
		for cover = 1, 4 do
			local t = cover / 4
			local from = shoulder + V(side * (0.3 + t * 1.2), t * 0.53, 0.24)
			c:segment(
				"GoldenShoulderFeather" .. cover,
				from,
				from + V(side * 0.36, -0.2, -0.75),
				0.44,
				0.22,
				cream,
				wing
			)
		end
		c:leaf("FlameMantle" .. side, V(side * 0.5, 3.65, 0.52), V(side * 0.85, 2.45, 1.0), 0.45, sunlight, body)
	end
	for i = 1, 5 do
		local from = V((i - 3) * 0.18, 3.0, 1.17)
		c:leaf(
			"ChestFeather" .. i,
			from,
			from + V((i - 3) * 0.12, -0.74, -0.02),
			0.25,
			i % 2 == 0 and sunlight or cream,
			body
		)
	end
	feet(c, body, 1.55, 0.5, 0.16, sunlight, true)
	local origin = V(0, 2.0, -0.64)
	local paths = {}
	for strand = 1, 7 do
		local x = (strand - 4) * 0.31
		paths[strand] = {
			V(x, 1.43, -1.65),
			V(x * 1.8, 0.69 + math.abs(x) * 0.2, -2.8),
			V(x * 2.35 + 0.2, 0.8 + math.abs(x) * 0.25, -3.8),
			V(x * 2.5 + 0.65, 1.67 + math.abs(x) * 0.3, -4.48),
		}
	end
	local tail = curvedTail(c, body, origin, paths, scarlet, sunlight, 0.62)
	for strand = 1, 3 do
		local x = (strand - 2) * 0.44
		c:segment("SolarTrainInlay" .. strand, V(x, 1.39, -1.65), V(x * 1.8, 0.79, -2.79), 0.15, 0.08, sunlight, tail)
		c:segment(
			"SolarTrainInlayCurl" .. strand,
			V(x * 1.8, 0.79, -2.79),
			V(x * 2.35 + 0.2, 0.9, -3.78),
			0.12,
			0.08,
			orange,
			tail
		)
	end
	local haloCenter = headCenter + V(0, 0.42, -0.71)
	local radius = 1.4
	for i = 1, 16 do
		local angle = (i - 1) * math.pi * 2 / 16
		local nextAngle = i * math.pi * 2 / 16
		local from = haloCenter + V(math.cos(angle) * radius, math.sin(angle) * radius, 0)
		local to = haloCenter + V(math.cos(nextAngle) * radius, math.sin(nextAngle) * radius, 0)
		c:segment("HaloArc" .. i, from, to, 0.11, 0.12, sunlight, head)
		if i % 2 == 0 then
			local rayFrom = haloCenter + V(math.cos(angle) * 1.43, math.sin(angle) * 1.43, 0)
			local rayTo = haloCenter + V(math.cos(angle) * 1.75, math.sin(angle) * 1.75, 0)
			c:leaf("HaloRay" .. i, rayFrom, rayTo, 0.17, sunlight, head)
		end
	end
	return { body = body, head = head }
end

return S
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">SculptTidal</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Anatomias autorais de maré e artrópodes. Coordenadas locais: +Z é a frente.
local S = {}
local C = Color3.fromRGB
local pearl = C(244, 221, 192)
local lagoon = C(82, 184, 183)
local rose = C(220, 133, 158)
local lavender = C(141, 137, 203)
local coral = C(229, 149, 115)
local function mouth(c, head, center, width, color)
	local V = c.V
	c:segment("Mouth", center + V(-width * 0.5, 0.03, 0), center + V(0, -0.04, 0.03), 0.065, 0.06, color, head)
	c:segment("MouthSmile", center + V(0, -0.04, 0.03), center + V(width * 0.5, 0.03, 0), 0.065, 0.06, color, head)
end

function S.bolhinho(c)
	local V, A, s = c.V, c.A, c.stage
	local baby = s == 1
	local blue = C(99, 176, 190)
	local mint = C(162, 222, 210)
	local body = c:sphere(
		"Body",
		V(baby and 2.8 or 3.3, baby and 2.5 or 2.8, baby and 2.7 or 3.4),
		V(0, 1.65, -0.25),
		blue,
		c.root,
		true
	)
	c:sphere("Tummy", V(2.65, 1.9, 1.8), V(0, 1.25, 0.43), pearl, body)
	local head =
		c:sphere("Head", V(baby and 2.5 or 2.85, 2.3, 2.25), V(0, baby and 2.08 or 2.23, 1.03), mint, body, true)
	c:eyes(head, V(0, 2.43, 2.05), 1.39, baby and 0.35 or 0.31, lagoon, -0.05)
	c:sphere("Muzzle", V(1.28, 0.58, 0.65), V(0, 1.72, 2.03), pearl, head)
	mouth(c, head, V(0, 1.62, 2.34), 0.6, c.dark)
	for _, side in { -1, 1 } do
		c:sphere("Cheek" .. side, V(0.51, 0.23, 0.15), V(side * 0.95, 1.94, 2.0), coral, head)
		local shoulder = V(side * 1.35, 1.55, 0.25)
		local tip = V(side * (baby and 2.02 or 2.7), 0.88, baby and 0.3 or -0.5)
		local fin = c:leaf("Fin" .. side, shoulder, tip, baby and 0.78 or 1.2, lagoon, body, true)
		c:segment("FinRib" .. side, shoulder, tip, 0.12, 0.1, pearl, fin)
		for feather = 1, s + 1 do
			local from = V(side * 1.14, 2.13 + feather * 0.12, 0.95 - feather * 0.3)
			c:leaf(
				"Gill" .. side .. "_" .. feather,
				from,
				from + V(side * (0.5 + s * 0.13), 0.28, -0.27),
				0.42,
				feather % 2 == 0 and lavender or coral,
				head
			)
		end
		c:sphere(
			"PaddleToe" .. side,
			V(0.8, 0.34, 0.95),
			V(side * 0.8, 0.28, 0.42),
			mint,
			body,
			true,
			A(0, side * 0.2, 0)
		)
	end
	local tailFrom, tailTo = V(0, 1.4, -1.48), V(0, 1.77, baby and -2.18 or -3.15)
	local tail = c:segment("Tail", tailFrom, tailTo, 0.7, 0.7, blue, body, true)
	for _, side in { -1, 1 } do
		c:leaf("TailFan" .. side, tailTo, tailTo + V(side * (baby and 0.7 or 1.15), 0.55, -0.45), 0.72, mint, tail)
	end
	local crown = s == 3 and 5 or s
	for i = 1, crown do
		local x = (i - (crown + 1) * 0.5) * 0.32
		c:leaf(
			"DorsalCrest" .. i,
			V(x, 2.78, -0.5),
			V(x * 1.5, 3.33 + (crown * 0.5 - math.abs(i - (crown + 1) * 0.5)) * 0.18, -0.9),
			0.45,
			i % 2 == 0 and pearl or lagoon,
			body
		)
	end
	for i = 1, 3 + s do
		local side = i % 2 == 0 and -1 or 1
		c:sphere(
			"WaterSpot" .. i,
			V(0.2, 0.24, 0.09),
			V(side * (1.05 + (i % 2) * 0.15), 1.65 + (i % 3) * 0.22, 1.43 - math.floor(i / 2) * 0.23),
			pearl,
			head
		)
	end
	return { body = body, head = head }
end

function S.marilisco(c)
	local V, s = c.V, c.stage
	local teal = C(70, 145, 158)
	local pale = C(167, 217, 199)
	local body = c:sphere("Body", V(2.1, 1.65, 2.35), V(0, 1.05, 0.47), teal, c.root, true)
	local head = c:sphere("Head", V(s == 1 and 1.95 or 2.1, 1.6, 1.98), V(0, 1.62, 1.98), pale, body, true)
	c:sphere("Snout", V(1.52, 0.69, 1.15), V(0, 1.29, 2.7), pearl, head)
	c:eyes(head, V(0, 1.92, 2.77), 1.1, s == 1 and 0.32 or 0.28, C(204, 151, 91), 0.05)
	mouth(c, head, V(0, 1.13, 3.2), 0.8, c.dark)
	for _, side in { -1, 1 } do
		c:sphere("Nostril" .. side, V(0.12, 0.1, 0.06), V(side * 0.32, 1.53, 3.2), c.dark, head)
		c:leaf(
			"GillFan" .. side,
			V(side * 0.82, 1.64, 1.85),
			V(side * (1.42 + s * 0.15), 2.11, 1.14),
			0.72,
			lavender,
			head
		)
		local fin = c:leaf(
			"Fin" .. side,
			V(side * 0.78, 0.91, 0.78),
			V(side * (1.7 + 0.2 * s), 0.28, -0.25),
			0.98,
			pale,
			body,
			true
		)
		c:segment(
			"FinVein" .. side,
			V(side * 0.9, 0.9, 0.68),
			V(side * (1.55 + 0.2 * s), 0.35, -0.15),
			0.1,
			0.1,
			pearl,
			fin
		)
	end
	local previous, parent = V(0, 1.04, -0.2), body
	local count = s == 1 and 4 or s == 2 and 6 or 8
	for i = 1, count do
		local t = i / count
		local nextPos = V(
			math.sin(t * math.pi * 1.6) * (0.5 + s * 0.25),
			0.85 + math.sin(t * math.pi) * 0.31,
			-0.2 - t * (3.3 + s * 0.85)
		)
		local width = 1.62 * (1 - t * 0.76)
		local segment =
			c:segment("Coil" .. i, previous, nextPos, width, width * 0.87, i % 2 == 0 and pale or teal, parent, true)
		if i < count then
			c:leaf(
				"DorsalSail" .. i,
				nextPos,
				nextPos + V(0, 0.55 + math.sin(t * math.pi) * (0.38 + s * 0.18), -0.48),
				0.54 + s * 0.09,
				i % 2 == 0 and lagoon or lavender,
				segment
			)
		end
		previous, parent = nextPos, segment
	end
	for _, side in { -1, 1 } do
		c:leaf("TailBlade" .. side, previous, previous + V(side * (0.68 + s * 0.17), 0.5, -0.6), 0.78, pale, parent)
		if s >= 2 then
			local base = V(side * 0.73, 2.05, 1.95)
			local fork = V(side * 1.03, 2.64 + s * 0.1, 1.35)
			c:segment("CrownStem" .. side, base, fork, 0.17, 0.17, pearl, head)
			c:leaf("CrownSail" .. side, fork, fork + V(side * 0.24, 0.4, -0.45), 0.45, lagoon, head)
		end
	end
	return { body = body, head = head }
end

function S.carangueperola(c)
	local V, s = c.V, c.stage
	local shell = C(160, 148, 191)
	local cream = C(244, 220, 184)
	local body = c:sphere("Body", V(s == 1 and 2.85 or 3.5, 1.65, 2.8), V(0, 1.15, -0.05), shell, c.root, true)
	c:sphere("ShellRim", V(3.12, 0.45, 2.65), V(0, 1.9, -0.17), cream, body)
	local dome =
		c:sphere("PearlDome", V(s == 1 and 1.8 or 2.38, s == 3 and 2.25 or 1.9, 2.16), V(0, 2.02, -0.18), pearl, body)
	c:sphere("PearlIridescence", V(1.2, 0.55, 0.16), V(-0.48, 2.67, 0.58), C(185, 220, 222), dome)
	c:sphere("PearlHighlight", V(0.56, 0.38, 0.1), V(-0.53, 2.84, 0.54), c.cream, dome)
	local head = c:sphere("Head", V(2.35, 1.25, 1.62), V(0, 1.05, 1.28), cream, body, true)
	for _, side in { -1, 1 } do
		c:segment("EyeStalk" .. side, V(side * 0.62, 1.41, 1.6), V(side * 0.72, 2.04, 1.77), 0.26, 0.26, shell, head)
	end
	c:eyes(head, V(0, 2.07, 1.82), 1.5, s == 1 and 0.33 or 0.31, C(98, 172, 186), -0.07)
	mouth(c, head, V(0, 0.99, 2.04), 0.72, c.dark)
	local pairs = s == 1 and 2 or s == 2 and 3 or 4
	for _, side in { -1, 1 } do
		for leg = 1, pairs do
			local z = 1.0 - (leg - 1) * 0.63
			local hip, elbow = V(side * 1.23, 1.24, z), V(side * (2.05 + leg * 0.08), 0.82, z - 0.2)
			local foot = V(side * (2.5 + leg * 0.09), 0.16, z - 0.48)
			local upper = c:segment("LegUpper" .. side .. "_" .. leg, hip, elbow, 0.43, 0.48, shell, body, true)
			local lower = c:segment("LegLower" .. side .. "_" .. leg, elbow, foot, 0.27, 0.31, cream, upper, true)
			c:sphere("LegKnuckle" .. side .. "_" .. leg, V(0.46, 0.43, 0.44), elbow, lagoon, upper)
			c:leaf(
				"LegToe" .. side .. "_" .. leg,
				foot + V(-side * 0.06, 0.1, 0),
				foot + V(side * 0.23, -0.06, -0.17),
				0.27,
				cream,
				lower
			)
		end
		local elbow = V(side * (s == 1 and 1.63 or 2.02), 1.21, 2.0)
		local arm = c:segment("ClawArm" .. side, V(side * 0.95, 1.15, 1.21), elbow, 0.56, 0.56, shell, body, true)
		local palm =
			c:sphere("ClawPalm" .. side, V(0.93, 0.86, 1.2), elbow + V(side * 0.19, 0.1, 0.43), cream, arm, true)
		local base = elbow + V(side * 0.22, 0.13, 0.7)
		c:leaf(
			"ClawUpper" .. side,
			base + V(-side * 0.23, 0.23, 0),
			base + V(side * 0.14, 0.13, 0.85),
			0.54,
			lagoon,
			palm
		)
		c:leaf(
			"ClawThumb" .. side,
			base + V(side * 0.23, -0.2, 0),
			base + V(side * 0.14, -0.06, 0.65),
			0.37,
			cream,
			palm
		)
		c:sphere("ClawPearl" .. side, V(0.29, 0.28, 0.27), elbow + V(side * 0.22, 0.54, 0.52), pearl, palm)
	end
	for i = 1, s == 1 and 3 or 5 do
		local a = i * math.pi * 2 / (s == 1 and 3 or 5)
		c:sphere(
			"RimPearl" .. i,
			V(0.3, 0.32, 0.3),
			V(math.cos(a) * 1.25, 1.98, math.sin(a) * 0.97 - 0.18),
			i % 2 == 0 and rose or lagoon,
			body
		)
	end
	if s >= 2 then
		for _, side in { -1, 1 } do
			local base = V(side * 0.94, 1.95, -0.74)
			local fork = base + V(side * 0.22, 0.75 + 0.12 * s, -0.11)
			c:segment("CoralTrunk" .. side, base, fork, 0.19, 0.21, rose, body)
			for branch = 1, s do
				local tip = fork + V(side * (0.2 + branch * 0.14), 0.28 + branch * 0.12, (branch - 1.5) * 0.24)
				c:segment("CoralBranch" .. side .. "_" .. branch, fork, tip, 0.13, 0.13, rose, body)
				c:sphere("CoralPolyp" .. side .. "_" .. branch, V(0.24, 0.24, 0.24), tip, coral, body)
			end
		end
	end
	return { body = body, head = head }
end

function S.abissauro(c)
	local V, s = c.V, c.stage
	local blue = C(61, 91, 125)
	local lilac = C(126, 139, 190)
	local glow = C(160, 220, 194)
	local body = c:sphere("Body", V(3.4, 2.5, s == 1 and 3.5 or 4.8), V(0, 1.65, -0.4), blue, c.root, true)
	c:sphere("Belly", V(2.55, 1.3, 3.5), V(0, 0.9, -0.2), lilac, body)
	local head = c:sphere("Head", V(s == 1 and 3.0 or 3.7, 2.5, 2.75), V(0, 1.91, 1.82), lilac, body, true)
	local jaw = c:sphere("LowerJaw", V(3.2, 0.72, 2.25), V(0, 0.91, 2.55), pearl, head)
	c:sphere("MouthCavity", V(2.65, 1.0, 0.19), V(0, 1.36, 3.16), blue, head)
	c:segment("MouthUpperRim", V(-1.27, 1.82, 3.07), V(1.27, 1.82, 3.07), 0.22, 0.2, glow, head)
	c:eyes(head, V(0, 2.44, 2.9), 2.05, s == 1 and 0.36 or 0.33, C(224, 174, 90), 0.12)
	for _, side in { -1, 1 } do
		c:sphere("NoseRidge" .. side, V(0.62, 0.38, 0.56), V(side * 0.65, 2.0, 3.05), blue, head)
		local shoulder = V(side * 1.43, 1.37, 0.75)
		local fin = c:leaf("Fin" .. side, shoulder, V(side * (2.2 + s * 0.3), 0.37, 0.1), 1.3, glow, body, true)
		c:segment("FinRib" .. side, shoulder, V(side * (2.1 + s * 0.3), 0.44, 0.22), 0.22, 0.15, blue, fin)
		for gill = 1, s + 1 do
			c:leaf(
				"GillRidge" .. side .. "_" .. gill,
				V(side * 1.47, 1.65, 1.25 - gill * 0.36),
				V(side * 1.85, 1.02, 0.95 - gill * 0.36),
				0.37,
				gill % 2 == 0 and pearl or glow,
				head
			)
		end
		for tooth = 1, s + 1 do
			local x = side * (0.4 + tooth * 0.24)
			c:leaf("UpperTooth" .. side .. "_" .. tooth, V(x, 1.75, 3.19), V(x * 0.96, 1.4, 3.26), 0.2, pearl, head)
		end
		c:leaf("JawTusk" .. side, V(side * 1.12, 1.05, 3.08), V(side * 1.19, 1.38, 3.25), 0.24, glow, jaw)
	end
	local count = s == 1 and 3 or 4 + s
	local previous, parent = V(0, 1.48, -1.35), body
	for i = 1, count do
		local t = i / count
		local nextPos = V(math.sin(t * 2.5) * 0.65, 1.3 + t * 0.8, -1.35 - t * (2.2 + s * 0.55))
		local tail = c:segment(
			"Tail" .. i,
			previous,
			nextPos,
			1.35 * (1 - t * 0.75),
			1.1 * (1 - t * 0.7),
			i % 2 == 0 and lilac or blue,
			parent,
			true
		)
		previous, parent = nextPos, tail
	end
	for _, side in { -1, 1 } do
		c:leaf("TailFork" .. side, previous, previous + V(side * (0.65 + s * 0.12), 0.6, -0.55), 0.84, glow, parent)
	end
	local lurePoints = {
		V(0, 2.8, 1.2),
		V(0, 3.65 + s * 0.17, 0.97),
		V(0, 4.05 + s * 0.17, 1.65),
		V(0, 3.62 + s * 0.17, 2.42),
	}
	for i = 1, #lurePoints - 1 do
		c:segment("LureStem" .. i, lurePoints[i], lurePoints[i + 1], 0.16, 0.16, blue, head)
	end
	c:sphere("LureLantern", V(0.7, 0.74, 0.68), lurePoints[#lurePoints], glow, head)
	c:sphere("LureGleam", V(0.2, 0.2, 0.11), lurePoints[#lurePoints] + V(-0.13, 0.15, 0.27), c.cream, head)
	for i = 1, s + 2 do
		c:leaf("BackSail" .. i, V(0, 2.54, -0.6 - i * 0.52), V(0, 3.24 - i * 0.11, -1.2 - i * 0.52), 0.75, lilac, body)
	end
	return { body = body, head = head }
end

function S.aracnoflora(c)
	local V, s = c.V, c.stage
	local adult = s == 3
	local green = C(108, 155, 111)
	local light = C(175, 202, 132)
	local petal = C(215, 135, 163)
	local body = c:sphere(
		"Body",
		adult and V(3.3, 2.05, 3.25) or V(2.75, 1.75, 2.55),
		adult and V(0, 1.46, -0.83) or V(0, 1.18, -0.56),
		green,
		c.root,
		true
	)
	local head = c:sphere("Head", V(1.98, 1.35, 1.7), V(0, 1.26, 1.2), light, body, true)
	c:sphere("FaceMask", V(1.68, 0.72, 0.4), V(0, 1.13, 1.96), pearl, head)
	c:eyes(head, V(0, 1.47, 1.96), 1.04, s == 1 and 0.31 or 0.28, C(122, 91, 150), -0.08)
	mouth(c, head, V(0, 0.98, 2.17), 0.56, c.dark)
	for _, side in { -1, 1 } do
		c:sphere("Cheek" .. side, V(0.32, 0.16, 0.1), V(side * 0.7, 1.09, 2.06), petal, head)
		c:leaf("Palp" .. side, V(side * 0.52, 0.95, 1.7), V(side * 0.77, 0.65, 2.32), 0.38, green, head, true)
		local antenna = V(side * 0.66, 1.72, 1.25)
		c:segment("Antenna" .. side, antenna, antenna + V(side * 0.2, 0.62, -0.16), 0.13, 0.13, green, head)
		c:leaf(
			"AntennaLeaf" .. side,
			antenna + V(side * 0.17, 0.47, -0.11),
			antenna + V(side * 0.48, 0.83, -0.31),
			0.42,
			petal,
			head
		)
	end
	local pairs = s == 1 and 3 or 4
	for _, side in { -1, 1 } do
		for leg = 1, pairs do
			local z = 1.0 - (leg - 1) * 0.7
			local hip = V(side * (adult and 1.14 or 0.98), adult and 1.44 or 1.2, z)
			local knee = V(side * (1.7 + leg * 0.11), (adult and 1.72 or 1.22) + (leg % 2) * 0.18, z - 0.2)
			local foot = V(side * ((adult and 2.85 or 2.3) + leg * 0.1), 0.18, z - 0.42)
			local upper = c:leaf("LegUpper" .. side .. "_" .. leg, hip, knee, adult and 0.54 or 0.42, light, body, true)
			local lower
			if adult then
				local ankle = V(side * (2.55 + leg * 0.1), 0.66, z - 0.43)
				lower = c:segment("LegLower" .. side .. "_" .. leg, knee, ankle, 0.2, 0.24, green, upper, true)
				lower = c:segment("LegAnkle" .. side .. "_" .. leg, ankle, foot, 0.17, 0.2, light, lower, true)
			else
				lower = c:segment("LegLower" .. side .. "_" .. leg, knee, foot, 0.17, 0.2, green, upper, true)
			end
			c:sphere("LegBud" .. side .. "_" .. leg, V(0.32, 0.3, 0.3), knee, petal, upper)
			c:leaf(
				"RootFoot" .. side .. "_" .. leg,
				foot + V(-side * 0.1, 0.02, 0),
				foot + V(side * 0.21, -0.11, 0.13),
				0.28,
				light,
				lower
			)
		end
	end
	local center = adult and V(0, 2.62, -0.87) or V(0, 2.02, -0.6)
	if adult then
		-- O cálice adulto sustenta a flor aberta e muda sua silhueta para além de uma escala maior.
		for i = 1, 7 do
			local angle = (i + 0.5) * math.pi * 2 / 7
			local radial = V(math.cos(angle), 0, math.sin(angle))
			c:leaf(
				"FlowerSepal" .. i,
				center - V(0, 0.25, 0),
				center + radial * 2.15 - V(0, 0.46, 0),
				0.72,
				light,
				body
			)
		end
		for _, side in { -1, 1 } do
			c:leaf("AbdomenLeaf" .. side, V(side * 0.45, 1.55, -1.7), V(side * 1.25, 1.78, -3.25), 1.15, green, body)
		end
	end
	local petals = s == 1 and 5 or s == 2 and 7 or 9
	for i = 1, petals do
		local a = i * math.pi * 2 / petals
		local radial = V(math.cos(a), 0, math.sin(a))
		local closed = s == 1
		local tip = center + radial * (closed and 0.65 or s == 2 and 1.55 or 2.15) + V(0, closed and 1.13 or 0.3, 0)
		c:leaf(
			"FlowerOuter" .. i,
			center - radial * 0.23,
			tip,
			closed and 0.83 or adult and 1.22 or 1.1,
			i % 2 == 0 and rose or petal,
			body
		)
	end
	if s >= 2 then
		local innerCount = adult and 7 or 5
		for i = 1, innerCount do
			local a = i * math.pi * 2 / innerCount + 0.4
			local radius = adult and 1.12 or 0.8
			c:leaf(
				"FlowerInner" .. i,
				center,
				center + V(math.cos(a) * radius, adult and 0.9 or 0.76, math.sin(a) * radius),
				adult and 0.85 or 0.7,
				lavender,
				body
			)
		end
	end
	c:sphere(
		"FlowerHeart",
		V(s == 1 and 0.55 or 0.85, 0.48, s == 1 and 0.55 or 0.85),
		center + V(0, 0.58, 0),
		c.gold,
		body
	)
	for i = 1, 3 + s do
		local a = i * math.pi * 2 / (3 + s)
		c:sphere(
			"Pollen" .. i,
			V(0.15, 0.17, 0.15),
			center + V(math.cos(a) * 0.31, 0.88, math.sin(a) * 0.31),
			pearl,
			body
		)
	end
	return { body = body, head = head }
end

function S.escorpiodra(c)
	local V, s = c.V, c.stage
	local sand = C(188, 154, 101)
	local armor = C(121, 101, 93)
	local jade = C(107, 163, 161)
	local body = c:sphere("Body", V(2.4, 1.35, s == 1 and 2.7 or 3.5), V(0, 1.03, -0.3), sand, c.root, true)
	local head = c:sphere("Head", V(1.94, 1.2, 1.64), V(0, 1.2, 1.47), armor, body, true)
	c:sphere("FacePlate", V(1.6, 0.74, 0.42), V(0, 1.07, 2.14), sand, head)
	c:eyes(head, V(0, 1.46, 2.15), 1.04, s == 1 and 0.29 or 0.25, C(219, 171, 86), 0.1)
	mouth(c, head, V(0, 0.94, 2.35), 0.53, c.dark)
	for plate = 1, 2 + s do
		local z = 0.68 - plate * 0.57
		c:sphere(
			"Carapace" .. plate,
			V(2.14 - plate * 0.09, 0.38, 0.75),
			V(0, 1.65, z),
			plate % 2 == 0 and armor or sand,
			body
		)
		if s == 3 then
			c:leaf("SpinalThorn" .. plate, V(0, 1.78, z), V(0, 2.1, z - 0.23), 0.24, jade, body)
		end
	end
	local pairs = s == 1 and 3 or 4
	for _, side in { -1, 1 } do
		for leg = 1, pairs do
			local z = 0.88 - (leg - 1) * 0.69
			local hip, knee = V(side * 1.0, 1.03, z), V(side * (1.65 + leg * 0.08), 0.8, z - 0.12)
			local foot = V(side * (2.2 + leg * 0.11), 0.14, z - 0.42)
			local upper = c:segment("LegUpper" .. side .. "_" .. leg, hip, knee, 0.29, 0.35, armor, body, true)
			local lower = c:segment("LegLower" .. side .. "_" .. leg, knee, foot, 0.19, 0.24, sand, upper, true)
			c:leaf(
				"ClawedToe" .. side .. "_" .. leg,
				foot + V(-side * 0.06, 0.06, 0),
				foot + V(side * 0.2, -0.04, 0.15),
				0.2,
				jade,
				lower
			)
		end
		local elbow = V(side * (s == 1 and 1.42 or 1.77), 1.12, 1.93)
		local arm = c:segment("PincerArm" .. side, V(side * 0.8, 1.1, 1.18), elbow, 0.4, 0.44, armor, body, true)
		local palmPos = elbow + V(side * 0.33, 0, 0.56)
		local palm = c:sphere("PincerPalm" .. side, V(0.85 + s * 0.1, 0.68, 1.13), palmPos, sand, arm, true)
		c:sphere("PincerPlate" .. side, V(0.62, 0.18, 0.78), palmPos + V(0, 0.34, 0), jade, palm)
		local tip = palmPos + V(side * 0.02, 0, 1.16)
		c:leaf(
			"PincerFinger" .. side,
			palmPos + V(-side * 0.32, 0.13, 0.3),
			tip + V(-side * 0.1, 0.16, 0),
			0.45,
			armor,
			palm
		)
		c:leaf(
			"PincerThumb" .. side,
			palmPos + V(side * 0.31, -0.12, 0.3),
			tip + V(side * 0.1, -0.05, -0.19),
			0.36,
			sand,
			palm
		)
	end
	local count = s == 1 and 3 or s == 2 and 5 or 7
	local previous, parent = V(0, 1.06, -1.28), body
	for i = 1, count do
		local t = i / count
		local nextPos = V(
			0,
			1.06 + math.sin(t * math.pi * 0.7) * (1.1 + s * 0.62),
			-1.28 - math.sin(t * math.pi) * (1.15 + s * 0.3) + t * 0.48
		)
		local width = 0.74 * (1 - t * 0.48)
		local tail =
			c:segment("Tail" .. i, previous, nextPos, width, width * 1.08, i % 2 == 0 and armor or sand, parent, true)
		c:sphere("TailJoint" .. i, V(width * 0.92, width * 0.92, width * 0.92), nextPos, jade, tail)
		previous, parent = nextPos, tail
	end
	local venom = c:sphere("StingerBulb", V(0.65 + 0.06 * s, 0.68, 0.76), previous + V(0, 0.12, 0.12), armor, parent)
	c:leaf("Stinger", previous + V(0, 0.13, 0.32), previous + V(0, -0.45, 0.91), 0.35, jade, venom)
	return { body = body, head = head }
end
return S
]]></string>
        </Properties>
      </Item>
