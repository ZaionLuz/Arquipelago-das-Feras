      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">WorldLayout</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Geometria compartilhada; servidor continua autoridade de posição/contexto.
local L = {
	RingRadius = 1400,
	RegionRadius = 420,
	SurfaceY = 14,
	RouteWidth = 64,
	Count = 7,
	SanctuaryOrigin = Vector3.new(5000, 12, 5000),
}
local V = Vector3.new
function L.center(index)
	local a = (index - 1) / L.Count * math.pi * 2
	return V(math.cos(a) * L.RingRadius, 10, math.sin(a) * L.RingRadius)
end
function L.route(index)
	local a, b = L.center(index), L.center(index % L.Count + 1)
	local direction = (b - a).Unit
	return {
		a = a + direction * (L.RegionRadius - 24),
		b = b - direction * (L.RegionRadius - 24),
		from = index,
		to = index % L.Count + 1,
		width = L.RouteWidth,
	}
end
function L.distanceToSegment(p, a, b)
	local delta = b - a
	local length = delta:Dot(delta)
	if length == 0 then
		return (p - a).Magnitude, 0
	end
	local t = math.clamp((p - a):Dot(delta) / length, 0, 1)
	return (p - (a + delta * t)).Magnitude, t
end
function L.detect(position)
	if
		typeof(position) ~= "Vector3"
		or position.X ~= position.X
		or position.Y ~= position.Y
		or position.Z ~= position.Z
	then
		return nil
	end
	if math.abs(position.Y - 10) > 180 then
		return nil
	end
	local flat = V(position.X, 10, position.Z)
	for index = 1, L.Count do
		if (flat - L.center(index)).Magnitude <= L.RegionRadius then
			return index, "region"
		end
	end
	for index = 1, L.Count do
		local road = L.route(index)
		local distance, t = L.distanceToSegment(flat, road.a, road.b)
		if distance <= L.RouteWidth * 0.5 then
			return t < 0.5 and road.from or road.to, "route"
		end
	end
	return nil
end
function L.safePoint(index)
	return L.center(index) + V(0, 9, 24)
end
function L.wildOffset(slot)
	local positions = {
		V(-100, 4, 70),
		V(100, 4, 80),
		V(-215, 4, -90),
		V(210, 4, -150),
		V(-70, 4, -310),
		V(290, 4, 180),
		V(-300, 4, 170),
		V(75, 4, 290),
	}
	return positions[(slot - 1) % #positions + 1]
end
function L.campOffset(index)
	local road = L.route(index)
	return (road.a - L.center(index)) * 0.68 + V(0, 4, 0)
end
function L.plotCenter(index)
	return L.SanctuaryOrigin + V(((index - 1) % 4) * 190, 0, math.floor((index - 1) / 4) * 190)
end
return L
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="40">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="41">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">Biomes</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Decoração determinística; centro e entradas das pontes permanecem livres.
local Data = require(script.Parent.DataService)
local Progression = require(game:GetService("ReplicatedStorage").Shared.Progression)
local B = {}
local V = Vector3.new
local Layout = require(game:GetService("ReplicatedStorage").Shared.WorldLayout)
function B.decorate(parent, origin, def)
	local folder = Instance.new("Folder")
	folder.Name = "Bioma_" .. def.id
	folder.Parent = parent
	local rng = Random.new(100 + def.idx)
	local decorationShift = V(0, 0, 0)
	local function part(shape, size, pos, color, material, solid)
		local p = Instance.new("Part")
		p.Shape = shape
		p.Size = size
		p.Position = origin + pos + decorationShift
		p.Anchored = true
		p.CanCollide = solid == true
		p.CanTouch = false
		p.CanQuery = solid == true
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.Parent = folder
		return p
	end
	local function crystal(pos, color)
		local p = part(Enum.PartType.Block, V(1.8, 5, 1.8), pos, color, Enum.Material.Neon)
		p.CFrame *= CFrame.Angles(0.2, 0, 0.4)
	end
	for i = 1, 20 do
		local angle = i * math.pi * 2 / 20 + rng:NextNumber(-0.1, 0.1)
		local radius = rng:NextNumber(160, Layout.RegionRadius - 55)
		local pos = V(math.cos(angle) * radius, 4, math.sin(angle) * radius)
		if def.id == "Brasa" then
			part(Enum.PartType.Ball, V(7, 6, 7), pos + V(0, 1, 0), Color3.fromRGB(40, 35, 40), Enum.Material.Basalt)
			crystal(pos + V(0, 4, 0), def.accent)
		elseif def.id == "Recife" then
			for j = 1, 3 do
				local coral = part(
					Enum.PartType.Cylinder,
					V(4, 0.7, 0.7),
					pos + V(j - 2, 2 + j * 0.4, 0),
					j % 2 == 0 and def.accent or Color3.fromRGB(240, 145, 180)
				)
				coral.CFrame *= CFrame.Angles(0, 0, math.pi / 2 + (j - 2) * 0.3)
			end
			crystal(pos + V(0, 5, 0), def.accent)
		elseif def.id == "Alvorecer" or def.id == "Floresta" or def.id == "Pantano" then
			local shadow = def.id == "Pantano"
			local trunk = part(
				Enum.PartType.Cylinder,
				V(10, 2, 2),
				pos + V(0, 5, 0),
				Color3.fromRGB(80, 57, 55),
				Enum.Material.Wood
			)
			trunk.CFrame *= CFrame.Angles(0, 0, math.pi / 2 + (shadow and 0.25 or 0))
			part(
				Enum.PartType.Ball,
				V(9, 7, 8),
				pos + V(1, 11, 0),
				shadow and Color3.fromRGB(60, 43, 82) or Color3.fromRGB(52, 120, 77),
				Enum.Material.Grass
			)
			part(Enum.PartType.Ball, V(2, 1, 2), pos + V(3, 1, 2), def.accent, Enum.Material.Neon)
		elseif def.id == "Dunas" then
			local pillar =
				part(Enum.PartType.Cylinder, V(7, 3, 3), pos + V(0, 3.5, 0), def.accent, Enum.Material.Sandstone)
			pillar.CFrame *= CFrame.Angles(0, 0, math.pi / 2 + 0.1)
			part(Enum.PartType.Block, V(5, 1, 4), pos + V(0, 7, 0), def.ground, Enum.Material.Sandstone)
		else
			part(Enum.PartType.Ball, V(10, 3, 7), pos + V(0, 5, 0), Color3.fromRGB(235, 243, 255))
			crystal(pos + V(0, 8, 0), def.accent)
		end
	end
	-- Marco maior deslocado: destino visível depois de explorar a região.
	decorationShift = V(0, 0, -240)
	if def.id == "Brasa" then
		part(Enum.PartType.Ball, V(16, 14, 16), V(0, 7, -27), Color3.fromRGB(46, 35, 39), Enum.Material.Basalt)
		part(Enum.PartType.Cylinder, V(0.5, 8, 8), V(0, 13, -27), def.accent, Enum.Material.Neon).CFrame *= CFrame.Angles(
			0,
			0,
			math.pi / 2
		)
	elseif def.id == "Recife" then
		part(Enum.PartType.Ball, V(13, 9, 10), V(0, 8, -28), def.ground, Enum.Material.Slate)
		local fall = part(Enum.PartType.Block, V(5, 8, 0.3), V(0, 8, -22.9), def.accent, Enum.Material.Glass)
		fall.Transparency = 0.35
	elseif def.id == "Floresta" or def.id == "Alvorecer" then
		local tree =
			part(Enum.PartType.Cylinder, V(18, 4, 4), V(0, 13, -26), Color3.fromRGB(83, 62, 45), Enum.Material.Wood)
		tree.CFrame *= CFrame.Angles(0, 0, math.pi / 2)
		part(Enum.PartType.Ball, V(19, 10, 16), V(0, 23, -26), Color3.fromRGB(67, 143, 96), Enum.Material.Grass)
	elseif def.id == "Dunas" or def.id == "Pantano" then
		for _, side in { -1, 1 } do
			part(Enum.PartType.Block, V(3, 12, 3), V(side * 6, 10, -25), def.ground, Enum.Material.Slate)
		end
		part(Enum.PartType.Block, V(16, 3, 4), V(0, 16, -25), def.accent, Enum.Material.Slate)
		if def.id == "Pantano" then
			local portal = part(Enum.PartType.Ball, V(7, 9, 0.3), V(0, 9, -25), def.accent, Enum.Material.Neon)
			portal.Transparency = 0.45
		end
	else
		for _, side in { -1, 1 } do
			crystal(V(side * 7, 12, -26), def.accent)
		end
		part(Enum.PartType.Ball, V(22, 4, 14), V(0, 16, -26), Color3.fromRGB(236, 243, 255))
	end
	-- Marco central preservado; entradas e superfície continuam livres.
	decorationShift = V(0, 0, 0)
	local _path = part(
		Enum.PartType.Block,
		V(18, 0.1, Layout.RegionRadius * 1.6),
		V(0, 4.1, 0),
		def.ground:Lerp(Color3.new(1, 1, 1), 0.2),
		Enum.Material.Cobblestone
	)
	local stone = part(Enum.PartType.Ball, V(7, 3, 7), V(24, 5, 0), def.ground, Enum.Material.Slate)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Conhecer bioma"
	prompt.ObjectText = def.name .. " • " .. def.desc
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.Parent = stone
	prompt.Triggered:Connect(function(player)
		local ch = player.Character
		local root = ch and ch:FindFirstChild("HumanoidRootPart")
		local data = Data.get(player)
		if not data or not root or (root.Position - stone.Position).Magnitude >= 16 then
			return
		end
		if not require(script.Parent.RegionService).requireCurrent(player, def.id, "encounter").ok then
			return
		end
		if require(script.Parent.EncounterService).active(player) then
			return
		end
		local notice = game:GetService("ReplicatedStorage"):FindFirstChild("WildNotice")
		if (data.gatherAt[def.id] or 0) > os.time() then
			if notice then
				notice:FireClient(player, "Este ponto se recupera em " .. (data.gatherAt[def.id] - os.time()) .. "s")
			end
			return
		end
		data.gatherAt[def.id] = os.time() + 120
		data.materials[def.el] = math.min(10000, (data.materials[def.el] or 0) + 1)
		if not data.visited[def.id] then
			data.visited[def.id] = true
			data.gold += 30
			data.stats.explore = (data.stats.explore or 0) + 1
			Progression.award(data, 60)
		end
		player:SetAttribute("BiomaVisitado", def.id)
		if notice then
			notice:FireClient(player, "Descoberta em " .. def.name .. " • +1 essência de " .. def.el)
		end
	end)
end
return B
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">CompanionService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Data = require(script.Parent.DataService)
local S = {}
function S.sync(player)
	local d = Data.get(player)
	local pet = d and d.companion and d.creatures[d.companion]
	player:SetAttribute("CompanionSpecies", pet and pet.id or nil)
	player:SetAttribute("CompanionLevel", pet and pet.lv or nil)
	player:SetAttribute("CompanionUid", pet and d.companion or nil)
end
return S
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">CreatureGallery</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Ferramenta explícita de revisão; nunca construída em servidor publicado.
local Run = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")
local C = require(RS.Shared.Creatures)
local Factory = require(RS.Shared.ModelFactory)
local Gallery = {}
function Gallery.build()
	assert(Run:IsStudio(), "A galeria só funciona no Studio")
	local previous = workspace:FindFirstChild("GaleriaV7")
	if previous then
		previous:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "GaleriaV7"
	folder.Parent = workspace
	local function display(def, lv, index)
		local point = Vector3.new((index - 1) % 9 * 28, 110, math.floor((index - 1) / 9) * 28)
		local stand = Instance.new("Part")
		stand.Size = Vector3.new(22, 1, 22)
		stand.Position = point
		stand.Anchored = true
		stand.Color = Color3.fromRGB(40, 49, 59)
		stand.Parent = folder
		local model
		local function replace(level)
			if model then
				model:Destroy()
			end
			model = Factory.build(def, level, { preview = true })
			local cf, size = model:GetBoundingBox()
			local lift = model:GetPivot().Position.Y - (cf.Position.Y - size.Y / 2)
			model:PivotTo(CFrame.new(point + Vector3.new(0, lift + 0.5, 0)))
			model:SetAttribute("Gallery", true)
			model.Parent = folder
		end
		replace(lv)
		local label = Instance.new("BillboardGui")
		label.Size = UDim2.fromOffset(210, 54)
		label.StudsOffset = Vector3.new(0, 10, 0)
		label.MaxDistance = 160
		label.Parent = stand
		local text = Instance.new("TextLabel")
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.Text = def.name .. " · Nv." .. lv .. " · estágio " .. C.stage(lv, def.id)
		text.TextColor3 = Color3.new(1, 1, 1)
		text.TextSize = 15
		text.Font = Enum.Font.GothamBold
		text.Parent = label
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Alternar estágio"
		prompt.ObjectText = def.name
		prompt.MaxActivationDistance = 14
		prompt.Parent = stand
		local choice = table.find({ 1, 7, 15 }, lv) or 3
		prompt.Triggered:Connect(function()
			choice = choice % 3 + 1
			local level = ({ 1, 7, 15 })[choice]
			replace(level)
			text.Text = def.name .. " · Nv." .. level .. " · estágio " .. C.stage(level, def.id)
		end)
	end
	local index = 0
	for _, def in C.List do
		for _, lv in { 1, 7, 15 } do
			index += 1
			display(def, lv, index)
		end
	end
	display(C.ById.fenix, 60, 91)
	return folder
end
return Gallery
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local DSS = game:GetService("DataStoreService")
local RS = game:GetService("ReplicatedStorage")
local C = require(RS.Shared.Creatures)
local I = require(RS.Shared.Islands)
local M = require(RS.Shared.Missions)
local SR = require(RS.Shared.SanctuaryRules)
local Story = require(RS.Shared.Story)
local Migration = require(RS.Shared.Migration)
local Quest = require(RS.Shared.PhoenixQuest)
local Access = require(RS.Shared.Access)
local Grant = require(RS.Shared.CreatureGrant)
local CaptureRules = require(RS.Shared.CaptureRules)
local store = DSS:GetDataStore("ArquipelagoV1")
local D = {}
local profiles = {}
local pending = {}
local VERSION = require(RS.Shared.Config).ProfileVersion
local sessions = {}
local Http = game:GetService("HttpService")
local LEASE = 180
local function clone(t)
	local out = {}
	for k, v in t do
		out[k] = typeof(v) == "table" and clone(v) or v
	end
	return out
end
local function default()
	local result = {
		navigation = { visited = { Alvorecer = true }, checkpoint = "Alvorecer" },
		v = VERSION,
		gold = 100,
		gems = 5,
		seals = 5,
		playerLevel = 1,
		playerXp = 0,
		sealStock = {},
		companion = nil,
		storyClaimed = {},
		guardians = {},
		visited = {},
		materials = {},
		gatherAt = {},
		sanctuary = { Alvorecer = { slot = 5, level = 1 } },
		nextId = 1,
		last = os.time(),
		wins = 0,
		creatures = {},
		eggs = {},
		stats = {},
		claimed = {},
		pass = {},
		receipts = {},
		dailyDay = 0,
		streak = 0,
		trophies = 0,
		tut = false,
		habitat = { Alvorecer = { "u1", "u2" } },
		unlocked = { Alvorecer = true },
		legacyGrandfathered = {},
		grants = {},
		phoenix = { glyphs = {}, sanctuaryOpen = false, attempts = 0, nextAttemptAt = 0, captured = false },
		legacyEggPermits = {},
		discovered = {},
	}
	if require(RS.Shared.Config).World.FreeExploration then
		for _, region in I.List do
			result.unlocked[region.id] = true
		end
	end
	assert(Grant.grant(result, "brotinho", "starter", "starter:1"))
	assert(Grant.grant(result, "folhuco", "starter", "starter:2"))
	return result
end
-- Registro corrompido é recusado. Nunca substituir um perfil real por padrões.
function D.validate(raw)
	if raw ~= nil then
		local migrated, reason = Migration.run(raw)
		assert(migrated, reason)
		raw = migrated
	end
	local d = default()
	if raw == nil then
		return d
	end
	local seeds = d
	d = clone(raw)
	for key, value in seeds do
		if d[key] == nil then
			d[key] = value
		end
	end
	local function num(x, f, _mx)
		return (typeof(x) == "number" and x == x and x >= 0 and x < math.huge) and math.floor(x) or f
	end
	d.seals = num(raw.seals, 5, 10000)
	d.sealStock = clone(raw.sealStock or {})
	for kind in CaptureRules.Seals do
		if kind ~= "Basic" and typeof(raw.sealStock) == "table" then
			d.sealStock[kind] = num(raw.sealStock[kind], 0, 10000)
		end
	end
	d.gold = num(raw.gold, d.gold, 1e12)
	d.gems = num(raw.gems, d.gems, 1e9)
	d.wins = num(raw.wins, 0, 1e9)
	d.nextId = num(raw.nextId, d.nextId, 1e9)
	d.legacyGrandfathered = Migration.clone(raw.legacyGrandfathered or {})
	d.grants = Migration.clone(raw.grants or {})
	d.legacyEggPermits = Migration.clone(raw.legacyEggPermits or {})
	d.phoenix = Migration.clone(raw.phoenix or d.phoenix)
	d.last = num(raw.last, os.time(), 1e12)
	local cr, n = {}, 0
	for uid, c in raw.creatures do
		if typeof(uid) == "string" and typeof(c) == "table" and C.ById[c.id] then
			cr[uid] = clone(c)
			cr[uid].lv = math.max(num(c.lv, 1, 100), 1)
			cr[uid].xp = num(c.xp, 0, 1e9)
			n += 1
		end
	end
	assert(n > 0, "CORRUPT_PROFILE")
	for uid in cr do
		local uidNumber = tonumber(string.match(uid, "^u(%d+)$"))
		if uidNumber then
			d.nextId = math.max(d.nextId, uidNumber + 1)
		end
	end
	d.creatures = cr
	d.discovered = clone(raw.discovered or {})
	for _, c in cr do
		d.discovered[c.id] = true
	end
	if typeof(raw.discovered) == "table" then
		for id in raw.discovered do
			if C.ById[id] then
				d.discovered[id] = true
			end
		end
	end
	d.unlocked = clone(raw.unlocked or {})
	d.unlocked.Alvorecer = true
	if typeof(raw.unlocked) == "table" then
		for id in I.ById do
			if raw.unlocked[id] == true then
				d.unlocked[id] = true
			end
		end
	end
	d.playerLevel = math.max(num(raw.playerLevel, 1, 100), 1)
	d.playerXp = num(raw.playerXp, 0, 1e9)
	d.companion = typeof(raw.companion) == "string" and cr[raw.companion] and raw.companion or nil
	d.guardians = clone(raw.guardians or {})
	d.visited = clone(raw.visited or {})
	d.materials = clone(raw.materials or {})
	d.gatherAt = clone(raw.gatherAt or {})
	for _, def in I.List do
		if typeof(raw.guardians) == "table" and raw.guardians[def.id] == true then
			d.guardians[def.id] = true
		end
		if typeof(raw.visited) == "table" and raw.visited[def.id] == true then
			d.visited[def.id] = true
		end
		if typeof(raw.gatherAt) == "table" then
			d.gatherAt[def.id] = num(raw.gatherAt[def.id], 0, 1e12)
		end
		if typeof(raw.materials) == "table" then
			d.materials[def.el] = num(raw.materials[def.el], 0, 10000)
		end
	end
	d.storyClaimed = clone(raw.storyClaimed or {})
	if typeof(raw.storyClaimed) == "table" then
		for id, claimed in raw.storyClaimed do
			if claimed == true and Story.ById[id] then
				d.storyClaimed[id] = true
			end
		end
	end
	if typeof(raw.sanctuary) == "table" then
		d.sanctuary = clone(raw.sanctuary)
	else -- Migração: habitats legados recebem posição própria; nenhuma criatura é removida.
		d.sanctuary = {}
		local slot = 0
		for _, def in I.List do
			if d.unlocked[def.id] then
				slot += 1
				d.sanctuary[def.id] = { slot = slot, level = 1 }
			end
		end
	end
	d.habitat = {}
	local seen = {}
	if typeof(raw.habitat) == "table" then
		for isl, list in raw.habitat do
			local def = I.ById[isl]
			if def and d.unlocked[isl] and typeof(list) == "table" then
				d.habitat[isl] = {}
				for _, uid in list do
					if typeof(uid) == "string" and cr[uid] and not seen[uid] then
						seen[uid] = true
						table.insert(d.habitat[isl], uid)
					end
				end
			end
		end
	end
	for id, list in d.habitat do
		if #list > 0 and not d.sanctuary[id] then
			for slot = 1, 9 do
				if SR.available(d.sanctuary, slot) then
					d.sanctuary[id] = { slot = slot, level = 1 }
					break
				end
			end
		end
	end
	d.stats = {}
	d.claimed = clone(raw.claimed or {})
	if typeof(raw.stats) == "table" then
		for k, v in raw.stats do
			if typeof(k) == "string" then
				d.stats[k] = num(v, 0, 1e9)
			end
		end
	end
	if typeof(raw.claimed) == "table" then
		for id, value in raw.claimed do
			if value == true and M.ById[id] then
				d.claimed[id] = true
			end
		end
	end
	d.trophies = num(raw.trophies, 0, 1e9)
	d.tut = raw.tut == true
	d.receipts = {}
	d.pass = {}
	d.dailyDay = num(raw.dailyDay, 0, 1e9)
	d.streak = num(raw.streak, 0, 1e6)
	if typeof(raw.receipts) == "table" then
		for k, value in raw.receipts do
			if value == true and typeof(k) == "string" then
				d.receipts[k] = true
			end
		end
	end
	d.eggs = {}
	if typeof(raw.eggs) == "table" then
		for _, e in raw.eggs do
			if
				typeof(e) == "table"
				and C.ById[e.id]
				and typeof(e.ready) == "number"
				and e.ready == e.ready
				and e.ready >= 0
				and e.ready < math.huge
			then
				table.insert(d.eggs, clone(e))
			end
		end
	end
	return d
end
-- Lease gravado atomicamente no MESMO registro legado (sem trocar a chave).
function D.load(p)
	if pending[p] then
		return false
	end
	local ticket = {}
	pending[p] = ticket
	local token = Http:GenerateGUID(false)
	local raw, ok
	for attempt = 1, 3 do
		ok, raw = pcall(function()
			return store:UpdateAsync("P" .. p.UserId, function(old)
				if ticket.cancelled then
					return nil
				end
				if
					old ~= nil
					and (typeof(old) ~= "table" or typeof(old.creatures) ~= "table" or (old.v or 1) > VERSION)
				then
					error(Text.PERFIL_INVALIDO_OU_VERSAO_FUTURA_RECUPERACAO_MAN_C36F9F)
				end
				local lock = old and old._session
				if lock and typeof(lock) ~= "table" then
					error(Text.LEASE_INVALIDO_1F2C7F)
				end
				if lock and lock.token ~= token and (lock.expires or 0) > os.time() then
					return nil
				end
				local migrated
				if old ~= nil then
					local reason
					migrated, reason = Migration.run(old)
					if not migrated then
						error(reason)
					end
				end
				local data = old == nil and default() or D.validate(migrated)
				data._session = { token = token, expires = os.time() + LEASE }
				return data
			end)
		end)
		if ok then
			break
		end
		task.wait(attempt)
	end
	if ticket.cancelled then
		pending[p] = nil
		if ok and raw then
			profiles[p] = D.validate(raw)
			sessions[p] = {
				token = token,
				expires = raw._session.expires,
				busy = false,
				region = "Alvorecer",
				lastSafe = "Alvorecer",
				closing = true,
			}
			D.release(p)
		end
		return false
	end
	pending[p] = nil
	if not ok or not raw then
		p:Kick(Text.DADOS_INDISPONIVEIS_OU_SESSAO_AINDA_ATIVA_AGUARD_97BBDC)
		return false
	end
	profiles[p] = D.validate(raw)
	-- Uma sessão recuperada nunca retoma um encontro do processo anterior.
	profiles[p].phoenix.encounterId = nil
	sessions[p] =
		{ token = token, expires = raw._session.expires, busy = false, region = "Alvorecer", lastSafe = "Alvorecer" }
	return true
end
function D.session(p)
	return sessions[p]
end
function D.get(p)
	local session = sessions[p]
	if not session or session.expires <= os.time() or session.closing then
		return nil
	end
	return profiles[p]
end
function D.snapshot(p)
	local d = clone(profiles[p])
	d.receipts = nil
	d.grants = nil
	d.legacyEggPermits = nil
	d.phoenix = nil
	d.quest = Quest.public(profiles[p])
	d.region = sessions[p] and sessions[p].region or "Alvorecer"
	d.access = {}
	for _, island in I.List do
		local check = Access.check(profiles[p], island.id, "travel")
		local unlock = Access.check(profiles[p], island.id, "unlock")
		d.access[island.id] = { ok = check.ok, reason = check.reason, unlockReason = unlock.reason }
	end
	for _, e in d.eggs do
		e.left = math.max(0, e.ready - os.time())
	end
	local el, left = M.event(os.time())
	d.event = { el = el, left = left }
	return d
end
function D.save(p, release)
	local session = sessions[p]
	local d = profiles[p]
	if not session or not d then
		return false
	end
	while session.busy do
		task.wait()
	end
	if sessions[p] ~= session then
		return false
	end
	session.busy = true
	local payload = clone(d)
	payload.pass = nil
	payload.event = nil
	for _, egg in payload.eggs do
		egg.left = nil
	end
	local expiry = os.time() + LEASE
	payload._session = not release and { token = session.token, expires = expiry } or nil
	local ok, result = pcall(function()
		return store:UpdateAsync("P" .. p.UserId, function(old)
			if not old or not old._session or old._session.token ~= session.token then
				return nil
			end
			return payload
		end)
	end)
	session.busy = false
	if ok and result then
		session.expires = expiry
		return true
	end
	warn(Text.FALHA_AO_SALVAR_PERFIL_DE_B99672 .. p.Name)
	if ok or os.time() >= session.expires then
		session.closing = true
		p:Kick(Text.SESSAO_DE_DADOS_ENCERRADA_RECONECTE_PARA_PROTEGE_C94A14)
	end
	return false
end
function D.release(p)
	if pending[p] then
		pending[p].cancelled = true
	end
	local session = sessions[p]
	if not session then
		return
	end
	session.closing = true
	for _ = 1, 3 do
		if D.save(p, true) then
			break
		end
		task.wait(1)
	end
	profiles[p] = nil
	sessions[p] = nil
end
function D.saveAll()
	for p in profiles do
		D.save(p)
	end
end
function D.closeAll()
	local remaining = 0
	for p in profiles do
		remaining += 1
		task.spawn(function()
			D.release(p)
			remaining -= 1
		end)
	end
	local deadline = os.clock() + 25
	while remaining > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
end
return D
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">EncounterService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Http = game:GetService("HttpService")
local Data = require(script.Parent.DataService)
local C = require(RS.Shared.Creatures)
local Rules = require(RS.Shared.CombatRules)
local CaptureRules = require(RS.Shared.CaptureRules)
local Progression = require(RS.Shared.Progression)
local Grant = require(RS.Shared.CreatureGrant)
local Quest = require(RS.Shared.PhoenixQuest)
local Config = require(RS.Shared.Config)
local Region = require(script.Parent.RegionService)
local Species = require(RS.Shared.SpeciesRules)
local E = {}
local opening = {}
local sessions = {}
local rng = Random.new()
local net
local events
local function snapshot(session, message)
	local s = session.state
	local party = {}
	for uid, p in s.party do
		party[uid] = { id = p.id, lv = p.lv, hp = p.hp, maxHp = p.maxHp, nextSkill = p.nextSkill }
	end
	return {
		token = session.token,
		seals = session.seals,
		sealType = session.sealType or "Basic",
		sealStock = session.sealStock or {},
		version = s.version,
		status = s.status,
		capturable = s.capturable ~= false,
		turn = s.turn,
		foe = s.foe,
		party = party,
		active = s.active,
		bond = s.bond,
		chance = Rules.chance(s),
		log = s.log,
		message = message,
		expires = session.expires,
		intro = session.special and "phoenix" or nil,
	}
end
local function finish(player, session)
	if session.released then
		return
	end
	session.released = true
	local d = Data.get(player)
	local s = session.state
	if d and s.status == "captured" then
		local origin = session.special and "phoenix_sanctuary" or "wild_capture"
		local uid, reason = Grant.grant(d, s.foe.id, origin, session.token, { level = s.foe.lv })
		if uid then
			d.stats.capture = (d.stats.capture or 0) + 1
			local pet = s.active and d.creatures[s.active]
			local reward =
				Progression.rewards(session.region, s.foe.lv, C.ById[s.foe.id].rar, pet and pet.lv or s.foe.lv)
			Progression.award(d, math.floor(reward.xp * 0.6))
		else
			s.status = "escaped"
			table.insert(s.log, { text = Text.CONCESSAO_RECUSADA_951368 .. reason, kind = "error" })
		end
	elseif d and s.status == "won" then
		local def = C.ById[s.foe.id]
		local teamLevel = 0
		for uid in s.party do
			local pet = d.creatures[uid]
			if pet then
				teamLevel = math.max(teamLevel, pet.lv)
			end
		end
		local reward = Progression.rewards(session.region, s.foe.lv, def.rar, teamLevel)
		d.gold += reward.gold
		d.wins += 1
		d.stats.win = (d.stats.win or 0) + 1
		Progression.award(d, reward.xp)
		local pet = d.creatures[s.active]
		if pet then
			Progression.awardCreature(pet, reward.creatureXp)
			local refreshed, err = pcall(require(script.Parent.World).refresh, player)
			if not refreshed then
				warn(Text.MODELO_SERA_RECONSTRUIDO_NA_PROXIMA_ATUALIZACAO_BF3624 .. tostring(err))
			end
		end
		table.insert(s.log, {
			text = "Recompensa: "
				.. reward.gold
				.. " ouro · "
				.. reward.xp
				.. " XP · "
				.. reward.creatureXp
				.. Text.XP_DA_FERA_1A37A2,
			kind = "reward",
		})
	end
	if d and s.status == "won" and session.guardian and not d.guardians[session.guardian] then
		d.guardians[session.guardian] = true
		d.stats.guardian = (d.stats.guardian or 0) + 1
		d.gold += 100
		Progression.award(d, 200)
	end
	if session.special and d then
		d.phoenix.encounterId = nil
		d.phoenix.nextAttemptAt = math.max(d.phoenix.nextAttemptAt or 0, os.time() + Config.PhoenixRetrySeconds)
		local saved = Data.save(player)
		if not saved then
			table.insert(s.log, { text = Text.SALVAMENTO_PENDENTE_AGUARDE_ANTES_DE_SAIR_5F0A13, kind = "error" })
		end
	end
	session.release(s.status == "captured" or s.status == "won")
end
function E.open(player, specimen, release)
	local d = Data.get(player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	if not d then
		return false
	end
	if opening[player] and not specimen.special then
		return false
	end
	if not specimen.special and not Species.isGeneral(specimen.id) then
		return false
	end
	local region = specimen.region or Region.current(player, "encounter")
	if not Region.requireCurrent(player, region, "encounter").ok then
		return false
	end
	local old = sessions[player]
	if old and old.state.status == "active" then
		return false
	end
	local session = {
		token = specimen.nonce or Http:GenerateGUID(false),
		region = region,
		special = specimen.special == true,
		state = Rules.new(
			specimen.id,
			specimen.lv,
			{ statMultiplier = specimen.statMultiplier, explorerLevel = d.playerLevel, isLegendary = specimen.special }
		),
		guardian = specimen.guardianId,
		seals = d.seals,
		origin = specimen.position,
		expires = os.time() + 150,
		release = release,
	}
	session.state.capturable = specimen.capturable ~= false
	session.state.isLegendary = session.special
	session.state.captureBase = specimen.captureBase
	session.sealType = "Basic"
	session.sealStock = d.sealStock or {}
	d.stats.fight = (d.stats.fight or 0) + 1
	sessions[player] = session
	events:FireClient(player, snapshot(session))
	return true
end
function E.startSpecial(player, id)
	if id ~= "phoenix_solar" or E.active(player) then
		return false, "ACTIVE_OR_INVALID"
	end
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false, "CHARACTER_UNAVAILABLE"
	end
	local d = Data.get(player)
	local ok, reason = Quest.check(d or {}, os.time())
	if not ok then
		return false, reason
	end
	if not Region.requireCurrent(player, "Dunas", "encounter").ok then
		return false, "WRONG_REGION"
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local altar = require(script.Parent.SanctuaryBuilder).altarPosition()
	if not root or (root.Position - altar).Magnitude > 15 then
		return false, "DISTANCE"
	end
	opening[player] = true
	local previousAttempts, previousCooldown = d.phoenix.attempts, d.phoenix.nextAttemptAt
	local nonce = Http:GenerateGUID(false)
	d.phoenix.encounterId = nonce
	d.phoenix.attempts += 1
	d.phoenix.nextAttemptAt = os.time() + Config.PhoenixRetrySeconds
	local saved = Data.save(player)
	if not saved or not Data.get(player) then
		d.phoenix.encounterId = nil
		opening[player] = nil
		return false, "SAVE_FAILED"
	end
	local opened = E.open(player, {
		id = Species.SpecialId,
		lv = 60,
		region = "Dunas",
		position = altar,
		special = true,
		nonce = nonce,
		captureBase = 0.04,
		statMultiplier = 1.3,
	}, function()
		player:SetAttribute("SolarEncounterEnded", os.time())
	end)
	if not opened then
		d.phoenix.encounterId = nil
		if Data.get(player) == d then
			d.phoenix.attempts = previousAttempts
			d.phoenix.nextAttemptAt = previousCooldown
			Data.save(player)
		end
	end
	opening[player] = nil
	return opened, opened and "OK" or "INTERRUPTED"
end
function E.active(player)
	if opening[player] then
		return true
	end
	local s = sessions[player]
	return s and s.state.status == "active"
end
function E.start()
	net = Instance.new("RemoteFunction")
	net.Name = "EncounterNet"
	net.Parent = RS
	events = Instance.new("RemoteEvent")
	events.Name = "EncounterNotice"
	events.Parent = RS
	net.OnServerInvoke = function(player, token, version, action, uid)
		local session = sessions[player]
		local d = Data.get(player)
		if not session or not d then
			return nil
		end
		-- Recuperação da própria sessão caso o evento inicial chegue antes da UI.
		if action == "Resume" then
			if session.readAt and os.clock() - session.readAt < 0.1 then
				return nil
			end
			session.readAt = os.clock()
			return snapshot(session)
		end
		if typeof(token) ~= "string" or #token > 80 or token ~= session.token then
			return nil
		end
		if typeof(action) ~= "string" or #action > 16 or (uid ~= nil and (typeof(uid) ~= "string" or #uid > 40)) then
			return snapshot(session, Text.PEDIDO_INVALIDO_C2C28F)
		end
		if action == "State" then
			if session.readAt and os.clock() - session.readAt < 0.1 then
				return nil
			end
			session.readAt = os.clock()
			return snapshot(session)
		end
		if session.state.status ~= "active" then
			return snapshot(session)
		end
		if not Region.requireCurrent(player, session.region, action == "Capture" and "capture" or "battle").ok then
			session.state.status = "escaped"
			finish(player, session)
			return snapshot(session, "REGION_ACCESS_DENIED")
		end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if
			os.time() >= session.expires
			or not root
			or not humanoid
			or humanoid.Health <= 0
			or (root.Position - session.origin).Magnitude > 40
		then
			session.state.status = "escaped"
			finish(player, session)
			return snapshot(session, Text.O_ENCONTRO_ENCERROU_DISTANCIA_TEMPO_OU_PERSONAGE_9012D6)
		end
		if typeof(version) ~= "number" or version ~= session.state.version then
			return snapshot(session, Text.ESTADO_ATUALIZADO_ESCOLHA_NOVAMENTE_CD8857)
		end
		if session.last and os.clock() - session.last < 0.25 then
			return snapshot(session, Text.AGUARDE_O_TURNO_25CBEF)
		end
		session.last = os.clock()
		if action == "ChooseSeal" then
			local seal = CaptureRules.Seals[uid]
			if not seal then
				return snapshot(session, Text.SELO_INVALIDO_51B2D9)
			end
			session.sealType = uid
			session.state.sealKind = uid
			session.state.version += 1
			session.state.log = {}
			session.seals = uid == "Basic" and d.seals or (d.sealStock or {})[uid] or 0
			return snapshot(session)
		end
		local pet = uid and d.creatures[uid]
		local count = 0
		for _ in d.creatures do
			count += 1
		end
		local ok, message = Rules.step(
			session.state,
			action,
			pet and { uid = uid, id = pet.id, lv = pet.lv },
			rng,
			session.seals,
			count < 60
		)
		if not ok then
			return snapshot(session, message)
		end
		if session.state.spentSeal then
			if session.sealType == "Basic" then
				d.seals -= 1
			else
				d.sealStock[session.sealType] -= 1
			end
		end
		session.seals = session.sealType == "Basic" and d.seals or (d.sealStock or {})[session.sealType] or 0
		if session.special and session.state.status == "active" then
			local stock = d.seals
			for _, n in d.sealStock or {} do
				stock += n
			end
			if stock <= 0 and action == "Capture" then
				session.state.status = "escaped"
				table.insert(
					session.state.log,
					{ text = Text.OS_SELOS_SE_ESGOTARAM_A_CHAMA_REPOUSARA_POR_VINT_B19B32, kind = "info" }
				)
			end
		end
		if session.state.status ~= "active" then
			finish(player, session)
		end
		return snapshot(session)
	end
	Players.PlayerRemoving:Connect(function(player)
		local s = sessions[player]
		if s then
			s.state.status = "escaped"
			finish(player, s)
		end
		sessions[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(2)
			for player, s in sessions do
				if s.state.status == "active" and (os.time() >= s.expires or not Data.get(player)) then
					s.state.status = "escaped"
					finish(player, s)
					events:FireClient(player, snapshot(s, Text.O_ENCONTRO_TERMINOU_6F159C))
				end
			end
		end
	end)
end
return E
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">ExpeditionWorld</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Superfícies de exploração contínuas. Os níveis descrevem perigo, nunca portões.
local RS = game:GetService("ReplicatedStorage")
local Layout = require(RS.Shared.WorldLayout)
local Islands = require(RS.Shared.Islands)
local Tokens = require(RS.Shared.ArtTokens)
local Bands = require(RS.Shared.LevelBands)
local E = { Budget = 850 }
local V = Vector3.new
local function part(parent, name, size, cf, color, solid, kind)
	local p = Instance.new(kind == "wedge" and "WedgePart" or "Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = solid == true
	p.CanTouch = false
	p.CanQuery = solid == true
	p.CastShadow = size.Magnitude > 12
	p.Parent = parent
	if kind == "cylinder" then
		p.Shape = Enum.PartType.Cylinder
	end
	return p
end
local function sign(parent, point, def)
	local ramp = Tokens.ramp(def.id)
	part(parent, "PosteDeTrilha", V(2, 10, 2), CFrame.new(point + V(0, 5, 0)), ramp[2], false)
	local board = part(parent, "PlacaDeTrilha", V(15, 5, 0.6), CFrame.new(point + V(0, 10, 0)), Tokens.Panel, false)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Indicacao"
	gui.Size = UDim2.fromOffset(250, 68)
	gui.StudsOffset = V(0, 3, 0)
	gui.MaxDistance = 120
	gui.Parent = board
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 0.12
	text.BackgroundColor3 = Tokens.Panel
	text.TextColor3 = Tokens.Ink
	text.Font = Tokens.Font
	text.TextSize = 14
	text.TextWrapped = true
	local band = Bands.ById[def.id]
	text.Text = def.name .. "\nTrilha livre · Feras Nv. " .. band.min .. "–" .. band.max
	text.Parent = gui
end
function E.build(parent)
	local root = Instance.new("Folder")
	root.Name = "TerritoriosExploraveis"
	root.Parent = parent
	for _, def in Islands.List do
		local center = Islands.pos(def.idx)
		local ramp = Tokens.ramp(def.id)
		local region = Instance.new("Model")
		region.Name = def.id
		region:SetAttribute("Region", def.id)
		region:SetAttribute("Radius", Layout.RegionRadius)
		region.Parent = root
		local base = part(
			region,
			"SoloRegional",
			V(8, Layout.RegionRadius * 2, Layout.RegionRadius * 2),
			CFrame.new(center) * CFrame.Angles(0, 0, math.pi / 2),
			ramp[3],
			true,
			"cylinder"
		)
		base:SetAttribute("Walkable", true)
		base:SetAttribute("SurfaceY", Layout.SurfaceY)
		-- Trilhas radiais não criam paredes: terreno principal continua inteiramente caminhável.
		for ray = 1, 6 do
			local angle = ray * math.pi / 3
			local dir = V(math.cos(angle), 0, math.sin(angle))
			local length = Layout.RegionRadius - 58
			local cf = CFrame.lookAt(
				center + dir * (length * 0.5) + V(0, 4.04, 0),
				center + dir * (length * 0.5 + 1) + V(0, 4.04, 0)
			)
			part(region, "TrilhaRadial", V(34, 0.08, length), cf, ramp[4], false)
		end
		-- Três destinos elevados: piso sólido, rampas largas, nada depende de salto especial.
		for terrace = 1, 3 do
			local angle = (terrace - 1) * math.pi * 2 / 3
			local dir = V(math.cos(angle), 0, math.sin(angle))
			local offset = dir * 280
			local height = 4 + terrace * 4
			local plateauCenter = center + offset + V(0, 4 + height * 0.5, 0)
			local plateau = part(
				region,
				"Mirante" .. terrace,
				V(height, 112, 112),
				CFrame.new(plateauCenter) * CFrame.Angles(0, 0, math.pi / 2),
				ramp[terrace % 2 + 2],
				true,
				"cylinder"
			)
			plateau:SetAttribute("Walkable", true)
			plateau:SetAttribute("SurfaceY", Layout.SurfaceY + height)
			local rampCenter = center + offset - dir * 112 + V(0, 4 + height * 0.5, 0)
			local slope = part(
				region,
				"RampaDoMirante" .. terrace,
				V(56, height, 128),
				CFrame.lookAt(rampCenter, rampCenter - dir),
				ramp[3],
				true,
				"wedge"
			)
			slope:SetAttribute("Walkable", true)
			slope:SetAttribute("SlopeRise", height)
			slope:SetAttribute("SlopeRun", 128)
			-- Composição do destino: ruína aberta, mesas e pedras sem fechar o terraço.
			local top = center + offset + V(0, 4 + height, 0)
			for _, side in { -1, 1 } do
				part(region, "ColunaDoMirante", V(5, 14, 5), CFrame.new(top + V(side * 26, 7, -20)), ramp[2], true)
				part(region, "Capitel", V(8, 2, 8), CFrame.new(top + V(side * 26, 15, -20)), ramp[4], false)
			end
			part(region, "MesaDeCampo", V(12, 2, 7), CFrame.new(top + V(0, 3, -23)), ramp[2], false)
			for stone = 1, 4 do
				local a = stone * math.pi / 2
				part(
					region,
					"PedraDeBorda",
					V(8, 5, 6),
					CFrame.new(top + V(math.cos(a) * 42, 2, math.sin(a) * 42)) * CFrame.Angles(0, a, 0.1),
					ramp[2],
					false,
					"wedge"
				)
			end
		end
		-- Anel de marcos de navegação distante do acampamento inicial.
		for marker = 1, 8 do
			local a = marker * math.pi / 4 + 0.25
			local pos = center + V(math.cos(a) * 360, 4, math.sin(a) * 360)
			part(region, "MarcoDeTrilha", V(3, 7, 3), CFrame.new(pos + V(0, 3.5, 0)), ramp[2], false)
			part(region, "FitaDoMarco", V(4, 0.8, 4), CFrame.new(pos + V(0, 6, 0)), ramp[4], false)
		end
		region:SetAttribute("WalkableTerraces", 3)
	end
	local routes = Instance.new("Folder")
	routes.Name = "RotasLivres"
	routes.Parent = root
	for index = 1, #Islands.List do
		local road = Layout.route(index)
		local a, b = road.a, road.b
		local mid = (a + b) * 0.5
		local direction = (b - a).Unit
		local floor = part(
			routes,
			"Rota" .. index,
			V(road.width, 8, (b - a).Magnitude),
			CFrame.lookAt(mid, mid + direction),
			Tokens.Ramps.Sand[3],
			true
		)
		floor:SetAttribute("Walkable", true)
		floor:SetAttribute("FromRegion", road.from)
		floor:SetAttribute("ToRegion", road.to)
		floor:SetAttribute("SurfaceY", Layout.SurfaceY)
		-- Borda baixa de pedra deixa a rota legível sem criar um portão de progressão.
		local right = V(direction.Z, 0, -direction.X)
		for _, side in { -1, 1 } do
			for segment = 1, 4 do
				local t = (segment - 0.5) / 4
				local point = a:Lerp(b, t) + right * side * (road.width * 0.5 + 2)
				part(
					routes,
					"PedraLateral",
					V(3, 2, (b - a).Magnitude / 4 - 8),
					CFrame.lookAt(point + V(0, 5, 0), point + direction + V(0, 5, 0)),
					Tokens.Ramps.Metal[2],
					true
				)
			end
		end
		sign(routes, a - right * 47 + V(0, 4, 0), Islands.List[road.to])
		sign(routes, b + right * 47 + V(0, 4, 0), Islands.List[road.from])
	end
	local count = 0
	for _, p in root:GetDescendants() do
		if p:IsA("BasePart") then
			count += 1
		end
	end
	assert(count <= E.Budget, "Mundo excede orçamento de superfícies")
	root:SetAttribute("PartCount", count)
	root:SetAttribute("RegionDiameter", Layout.RegionRadius * 2)
	root:SetAttribute("RouteWidth", Layout.RouteWidth)
	return root
end
return E
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">GameService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local C = require(RS.Shared.Creatures)
local I = require(RS.Shared.Islands)
local B = require(RS.Shared.Breeding)
local Access = require(RS.Shared.Access)
local Grant = require(RS.Shared.CreatureGrant)
local Pools = require(RS.Shared.EncounterPools)
local Region = require(script.Parent.RegionService)
local Http = game:GetService("HttpService")
local M = require(RS.Shared.Missions)
local SR = require(RS.Shared.SanctuaryRules)
local CaptureRules = require(RS.Shared.CaptureRules)
local Story = require(RS.Shared.Story)
local Progression = require(RS.Shared.Progression)
local Combat = require(RS.Shared.CombatRules)
local Transport = require(script.Parent.Transport)
local Sanctuary = require(script.Parent.SanctuaryService)
local Data = require(script.Parent.DataService)
local World = require(script.Parent.World)
local G = {}
local rng = Random.new()
local Mon = require(script.Parent.MonetizationService)
local lastBattle = setmetatable({}, { __mode = "k" })
local Balance = require(RS.Shared.Economy)
local MAXLV, OFFLINE_CAP, BREED_COST = Balance.MaxLevel, Balance.OfflineCap, Balance.BreedCost
local function lvMul(lv)
	return 1 + 0.15 * (lv - 1)
end
local function bump(d, k)
	d.stats[k] = (d.stats[k] or 0) + 1
end
local function fail(m)
	return { ok = false, msg = m }
end
local function ok(p, m)
	return { ok = true, msg = m, data = Data.snapshot(p) }
end
-- Renda por tempo REAL do servidor (os.time), limitada a 8 h: alterar o relógio do cliente não adianta.
local function settle(p)
	local d = Data.get(p)
	local now = os.time()
	local mins = math.clamp(now - d.last, 0, OFFLINE_CAP) / 60
	local gold = 0
	local EV = M.event(now)
	for isl, list in d.habitat do
		for _, uid in list do
			local cr = d.creatures[uid]
			if cr then
				local cd = C.ById[cr.id]
				gold += cd.gpm * lvMul(cr.lv) * (cd.el == I.ById[isl].el and 1.5 or 1) * (cd.el == EV and 1.5 or 1) * (d.pass.Dobro and 2 or 1) * mins
			end
		end
	end
	gold = math.floor(gold)
	d.gold += gold
	d.last = now
	return gold
end
G.Actions = {}
local A = G.Actions
function A.Home(p)
	if not Sanctuary.home(p) then
		return fail(Text.PERSONAGEM_OU_DESTINO_INDISPONIVEL_AGUARDE_E_TEN_09997D)
	end
	return ok(p, Text.BEM_VINDO_AO_SEU_SANTUARIO_161FE8)
end
function A.Travel(p, id)
	local d = Data.get(p)
	local def = I.ById[id]
	if not Access.check(d, id, "travel").ok then
		return fail(Text.ACESSO_NEGADO_AB7F08)
	end
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if not def or not root then
		return fail(Text.DESTINO_INDISPONIVEL_06B531)
	end
	if not Transport.go(p, I.pos(def.idx) + Vector3.new(0, 9, 24), id) then
		return fail(Text.DESTINO_AINDA_NAO_CARREGOU_TENTE_NOVAMENTE_005D89)
	end
	return ok(p, Text.CHEGOU_A_FAE834 .. def.name)
end
function A.Companion(p, uid)
	local d = Data.get(p)
	if uid ~= nil and not d.creatures[uid] then
		return fail(Text.ESCOLHA_UMA_FERA_SUA_E1857C)
	end
	if d.companion == uid then
		d.companion = nil
	else
		d.companion = uid
	end
	World.refresh(p)
	return ok(p, d.companion and Text.COMPANHEIRO_ESCOLHIDO_411FF1 or Text.COMPANHEIRO_GUARDADO_027BB3)
end
function A.Pet(p)
	local d = Data.get(p)
	if not d.companion then
		return fail(Text.ESCOLHA_UM_COMPANHEIRO_FBC455)
	end
	p:SetAttribute("PetHappyUntil", workspace:GetServerTimeNow() + 2)
	return ok(p, Text.SEU_COMPANHEIRO_GOSTOU_DO_CARINHO_C1382F)
end
function A.BuildHabitat(p, id, slot)
	local d = Data.get(p)
	local def = I.ById[id]
	if not Access.check(d, id, "habitat").ok or not def or d.sanctuary[id] or not SR.available(d.sanctuary, slot) then
		return fail(Text.HABITAT_POSICAO_OU_DESBLOQUEIO_INVALIDO_CC4AAD)
	end
	local cost = SR.buildCost(def)
	if d.gold < cost then
		return fail(Text.PRECISA_DE_3C22C8 .. cost .. " ouro")
	end
	d.gold -= cost
	d.sanctuary[id] = { slot = slot, level = 1 }
	bump(d, "habitatBuild")
	World.refresh(p)
	return ok(p, Text.HABITAT_CONSTRUIDO_NO_SEU_TERRENO_C7F40C)
end
function A.MoveHabitat(p, id, slot)
	local d = Data.get(p)
	if not Access.check(d, id, "habitat").ok then
		return fail(Text.ACESSO_NEGADO_AB7F08)
	end
	local entry = d.sanctuary[id]
	if not entry or not SR.available(d.sanctuary, slot, id) then
		return fail(Text.POSICAO_OCUPADA_OU_INVALIDA_5582C8)
	end
	entry.slot = slot
	World.refresh(p)
	return ok(p, Text.HABITAT_MOVIDO_2E232D)
end
function A.UpgradeHabitat(p, id)
	local d = Data.get(p)
	if not Access.check(d, id, "habitat").ok then
		return fail(Text.ACESSO_NEGADO_AB7F08)
	end
	local entry = d.sanctuary[id]
	if not entry or entry.level >= SR.MaxLevel then
		return fail(Text.HABITAT_INDISPONIVEL_OU_MAXIMO_989E00)
	end
	local cost = SR.upgradeCost(entry)
	if d.gold < cost then
		return fail(Text.PRECISA_DE_3C22C8 .. cost .. " ouro")
	end
	settle(p)
	d.gold -= cost
	entry.level += 1
	bump(d, "habitatUpgrade")
	World.refresh(p)
	return ok(p, Text.HABITAT_MELHORADO_MAIS_DUAS_VAGAS_C4EEBD)
end
function A.RemoveHabitat(p, id)
	local d = Data.get(p)
	if not Access.check(d, id, "habitat").ok then
		return fail(Text.ACESSO_NEGADO_AB7F08)
	end
	if not d.sanctuary[id] or #(d.habitat[id] or {}) > 0 then
		return fail(Text.TRANSFIRA_AS_FERAS_ANTES_DE_REMOVER_O_HABITAT_C629D5)
	end
	d.sanctuary[id] = nil
	World.refresh(p)
	return ok(p, Text.ESTRUTURA_REMOVIDA_SEM_REEMBOLSO_565589)
end
function A.ClaimStory(p, id)
	local d = Data.get(p)
	if not Story.canClaim(d, id) then
		return fail(Text.CONCLUA_O_CAPITULO_ATUAL_PRIMEIRO_3187C6)
	end
	local q = Story.ById[id]
	d.storyClaimed[id] = true
	d.gold += q.gold
	d.seals = math.min(10000, d.seals + q.seals)
	Progression.award(d, q.xp)
	return ok(
		p,
		Text.CAPITULO_CONCLUIDO_BF33C2 .. q.gold .. " ouro, +" .. q.xp .. Text.XP_E_5EFA95 .. q.seals .. " selos"
	)
end
function A.CraftSeal(p, kind)
	local d = Data.get(p)
	kind = kind or "Basic"
	local recipe = CaptureRules.Seals[kind]
	if not recipe then
		return fail(Text.TIPO_DE_SELO_INVALIDO_9B6D96)
	end
	local count = kind == "Basic" and d.seals or d.sealStock[kind] or 0
	if count >= 10000 or d.gold < recipe.cost or d.playerLevel < recipe.level then
		return fail(
			Text.PRECISA_DE_NIVEL_3806D7 .. recipe.level .. " e " .. recipe.cost .. Text.OURO_LIMITE_10_MIL_SELOS_71673A
		)
	end
	if recipe.material and (d.materials[recipe.material] or 0) < recipe.amount then
		return fail(Text.PRECISA_DE_3C22C8 .. recipe.amount .. Text.ESSENCIA_DE_0F286A .. recipe.material)
	end
	d.gold -= recipe.cost
	if recipe.material then
		d.materials[recipe.material] -= recipe.amount
	end
	if kind == "Basic" then
		d.seals += 1
	else
		d.sealStock[kind] = count + 1
	end
	return ok(p, "+1 Selo " .. recipe.name)
end
function A.Get(p)
	return ok(p)
end
function A.Collect(p)
	local g = settle(p)
	bump(Data.get(p), "collect")
	return ok(p, "+" .. g .. " ouro")
end
function A.Feed(p, uid)
	local d = Data.get(p)
	local cr = d.creatures[uid]
	if not cr then
		return fail(Text.CRIATURA_INVALIDA_3A9F3E)
	end
	if cr.lv >= MAXLV then
		return fail(Text.NIVEL_MAXIMO_8078AA)
	end
	settle(p)
	local cost = cr.lv * 20
	if d.gold < cost then
		return fail(Text.OURO_INSUFICIENTE_AF56CF .. cost .. ")")
	end
	d.gold -= cost
	cr.lv += 1
	bump(d, "feed")
	World.refresh(p)
	return ok(
		p,
		Text.SUBIU_PARA_O_NIVEL_0AB637
			.. cr.lv
			.. (C.stage(cr.lv, cr.id) > C.stage(cr.lv - 1, cr.id) and " — EVOLUIU!" or "")
	)
end
function A.Place(p, uid, isl)
	local d = Data.get(p)
	local def = I.ById[isl]
	if not d.creatures[uid] or not def or not Access.check(d, isl, "habitat").ok then
		return fail(Text.ILHA_OU_CRIATURA_INVALIDA_000968)
	end
	local structure = d.sanctuary[isl]
	if not structure then
		return fail(Text.CONSTRUA_ESSE_HABITAT_NO_SANTUARIO_6A9DF1)
	end
	local creature = C.ById[d.creatures[uid].id]
	if creature.el ~= def.el and not (creature.hybrid and table.find(creature.hybrid, def.el)) then
		return fail(Text.ELEMENTO_INCOMPATIVEL_COM_ESTE_HABITAT_30076C)
	end
	local list = d.habitat[isl] or {}
	if #list - (table.find(list, uid) and 1 or 0) >= SR.capacity(def, structure) then
		return fail(Text.HABITAT_CHEIO_1E10B0)
	end
	settle(p)
	for _, l in d.habitat do
		local i = table.find(l, uid)
		if i then
			table.remove(l, i)
		end
	end
	d.habitat[isl] = d.habitat[isl] or {}
	table.insert(d.habitat[isl], uid)
	World.refresh(p)
	return ok(p, C.ById[d.creatures[uid].id].name .. Text.AGORA_VIVE_EM_207F92 .. def.name)
end
function A.Unlock(p, isl)
	local d = Data.get(p)
	local check = Access.check(d, isl, "unlock")
	if not check.ok then
		return fail(check.reason)
	end
	if require(RS.Shared.Config).World.FreeExploration then
		return ok(p, "Região livre para explorar; nenhum ouro foi cobrado.")
	end
	if d.unlocked[isl] then
		return fail(Text.JA_DESBLOQUEADA_118724)
	end
	d.gold -= I.ById[isl].cost
	d.unlocked[isl] = true
	return ok(p, Text.REGIAO_DESBLOQUEADA_561460)
end
function A.Breed(p, a, b)
	local d = Data.get(p)
	if a == b or not d.creatures[a] or not d.creatures[b] then
		return fail(Text.ESCOLHA_DUAS_FERAS_DIFERENTES_D70C07)
	end
	if #d.eggs >= Balance.IncubatorSlots then
		return fail(Text.CHOCADEIRA_CHEIA_3D3160)
	end
	if d.gold < BREED_COST then
		return fail(Text.PRECISA_DE_3C22C8 .. BREED_COST .. " ouro")
	end
	d.gold -= BREED_COST
	bump(d, "breed")
	local id = B.pick(d.creatures[a].id, d.creatures[b].id, rng)
	local r = C.ById[id].rar
	table.insert(d.eggs, {
		id = id,
		ready = os.time() + Balance.IncubationBase * r * r,
		nonce = "egg:" .. Http:GenerateGUID(false),
		region = (Data.session(p) and Data.session(p).lastSafe) or "Alvorecer",
	})
	return ok(p, Text.OVO_MISTERIOSO_ECLODE_EM_F655A9 .. Balance.IncubationBase * r * r .. "s")
end
function A.Hatch(p, i)
	local d = Data.get(p)
	local e = typeof(i) == "number" and d.eggs[i]
	if not e then
		return fail(Text.OVO_INVALIDO_5146F8)
	end
	if os.time() < e.ready then
		return fail(Text.AINDA_NAO_ECLODIU_EB8B13)
	end
	local n = 0
	for _ in d.creatures do
		n += 1
	end
	if n >= Balance.InventoryLimit then
		return fail(Text.LIMITE_DE_60_FERAS_E2D3F3)
	end
	local check = Region.requireContext(p, e.region or "Alvorecer", "hatch", true)
	if not check.ok then
		return fail(check.reason)
	end
	local nonce = e.nonce
	if not nonce then
		return fail(Text.OVO_SEM_IDENTIFICACAO_RECONECTE_PARA_MIGRAR_D37C37)
	end
	local origin = d.legacyEggPermits and d.legacyEggPermits[nonce] and "legacy_egg" or "hatch"
	local uid, reason = Grant.grant(d, e.id, origin, nonce, { level = 1 })
	if not uid then
		return fail(reason)
	end
	table.remove(d.eggs, i)
	bump(d, "hatch")
	return ok(p, "Nasceu " .. C.ById[e.id].name .. "!")
end
function A.Battle(p, uid, isl)
	local d = Data.get(p)
	local actual = Region.current(p, "battle")
	if actual ~= isl then
		return fail("WRONG_REGION")
	end
	local cr = d.creatures[uid]
	local def = I.ById[actual]
	if not cr or not def then
		return fail(Text.BATALHA_INVALIDA_A8AE42)
	end
	if lastBattle[p] and os.clock() - lastBattle[p] < 20 then
		return fail(Text.SUAS_FERAS_DESCANSAM_6D6F29 .. math.ceil(20 - (os.clock() - lastBattle[p])) .. "s")
	end
	lastBattle[p] = os.clock()
	bump(d, "fight")
	local pool = Pools.list(actual, false)
	if #pool == 0 then
		return fail(Text.SEM_ENCONTROS_GERAIS_NESTA_REGIAO_ED1AF7)
	end
	local g = pool[rng:NextInteger(1, #pool)]
	local glv = Pools.rollLevel(actual, g.rar, rng)
	local log, win = Combat.resolve(cr.id, cr.lv, g.id, glv, rng)
	local info = { log = log, me = { id = cr.id, lv = cr.lv }, foe = { id = g.id, lv = glv }, win = win }
	if not win then
		local response =
			ok(p, Text.DERROTA_PARA_F29D4F .. g.name .. " (Nv." .. glv .. Text.TREINE_E_TENTE_DE_NOVO_74F9F0)
		response.battle = info
		return response
	end
	local reward = Progression.rewards(actual, glv, g.rar, cr.lv)
	Progression.award(d, reward.xp)
	Progression.awardCreature(cr, reward.creatureXp)
	local gold = reward.gold
	local gem = rng:NextNumber() < 0.2 and 1 or 0
	d.gold += gold
	d.gems += gem
	d.wins += 1
	bump(d, "win")
	local r = ok(p, Text.VITORIA_SOBRE_36EFE4 .. g.name .. "! +" .. gold .. " ouro" .. (gem > 0 and " +1 gema" or ""))
	r.battle = info
	return r
end

function A.Claim(p, id)
	local d = Data.get(p)
	local m = M.ById[id]
	if not m or d.claimed[id] or M.progress(d, m.stat) < m.goal then
		return fail(Text.MISSAO_INDISPONIVEL_EE2728)
	end
	d.claimed[id] = true
	d.gold += m.gold
	d.gems += m.gems
	return ok(p, "Recompensa: +" .. m.gold .. " ouro, +" .. m.gems .. " gemas")
end
function A.BuyEgg(p, isl)
	local d = Data.get(p)
	local def = I.ById[isl]
	local access = Region.requireContext(p, isl, "shop", true)
	if not def or not access.ok then
		return fail(access.reason)
	end
	if #d.eggs >= Balance.IncubatorSlots then
		return fail(Text.CHOCADEIRA_CHEIA_3D3160)
	end
	local cost = 80 * def.idx
	if d.gold < cost then
		return fail(Text.PRECISA_DE_3C22C8 .. cost .. " ouro")
	end
	local pick = Pools.pick(isl, rng, true)
	if not pick then
		return fail(Text.SEM_OVOS_GERAIS_NESTA_REGIAO_623A41)
	end
	d.gold -= cost
	table.insert(d.eggs, {
		id = pick.id,
		ready = os.time() + Balance.IncubationBase * pick.rar * pick.rar,
		nonce = "egg:" .. Http:GenerateGUID(false),
		region = isl,
	})
	return ok(p, Text.OVO_DE_763A79 .. def.name .. " comprado!")
end
function A.Speed(p, i)
	local d = Data.get(p)
	local e = typeof(i) == "number" and d.eggs[i]
	if not e then
		return fail(Text.OVO_INVALIDO_5146F8)
	end
	local left = e.ready - os.time()
	if left <= 0 then
		return fail(Text.JA_PODE_CHOCAR_035D5F)
	end
	local cost = math.max(1, math.ceil(left / 30))
	if d.gems < cost then
		return fail(Text.PRECISA_DE_3C22C8 .. cost .. " gemas")
	end
	d.gems -= cost
	e.ready = os.time()
	return ok(p, Text.OVO_ACELERADO_AB603C)
end
function A.Daily(p)
	local d = Data.get(p)
	local today = os.time() // 86400
	if d.dailyDay >= today then
		return fail(Text.VOLTE_AMANHA_E195DE)
	end
	d.streak = (d.dailyDay == today - 1) and d.streak + 1 or 1
	d.dailyDay = today
	local gold = 50 * math.min(d.streak, 7)
	local gem = d.streak % 3 == 0 and 1 or 0
	d.gold += gold
	d.gems += gem
	return ok(p, "Dia " .. d.streak .. " seguido: +" .. gold .. " ouro" .. (gem > 0 and " +1 gema" or ""))
end
function A.Buy(p, key)
	if typeof(key) ~= "string" then
		return fail(Text.ITEM_INVALIDO_96E69E)
	end
	local s, m = Mon.buy(p, key)
	if not s then
		return fail(m)
	end
	return ok(p, Text.ABRINDO_A_COMPRA_5DF77F)
end
local Players = game:GetService("Players")
local invitations = {}
local lastDuel = setmetatable({}, { __mode = "k" })
local function sim(ca, la, cb, lb)
	return Combat.resolve(ca.id, la, cb.id, lb, rng)
end
local function best(d)
	local b, bs
	for _, cr in d.creatures do
		local sc = C.ById[cr.id].rar * 10 + cr.lv
		if not bs or sc > bs then
			b, bs = cr, sc
		end
	end
	return b
end
-- Duelo online: sua melhor fera contra a melhor fera de outro jogador do servidor (o rival não perde nada).
function A.Duel(p, tid)
	local t = typeof(tid) == "number" and Players:GetPlayerByUserId(tid)
	local d = Data.get(p)
	local td = t and Data.get(t)
	if not td or t == p then
		return fail(Text.JOGADOR_INDISPONIVEL_D18F3F)
	end
	local key = tostring(p.UserId) .. ":" .. tostring(t.UserId)
	local reverse = tostring(t.UserId) .. ":" .. tostring(p.UserId)
	if not invitations[reverse] or invitations[reverse] < os.clock() then
		invitations[key] = os.clock() + 30
		return ok(p, Text.CONVITE_ENVIADO_O_RIVAL_DEVE_TOCAR_DESAFIAR_NO_S_D712DA)
	end
	invitations[reverse] = nil
	invitations[key] = nil
	if lastDuel[p] and os.clock() - lastDuel[p] < 30 then
		return fail(Text.SUAS_FERAS_DESCANSAM_6D6F29 .. math.ceil(30 - (os.clock() - lastDuel[p])) .. "s")
	end
	lastDuel[p] = os.clock()
	local a, b = best(d), best(td)
	local log, win = sim(C.ById[a.id], a.lv, C.ById[b.id], b.lv)
	local info = { log = log, me = { id = a.id, lv = a.lv }, foe = { id = b.id, lv = b.lv }, win = win }
	if not win then
		local r = ok(p, Text.DERROTA_PARA_F29D4F .. t.DisplayName .. Text.TREINE_E_TENTE_DE_NOVO_F77824)
		r.battle = info
		return r
	end
	local gold = 40 + 5 * b.lv
	d.gold += gold
	d.trophies += 1
	bump(d, "duelwin")
	local r = ok(p, Text.VITORIA_CONTRA_F35782 .. t.DisplayName .. "! +" .. gold .. Text.OURO_1_TROFEU_AC2EBF)
	r.battle = info
	return r
end
function A.Tut(p)
	Data.get(p).tut = true
	return ok(p, Text.TUTORIAL_CONCLUIDO_EE21ED)
end
return G
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">Guardians</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local I = require(RS.Shared.Islands)
local C = require(RS.Shared.Creatures)
local MF = require(RS.Shared.ModelFactory)
local Data = require(script.Parent.DataService)
local Encounters = require(script.Parent.EncounterService)
local Species = require(RS.Shared.SpeciesRules)
local Bands = require(RS.Shared.LevelBands)
local Region = require(script.Parent.RegionService)
local G = {}
function G.start()
	local folder = Instance.new("Folder")
	folder.Name = "Guardioes"
	folder.Parent = workspace
	for _, island in I.List do
		local chosen
		for _, def in C.List do
			if def.el == island.el and not def.hybrid and def.rar >= 3 and Species.isGeneral(def.id) then
				chosen = def
				break
			end
		end
		if not chosen then
			continue
		end
		local level = Bands.ById[island.id].guardian
		local model = MF.build(chosen, level)
		local box, size = model:GetBoundingBox()
		local lift = model:GetPivot().Position.Y - (box.Position.Y - size.Y / 2)
		model:PivotTo(CFrame.new(I.pos(island.idx) + Vector3.new(-20, 4 + lift, 8)))
		model.Parent = folder
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = Text.DESAFIAR_GUARDIAO_C2DC77
		prompt.ObjectText = island.name .. " • Nv." .. level
		prompt.HoldDuration = 0.8
		prompt.MaxActivationDistance = 11
		prompt.Parent = model.PrimaryPart
		prompt.Triggered:Connect(function(p)
			local d = Data.get(p)
			local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if
				not d
				or not root
				or (root.Position - model.PrimaryPart.Position).Magnitude > 13
				or not require(RS.Shared.Access).check(d, island.id, "battle").ok
				or Encounters.active(p)
			then
				return
			end
			if not Region.requireCurrent(p, island.id, "battle").ok then
				return
			end
			if d.guardians[island.id] then
				local notice = RS:FindFirstChild("WildNotice")
				if notice then
					notice:FireClient(p, Text.VOCE_JA_CONCLUIU_ESTE_DESAFIO_DE_GUARDIAO_12DC0F)
				end
				return
			end
			Encounters.open(p, {
				id = chosen.id,
				lv = level,
				position = model.PrimaryPart.Position,
				capturable = false,
				guardianId = island.id,
				region = island.id,
				statMultiplier = 1.17,
			}, function()
				model:SetAttribute("LastChallengeEnded", os.time())
			end)
		end)
	end
end
return G
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">IslandArchitecture</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Silhueta estratificada cenográfica; piso e colisão originais ficam em World.
local T = require(game:GetService("ReplicatedStorage").Shared.ArtTokens)
local Layout = require(game:GetService("ReplicatedStorage").Shared.WorldLayout)
local A = {}
local V = Vector3.new
function A.build(parent, center, def)
	local group = Instance.new("Folder")
	group.Name = "Geologia_" .. def.id
	group.Parent = parent
	local ramp = T.ramp(def.id)
	local function slab(size, offset, color, rotation, kind)
		local p = Instance.new(kind == "wedge" and "WedgePart" or "Part")
		p.Name = "Estrato"
		p.Size = size
		p.CFrame = CFrame.new(center + offset) * (rotation or CFrame.identity)
		p.Color = color
		p.Material = Enum.Material.SmoothPlastic
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Parent = group
		return p
	end
	-- Grandes planos recortados, com bordas quentes em cima e sombras frias abaixo.
	for tier = 1, 3 do
		local radius = Layout.RegionRadius - tier * 18
		for side = 1, 16 do
			local angle = side * math.pi / 8
			slab(
				V(168, 18, 26),
				V(math.cos(angle) * radius, -tier * 16 + 1, math.sin(angle) * radius),
				ramp[math.max(1, 4 - tier)],
				CFrame.Angles(0, -angle + math.pi / 2, 0.06 * (side % 2)),
				tier == 3 and "wedge" or nil
			)
		end
	end
	slab(V(630, 28, 630), V(0, -44, 0), ramp[1], CFrame.Angles(0, math.pi / 4, 0), "wedge")
	-- Veios de cor mantêm o mesmo material fosco e não criam pontos luminosos sem motivo.
	for index = 1, 4 do
		local angle = index * math.pi / 2 + 0.3
		slab(
			V(38, 1.5, 4),
			V(math.cos(angle) * (Layout.RegionRadius - 5), -3.2, math.sin(angle) * (Layout.RegionRadius - 5)),
			ramp[3],
			CFrame.Angles(0, -angle + math.pi / 2, 0)
		)
	end
	return group
end
return A
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="51">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!nonstrict
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Data = require(script.Parent.DataService)
local World = require(script.Parent.World)
local G = require(script.Parent.GameService)
local Mon = require(script.Parent.MonetizationService)
local Encounters = require(script.Parent.EncounterService)
local physics = game:GetService("PhysicsService")
pcall(function()
	physics:RegisterCollisionGroup("Creatures")
end)
physics:CollisionGroupSetCollidable("Creatures", "Default", false)
physics:CollisionGroupSetCollidable("Creatures", "Creatures", false)
Encounters.start()
World.build()
require(script.Parent.RegionGuard).start()
require(script.Parent.StartingCamp).build()
require(script.Parent.Researcher).start()
require(script.Parent.Wildlife).start()
require(script.Parent.Guardians).start()
require(script.Parent.SanctuaryBuilder).build()
local Net = Instance.new("RemoteFunction")
Net.Name = "Net"
Net.Parent = RS
local last = {}
local busy = {}
local function argument(v)
	return v == nil
		or (typeof(v) == "string" and #v <= 80)
		or (typeof(v) == "number" and v == v and math.abs(v) < 1e12 and v % 1 == 0)
end
Net.OnServerInvoke = function(p, action, a, b)
	if typeof(action) ~= "string" or not argument(a) or not argument(b) then
		return
	end
	local t = os.clock()
	if last[p] and t - last[p] < 0.15 then
		return { ok = false, msg = "Calma!" }
	end
	last[p] = t
	if Encounters.active(p) and action ~= "Get" then
		return { ok = false, msg = "Termine ou abandone o encontro primeiro." }
	end
	local f = G.Actions[action]
	if not f or not Data.get(p) then
		return { ok = false, msg = "Indisponível" }
	end
	if busy[p] then
		return { ok = false, msg = "Aguarde a ação anterior" }
	end
	busy[p] = true
	local s, r = pcall(f, p, a, b)
	busy[p] = nil
	if s then
		return r
	end
	warn(r)
	return { ok = false, msg = "Erro interno" }
end
local function join(p)
	if Data.load(p) then
		if p.Parent ~= Players then
			Data.release(p)
			return
		end
		require(script.Parent.RegionGuard).initialize(p)
		Mon.refresh(p)
		World.refresh(p)
	end
end
Players.PlayerAdded:Connect(join)
for _, p in Players:GetPlayers() do
	task.spawn(join, p)
end
Players.PlayerRemoving:Connect(function(p)
	while busy[p] do
		task.wait()
	end
	require(script.Parent.SanctuaryService).release(p)
	Data.release(p)
	last[p] = nil
	busy[p] = nil
	local f = workspace:FindFirstChild("Criaturas")
	local m = f and f:FindFirstChild(tostring(p.UserId))
	if m then
		m:Destroy()
	end
end)
task.spawn(function()
	while true do
		task.wait(60)
		Data.saveAll()
	end
end)
game:BindToClose(function()
	Data.closeAll()
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Só itens opcionais: gemas (pacotes), passe de ouro em dobro e aura cosmética. Nada bloqueia o jogo gratuito.
local MPS = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local Data = require(script.Parent.DataService)
-- Crie os itens em create.roblox.com e cole os IDs aqui (0 = desativado).
local Products = { Gems100 = { id = 0, gems = 100 }, Gems500 = { id = 0, gems = 500 } }
local Passes = { Dobro = 0, Aura = 0 }
local S = {}
function S.refresh(p)
	local d = Data.get(p)
	if not d then
		return
	end
	for k, id in Passes do
		if id > 0 then
			local ok, own = pcall(function()
				return MPS:UserOwnsGamePassAsync(p.UserId, id)
			end)
			if ok and own then
				d.pass[k] = true
			end
		end
	end
end
function S.buy(p, key)
	if true then
		return false, "Compras reais desativadas nesta versão de testes"
	end
	local pr = Products[key]
	if pr then
		if pr.id == 0 then
			return false, "Produto ainda não configurado"
		end
		MPS:PromptProductPurchase(p, pr.id)
		return true
	end
	if Passes[key] then
		if Passes[key] == 0 then
			return false, "Passe ainda não configurado"
		end
		MPS:PromptGamePassPurchase(p, Passes[key])
		return true
	end
	return false, "Item inválido"
end
MPS.ProcessReceipt = function(info)
	local N = Enum.ProductPurchaseDecision
	local p = Players:GetPlayerByUserId(info.PlayerId)
	local d = p and Data.get(p)
	if not d then
		return N.NotProcessedYet
	end
	local key = tostring(info.PurchaseId)
	if d.receipts[key] then
		return N.PurchaseGranted
	end
	for _, pr in Products do
		if pr.id == info.ProductId then
			d.gems += pr.gems
			d.receipts[key] = true
			if Data.save(p) then
				return N.PurchaseGranted
			end
			d.gems -= pr.gems
			d.receipts[key] = nil
			return N.NotProcessedYet
		end
	end
	return N.NotProcessedYet
end
MPS.PromptGamePassPurchaseFinished:Connect(function(p, id, bought)
	local d = Data.get(p)
	if not (d and bought) then
		return
	end
	for k, v in Passes do
		if v == id then
			d.pass[k] = true
		end
	end
end)
return S
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">RegionGuard</string>
          <string name="Source"><![CDATA[--!nonstrict
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local I = require(RS.Shared.Islands)
local Access = require(RS.Shared.Access)
local Data = require(script.Parent.DataService)
local Region = require(script.Parent.RegionService)
local G = {}
local spawns = {}
local notices = {}
function G.best(d)
	local checkpoint = d.navigation and d.navigation.checkpoint
	if checkpoint and I.ById[checkpoint] and Access.check(d, checkpoint, "travel").ok then
		return checkpoint
	end
	return "Alvorecer"
end
function G.inspect(d, s, position)
	if
		typeof(position) ~= "Vector3"
		or position.X ~= position.X
		or position.Y ~= position.Y
		or position.Z ~= position.Z
		or math.abs(position.X) > 100000
		or math.abs(position.Z) > 100000
		or position.Y < -65
	then
		return { ok = false, reason = "RETURN_TO_CAMP", safe = s.lastSafe or "Alvorecer" }
	end
	local id, kind = Region.detect(position)
	if not id then
		return { ok = true }
	end
	local access = Access.check(d, id, "travel")
	if not access.ok then
		return { ok = false, reason = access.reason, safe = s.lastSafe or "Alvorecer" }
	end
	return { ok = true, island = id, kind = kind }
end
function G.initialize(p)
	local d = Data.get(p)
	local s = Data.session(p)
	if not d or not s then
		return
	end
	local best = G.best(d)
	p.RespawnLocation = spawns[best]
	s.lastSafe = best
	local function respawn(character)
		s.spawning = true
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root and Data.get(p) and p.Character == character then
			character:PivotTo(CFrame.new(Region.safePoint(s.lastSafe)))
			Region.note(p, s.lastSafe, "region")
		end
		s.spawning = false
	end
	p.CharacterAdded:Connect(respawn)
	if p.Character then
		task.spawn(respawn, p.Character)
	end
end
function G.tick(p)
	local d = Data.get(p)
	local s = Data.session(p)
	local char = p.Character
	local part = char and char:FindFirstChild("HumanoidRootPart")
	if not d or not s or not part or s.transporting or s.spawning then
		return
	end
	local result = G.inspect(d, s, part.Position)
	if not result.ok then
		char:PivotTo(CFrame.new(Region.safePoint(result.safe)))
		Region.note(p, result.safe, "region")
		if not notices[p] or os.clock() - notices[p] > 3 then
			local event = RS:FindFirstChild("WildNotice")
			if event then
				event:FireClient(p, "Você retornou ao último acampamento seguro.")
			end
			notices[p] = os.clock()
		end
	elseif result.island then
		Region.note(p, result.island, result.kind)
		if result.kind ~= "route" then
			p.RespawnLocation = spawns[result.island]
		end
	end
end
function G.start()
	local folder = Instance.new("Folder")
	folder.Name = "PontosSeguros"
	folder.Parent = workspace
	for _, def in I.List do
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = def.id
		spawn.Size = Vector3.new(8, 1, 8)
		spawn.Anchored = true
		spawn.Neutral = true
		spawn.Transparency = 1
		spawn.CanCollide = false
		spawn.Position = Region.safePoint(def.id)
		spawn.Parent = folder
		spawns[def.id] = spawn
	end
	Players.PlayerRemoving:Connect(function(p)
		notices[p] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			for _, p in Players:GetPlayers() do
				G.tick(p)
			end
		end
	end)
end
return G
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">RegionService</string>
          <string name="Source"><![CDATA[--!nonstrict
local RS = game:GetService("ReplicatedStorage")
local I = require(RS.Shared.Islands)
local Layout = require(RS.Shared.WorldLayout)
local Access = require(RS.Shared.Access)
local Data = require(script.Parent.DataService)
local R = {}
function R.detect(position)
	local index, kind = Layout.detect(position)
	return index and I.List[index].id or nil, kind
end
function R.note(p, id, kind)
	local d = Data.get(p)
	local s = Data.session(p)
	if not d or not s then
		return
	end
	s.region = id
	if kind ~= "route" then
		s.lastSafe = id
		d.navigation = d.navigation or { visited = { Alvorecer = true }, checkpoint = "Alvorecer" }
		d.navigation.visited[id] = true
		d.navigation.checkpoint = id
		local count = 0
		for _, v in d.navigation.visited do
			if v then
				count += 1
			end
		end
		d.stats = d.stats or {}
		d.stats.regionVisit = math.max(d.stats.regionVisit or 0, count)
	end
	if p.SetAttribute then
		p:SetAttribute("RegionId", id)
	end
end
function R.current(p, purpose)
	local d = Data.get(p)
	local session = Data.session(p)
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if not d or not session or not root or session.transporting then
		return nil
	end
	local id, kind = R.detect(root.Position)
	if id and Access.check(d, id, purpose or "encounter").ok then
		R.note(p, id, kind)
		return id
	end
	if session.region == "sanctuary" and require(script.Parent.SanctuaryService).contains(p, root.Position) then
		return "sanctuary"
	end
	return nil
end
function R.requireCurrent(p, id, purpose)
	local result = Access.check(Data.get(p), id, purpose)
	if not result.ok then
		return result
	end
	if R.current(p, purpose) ~= id then
		return { ok = false, reason = "WRONG_REGION" }
	end
	return result
end
function R.requireContext(p, id, purpose, allowHome)
	local result = Access.check(Data.get(p), id, purpose)
	if not result.ok then
		return result
	end
	if allowHome and R.current(p, purpose) == "sanctuary" then
		return result
	end
	return R.requireCurrent(p, id, purpose)
end
function R.safePoint(id)
	return Layout.safePoint((I.ById[id] or I.ById.Alvorecer).idx)
end
return R
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">Researcher</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local Data = require(script.Parent.DataService)
local Story = require(RS.Shared.Story)
local I = require(RS.Shared.Islands)
local Art = require(script.Parent.WorldArt)
local R = {}
function R.start()
	local event = Instance.new("RemoteEvent")
	event.Name = "StoryNotice"
	event.Parent = RS
	local model = Instance.new("Model")
	model.Name = Text.MAIA_PESQUISADORA_1A62F7
	model.Parent = workspace
	local base = I.pos(1) + Vector3.new(19, 4, 23)
	local function part(name, size, offset, color, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Position = base + offset
		p.Color = color
		p.Shape = shape or Enum.PartType.Block
		p.Anchored = true
		p.CanCollide = false
		p.Parent = model
		return p
	end
	local torso = part("Casaco", Vector3.new(2.2, 2.5, 1), Vector3.new(0, 2.8, 0), Color3.fromRGB(62, 121, 115))
	local _head = part(
		Text.CABECA_D8228B,
		Vector3.new(1.7, 1.7, 1.7),
		Vector3.new(0, 4.7, 0),
		Color3.fromRGB(205, 159, 123),
		Enum.PartType.Ball
	)
	for _, side in { -1, 1 } do
		part("Bota", Vector3.new(0.8, 1.6, 1), Vector3.new(side * 0.6, 0.9, 0), Color3.fromRGB(65, 65, 77))
		part(
			Text.BRACO_DB4D66,
			Vector3.new(0.65, 2.2, 0.7),
			Vector3.new(side * 1.5, 2.7, 0),
			Color3.fromRGB(62, 121, 115)
		)
	end
	Art.researcher(model, base)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = Text.CONVERSAR_AC3B38
	prompt.ObjectText = Text.MAIA_PESQUISADORA_DO_ARQUIPELAGO_38D949
	prompt.HoldDuration = 0.2
	prompt.MaxActivationDistance = 10
	prompt.Parent = torso
	prompt.Triggered:Connect(function(p)
		local d = Data.get(p)
		local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if not d or not root or (root.Position - torso.Position).Magnitude > 12 then
			return
		end
		local q = Story.current(d)
		event:FireClient(
			p,
			q
					and ("Maia: " .. q.text .. " (" .. Story.progress(d, q) .. "/" .. q.goal .. Text.VEJA_MISSOES_PARA_RECEBER_A_RECOMPENSA_8B5929)
				or Text.MAIA_VOCE_CONCLUIU_NOSSOS_PRIMEIROS_ESTUDOS_CONT_FCC227
		)
	end)
end
return R
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">SanctuaryBuilder</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local I = require(RS.Shared.Islands)
local Tokens = require(RS.Shared.ArtTokens)
local Data = require(script.Parent.DataService)
local Quest = require(RS.Shared.PhoenixQuest)
local Region = require(script.Parent.RegionService)
local B = {}
local origin = I.pos(I.ById.Dunas.idx) + Vector3.new(0, 4, -23)
function B.altarPosition()
	return origin + Vector3.new(0, 1, 0)
end
function B.build()
	local root = Instance.new("Model")
	root.Name = "RuinasAntigas"
	root.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	root.Parent = workspace
	local function part(name, size, pos, color, material, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Position = pos
		p.Color = Tokens.nearest(color)
		p.Material = material == Enum.Material.Neon and Enum.Material.Neon or Enum.Material.SmoothPlastic
		p.Shape = shape or Enum.PartType.Block
		p.Anchored = true
		p.CanTouch = false
		p.CanCollide = false
		p.Parent = root
		return p
	end
	local floor = part(
		"Piso",
		Vector3.new(32, 0.8, 26),
		origin - Vector3.new(0, 0.8, 0),
		Color3.fromRGB(91, 72, 63),
		Enum.Material.Basalt
	)
	floor.CanCollide = true
	for _, side in { -1, 1 } do
		local wall =
			part("Muralha", Vector3.new(1, 12, 26), origin + Vector3.new(side * 16, 5, 0), Color3.fromRGB(103, 81, 67))
		wall.CanCollide = true
	end
	local rear = part("Parede", Vector3.new(32, 12, 1), origin + Vector3.new(0, 5, -13), Color3.fromRGB(103, 81, 67))
	rear.CanCollide = true
	local roof = part("Abobada", Vector3.new(32, 1, 26), origin + Vector3.new(0, 11, 0), Color3.fromRGB(72, 60, 58))
	roof.CanCollide = true
	local gate =
		part("LajeSelada", Vector3.new(10, 10, 1), origin + Vector3.new(0, 4, 13), Color3.fromRGB(158, 111, 66))
	gate:SetAttribute("AncientGate", true)
	for _, side in { -1, 1 } do
		local front = part(
			"Entrada",
			Vector3.new(11, 12, 1),
			origin + Vector3.new(side * 10.5, 5, 13),
			Color3.fromRGB(103, 81, 67)
		)
		front.CanCollide = true
	end
	local stone = Tokens.Ramps.Sand[2]
	local gold = Tokens.Ramps.Sand[4]
	for i = 1, 12 do
		local a = i * math.pi / 6
		local p = part(
			"Fragmento",
			Vector3.new(2, 7 + i % 3, 2),
			origin + Vector3.new(math.cos(a) * 13, 3, math.sin(a) * 10),
			stone
		)
		p.CFrame *= CFrame.Angles(0, a, 0.08)
		if i % 2 == 0 then
			part("Arco", Vector3.new(6, 1.3, 2.5), p.Position + Vector3.new(0, 4, 0), stone)
		end
	end
	for i = 1, 16 do
		local a = i * math.pi / 8
		local p = part(
			Text.INSCRICAO_3A97CD,
			Vector3.new(1.2, 0.12, 2),
			origin + Vector3.new(math.cos(a) * 8, 0.15, math.sin(a) * 8),
			gold,
			Enum.Material.Neon
		)
		p.CFrame *= CFrame.Angles(0, -a, 0)
	end
	local altar = part("PedraCentral", Vector3.new(1, 6, 6), origin, gold, Enum.Material.Slate, Enum.PartType.Cylinder)
	altar.CFrame *= CFrame.Angles(0, 0, math.pi / 2)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ObjectText = Text.PEDRA_ANTIGA_ACE013
	prompt.ActionText = Text.EXAMINAR_F96563
	prompt.HoldDuration = 1
	prompt.MaxActivationDistance = 12
	prompt.Parent = altar
	prompt.Triggered:Connect(function(p)
		local d = Data.get(p)
		local event = RS:FindFirstChild("WildNotice")
		if not d then
			return
		end
		local ok, reason = require(script.Parent.EncounterService).startSpecial(p, "phoenix_solar")
		if not ok and event then
			event:FireClient(
				p,
				reason == "COOLDOWN"
						and (Text.AS_MARCAS_REPOUSAM_POR_F8A177 .. math.max(0, d.phoenix.nextAttemptAt - os.time()) .. "s")
					or Text.AS_MARCAS_AINDA_NAO_RESPONDEM_A_SUA_PRESENCA_12E579
			)
		end
	end)
	for i = 1, 8 do
		local a = i * math.pi / 4
		local rock = part(
			"Rocha",
			Vector3.new(2 + i % 2, 1.5, 2),
			origin + Vector3.new(math.cos(a) * 12, 0, math.sin(a) * 9),
			stone,
			Enum.Material.Basalt
		)
		rock.CFrame *= CFrame.Angles(0.2, a, 0.15)
		local crystal = part(
			"Cristal",
			Vector3.new(0.7, 2 + i % 3, 0.7),
			rock.Position + Vector3.new(0, 1.5, 0),
			gold,
			Enum.Material.Neon
		)
		crystal.CFrame *= CFrame.Angles(0, a, 0.2)
	end
	local glyphs = {
		{ id = "duneHidden", region = "Dunas", offset = Vector3.new(27, 5, -10) },
		{ id = "duneRuin", region = "Dunas", offset = Vector3.new(-26, 15, 10) },
		{ id = "skyPeak", region = "Picos", offset = Vector3.new(20, 16, -20) },
	}
	for _, g in glyphs do
		local p = part(
			Text.VESTIGIO_A22F5D,
			Vector3.new(1.5, 2.5, 1),
			I.pos(I.ById[g.region].idx) + g.offset,
			gold,
			Enum.Material.Neon
		)
		if g.id ~= "duneHidden" then
			for step = 1, 5 do
				local platform = part(
					"Degrau",
					Vector3.new(4, 1, 4),
					p.Position + Vector3.new((step - 5) * 3, step * 2 - 11, 0),
					stone
				)
				platform.CanCollide = true
			end
		else
			for _, side in { -1, 1 } do
				part(
					"Abrigo",
					Vector3.new(2, 5, 4),
					p.Position + Vector3.new(side * 2, -0.5, 0),
					stone,
					Enum.Material.Basalt
				)
			end
		end
		local glyphPrompt = Instance.new("ProximityPrompt")
		glyphPrompt.ObjectText = Text.MARCA_ANTIGA_9C4D11
		glyphPrompt.ActionText = Text.EXAMINAR_F96563
		glyphPrompt.HoldDuration = 0.5
		glyphPrompt.MaxActivationDistance = 10
		glyphPrompt.Parent = p
		glyphPrompt.Triggered:Connect(function(player)
			local d = Data.get(player)
			local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if
				not d
				or not hrp
				or (hrp.Position - p.Position).Magnitude > 12
				or not Region.requireCurrent(player, g.region, "encounter").ok
			then
				return
			end
			if not Quest.Glyphs[g.id] or d.phoenix.glyphs[g.id] then
				return
			end
			d.phoenix.glyphs[g.id] = true
			d.phoenix.sanctuaryOpen = Quest.stage(d) == 3
			local event = RS:FindFirstChild("WildNotice")
			if event then
				event:FireClient(player, Quest.public(d).hint)
			end
		end)
	end
	local parts = 0
	for _, obj in root:GetDescendants() do
		if obj:IsA("BasePart") then
			parts += 1
		end
	end
	assert(parts <= 400, Text.RUINAS_EXCEDEM_ORCAMENTO_6CD117)
end
return B
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">SanctuaryService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local Data = require(script.Parent.DataService)
local I = require(RS.Shared.Islands)
local Rules = require(RS.Shared.SanctuaryRules)
local Art = require(script.Parent.WorldArt)
local Layout = require(RS.Shared.WorldLayout)
local Tokens = require(RS.Shared.ArtTokens)
local S = {}
local plots = {}
local used = {}
local V = Vector3.new
local function part(parent, name, size, position, color, material, collide, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Position = position
	p.Anchored = true
	p.CanCollide = collide == true
	p.CanTouch = false
	p.Material = material or Enum.Material.SmoothPlastic
	p.Color = color
	p.Shape = shape or Enum.PartType.Block
	p.Parent = parent
	return p
end
function S.ensure(player)
	if plots[player] then
		return plots[player]
	end
	local index = 1
	while used[index] do
		index += 1
	end
	used[index] = true
	local center = Layout.plotCenter(index)
	local root = workspace:FindFirstChild("Santuarios") or Instance.new("Folder", workspace)
	root.Name = "Santuarios"
	local folder = Instance.new("Folder")
	folder.Name = tostring(player.UserId)
	folder:SetAttribute("OwnerUserId", player.UserId)
	folder.Parent = root
	local _base = part(
		folder,
		Text.ILHA_PESSOAL_498B3B,
		V(144, 4, 144),
		center,
		Color3.fromRGB(85, 132, 106),
		Enum.Material.Grass,
		true
	)
	part(
		folder,
		Text.ROCHA_FLUTUANTE_B3C46F,
		V(142, 35, 142),
		center - V(0, 15, 0),
		Color3.fromRGB(74, 87, 92),
		Enum.Material.Rock,
		false,
		Enum.PartType.Ball
	)
	part(
		folder,
		Text.CAMINHO_CENTRAL_22B87F,
		V(9, 0.2, 125),
		center + V(0, 2.2, 0),
		Color3.fromRGB(202, 194, 165),
		Enum.Material.Cobblestone,
		false
	)
	local sign = part(
		folder,
		Text.PORTAL_DE_RETORNO_18016A,
		V(7, 9, 2),
		center + V(0, 6, 61),
		Color3.fromRGB(80, 146, 166),
		Enum.Material.Neon,
		false
	)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = Text.VOLTAR_A_AVENTURA_D7DC5A
	prompt.ObjectText = Text.PORTAL_DO_SANTUARIO_1F3781
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = 10
	prompt.Parent = sign
	prompt.Triggered:Connect(function(p)
		local d = Data.get(p)
		local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if p ~= player or not d or not hrp or (hrp.Position - sign.Position).Magnitude > 12 then
			return
		end
		if require(script.Parent.EncounterService).active(p) then
			return
		end
		require(script.Parent.Transport).go(p, I.pos(1) + V(0, 9, 24), "Alvorecer")
	end)
	Art.plot(folder, center)
	local plot = { index = index, center = center, folder = folder, signature = "" }
	plots[player] = plot
	return plot
end
function S.position(player, island)
	local d = Data.get(player)
	local entry = d and d.sanctuary[island]
	if not entry then
		return nil
	end
	local x, z = Rules.slot(entry.slot)
	return S.ensure(player).center + V(x, 2, z)
end
function S.refresh(player)
	local d = Data.get(player)
	if not d then
		return
	end
	local plot = S.ensure(player)
	local keys = {}
	for id, entry in d.sanctuary do
		table.insert(keys, id .. ":" .. entry.slot .. ":" .. entry.level .. ":" .. #(d.habitat[id] or {}))
	end
	table.sort(keys)
	local signature = table.concat(keys, "|")
	if plot.signature == signature then
		return
	end
	plot.signature = signature
	local old = plot.folder:FindFirstChild("Habitats")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "Habitats"
	folder.Parent = plot.folder
	for id, entry in d.sanctuary do
		local def = I.ById[id]
		local pos = S.position(player, id)
		local zone = Instance.new("Model")
		zone.Name = def.name
		zone:SetAttribute("OwnerUserId", player.UserId)
		zone.Parent = folder
		local base = part(zone, "Habitat", V(28, 0.4, 28), pos + V(0, 0.2, 0), def.ground, Enum.Material.Slate, true)
		for _, sx in { -1, 1 } do
			for _, sz in { -1, 1 } do
				part(
					zone,
					Text.MARCO_ELEMENTAL_3DB8E3,
					V(2, 3 + entry.level, 2),
					pos + V(sx * 12, 2, sz * 12),
					def.accent,
					Enum.Material.Neon,
					false
				)
			end
		end
		local label = Instance.new("BillboardGui")
		label.Size = UDim2.fromOffset(190, 45)
		label.StudsOffset = V(0, 5, 0)
		label.MaxDistance = 70
		label.Parent = base
		local text = Instance.new("TextLabel")
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.TextColor3 = Tokens.Ink
		text.TextStrokeTransparency = 0.4
		text.TextSize = 14
		text.Font = Tokens.Font
		text.Text = def.el
			.. " • Habitat "
			.. entry.level
			.. "\n"
			.. #(d.habitat[id] or {})
			.. " / "
			.. Rules.capacity(def, entry)
		text.Parent = label
		Art.habitat(zone, pos, id)
	end
end
function S.contains(player, position)
	local plot = plots[player]
	if not plot then
		return false
	end
	local d = position - plot.center
	return math.abs(d.X) <= 72 and math.abs(d.Z) <= 72 and math.abs(d.Y) <= 90
end
function S.home(player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	return require(script.Parent.Transport).go(player, S.ensure(player).center + V(0, 7, 55))
end
function S.release(player)
	local plot = plots[player]
	if not plot then
		return
	end
	plot.folder:Destroy()
	used[plot.index] = nil
	plots[player] = nil
end
return S
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">StartingCamp</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local I = require(game:GetService("ReplicatedStorage").Shared.Islands)
local Art = require(script.Parent.WorldArt)
local C = {}
function C.build()
	local parent = Instance.new("Model")
	parent.Name = Text.ACAMPAMENTO_DO_ALVORECER_EBD2E1
	parent.Parent = workspace
	local center = I.pos(1)
	local function part(size, offset, color, material, shape)
		local p = Instance.new("Part")
		p.Size = size
		p.Position = center + offset
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.Color = color
		p.Material = material or Enum.Material.Wood
		p.Shape = shape or Enum.PartType.Block
		p.Parent = parent
		return p
	end
	-- Gazebo de pesquisa e fonte baixa. Centro, spawn e passagem até as pontes livres.
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			part(Vector3.new(1, 9, 1), Vector3.new(-20 + x * 5, 8, -17 + z * 5), Color3.fromRGB(91, 74, 60))
		end
	end
	local _roof = part(
		Vector3.new(15, 3, 15),
		Vector3.new(-20, 13, -17),
		Color3.fromRGB(81, 136, 130),
		Enum.Material.SmoothPlastic,
		Enum.PartType.Ball
	)
	part(Vector3.new(9, 1, 5), Vector3.new(-20, 6, -17), Color3.fromRGB(159, 128, 89))
	local _bowl = part(
		Vector3.new(8, 2, 8),
		Vector3.new(22, 5, -16),
		Color3.fromRGB(158, 177, 163),
		Enum.Material.Slate,
		Enum.PartType.Ball
	)
	local water = part(
		Vector3.new(6, 0.3, 6),
		Vector3.new(22, 6, -16),
		Color3.fromRGB(109, 199, 217),
		Enum.Material.Glass,
		Enum.PartType.Ball
	)
	water.Transparency = 0.3
	for i = 1, 5 do
		local a = i * math.pi * 2 / 5
		part(
			Vector3.new(2.5, 0.4, 1.6),
			Vector3.new(22 + math.cos(a) * 4, 4.3, -16 + math.sin(a) * 4),
			Color3.fromRGB(229, 174, 191),
			Enum.Material.SmoothPlastic,
			Enum.PartType.Ball
		)
	end
	Art.camp(parent, center)
end
return C
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">Transport</string>
          <string name="Source"><![CDATA[--!nonstrict
local Data = require(script.Parent.DataService)
local T = {}
local busy = setmetatable({}, { __mode = "k" })
function T.go(player, position, region)
	region = region or "sanctuary"
	if
		typeof(position) ~= "Vector3"
		or position.X ~= position.X
		or position.Y ~= position.Y
		or position.Z ~= position.Z
		or position.Magnitude > 1e6
	then
		return false
	end
	local profile = Data.get(player)
	if
		region ~= "sanctuary"
		and not require(game:GetService("ReplicatedStorage").Shared.Access).check(profile, region, "travel").ok
	then
		return false
	end
	if busy[player] or not profile or require(script.Parent.EncounterService).active(player) then
		return false
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local session = Data.session(player)
	if not root or not session or not humanoid or humanoid.Health <= 0 then
		return false
	end
	local ticket = { root = root, anchored = root.Anchored, session = session }
	busy[player] = ticket
	session.transporting = true
	local function cleanup()
		if busy[player] ~= ticket then
			return
		end
		if root.Parent then
			root.Anchored = ticket.anchored
		end
		session.transporting = false
		busy[player] = nil
	end
	local ready = pcall(function()
		player:RequestStreamAroundAsync(position, 3)
	end)
	if
		not ready
		or player.Character ~= character
		or not root.Parent
		or not Data.get(player)
		or humanoid.Health <= 0
		or require(script.Parent.EncounterService).active(player)
	then
		cleanup()
		return false
	end
	local moved = pcall(function()
		root.Anchored = true
		character:PivotTo(CFrame.new(position))
	end)
	if not moved then
		cleanup()
		return false
	end
	session.region = region
	if region == "sanctuary" and player.SetAttribute then
		player:SetAttribute("RegionId", region)
	end
	if region ~= "sanctuary" then
		require(script.Parent.RegionService).note(player, region, "region")
	end
	task.delay(1, cleanup) -- manter reserva até restaurar a âncora; segunda viagem não captura Anchored=true.
	return true
end
return T
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">Wildlife</string>
          <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local C = require(RS.Shared.Creatures)
local I = require(RS.Shared.Islands)
local Layout = require(RS.Shared.WorldLayout)
local MF = require(RS.Shared.ModelFactory)
local Rules = require(RS.Shared.CaptureRules)
local Data = require(script.Parent.DataService)
local Encounters = require(script.Parent.EncounterService)
local Pools = require(RS.Shared.EncounterPools)
local Region = require(script.Parent.RegionService)
local W = { SlotsPerRegion = 8, SpawnDistance = 300, DespawnDistance = 440, DespawnGrace = 15 }
local rng = Random.new()
local cooldown = setmetatable({}, { __mode = "k" })
local started = false
function W.start()
	if started then
		return
	end
	started = true
	local notice = Instance.new("RemoteEvent")
	notice.Name = "WildNotice"
	notice.Parent = RS
	local folder = Instance.new("Folder")
	folder.Name = "Selvagens"
	folder.Parent = workspace
	local slots = {}
	for _, island in I.List do
		for slot = 1, W.SlotsPerRegion do
			table.insert(slots, {
				island = island,
				slot = slot,
				ground = I.pos(island.idx) + Layout.wildOffset(slot),
				nextSpawn = 0,
			})
		end
	end
	local function despawn(s, respawnAt)
		local model = s.model
		s.model = nil
		s.busy = false
		s.awaySince = nil
		s.nextSpawn = respawnAt or 0
		if model then
			model:Destroy()
		end
	end
	local function spawn(s)
		-- A mesma espécie pode povoar regiões diferentes; a densidade é regional.
		local counts = {}
		for _, other in slots do
			if other.model and other.island.id == s.island.id then
				counts[other.id] = (counts[other.id] or 0) + 1
			end
		end
		local def = Pools.pick(s.island.id, rng, false, counts)
		if not def then
			return
		end
		local level = Pools.rollLevel(s.island.id, def.rar, rng)
		local m = MF.build(def, level)
		local cf, size = m:GetBoundingBox()
		local lift = m:GetPivot().Position.Y - (cf.Position.Y - size.Y / 2)
		s.home = s.ground + Vector3.new(0, lift, 0)
		s.model = m
		s.id = def.id
		s.level = level
		s.born = os.clock()
		s.awaySince = nil
		m:PivotTo(CFrame.new(s.home))
		m:SetAttribute("WildRegion", s.island.id)
		m:SetAttribute("WildSlot", s.slot)
		m.Parent = folder
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = Text.ENCONTRAR_FERA_2CE20D
		prompt.ObjectText = def.name .. " • Nv." .. level
		prompt.HoldDuration = 1
		prompt.MaxActivationDistance = 11
		prompt.RequiresLineOfSight = true
		prompt.Parent = m.PrimaryPart
		prompt.Triggered:Connect(function(player)
			local d = Data.get(player)
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if
				s.model ~= m
				or s.busy
				or not d
				or not root
				or (root.Position - m.PrimaryPart.Position).Magnitude > Rules.MaxDistance
			then
				return
			end
			if cooldown[player] and os.clock() - cooldown[player] < 1.5 then
				return
			end
			cooldown[player] = os.clock()
			local access = Region.requireCurrent(player, s.island.id, "encounter")
			if not access.ok then
				notice:FireClient(player, access.reason)
				return
			end
			if Encounters.active(player) then
				return
			end
			-- Reserva antes de chamar o serviço: outra ativação nunca compartilha o animal.
			s.busy = true
			prompt.Enabled = false
			local succeeded, opened = pcall(
				Encounters.open,
				player,
				{ id = def.id, lv = level, region = s.island.id, position = m.PrimaryPart.Position },
				function(remove)
					if s.model ~= m then
						return
					end
					s.busy = false
					s.awaySince = nil
					if remove then
						despawn(s, os.clock() + Rules.RespawnSeconds)
					else
						prompt.Enabled = true
						s.born = os.clock()
					end
				end
			)
			if not succeeded then
				warn("Encontro indisponível: " .. tostring(opened))
			end
			if not succeeded or not opened then
				if s.model == m then
					s.busy = false
					prompt.Enabled = true
				end
			end
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		cooldown[player] = nil
	end)
	task.spawn(function()
		while folder.Parent do
			local now = os.clock()
			-- Uma busca por pulso para todos os slots, sem thread ou heartbeat por criatura.
			local observers = {}
			for _, player in Players:GetPlayers() do
				local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				if root and Data.get(player) then
					table.insert(observers, root.Position)
				end
			end
			for _, s in slots do
				local distance = math.huge
				for _, position in observers do
					distance = math.min(distance, (position - s.ground).Magnitude)
				end
				if not s.model then
					if distance <= W.SpawnDistance and now >= s.nextSpawn then
						local ok, problem = pcall(spawn, s)
						if not ok then
							if s.model then
								despawn(s, now + 5)
							else
								s.nextSpawn = now + 5
							end
							warn("Não foi possível apresentar a fera: " .. tostring(problem))
						end
					end
				elseif not s.busy then
					if distance > W.DespawnDistance then
						s.awaySince = s.awaySince or now
						if now - s.awaySince >= W.DespawnGrace then
							despawn(s)
						end
					else
						s.awaySince = nil
						local elapsed = now - s.born + s.slot * 0.7
						local pos = s.home + Vector3.new(math.sin(elapsed * 0.35) * 6, 0, math.cos(elapsed * 0.35) * 6)
						if C.ById[s.id].shape == "Bird" then
							pos += Vector3.new(0, math.max(0, math.sin(elapsed * 0.5)) * 2, 0)
						end
						s.model:SetAttribute("Moving", true)
						s.model:PivotTo(
							CFrame.lookAt(
								pos,
								pos + Vector3.new(math.cos(elapsed * 0.35), 0, -math.sin(elapsed * 0.35))
							)
						)
					end
				end
			end
			task.wait(0.5)
		end
	end)
end
return W
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[--!nonstrict
local RS = game:GetService("ReplicatedStorage")
local I = require(RS.Shared.Islands)
local C = require(RS.Shared.Creatures)
local MF = require(RS.Shared.ModelFactory)
local Data = require(script.Parent.DataService)
local Sanctuary = require(script.Parent.SanctuaryService)
local Art = require(script.Parent.WorldArt)
local Tokens = require(RS.Shared.ArtTokens)
local W = {}
function W.pos(i)
	return I.pos(i)
end
function W.build()
	local old = workspace:FindFirstChild("Arquipelago")
	if old then
		old:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = "Arquipelago"
	f.Parent = workspace
	require(script.Parent.ExpeditionWorld).build(f)
	for _, def in I.List do
		local p = I.pos(def.idx)
		require(script.Parent.IslandArchitecture).build(f, p, def)
		require(script.Parent.Biomes).decorate(f, p, def)
	end
	-- Água dividida em peças abaixo do limite de 2048 studs do Roblox.
	for x = -1, 1 do
		for z = -1, 1 do
			local water = Instance.new("Part")
			water.Name = "Mar"
			water.Anchored = true
			water.CanCollide = false
			water.CanTouch = false
			water.CanQuery = false
			water.Size = Vector3.new(1664, 2, 1664)
			water.Position = Vector3.new(x * 1664, -4, z * 1664)
			water.Material = Enum.Material.Glass
			water.Color = Tokens.Ramps.Tidal[2]
			water.Transparency = 0.12
			water.Parent = f
		end
	end
	local L = game:GetService("Lighting")
	L.Brightness = 2.1
	L.GeographicLatitude = 28
	L.ShadowSoftness = 0.12
	L.Ambient = Tokens.Ramps.Sky[2]
	L.OutdoorAmbient = Tokens.Ramps.Metal[3]
	L.EnvironmentDiffuseScale = 0.5
	L.EnvironmentSpecularScale = 0.15
	L.ClockTime = 14
	L.GlobalShadows = true
	local at = Instance.new("Atmosphere")
	at.Density = 0.18
	at.Haze = 0.9
	at.Color = Tokens.Ramps.Sky[4]
	at.Parent = L
	local bl = Instance.new("BloomEffect")
	bl.Intensity = 0.12
	bl.Size = 12
	bl.Threshold = 1.8
	bl.Parent = L
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.05
	cc.Contrast = 0.1
	cc.Parent = L
	local s = Instance.new("SpawnLocation")
	s.Anchored = true
	s.Size = Vector3.new(10, 1, 10)
	s.Position = W.pos(1) + Vector3.new(0, 5, 30)
	s.Parent = f
	Art.recolor(f)
	Art.build(f)
end
function W.refresh(p)
	local root = workspace:FindFirstChild("Criaturas") or Instance.new("Folder", workspace)
	root.Name = "Criaturas"
	local old = root:FindFirstChild(tostring(p.UserId))
	if old then
		old:Destroy()
	end
	local d = Data.get(p)
	if not d then
		return
	end
	Sanctuary.refresh(p)
	local visualCount = 0
	local occupied = 0
	for id, list in d.habitat do
		if d.sanctuary[id] and #list > 0 then
			occupied += 1
		end
	end
	local perHabitat = math.min(2, math.max(1, math.floor(12 / math.max(1, occupied))))
	local mine = Instance.new("Folder")
	mine.Name = tostring(p.UserId)
	for isl, list in d.habitat do
		local center = Sanctuary.position(p, isl)
		if not center then
			continue
		end
		for k, uid in list do
			if k > perHabitat or visualCount >= 12 then
				continue
			end -- Representantes visuais; todas as feras seguem produzindo.
			local cr = d.creatures[uid]
			if cr and uid ~= d.companion then
				visualCount += 1
				local displayed = math.min(#list, perHabitat)
				local radius = displayed == 1 and 0 or 8
				local a = k / displayed * math.pi * 2
				local m = MF.build(C.ById[cr.id], cr.lv)
				local _, dimensions = m:GetBoundingBox()
				local largest = math.max(dimensions.X, dimensions.Y, dimensions.Z)
				if largest > 9 then
					m:ScaleTo(m:GetScale() * 9 / largest)
				end
				local bc, bs = m:GetBoundingBox()
				local lift = m:GetPivot().Position.Y - (bc.Position.Y - bs.Y / 2)
				m:PivotTo(
					CFrame.new(
						center + Vector3.new(math.cos(a) * radius, 0.5 + lift, math.sin(a) * radius),
						center + Vector3.new(0, 0.5 + lift, 0)
					)
				)
				if d.pass and d.pass.Aura then
					local h = Instance.new("Highlight")
					h.FillTransparency = 1
					h.OutlineColor = Tokens.Accent
					h.Parent = m
				end
				m:SetAttribute("OwnerUserId", p.UserId)
				m:SetAttribute("CreatureUid", uid)
				m.Parent = mine
			end
		end
	end
	mine.Parent = root
	require(script.Parent.CompanionService).sync(p)
end
return W
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="62">
        <Properties>
          <string name="Name">WorldArt</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Camada cenográfica: nenhuma peça é sólida, consultável ou interativa.
local RS = game:GetService("ReplicatedStorage")
local T = require(RS.Shared.ArtTokens)
local I = require(RS.Shared.Islands)
local Layout = require(RS.Shared.WorldLayout)
local A = { BudgetPerIsland = 340 }
local V = Vector3.new
local function block(parent, name, size, position, color, rotation, kind)
	local p = Instance.new(kind == "wedge" and "WedgePart" or "Part")
	p.Name = name
	p.Size = size
	p.CFrame = CFrame.new(position) * (rotation or CFrame.identity)
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = size.Magnitude > 4
	p.Parent = parent
	return p
end
local function motion(part, kind, phase)
	part:SetAttribute("ArtMotion", kind)
	part:SetAttribute("ArtPhase", phase or 0)
end
local function shrub(parent, origin, ramp, style, index)
	local trunk = T.Ramps.Sand
	local ground = block(parent, "SombraRecortada", V(7, 0.04, 5), origin + V(1, 0.02, 0.6), ramp[1])
	ground.Transparency = 0.3
	ground.CastShadow = false
	if style == "Leaf" then
		block(
			parent,
			"TroncoFacetado",
			V(1.3, 7, 1.5),
			origin + V(0, 3.5, 0),
			trunk[2],
			CFrame.Angles(0, index * 0.7, 0.08)
		)
		block(parent, "Ramo", V(3, 0.7, 0.7), origin + V(1, 5, 0), trunk[3], CFrame.Angles(0, 0, 0.4))
		for tier = 1, 3 do
			local size = 8 - tier * 1.5
			local leaf = block(
				parent,
				"CopaEmCamadas",
				V(size, 1.4, size * 0.85),
				origin + V(tier % 2 * 0.5, 6 + tier, 0),
				ramp[tier + 1],
				CFrame.Angles(0, math.pi / 4, 0)
			)
			if tier == 3 then
				motion(leaf, "leaf", index * 0.5)
			end
		end
	elseif style == "Ember" then
		for tier = 1, 3 do
			block(
				parent,
				"BasaltoEstratificado",
				V(5 - tier, 1.6, 4.5 - tier),
				origin + V(0, tier * 0.9, 0),
				ramp[tier % 2 + 1],
				CFrame.Angles(0, index * 0.7, 0),
				"wedge"
			)
		end
		local shard = block(
			parent,
			"VidroDeBrasa",
			V(0.5, 3, 0.6),
			origin + V(0.2, 3, 0),
			ramp[4],
			CFrame.Angles(0.2, 0, 0.3),
			"wedge"
		)
		motion(shard, "spark", index)
	elseif style == "Tidal" then
		for side = -1, 1 do
			block(
				parent,
				"CoralRamo",
				V(0.8, 3 + side * 0.4, 0.8),
				origin + V(side * 1.2, 1.5, 0),
				T.Ramps.Rose[side + 3],
				CFrame.Angles(0, 0, side * 0.3)
			)
			block(
				parent,
				"CoralLeque",
				V(2, 0.6, 1),
				origin + V(side * 1.3, 3 + side * 0.4, 0),
				T.Ramps.Rose[4],
				CFrame.Angles(0, side * 0.2, 0)
			)
		end
		block(
			parent,
			"ConchaListrada",
			V(2.2, 0.7, 1.6),
			origin + V(2, 0.4, 1),
			T.Ramps.Sand[5],
			CFrame.Angles(0, 0.4, 0),
			"wedge"
		)
	elseif style == "Sand" then
		block(parent, "PedestalDeAreia", V(5, 1.2, 4), origin + V(0, 0.6, 0), ramp[3])
		block(
			parent,
			"EstelaInclinada",
			V(1.8, 5, 1.8),
			origin + V(0, 3.1, 0),
			ramp[4],
			CFrame.Angles(0, index * 0.4, 0.1)
		)
		block(parent, "FaixaDeEstela", V(2, 0.4, 2), origin + V(0, 4, 0), ramp[1], CFrame.Angles(0, index * 0.4, 0.1))
	elseif style == "Sky" then
		for tier = 1, 3 do
			local c = block(
				parent,
				"NuvemEscalonada",
				V(6 - tier, 1.4, 4.5 - tier * 0.4),
				origin + V(tier * 0.5, 1.5 + tier * 0.6, 0),
				ramp[tier + 2]
			)
			motion(c, "cloud", index * 0.7 + tier)
		end
		block(
			parent,
			"CristalCeleste",
			V(1.4, 4, 1.4),
			origin + V(1, 4, 0),
			ramp[4],
			CFrame.Angles(0.2, 0.5, 0.3),
			"wedge"
		)
	else
		block(parent, "RaizTorcida", V(1.2, 5, 1.2), origin + V(0, 2.5, 0), ramp[1], CFrame.Angles(0.1, 0, 0.3))
		block(parent, "CogumeloBase", V(0.8, 2, 0.8), origin + V(1, 1, 0), ramp[3])
		block(
			parent,
			"CogumeloChapeu",
			V(3, 0.6, 2.5),
			origin + V(1, 2.3, 0),
			ramp[4],
			CFrame.Angles(0, math.pi / 4, 0)
		)
		local glow = block(parent, "LuzDeEsporo", V(0.3, 0.3, 0.3), origin + V(1.3, 3.2, 0), ramp[5])
		motion(glow, "spark", index * 0.9)
	end
end
function A.biome(parent, center, def)
	local root = Instance.new("Folder")
	root.Name = "Arte_" .. def.id
	root:SetAttribute("ArtDecor", true)
	root.Parent = parent
	local ramp = T.ramp(def.id)
	local style = T.Biomes[def.id]
	-- Rebordo de ladrilhos e pequenos pisos interrompidos deixam legíveis o centro e as entradas.
	for index = 1, 24 do
		local angle = index * math.pi / 12
		local edge = center
			+ V(math.cos(angle) * (Layout.RegionRadius - 4), 4.03, math.sin(angle) * (Layout.RegionRadius - 4))
		block(root, "BordaDeIlha", V(36, 0.18, 3), edge, ramp[4], CFrame.Angles(0, -angle + math.pi / 2, 0))
	end
	for index = 1, 20 do
		local angle = index * math.pi / 10 + 0.15
		local radius = 155 + (index % 3) * 85
		shrub(root, center + V(math.cos(angle) * radius, 4.08, math.sin(angle) * radius), ramp, style, index)
	end
	for index = 1, 64 do
		local angle = index * 2.399
		local radius = 90 + (index % 8) * 39
		local point = center + V(math.cos(angle) * radius, 4.08, math.sin(angle) * radius)
		if math.abs(point.X - center.X) > 7 then
			local grass = block(
				root,
				"DetalheDeSolo",
				V(0.3, style == "Sand" and 0.18 or 0.8, 1.2),
				point,
				ramp[index % 2 + 3],
				CFrame.Angles(0, angle, 0.12),
				"wedge"
			)
			if style == "Leaf" or style == "Veil" then
				motion(grass, "grass", index * 0.5)
			end
			if index % 4 == 0 then
				block(
					root,
					"Petala",
					V(0.4, 0.2, 0.4),
					point + V(0.4, 0.7, 0),
					style == "Leaf" and T.Ramps.Rose[4] or ramp[5]
				)
			end
		end
	end
	-- Vinheta do ponto de descoberta original: livros/placas decorativos, sem tocar no prompt.
	block(root, "PlacaDescoberta", V(5, 0.25, 2), center + V(24, 4.16, 3), ramp[1])
	for index = 1, 3 do
		block(root, "Inscricao", V(0.3, 0.05, 0.8), center + V(22.8 + index * 0.6, 4.33, 3), ramp[4])
	end
	local parts = 0
	for _, obj in root:GetDescendants() do
		if obj:IsA("BasePart") then
			parts += 1
		end
	end
	root:SetAttribute("PartCount", parts)
	assert(parts <= A.BudgetPerIsland, "Cenário acima do orçamento")
	return root
end
function A.build(parent)
	for _, def in I.List do
		A.biome(parent, I.pos(def.idx), def)
	end
	local ocean = Instance.new("Folder")
	ocean.Name = "ArteOceano"
	ocean.Parent = parent
	-- Linhas de espuma escalonadas são geométricas, sem textura filtrada ou emissor global.
	for index = 1, 42 do
		local angle = index * math.pi / 21
		local distance = Layout.RingRadius + Layout.RegionRadius + 100 + (index % 3) * 28
		local strip = block(
			ocean,
			"Espuma",
			V(7 + index % 4, 0.06, 0.6),
			V(math.cos(angle) * distance, -2.96, math.sin(angle) * distance),
			T.Ramps.Tidal[4],
			CFrame.Angles(0, -angle, 0)
		)
		strip.Transparency = 0.4
		motion(strip, "water", index * 0.3)
	end
end
function A.recolor(parent)
	for _, obj in parent:GetDescendants() do
		if obj:IsA("BasePart") then
			obj.Color = T.nearest(obj.Color)
		elseif obj:IsA("TextLabel") then
			obj.Font = T.Font
			obj.TextColor3 = T.Ink
			obj.TextStrokeColor3 = T.Panel
			obj.TextStrokeTransparency = 0.1
		end
	end
end
function A.camp(parent, center)
	local wood = T.Ramps.Sand
	local roof = T.Ramps.Tidal
	-- Dossel de telhas facetadas e beiral quente sobre o gazebo existente.
	for _, side in { -1, 1 } do
		block(
			parent,
			"TelhadoDePesquisa",
			V(8, 0.7, 16),
			center + V(-20 + side * 3.5, 14.4, -17),
			roof[3],
			CFrame.Angles(0, 0, -side * 0.25)
		)
		block(parent, "Beiral", V(1, 0.6, 16.4), center + V(-20 + side * 7, 13.5, -17), wood[4])
	end
	block(parent, "Cumeeira", V(0.7, 0.8, 16.7), center + V(-20, 15.5, -17), wood[5])
	for index = 1, 4 do
		block(
			parent,
			"AmostraDePesquisa",
			V(0.7, 0.15, 1),
			center + V(-23 + index * 1.2, 6.6, -17),
			T.Palette[10 + index * 3],
			CFrame.Angles(0, index * 0.2, 0)
		)
	end
	block(parent, "LivroAberto", V(2, 0.2, 1.5), center + V(-21, 6.7, -18), T.Ink, CFrame.Angles(0, -0.2, 0))
	block(parent, "Lombada", V(0.1, 0.24, 1.5), center + V(-21, 6.72, -18), wood[2], CFrame.Angles(0, -0.2, 0))
	for index = 1, 5 do
		local a = index * math.pi * 2 / 5
		local ripple = block(
			parent,
			"ReflexoDaFonte",
			V(1, 0.05, 0.2),
			center + V(22 + math.cos(a) * 1.5, 6.22, -16 + math.sin(a) * 1.5),
			T.Ramps.Tidal[5],
			CFrame.Angles(0, -a, 0)
		)
		motion(ripple, "water", index)
	end
	A.recolor(parent)
end
function A.researcher(parent, base)
	local skin = T.Ramps.Rose
	local cloth = T.Ramps.Tidal
	local wood = T.Ramps.Sand
	-- Rosto original: olhos com sobrancelha, mecha lateral, óculos e sorriso curto.
	block(parent, "PlanoDoRosto", V(1.45, 1.25, 0.18), base + V(0, 4.65, 0.73), skin[4])
	for _, side in { -1, 1 } do
		block(parent, "Lente", V(0.62, 0.44, 0.09), base + V(side * 0.4, 4.78, 0.86), cloth[1])
		block(parent, "Olho", V(0.14, 0.19, 0.08), base + V(side * 0.4, 4.77, 0.93), T.Ink)
		block(
			parent,
			"Sobrancelha",
			V(0.42, 0.09, 0.08),
			base + V(side * 0.4, 5.1, 0.87),
			wood[1],
			CFrame.Angles(0, 0, side * 0.08)
		)
		block(parent, "Mao", V(0.55, 0.55, 0.55), base + V(side * 1.5, 1.65, 0), skin[4])
	end
	block(parent, "PonteDosOculos", V(0.23, 0.1, 0.09), base + V(0, 4.8, 0.87), cloth[1])
	block(parent, "Sorriso", V(0.3, 0.08, 0.08), base + V(0.09, 4.3, 0.86), skin[2], CFrame.Angles(0, 0, 0.08))
	block(parent, "Cabelo", V(1.9, 0.5, 1.8), base + V(0, 5.55, -0.03), wood[1])
	block(parent, "Mecha", V(0.45, 1.4, 0.3), base + V(-0.7, 5.0, 0.71), wood[2], CFrame.Angles(0, 0, -0.12))
	block(parent, "Gola", V(1.35, 0.3, 1.1), base + V(0, 3.9, 0), T.Ink)
	block(parent, "Bolso", V(0.65, 0.6, 0.14), base + V(-0.5, 2.8, 0.56), cloth[2])
	block(parent, "CadernoDeCampo", V(0.7, 0.9, 0.15), base + V(-0.5, 3, 0.65), wood[4], CFrame.Angles(0, 0, 0.1))
	block(parent, "Cinto", V(2.3, 0.22, 1.1), base + V(0, 1.8, 0), wood[1])
	block(parent, "Fivela", V(0.36, 0.3, 0.1), base + V(0, 1.8, 0.62), wood[4])
	block(parent, "Mochila", V(1.65, 1.8, 0.7), base + V(0, 2.9, -0.8), wood[2])
	local shadow = block(parent, "SombraDaMaia", V(3.2, 0.025, 2), base + V(0.4, 0.03, 0.3), T.Shadow)
	shadow.Transparency = 0.35
	shadow.CastShadow = false
	A.recolor(parent)
end
function A.plot(parent, center)
	local ramp = T.Ramps.Leaf
	for _, side in { -1, 1 } do
		for index = 1, 5 do
			block(
				parent,
				"LadrilhoDeJardim",
				V(3, 0.12, 3),
				center + V(side * 6, 2.12, -45 + index * 18),
				T.Ramps.Sand[4],
				CFrame.Angles(0, math.pi / 4, 0)
			)
		end
		block(parent, "MolduraDoPortal", V(1.1, 10, 2.7), center + V(side * 4.5, 6.5, 61), T.Ramps.Sand[4])
		block(parent, "Canteiro", V(7, 0.6, 5), center + V(side * 58, 2.4, 52), ramp[1])
		for index = 1, 3 do
			block(
				parent,
				"FolhaDeCanteiro",
				V(1.4, 1.2, 1.4),
				center + V(side * 58 + (index - 2) * 1.6, 3.1, 52),
				ramp[index + 1],
				CFrame.Angles(0, index * 0.5, 0),
				"wedge"
			)
		end
	end
	block(parent, "LintelDoPortal", V(11, 1, 2.7), center + V(0, 12, 61), T.Ramps.Sand[5])
	A.recolor(parent)
end
function A.habitat(parent, position, id)
	local ramp = T.ramp(id)
	for _, side in { -1, 1 } do
		block(parent, "RebordoHabitat", V(28, 0.18, 0.6), position + V(0, 0.45, side * 13.5), ramp[2])
		block(parent, "RebordoHabitat", V(0.6, 0.18, 26), position + V(side * 13.5, 0.45, 0), ramp[2])
		block(
			parent,
			"TalheDeCanto",
			V(2, 0.22, 2),
			position + V(side * 12, 0.46, side * 12),
			ramp[4],
			CFrame.Angles(0, math.pi / 4, 0)
		)
	end
	block(parent, "SeloDeHabitat", V(4, 0.08, 4), position + V(0, 0.46, -10), ramp[4], CFrame.Angles(0, math.pi / 4, 0))
	A.recolor(parent)
end
return A
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="63">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="64">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="65">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">ArtOverlay</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Presentation only: never gates movement, net requests or profile loading.
local Tween = game:GetService("TweenService")
local Players = game:GetService("Players")
local Theme = require(script.Parent.UITheme)
local Icons = require(script.Parent.PixelIcons)
local A = {}
function A.loading(gui)
	local overlay = Instance.new("Frame")
	overlay.Name = "ArtLoading"
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundColor3 = Theme.Panel
	overlay.ZIndex = 100
	overlay.Active = false
	overlay.Parent = gui
	local center = Instance.new("Frame")
	center.AnchorPoint = Vector2.new(0.5, 0.5)
	center.Position = UDim2.fromScale(0.5, 0.5)
	center.Size = UDim2.new(0.92, 0, 0, 320)
	center.BackgroundTransparency = 1
	center.ZIndex = 101
	center.Parent = overlay
	local max = Instance.new("UISizeConstraint")
	max.MaxSize = Vector2.new(640, 320)
	max.Parent = center
	local skyline = Instance.new("Frame")
	skyline.Size = UDim2.fromOffset(176, 70)
	skyline.Position = UDim2.new(0.5, -88, 0, 0)
	skyline.BackgroundTransparency = 1
	skyline.ZIndex = 101
	skyline.Parent = center
	for index, kind in { "Natureza", "Fogo", "Agua", "Sombra", "Ar" } do
		local ramp = ({
			Theme.Tokens.Ramps.Leaf,
			Theme.Tokens.Ramps.Ember,
			Theme.Tokens.Ramps.Tidal,
			Theme.Tokens.Ramps.Veil,
			Theme.Tokens.Ramps.Sky,
		})[index]
		local icon = Icons.draw(skyline, kind, 2, ramp)
		icon.Position = UDim2.fromOffset((index - 1) * 36, index % 2 == 0 and 0 or 16)
		icon.ZIndex = 102
	end
	local title = Theme.label(center, "ARQUIPÉLAGO\nDAS FERAS", 32)
	title.Size = UDim2.new(1, 0, 0, 94)
	title.Position = UDim2.fromOffset(0, 84)
	title.TextColor3 = Theme.Accent
	title.ZIndex = 102
	local subtitle = Theme.label(center, "EXPLORAR  /  DESCOBRIR  /  CUIDAR", 14)
	subtitle.Size = UDim2.new(1, 0, 0, 28)
	subtitle.Position = UDim2.fromOffset(0, 188)
	subtitle.TextColor3 = Theme.Muted
	subtitle.ZIndex = 102
	local status = Theme.label(center, "Preparando sua expedição...", 16)
	status.Size = UDim2.new(1, -24, 0, 64)
	status.Position = UDim2.fromOffset(12, 236)
	status.ZIndex = 102
	local track = Instance.new("Frame")
	track.Size = UDim2.new(0.6, 0, 0, 4)
	track.Position = UDim2.new(0.2, 0, 0, 222)
	track.BackgroundColor3 = Theme.Edge
	track.BorderSizePixel = 0
	track.ZIndex = 102
	track.Parent = center
	for index = 1, 12 do
		local segment = Instance.new("Frame")
		segment.Size = UDim2.new(1 / 12, -3, 1, 0)
		segment.Position = UDim2.fromScale((index - 1) / 12, 0)
		segment.BorderSizePixel = 0
		segment.BackgroundColor3 = index % 3 == 0 and Theme.Mint or Theme.Accent
		segment.ZIndex = 103
		segment.Parent = track
	end
	local closed = false
	local handle = {}
	function handle.message(text)
		if not closed and status.Parent and text ~= "" then
			status.Text = text
		end
	end
	function handle.ready()
		if closed then
			return
		end
		closed = true
		local reduced = Players.LocalPlayer:GetAttribute("MotionReduced")
		if reduced then
			overlay:Destroy()
			return
		end
		Tween:Create(overlay, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
		for _, obj in overlay:GetDescendants() do
			if obj:IsA("TextLabel") then
				Tween:Create(obj, TweenInfo.new(0.25), { TextTransparency = 1 }):Play()
			elseif obj:IsA("Frame") then
				Tween:Create(obj, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
			end
		end
		task.delay(0.28, function()
			overlay:Destroy()
		end)
	end
	return handle
end
return A
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">BattleStage</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Cenografia apenas local para WorldModel; não conhece serviços, jogadores nem estado de batalha.
local RS = game:GetService("ReplicatedStorage")
local Art = require(RS.Shared.ArtTokens)
local S = { Budget = 190 }
local V = Vector3.new
function S.resolve(def)
	if Art.Biomes[def.island] then
		return def.island
	end
	return ({
		Fogo = "Brasa",
		["Água"] = "Recife",
		Natureza = "Floresta",
		Terra = "Dunas",
		Ar = "Picos",
		Sombra = "Pantano",
	})[def.el] or "Alvorecer"
end
function S.build(world, id, origin)
	origin = origin or V(0, 0, 0)
	local folder = Instance.new("Model")
	folder.Name = "BattleScenery"
	folder.Parent = world
	local ramp = Art.ramp(id)
	local leaf = Art.Ramps.Leaf
	local stone = Art.Ramps.Metal
	local function part(name, size, pos, color, kind, rotation)
		local p = Instance.new(kind == "wedge" and "WedgePart" or "Part")
		p.Name = name
		p.Size = size
		p.CFrame = CFrame.new(pos + origin) * (rotation or CFrame.identity)
		p.Color = color
		p.Material = Enum.Material.SmoothPlastic
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.CastShadow = false
		p.Parent = folder
		if kind == "cylinder" then
			p.Shape = Enum.PartType.Cylinder
		end
		return p
	end
	part("Sky", V(100, 50, 1), V(0, 18, -24), Art.Ramps.Sky[2])
	for layer = 1, 3 do
		for i = 1, 6 do
			local h = 4 + (i * 7 + layer * 3) % 9
			local x = (i - 3.5) * 13
			local z = -21 + layer * 3
			for _, side in { -1, 1 } do
				part(
					"DistantContour",
					V(2, h, 6.5),
					V(x + side * 3.25, h * 0.5 + 4 - layer, z),
					ramp[layer],
					"wedge",
					CFrame.Angles(0, -side * math.pi / 2, 0)
				)
			end
		end
	end
	part("SunDisk", V(0.2, 5, 5), V(22, 19, -22), Art.Ramps.Sand[5], "cylinder", CFrame.Angles(0, math.pi / 2, 0))
	for cloud = 1, 3 do
		local x = cloud * 18 - 34
		local y = 17 + cloud % 2 * 4
		part("CloudMiddle", V(7, 1.5, 1), V(x, y, -19), Art.Ramps.Sky[5])
		part("CloudCrown", V(4, 1.1, 1), V(x - 0.6, y + 1, -19), Art.Ramps.Sky[5])
		part("CloudShadow", V(6, 0.4, 1.1), V(x + 0.3, y - 0.8, -19), Art.Ramps.Sky[4])
	end
	part("Ground", V(70, 1, 40), V(0, -0.55, 0), ramp[2])
	for i = 1, 14 do
		part("GroundTile", V(2 + (i % 3), 0.06, 1), V((i % 7 - 3) * 8, 0.01, math.floor(i / 7) * 8 - 6), ramp[3])
	end
	for _, x in { -8, 8 } do
		part("ContactShadow", V(0.12, 10, 7), V(x, 0.04, 0), ramp[1], "cylinder", CFrame.Angles(0, 0, math.pi / 2))
		part("PlatformEdge", V(0.3, 9, 6.5), V(x, 0.08, 0), stone[2], "cylinder", CFrame.Angles(0, 0, math.pi / 2))
		part("PlatformLight", V(0.12, 8.4, 6), V(x, 0.26, 0), ramp[4], "cylinder", CFrame.Angles(0, 0, math.pi / 2))
		part("PlatformSurface", V(0.12, 7.8, 5.4), V(x, 0.34, 0), ramp[3], "cylinder", CFrame.Angles(0, 0, math.pi / 2))
	end
	for i = 1, 8 do
		local x = (i - 4.5) * 7
		local z = -10 - (i % 2) * 3
		if id == "Alvorecer" or id == "Floresta" or id == "Pantano" then
			part(
				"Trunk",
				V(1.4, 5 + i % 3, 1.4),
				V(x, 3, z),
				id == "Pantano" and Art.Ramps.Veil[1] or Art.Ramps.Sand[2]
			)
			for tier = 1, 3 do
				part(
					"Canopy",
					V(6 - tier, 2, 4),
					V(x + (tier % 2) * 0.7, 5 + tier * 1.2, z),
					id == "Pantano" and Art.Ramps.Veil[tier + 1] or leaf[tier + 1],
					"wedge",
					CFrame.Angles(0, tier % 2 * math.pi, 0)
				)
			end
		elseif id == "Brasa" then
			part("Basalt", V(4, 5 + i % 4, 4), V(x, 2, z), ramp[1], "wedge", CFrame.Angles(0, i * 0.7, 0))
			part("Ember", V(0.35, 3, 0.3), V(x + 0.8, 3, z + 2), ramp[4])
		elseif id == "Recife" then
			for branch = 1, 3 do
				part(
					"Coral",
					V(0.5, 2 + branch, 0.6),
					V(x + branch * 0.5, 1.5, z),
					Art.Ramps.Rose[branch + 1],
					nil,
					CFrame.Angles(0, 0, (branch - 2) * 0.3)
				)
			end
			part("Tide", V(5, 0.08, 2), V(x, 0.05, z + 4), ramp[4])
		elseif id == "Dunas" then
			part("RuinColumn", V(2, 4 + i % 4, 2), V(x, 2, z), ramp[3])
			part("RuinCap", V(3, 1, 3), V(x, 4 + i % 4 * 0.5, z), ramp[4])
			part("Inscription", V(0.2, 1, 0.1), V(x, 0.5 + i % 4, z + 1.05), ramp[1])
		else
			part("SkySpire", V(3, 7 + i % 3, 3), V(x, 3, z), ramp[2], "wedge", CFrame.Angles(0, i * 0.8, 0))
			part("SnowCap", V(3.2, 1.2, 3.2), V(x, 6 + i % 3 * 0.5, z), ramp[5], "wedge")
		end
	end
	for i = 1, 9 do
		part(
			"ForegroundGrass",
			V(0.25, 0.4 + (i % 3) * 0.3, 0.4),
			V((i - 5) * 7, 0.2, 8 + i % 2),
			ramp[i % 2 + 2],
			"wedge",
			CFrame.Angles(0, 0, i % 2 * 0.4)
		)
	end
	local count = 0
	for _, obj in folder:GetDescendants() do
		if obj:IsA("BasePart") then
			count += 1
		end
	end
	assert(count <= S.Budget, "Cenário excede orçamento gráfico")
	folder:SetAttribute("PartBudget", S.Budget)
	folder:SetAttribute("PartCount", count)
	folder:SetAttribute("Biome", id)
	return folder
end
return S
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="68">
          <Properties>
            <string name="Name">Client</string>
            <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local TS = game:GetService("TweenService")
local Missions = require(RS.Shared.Missions)
local Sounds = require(RS.Shared.Sounds)
local SS = game:GetService("SoundService")
local C = require(RS.Shared.Creatures)
local I = require(RS.Shared.Islands)
local Net = RS:WaitForChild("Net")
local gui = Instance.new("ScreenGui")
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
local S, tab, isl, pick, snapAt = nil, Text.FERAS_EF033A, "Alvorecer", {}, os.clock()
local render
local tabBtn = {}
local tutorial
local CollectionUI = require(script.Parent.CollectionUI)
local inFlight = false
local Breeding = require(RS.Shared.Breeding)
local Balance = require(RS.Shared.Economy)
local Nursery = require(script.Parent.NurseryUI)
local Journal = require(script.Parent.JournalUI)
local Theme = require(script.Parent.UITheme)
local PixelIcons = require(script.Parent.PixelIcons)
local BattleStage = require(script.Parent.BattleStage)
local ArtOverlay = require(script.Parent.ArtOverlay)
local loading = ArtOverlay.loading(gui)
local SanctuaryUI = require(script.Parent.SanctuaryUI)
local Story = require(RS.Shared.Story)
local Progression = require(RS.Shared.Progression)
local CaptureRules = require(RS.Shared.CaptureRules)
local Bands = require(RS.Shared.LevelBands)
local LocalPlayer = Players.LocalPlayer
LocalPlayer:SetAttribute("GraphicsQuality", Text.MEDIO_4F48C1)
local function mk(cls, props, parent)
	local o = Instance.new(cls)
	for k, v in props do
		o[k] = v
	end
	if cls == "TextButton" or cls == "Frame" or cls == "ScrollingFrame" then
		Theme.round(o)
		if cls ~= "ScrollingFrame" and props.BackgroundTransparency ~= 1 then
			Theme.stroke(o)
		end
	end
	if (cls == "TextButton" or cls == "TextLabel") and o.TextScaled then
		Instance.new("UITextSizeConstraint", o).MaxTextSize = 28
	end
	if cls == "TextButton" then
		o.Active = true
		o.Selectable = true
		Theme.bind(o)
	end
	if cls == "TextLabel" or cls == "TextButton" then
		o.Font = Theme.Font
	end
	o.Parent = parent
	return o
end
local WHITE = Theme.Ink
local drawerOpen = false
local top = mk(
	"Frame",
	{ Position = UDim2.fromOffset(8, 8), Size = UDim2.new(0.72, -8, 0, 40), BackgroundColor3 = Theme.Panel },
	gui
)
local resourceValues = {}
local function resourceAmount(n)
	if n >= 1e9 then
		return ("%.1fb"):format(n / 1e9)
	elseif n >= 1e6 then
		return ("%.1fm"):format(n / 1e6)
	elseif n >= 1e3 then
		return math.floor(n / 1e3) .. "k"
	end
	return tostring(n)
end
local resourceKinds = { "Fera", "Coin", "Gem", "Seal" }
for index, kind in resourceKinds do
	local holder = mk(
		"Frame",
		{ Position = UDim2.fromScale((index - 1) / 4, 0), Size = UDim2.fromScale(0.25, 1), BackgroundTransparency = 1 },
		top
	)
	local icon = PixelIcons.draw(holder, kind, 1)
	icon.Position = UDim2.fromOffset(4, 12)
	local value = mk("TextLabel", {
		Position = UDim2.fromOffset(24, 0),
		Size = UDim2.new(1, -26, 1, 0),
		BackgroundTransparency = 1,
		Text = "0",
		TextSize = 12,
		TextColor3 = Theme.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, holder)
	resourceValues[index] = value
end
local msg = mk("TextLabel", {
	Position = UDim2.new(0, 8, 0, 62),
	Size = UDim2.new(1, -16, 0, 28),
	BackgroundTransparency = 1,
	TextColor3 = Theme.Accent,
	TextStrokeTransparency = 0.4,
	TextScaled = true,
	Font = Theme.Font,
}, gui)
local list = mk("ScrollingFrame", {
	Visible = false,
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -8, 0.22, 0),
	Size = UDim2.new(0.9, 0, 0.66, -8),
	BackgroundColor3 = Theme.Panel,
	BackgroundTransparency = 0.15,
	CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
}, gui)
mk("UISizeConstraint", { MaxSize = Vector2.new(440, 1000) }, list)
mk("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, list)
local xpTrack = mk(
	"Frame",
	{ Position = UDim2.fromOffset(8, 52), Size = UDim2.new(0.72, -8, 0, 4), BackgroundColor3 = Theme.Card },
	gui
)
local xpFill = mk("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Mint }, xpTrack)
local objective = mk("TextLabel", {
	Position = UDim2.fromOffset(12, 62),
	Size = UDim2.new(0.7, 0, 0, 36),
	BackgroundTransparency = 1,
	TextColor3 = Theme.Ink,
	TextSize = 12,
	TextWrapped = true,
	Font = Theme.Font,
}, gui)
local muted = false
local function sfx(n)
	if muted or Sounds[n] == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = Sounds[n]
	s.Volume = 0.6
	s.Parent = SS
	s.Ended:Once(function()
		s:Destroy()
	end)
	s:Play()
end
-- Efeito de golpe por elemento: projétil com trajetória própria + explosão de partículas + onda de choque.
local FX = {
	Fogo = { shape = "Ball", size = 3, path = "line", n = 45, spd = 34 },
	[Text.AGUA_F11A05] = { shape = "Ball", size = 2.5, path = "arc", n = 35, spd = 22 },
	Natureza = { shape = "Block", size = 2, path = "line", n = 28, spd = 18, spin = true },
	Terra = { shape = "Block", size = 4, path = "drop", n = 30, spd = 26 },
	Ar = { shape = "Cylinder", size = 1.5, path = "line", n = 40, spd = 40, spin = true },
	Sombra = { shape = "Ball", size = 3, path = "arc", n = 40, spd = 14 },
}
local function fx(el, a, b)
	if
		LocalPlayer:GetAttribute("GraphicsQuality") == Text.BAIXO_74FD00 or LocalPlayer:GetAttribute("MotionReduced")
	then
		return
	end
	local d = FX[el]
	local c = Theme.Tokens.Elements[el][4]
	local arena = workspace:FindFirstChild(Text.ARENA_1A4BA8)
	if not arena then
		return
	end
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.Shape = Enum.PartType[d.shape]
	p.Size = Vector3.one * d.size
	p.Material = Enum.Material.Neon
	p.Color = c
	p.Parent = arena
	local e = Instance.new("ParticleEmitter")
	e.Rate = 60
	e.Lifetime = NumberRange.new(0.4)
	e.Speed = NumberRange.new(1, 3)
	e.Color = ColorSequence.new(c)
	e.LightEmission = 1
	e.Size = NumberSequence.new(d.size * 0.6, 0)
	e.Parent = p
	local start = d.path == "drop" and b + Vector3.new(0, 25, 0) or a
	local t0 = os.clock()
	while true do
		local k = (os.clock() - t0) / 0.35
		if k >= 1 then
			break
		end
		local pos = start:Lerp(b, k)
		if d.path == "arc" then
			pos += Vector3.new(0, math.sin(k * math.pi) * 8, 0)
		end
		p.CFrame = CFrame.new(pos) * (d.spin and CFrame.Angles(k * 12, k * 9, 0) or CFrame.identity)
		task.wait()
	end
	p.CFrame = CFrame.new(b)
	p.Transparency = 1
	e.Rate = 0
	e.Speed = NumberRange.new(d.spd * 0.5, d.spd)
	e.Lifetime = NumberRange.new(0.5, 0.9)
	e:Emit(d.n)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Ball
	ring.Anchored = true
	ring.CanCollide = false
	ring.Material = Enum.Material.Neon
	ring.Color = c
	ring.Size = Vector3.one
	ring.Transparency = 0.3
	ring.Position = b
	ring.Parent = arena
	TS:Create(ring, TweenInfo.new(0.4), { Size = Vector3.one * 14, Transparency = 1 }):Play()
	task.delay(1, function()
		p:Destroy()
		ring:Destroy()
	end)
end
-- Batalha animada: o servidor decide o resultado; aqui só se reproduz o log de golpes.
local function playBattle(b)
	local MF = require(RS.Shared.ModelFactory)
	local cam = workspace.CurrentCamera
	local o = Vector3.new(0, 300, 0)
	local ct = cam.CameraType
	local originalCF, originalFov, originalFocus = cam.CFrame, cam.FieldOfView, cam.Focus
	local stage = Instance.new("Folder")
	stage.Name = Text.ARENA_1A4BA8
	stage.Parent = workspace
	BattleStage.build(stage, BattleStage.resolve(C.ById[b.foe.id]), o)
	local function face(pos, to)
		return CFrame.lookAt(pos, pos + (pos - to))
	end
	local pa, pf = o + Vector3.new(-8, 5, 0), o + Vector3.new(8, 5, 0)
	local a = MF.build(C.ById[b.me.id], b.me.lv)
	local f = MF.build(C.ById[b.foe.id], b.foe.lv)
	local ac, asz = a:GetBoundingBox()
	local fc, fsz = f:GetBoundingBox()
	pa = Vector3.new(pa.X, o.Y + 0.42 + a:GetPivot().Position.Y - (ac.Position.Y - asz.Y * 0.5), pa.Z)
	pf = Vector3.new(pf.X, o.Y + 0.42 + f:GetPivot().Position.Y - (fc.Position.Y - fsz.Y * 0.5), pf.Z)
	a:PivotTo(face(pa, pf))
	f:PivotTo(face(pf, pa))
	a.Parent = stage
	f.Parent = stage
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame = CFrame.lookAt(o + Vector3.new(0, 14, 40), o + Vector3.new(0, 5, 0))
	local barA = mk("Frame", {
		Position = UDim2.fromScale(0.05, 0.12),
		Size = UDim2.fromScale(0.4, 0.03),
		BackgroundColor3 = Theme.Mint,
	}, gui)
	local barF = mk("Frame", {
		Position = UDim2.fromScale(0.55, 0.12),
		Size = UDim2.fromScale(0.4, 0.03),
		BackgroundColor3 = Theme.Tokens.Ramps.Ember[4],
	}, gui)
	pcall(function()
		task.wait(0.6)
		for _, s in b.log do
			local att, tgt, bar = s.me and a or f, s.me and f or a, s.me and barF or barA
			local c0 = att:GetPivot()
			local c1 = c0 + (tgt:GetPivot().Position - c0.Position) * 0.75
			for t = 0, 1, 1 / 8 do
				att:PivotTo(c0:Lerp(c1, math.sin(t * math.pi)))
				task.wait(0.03)
			end
			att:PivotTo(c0)
			fx(C.ById[(s.me and b.me or b.foe).id].el, c0.Position, tgt:GetPivot().Position)
			sfx("Hit")
			TS:Create(bar, TweenInfo.new(0.25), { Size = UDim2.fromScale(0.4 * s.hp, 0.03) }):Play()
			local g = Instance.new("BillboardGui")
			g.Size = UDim2.fromOffset(120, 40)
			g.StudsOffset = Vector3.new(0, 6, 0)
			g.AlwaysOnTop = true
			g.Adornee = tgt.PrimaryPart
			g.Parent = tgt.PrimaryPart
			mk("TextLabel", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				TextScaled = true,
				Font = Theme.Font,
				TextColor3 = s.mult > 1 and Theme.Accent or WHITE,
				Text = "-" .. s.dmg .. (s.mult > 1 and "!" or s.mult < 1 and Text.FRACO_988207 or ""),
			}, g)
			task.delay(1, function()
				g:Destroy()
			end)
			local tc = tgt:GetPivot()
			for i = 1, 4 do
				tgt:PivotTo(tc * CFrame.new((i % 2 * 2 - 1) * 0.6, 0, 0))
				task.wait(0.03)
			end
			tgt:PivotTo(tc)
			task.wait(0.35)
		end
		sfx(b.win and "Win" or "Lose")
		task.wait(0.8)
	end)
	barA:Destroy()
	barF:Destroy()
	stage:Destroy()
	cam.CameraType = ct
	cam.CFrame = originalCF
	cam.FieldOfView = originalFov
	cam.Focus = originalFocus
end
local function call(...)
	if inFlight then
		return
	end
	inFlight = true
	local before = S
	local act = ...
	msg.Text = "Processando..."
	local success, r = pcall(Net.InvokeServer, Net, ...)
	if not success then
		inFlight = false
		msg.Text = Text.CONEXAO_INTERROMPIDA_TENTE_NOVAMENTE_32854B
		return
	end
	if r then
		if r.data then
			S = r.data
			snapAt = os.clock()
			if r.ok and before and (act == "Hatch" or act == "Feed") then
				for uid, cr in S.creatures do
					local old = before.creatures[uid]
					if (act == "Hatch" and not old) or (old and C.stage(cr.lv, cr.id) > C.stage(old.lv, old.id)) then
						CollectionUI.discovery(gui, C.ById[cr.id], cr.lv, old ~= nil)
						break
					end
				end
			end
		end
		sfx(r.ok and (act == "Hatch" and "Hatch" or "Click") or "Lose")
		local m = r.msg or ""
		if r.battle then
			msg.Text = "Batalha!"
			render()
			playBattle(r.battle)
		end
		msg.Text = m
	end
	inFlight = false
	render()
	tutorial()
end
local function row(text, acts, creature)
	local f = mk("Frame", {
		LayoutOrder = 0,
		Size = UDim2.new(1, -8, 0, #acts > 2 and 178 or #acts > 0 and 124 or 64),
		BackgroundColor3 = Theme.Card,
	}, list)
	mk("TextLabel", {
		Position = UDim2.fromOffset(creature and 96 or 10, 4),
		Size = UDim2.new(1, creature and -106 or -20, 0, #acts > 0 and 62 or 56),
		BackgroundTransparency = 1,
		Text = text,
		TextScaled = true,
		TextColor3 = WHITE,
		Font = Theme.Font,
	}, f)
	if creature then
		local holder = mk(
			"Frame",
			{ Position = UDim2.fromOffset(4, 4), Size = UDim2.fromOffset(88, 68), BackgroundTransparency = 1 },
			f
		)
		local preview
		local function showSpecimen()
			if not f.Parent then
				return
			end
			local scrollTop = list.AbsolutePosition.Y
			local y = f.AbsolutePosition.Y
			local visible = list.Visible and y + f.AbsoluteSize.Y >= scrollTop and y <= scrollTop + list.AbsoluteSize.Y
			if visible and not preview then
				preview = CollectionUI.preview(holder, C.ById[creature.id], creature.lv, false)
				preview.Size = UDim2.fromScale(1, 1)
			elseif not visible and preview then
				preview:Destroy()
				preview = nil
			end
		end
		local scroll = list:GetPropertyChangedSignal("CanvasPosition"):Connect(showSpecimen)
		local visibility = list:GetPropertyChangedSignal("Visible"):Connect(showSpecimen)
		local layout = f:GetPropertyChangedSignal("AbsolutePosition"):Connect(showSpecimen)
		f.Destroying:Connect(function()
			scroll:Disconnect()
			visibility:Disconnect()
			layout:Disconnect()
		end)
		task.defer(showSpecimen)
	end
	local columns = math.min(2, math.max(1, #acts))
	local w = 1 / columns
	local rows = math.ceil(#acts / columns)
	for i, a in acts do
		local b = mk("TextButton", {
			Position = UDim2.new((i - 1) % columns * w, 4, 1, -rows * 52 + (math.floor((i - 1) / columns)) * 52),
			Size = UDim2.new(w, -8, 0, 44),
			Text = a[1],
			TextScaled = true,
			Font = Theme.Font,
			BackgroundColor3 = Theme.Card,
			TextColor3 = WHITE,
		}, f)
		b.Activated:Connect(a[2])
	end
	return f
end
local function crText(cr)
	local d = C.ById[cr.id]
	return (Text.S_NV_D_S_S_10A567):format(d.name, cr.lv, d.el, C.Rarity[d.rar])
end
render = function()
	for n, b in tabBtn do
		b.BackgroundColor3 = n == tab and Theme.Tokens.Ramps.Leaf[2] or Theme.Card
	end
	for _, c in list:GetChildren() do
		if c:IsA("Frame") and not (tab == Text.BESTIARIO_65A46C and c.Name == "BestiaryPanel") then
			c:Destroy()
		end
	end
	if not S then
		return
	end
	local n = 0
	for _ in S.discovered do
		n += 1
	end
	resourceValues[1].Text = tostring(S.playerLevel or 1)
	resourceValues[2].Text = resourceAmount(S.gold)
	resourceValues[3].Text = resourceAmount(S.gems)
	resourceValues[4].Text = resourceAmount(S.seals or 0)
	loading.ready()
	xpFill.Size = UDim2.fromScale(math.clamp((S.playerXp or 0) / Progression.playerCost(S.playerLevel or 1), 0, 1), 1)
	local objectiveChapter = Story.current(S)
	objective.Text = objectiveChapter
			and (objectiveChapter.name .. " • " .. Story.progress(S, objectiveChapter) .. "/" .. objectiveChapter.goal)
		or Text.PRIMEIRA_EXPEDICAO_CONCLUIDA_CONTINUE_EXPLORANDO_04DB58
	local regionId = LocalPlayer:GetAttribute("RegionId") or S.region or "Alvorecer"
	local current = I.ById[regionId]
	if current then
		local b = Bands.ById[regionId]
		objective.Text = current.name .. " · feras " .. b.min .. "–" .. b.max .. " · exploração livre"
	end
	objective.Visible = not drawerOpen and msg.Text == ""
	if tab == Text.FERAS_EF033A then
		for uid, cr in S.creatures do
			row(crText(cr), {
				{
					S.companion == uid and Text.GUARDAR_A0B626 or Text.COMPANHEIRO_FDBCE5,
					function()
						call("Companion", uid)
					end,
				},
				{
					"Ver no bestiário",
					function()
						Journal.select(cr.id)
						tab = Text.BESTIARIO_65A46C
						render()
					end,
				},
			}, cr)
		end
	elseif tab == Text.BESTIARIO_65A46C then
		Journal.render(list, S, function()
			render()
		end)
	elseif tab == Text.ARENA_1A4BA8 then
		row(Text.TROFEUS_F30057 .. S.trophies .. Text.AMBOS_DEVEM_TOCAR_DESAFIAR_EM_ATE_30S_DE8B6F, {})
		local rivalCount = 0
		for _, pl in Players:GetPlayers() do
			if pl ~= Players.LocalPlayer then
				rivalCount += 1
				row(
					pl.DisplayName,
					{ {
						Text.DESAFIAR_59C639,
						function()
							call("Duel", pl.UserId)
						end,
					} }
				)
			end
		end
		if rivalCount == 0 then
			row(Text.NENHUM_OUTRO_JOGADOR_AGORA_CONVIDE_AMIGOS_C96A34, {})
		end
	elseif tab == Text.SANTUARIO_D50F02 then
		SanctuaryUI.render(list, S, call, render)
	elseif tab == Text.OPCOES_4C8DF5 then
		for element, count in S.materials do
			row(Text.ESSENCIA_DE_3D63D1 .. element .. ": " .. count, {})
		end
		for _, quality in { Text.BAIXO_74FD00, Text.MEDIO_4F48C1, Text.ALTO_F46EDD } do
			row(Text.QUALIDADE_BE9B02 .. quality, {
				{
					LocalPlayer:GetAttribute("GraphicsQuality") == quality and "Ativa" or Text.SELECIONAR_4EDC0B,
					function()
						LocalPlayer:SetAttribute("GraphicsQuality", quality)
						for _, effect in Lighting:GetChildren() do
							if effect:IsA("BloomEffect") then
								effect.Enabled = quality == Text.ALTO_F46EDD
							end
						end
						render()
					end,
				},
			})
		end
		row(Text.MOVIMENTOS_REDUZIDOS_285637, {
			{
				LocalPlayer:GetAttribute("MotionReduced") and "Ativado" or "Desativado",
				function()
					LocalPlayer:SetAttribute("MotionReduced", not LocalPlayer:GetAttribute("MotionReduced"))
					render()
				end,
			},
		})
	elseif tab == Text.MISSOES_FAE2D2 then
		if S.quest and S.quest.stage > 0 then
			local q = S.quest
			local text = (q.title or Text.VESTIGIOS_513BA0) .. " · " .. q.stage .. "/3\n" .. q.hint
			if q.nextAttemptAt then
				text ..= "\n" .. (q.captured and Text.ALTAR_EM_REPOUSO_64BE88 or Text.NOVA_TENTATIVA_EM_CA2FA0 .. math.max(
					0,
					math.ceil(q.nextAttemptAt - workspace:GetServerTimeNow())
				) .. "s")
			end
			row(text, {})
		end
		local quest = Story.current(S)
		if quest then
			row(Text.MAIA_2FE34E .. quest.name .. " — " .. Story.progress(S, quest) .. "/" .. quest.goal, {
				{
					Story.canClaim(S, quest.id) and Text.RECEBER_CAPITULO_3ACD37 or Text.EM_ANDAMENTO_5CA373,
					function()
						call("ClaimStory", quest.id)
					end,
				},
			})
		end
		local ev = S.event
		row((Text.EVENTO_50_OURO_DE_S_DH_853264):format(ev.el, math.ceil(ev.left / 3600)), {})
		row(
			Text.RECOMPENSA_DIARIA_SEQUENCIA_B9C689 .. S.streak .. ")",
			{ {
				Text.RESGATAR_76A111,
				function()
					call("Daily")
				end,
			} }
		)
		for _, m in Missions.List do
			local pr = Missions.progress(S, m.stat)
			local done = S.claimed[m.id]
			row((Text.S_D_D_A1F15E):format(m.text, math.min(pr, m.goal), m.goal), {
				{
					done and "Concluída"
						or (pr >= m.goal and Text.RESGATAR_76A111 or "+" .. m.gold .. Text.OURO_6C9D60),
					function()
						if not done and pr >= m.goal then
							call("Claim", m.id)
						end
					end,
				},
			})
		end
	elseif tab == Text.LOJA_B9614D then
		for _, kind in CaptureRules.SealOrder do
			local recipe = CaptureRules.Seals[kind]
			local count = kind == "Basic" and S.seals or S.sealStock[kind] or 0
			row(
				Text.SELO_8CBE0B
					.. recipe.name
					.. " • "
					.. count
					.. Text.NIVEL_002242
					.. recipe.level
					.. (recipe.material and " • " .. recipe.amount .. Text.ESSENCIA_2D0983 .. recipe.material or ""),
				{
					{
						Text.CRIAR_BD03AE .. recipe.cost .. Text.OURO_6C9D60,
						function()
							call("CraftSeal", kind)
						end,
					},
				}
			)
		end
		row(Text.MERCADO_DE_OVOS_COMPRAS_COM_OURO_DO_JOGO_7CDE97, {})
		for _, def in I.List do
			if S.unlocked[def.id] then
				row(
					Text.OVO_DE_763A79 .. def.name .. " — " .. (80 * def.idx) .. Text.OURO_6C9D60,
					{ {
						Text.COMPRAR_F8AAD3,
						function()
							call("BuyEgg", def.id)
						end,
					} }
				)
			end
		end
	elseif tab == Text.ILHAS_577072 then
		for _, def in I.List do
			local band = Bands.ById[def.id]
			local state = S.access and S.access[def.id]
				or { ok = false, reason = "NOT_UNLOCKED", unlockReason = "NOT_UNLOCKED" }
			local seen = S.navigation and S.navigation.visited[def.id]
			local text = def.name
				.. (def.id == isl and " · selecionada" or "")
				.. " · "
				.. (seen and "Visitada" or "Por descobrir")
				.. "\nFeras "
				.. band.min
				.. "–"
				.. band.max
				.. " · Guardião "
				.. band.guardian
				.. "\nExploração livre · "
				.. (
					S.playerLevel < band.min and "PERIGO: inimigos acima do seu nível"
					or "Equipe preparada para esta região"
				)
			local acts = {}
			if state.ok then
				acts = {
					{
						Text.SELECIONAR_4EDC0B,
						function()
							isl = def.id
							render()
						end,
					},
					{
						Text.VIAJAR_AF3BD5,
						function()
							call("Travel", def.id)
						end,
					},
				}
			end
			local card = row(text, acts)
			local track = mk(
				"Frame",
				{ Size = UDim2.new(1, -20, 0, 4), Position = UDim2.fromOffset(10, 58), BackgroundColor3 = Theme.Panel },
				card
			)
			mk("Frame", {
				Size = UDim2.fromScale(math.clamp(S.playerLevel / def.minLevel, 0, 1), 1),
				BackgroundColor3 = state.ok and Theme.Mint or Theme.Accent,
			}, track)
		end
	else
		row(
			Text.CHOCADEIRA_D1AF5D .. #S.eggs .. "/" .. Balance.IncubatorSlots .. Text.ESCOLHA_DOIS_PROGENITORES_C7CD31,
			{}
		)
		for i, e in S.eggs do
			local left = math.max(0, math.ceil(e.left - (os.clock() - snapAt)))
			Nursery.egg(list, C.ById[e.id], left, function()
				call("Hatch", i)
			end, function()
				call("Speed", i)
			end)
		end
		if #pick == 2 and S.creatures[pick[1]] and S.creatures[pick[2]] then
			local a, b = S.creatures[pick[1]], S.creatures[pick[2]]
			Nursery.parents(
				list,
				C.ById[a.id],
				C.ById[b.id],
				Breeding.outcomes(a.id, b.id),
				#S.eggs < Balance.IncubatorSlots and S.gold >= Balance.BreedCost,
				function()
					call("Breed", pick[1], pick[2])
				end
			)
		end
		for uid, cr in S.creatures do
			local on = table.find(pick, uid)
			row((on and "Selecionada · " or "") .. crText(cr), {
				{
					on and Text.TIRAR_F409BD or Text.ESCOLHER_D7B72C,
					function()
						if on then
							table.remove(pick, on)
						elseif #pick < 2 then
							table.insert(pick, uid)
						end
						render()
					end,
				},
			})
		end
	end
end
local tabs = {
	Text.FERAS_EF033A,
	Text.SANTUARIO_D50F02,
	Text.ILHAS_577072,
	Text.OVOS_99289F,
	Text.BESTIARIO_65A46C,
	Text.ARENA_1A4BA8,
	Text.MISSOES_FAE2D2,
	Text.LOJA_B9614D,
	Text.OPCOES_4C8DF5,
}
local bar = mk("Frame", {
	Visible = false,
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -8, 0.1, 0),
	Size = UDim2.new(0.9, 0, 0.12, -4),
	BackgroundTransparency = 1,
}, gui)
mk("UISizeConstraint", { MaxSize = Vector2.new(440, 160) }, bar)
local toggle = mk("TextButton", {
	Position = UDim2.new(1, -94, 0, 60),
	Size = UDim2.fromOffset(86, 44),
	Text = Text.MENU_57F5F5,
	TextSize = 12,
	Font = Theme.Font,
	TextColor3 = WHITE,
	BackgroundColor3 = Theme.Card,
}, gui)
local function setDrawer(open)
	drawerOpen = open
	list.Visible = open
	if not open then
		for _, child in list:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
	end
	bar.Visible = open
	toggle.Text = open and Text.FECHAR_7B2006 or Text.MENU_57F5F5
	objective.Visible = not open and msg.Text == ""
	if tutorial then
		tutorial()
	end
	if open then
		render()
		list.BackgroundTransparency = 0.5
		TS:Create(list, TweenInfo.new(0.15), { BackgroundTransparency = 0.12 }):Play()
	end
end
local function layoutDrawer()
	local size = gui.AbsoluteSize
	local w = math.min(460, size.X - 16)
	local header = math.ceil(#tabs / 4) * 50
	bar.Size = UDim2.fromOffset(w, header)
	bar.Position = UDim2.new(1, -8, 0, 94)
	list.Size = UDim2.fromOffset(w, math.max(70, size.Y - header - 108))
	list.Position = UDim2.new(1, -8, 0, header + 100)
end
layoutDrawer()
gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutDrawer)
toggle.Activated:Connect(function()
	setDrawer(not drawerOpen)
end)
game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.Escape then
		setDrawer(false)
	end
end)
for i, name in tabs do
	local b = mk("TextButton", {
		Position = UDim2.fromScale(((i - 1) % 4) / 4, math.floor((i - 1) / 4) / math.ceil(#tabs / 4)),
		Size = UDim2.fromScale(1 / 4, 1 / math.ceil(#tabs / 4)),
		Text = ({
			Feras = "Equipe",
			["Santuário"] = "Acampamento",
			Ilhas = "Regiões",
			Ovos = "Criação",
			["Missões"] = "Diário",
		})[name] or name,
		TextScaled = true,
		Font = Theme.Font,
		BackgroundColor3 = Theme.Card,
		TextColor3 = WHITE,
	}, bar)
	tabBtn[name] = b
	b.Activated:Connect(function()
		tab = name
		render()
	end)
end
LocalPlayer:GetAttributeChangedSignal("RegionId"):Connect(function()
	if S and not inFlight then
