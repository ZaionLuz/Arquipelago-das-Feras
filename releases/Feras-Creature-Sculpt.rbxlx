        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">SanctuaryUI</string>
            <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local I = require(RS.Shared.Islands)
local Rules = require(RS.Shared.SanctuaryRules)
local Theme = require(script.Parent.UITheme)
local Icons = require(script.Parent.PixelIcons)
local U = {}
local slot = 5
function U.render(parent, d, call, render)
	local function card(height)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, -8, 0, height)
		f.BackgroundColor3 = Theme.Card
		f.Parent = parent
		Theme.panel(f)
		return f
	end
	local info = card(70)
	local t = Theme.label(info, Text.SEU_SANTUARIO_9_POSICOES_SELECIONE_UMA_POSICAO_E_400064, 14)
	t.Size = UDim2.fromScale(1, 1)
	local production = card(48)
	local collect = Theme.button(production, "Recolher suprimentos da base", function()
		call("Collect")
	end)
	collect.Size = UDim2.fromScale(1, 1)
	local travel = card(48)
	local home = Theme.button(travel, Text.VISITAR_MEU_SANTUARIO_A636DA, function()
		call("Home")
	end)
	home.Size = UDim2.fromScale(0.5, 1)
	local pet = Theme.button(travel, Text.ACARICIAR_COMPANHEIRO_6D295C, function()
		call("Pet")
	end)
	pet.Size = UDim2.fromScale(0.5, 1)
	pet.Position = UDim2.fromScale(0.5, 0)
	local grid = card(164)
	grid.BackgroundTransparency = 1
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.new(1 / 3, -6, 0, 50)
	layout.CellPadding = UDim2.fromOffset(6, 6)
	layout.Parent = grid
	for index = 1, 9 do
		local occupied
		for id, entry in d.sanctuary do
			if entry.slot == index then
				occupied = I.ById[id].el
			end
		end
		local b = Theme.button(grid, index .. " • " .. (occupied or "Livre"), function()
			slot = index
			render()
		end)
		if slot == index then
			b.BackgroundColor3 = Theme.Tokens.Ramps.Leaf[2]
		end
	end
	for _, def in I.List do
		local entry = d.sanctuary[def.id]
		local f = card(184)
		local icon = Icons.draw(f, def.el, 16, Theme.Tokens.Elements[def.el])
		icon.Position = UDim2.fromOffset(12, 12)
		local label = Theme.label(
			f,
			def.name
				.. " • "
				.. def.el
				.. "\n"
				.. (
					entry
						and Text.NIVEL_2EE2A0 .. entry.level .. Text.POSICAO_26334E .. entry.slot .. " • " .. #(d.habitat[def.id] or {}) .. "/" .. Rules.capacity(
							def,
							entry
						) .. Text.FERAS_C56D89
					or Text.CONSTRUIR_BB999C .. Rules.buildCost(def) .. Text.OURO_6C9D60
				),
			14
		)
		label.Size = UDim2.new(1, -44, 0, 112)
		label.Position = UDim2.fromOffset(36, 4)
		local buttons = entry
				and {
					{
						Text.MOVER_7D5F11 .. slot,
						function()
							call("MoveHabitat", def.id, slot)
						end,
					},
					{
						Text.MELHORAR_5E30CA .. Rules.upgradeCost(entry),
						function()
							call("UpgradeHabitat", def.id)
						end,
					},
					{
						"Remover",
						function()
							call("RemoveHabitat", def.id)
						end,
					},
				}
			or {
				{
					d.unlocked[def.id] and Text.CONSTRUIR_NA_POSICAO_AF4C45 .. slot or Text.DESBLOQUEIE_A_ILHA_CC6976,
					function()
						call("BuildHabitat", def.id, slot)
					end,
				},
			}
		for k, button in buttons do
			local b = Theme.button(f, button[1], button[2])
			b.Size = UDim2.new(1 / #buttons, -8, 0, 48)
			b.Position = UDim2.new((k - 1) / #buttons, 3, 1, -54)
		end
	end
	local ids = {}
	for uid in d.creatures do
		table.insert(ids, uid)
	end
	table.sort(ids)
	local destination
	for id, entry in d.sanctuary do
		if entry.slot == slot then
			destination = id
		end
	end
	local C = require(RS.Shared.Creatures)
	for _, uid in ids do
		local creature = d.creatures[uid]
		local f = card(108)
		local label = Theme.label(f, C.ById[creature.id].name .. " · Nv." .. creature.lv .. " · cuidado opcional", 14)
		label.Size = UDim2.new(1, -16, 0, 48)
		label.Position = UDim2.fromOffset(8, 4)
		local feed = Theme.button(f, "Cuidar · " .. (creature.lv * 20) .. " ouro", function()
			call("Feed", uid)
		end)
		feed.Size = UDim2.new(0.5, -8, 0, 44)
		feed.Position = UDim2.new(0, 4, 1, -50)
		feed.Active = creature.lv < 100
		feed.Selectable = feed.Active
		local place = Theme.button(f, destination and "Pôr em " .. destination or "Selecione habitat", function()
			if destination then
				call("Place", uid, destination)
			end
		end)
		place.Size = UDim2.new(0.5, -8, 0, 44)
		place.Position = UDim2.new(0.5, 4, 1, -50)
		place.Active = destination ~= nil
		place.Selectable = place.Active
	end
end
return U
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">SolarPresentation</string>
            <string name="Source"><![CDATA[--!nonstrict
local Text = require(game:GetService("ReplicatedStorage").Shared.Strings).Text
local RS = game:GetService("ReplicatedStorage")
local Run = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local TS = game:GetService("TweenService")
local I = require(RS.Shared.Islands)
local Config = require(RS.Shared.Config)
local Theme = require(script.Parent.UITheme)
local Art = require(RS.Shared.ArtTokens)
local Solar = {}
local started = false
function Solar.start(getSnapshot)
	if started then
		return
	end
	started = true
	local elapsed = 0
	local correction
	local atmosphere
	local priorAtmosphere
	local priorClock
	local ambientSound
	local center = I.pos(I.ById.Dunas.idx) + Vector3.new(0, 4, -23)
	Run.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.25 then
			return
		end
		elapsed = 0
		local p = Players.LocalPlayer
		local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		local snapshot = getSnapshot()
		local discovered = snapshot and snapshot.quest and snapshot.quest.stage >= 3
		local inside = discovered
			and hrp
			and math.abs(hrp.Position.X - center.X) < 16
			and math.abs(hrp.Position.Z - center.Z) < 13
			and math.abs(hrp.Position.Y - center.Y) < 12
		local ruins = workspace:FindFirstChild("RuinasAntigas")
		if ruins then
			local gate = ruins:FindFirstChild("LajeSelada")
			if gate then
				gate.LocalTransparencyModifier = discovered and 1 or 0
			end
			local altar = ruins:FindFirstChild("PedraCentral")
			local prompt = altar and altar:FindFirstChildOfClass("ProximityPrompt")
			if prompt then
				prompt.ActionText = discovered and Text.OFERECER_CHAMA_E43EFE or Text.EXAMINAR_F96563
				local q = snapshot and snapshot.quest
				local left = q and q.nextAttemptAt and math.max(0, q.nextAttemptAt - workspace:GetServerTimeNow()) or 0
				prompt.ObjectText = q and q.captured and Text.ALTAR_EM_REPOUSO_64BE88
					or left > 0 and (Text.REPOUSO_056AEB .. math.ceil(left) .. "s")
					or Text.PEDRA_ANTIGA_ACE013
			end
		end
		local enabled = inside and p:GetAttribute("GraphicsQuality") ~= Text.BAIXO_74FD00
		if enabled and not correction then
			correction = Instance.new("ColorCorrectionEffect")
			correction.Name = "TonalidadeLocal"
			correction.TintColor = Art.Ramps.Sand[5]
			correction.Saturation = 0.1
			correction.Contrast = 0.06
			correction.Parent = Lighting
			priorClock = Lighting.ClockTime
			Lighting.ClockTime = 17.5
			atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
			priorAtmosphere = { Color = atmosphere.Color, Density = atmosphere.Density, Haze = atmosphere.Haze }
			atmosphere.Color = Art.Ramps.Sand[4]
			atmosphere.Density = 0.26
			atmosphere.Haze = 1.8
			atmosphere.Parent = Lighting
			if Config.Assets.SolarAmbience ~= "" then
				ambientSound = Instance.new("Sound")
				ambientSound.SoundId = Config.Assets.SolarAmbience
				ambientSound.Looped = true
				ambientSound.Volume = 0.2
				ambientSound.Parent = game:GetService("SoundService")
				ambientSound:Play()
			end
		elseif not enabled and correction then
			correction:Destroy()
			correction = nil
			for key, value in priorAtmosphere do
				atmosphere[key] = value
			end
			Lighting.ClockTime = priorClock
			atmosphere = nil
			priorAtmosphere = nil
			if ambientSound then
				ambientSound:Destroy()
				ambientSound = nil
			end
		end
	end)
end
-- A câmera usada é a do Viewport: nunca toma o controle da câmera do jogador.
function Solar.intro(panel, viewport, model, alive)
	local cam = viewport.CurrentCamera
	local original = cam.CFrame
	local initial = model:GetPivot()
	local parts = {}
	local card = Theme.label(panel, Text.FENIX_LENDARIA_NV_60_A1FE17, 22)
	card.Size = UDim2.new(0.94, 0, 0, 54)
	card.Position = UDim2.fromScale(0.03, 0.25)
	card.ZIndex = 70
	card.TextColor3 = Theme.Accent
	local motion = not Players.LocalPlayer:GetAttribute("MotionReduced")
	local ok, err = pcall(function()
		if motion then
			model:PivotTo(initial + Vector3.new(0, 20, 0))
			cam.CFrame = original * CFrame.new(0, 1, -5)
			local start = os.clock()
			repeat
				if not alive() or not model.Parent or not viewport.Parent then
					return
				end
				local t = math.clamp((os.clock() - start) / 1.1, 0, 1)
				model:PivotTo(initial + Vector3.new(0, (1 - t) ^ 2 * 20, 0))
				cam.CFrame = original:Lerp(original * CFrame.new(0, 1, -5), math.sin(t * math.pi) * 0.5)
				Run.Heartbeat:Wait()
			until os.clock() - start >= 1.1
			model:PivotTo(initial)
			if Players.LocalPlayer:GetAttribute("GraphicsQuality") ~= Text.BAIXO_74FD00 then
				local ring = Instance.new("Part")
				ring.Name = "OndaLocal"
				ring.Shape = Enum.PartType.Cylinder
				ring.CFrame = initial * CFrame.Angles(0, 0, math.pi / 2)
				ring.Size = Vector3.new(0.1, 3, 3)
				ring.Material = Enum.Material.Neon
				ring.Color = Theme.Accent
				ring.Anchored = true
				ring.CanCollide = false
				ring.CanTouch = false
				ring.CanQuery = false
				ring.Parent = model.Parent
				table.insert(parts, ring)
				local light = Instance.new("PointLight")
				light.Brightness = 1
				light.Range = 16
				light.Color = Theme.Accent
				light.Parent = model.PrimaryPart
				table.insert(parts, light)
				TS:Create(ring, TweenInfo.new(0.6), { Size = Vector3.new(0.1, 25, 25), Transparency = 1 }):Play()
			end
		end
		if Config.Assets.PhoenixIntro ~= "" then
			local sound = Instance.new("Sound")
			sound.SoundId = Config.Assets.PhoenixIntro
			sound.Volume = 0.4
			sound.Parent = panel
			sound:Play()
			table.insert(parts, sound)
		end
		task.wait(0.6)
	end)
	if cam.Parent then
		cam.CFrame = original
	end
	if model.Parent then
		model:PivotTo(initial)
	end
	card:Destroy()
	for _, part in parts do
		part:Destroy()
	end
	if not ok then
		warn(Text.APRESENTACAO_INTERROMPIDA_310A92 .. tostring(err))
	end
end
return Solar
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">UITheme</string>
            <string name="Source"><![CDATA[--!nonstrict
local Tokens = require(game:GetService("ReplicatedStorage").Shared.ArtTokens)
local T = {
	Ink = Tokens.Ink,
	Muted = Tokens.Muted,
	Panel = Tokens.Panel,
	Card = Tokens.Card,
	Accent = Tokens.Accent,
	Mint = Tokens.Mint,
	Edge = Tokens.Edge,
	Shadow = Tokens.Shadow,
	Font = Tokens.Font,
	Tokens = Tokens,
}
function T.round(o, _radius)
	local existing = o:FindFirstChild("PixelCorner")
	if existing then
		return existing
	end
	local corner = Instance.new("UICorner")
	corner.Name = "PixelCorner"
	corner.CornerRadius = UDim.new(0, 2)
	corner.Parent = o
	o.BorderSizePixel = 0
	return corner
end
function T.stroke(o)
	local existing = o:FindFirstChild("PixelEdge")
	if existing then
		return existing
	end
	local stroke = Instance.new("UIStroke")
	stroke.Name = "PixelEdge"
	stroke.Color = T.Edge
	stroke.Transparency = 0
	stroke.Thickness = Tokens.Border
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = o
	return stroke
end
function T.panel(o, accent)
	T.round(o)
	local stroke = T.stroke(o)
	stroke.Color = accent or T.Edge
	return o
end
function T.bind(button)
	if button:GetAttribute("ArtButton") then
		return
	end
	button:SetAttribute("ArtButton", true)
	button.AutoButtonColor = false
	button.Selectable = true
	button.Font = T.Font
	local edge = T.stroke(button)
	T.round(button)
	local normal = button.BackgroundColor3
	local normalText = button.TextColor3
	local hover, pressed, updating = false, false, false
	local function refresh()
		updating = true
		local disabled = not button.Active or not button.Selectable
		button.BackgroundColor3 = disabled and T.Panel
			or pressed and T.Edge
			or hover and Tokens.nearest(normal:Lerp(T.Mint, 0.3))
			or normal
		button.TextColor3 = disabled and T.Muted or pressed and T.Ink or normalText
		edge.Color = disabled and T.Card or pressed and T.Mint or hover and T.Accent or T.Edge
		updating = false
	end
	button.MouseEnter:Connect(function()
		hover = true
		refresh()
	end)
	button.MouseLeave:Connect(function()
		hover = false
		pressed = false
		refresh()
	end)
	button.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			pressed = true
			refresh()
		end
	end)
	button.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			pressed = false
			refresh()
		end
	end)
	button.SelectionGained:Connect(function()
		hover = true
		refresh()
	end)
	button.SelectionLost:Connect(function()
		hover = false
		pressed = false
		refresh()
	end)
	button:GetPropertyChangedSignal("Active"):Connect(refresh)
	button:GetPropertyChangedSignal("Selectable"):Connect(refresh)
	button:GetPropertyChangedSignal("BackgroundColor3"):Connect(function()
		if not updating then
			normal = button.BackgroundColor3
			refresh()
		end
	end)
	refresh()
end
function T.label(parent, text, size)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextColor3 = T.Ink
	l.TextSize = size or 16
	l.TextWrapped = true
	l.Font = T.Font
	l.Parent = parent
	return l
end
function T.button(parent, text, callback)
	local b = Instance.new("TextButton")
	b.Text = text
	b.Font = T.Font
	b.TextSize = 16
	b.TextWrapped = true
	b.Size = UDim2.fromOffset(160, 44)
	b.BackgroundColor3 = T.Card
	b.TextColor3 = T.Ink
	b.Active = true
	b.Selectable = true
	b.Parent = parent
	T.bind(b)
	b.Activated:Connect(callback)
	return b
end
return T
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
