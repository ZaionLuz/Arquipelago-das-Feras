      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Access</string>
          <string name="Source"><![CDATA[--!nonstrict
local Bands = require(script.Parent.LevelBands)
local Config = require(script.Parent.Config)
local A = {}
local purposes = {
	travel = true,
	encounter = true,
	capture = true,
	battle = true,
	hatch = true,
	shop = true,
	habitat = true,
	sanctuary = true,
	unlock = true,
}
function A.check(profile, id, purpose)
	if typeof(profile) ~= "table" or typeof(id) ~= "string" or not Bands.ById[id] or not purposes[purpose] then
		return { ok = false, reason = "UNKNOWN_ISLAND" }
	end
	local level = profile.playerLevel or 1
	if typeof(level) ~= "number" or level ~= level or level < 1 or level == math.huge then
		return { ok = false, reason = "LOCKED_LEVEL" }
	end
	if Config.World.FreeExploration then
		return { ok = true, reason = "OPEN_WORLD" }
	end
	local band = Bands.ById[id]
	local unlocked = profile.unlocked and profile.unlocked[id] == true
	local grandfathered = unlocked and profile.legacyGrandfathered and profile.legacyGrandfathered[id] == true
	if purpose ~= "unlock" and not unlocked then
		return { ok = false, reason = "NOT_UNLOCKED" }
	end
	if Config.V7.EnforceIslandLevels and not grandfathered and level < band.min then
		return { ok = false, reason = "LOCKED_LEVEL" }
	end
	if purpose == "unlock" then
		if band.previous and not (profile.unlocked and profile.unlocked[band.previous]) then
			return { ok = false, reason = "LOCKED_PREV" }
		end
		if
			Config.V7.RequireGuardian
			and band.previous
			and not (profile.guardians and profile.guardians[band.previous])
		then
			return { ok = false, reason = "LOCKED_GUARDIAN" }
		end
		if (profile.gold or 0) < band.cost then
			return { ok = false, reason = "LOCKED_GOLD" }
		end
	end
	return { ok = true, reason = grandfathered and "LEGACY" or "OK" }
end
return A
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">ArtTokens</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Contrato visual único: 48 cores, sem assets externos nem estado de gameplay.
local T = {
	BaseGrid = 4,
	IconGrid = 16,
	Font = Enum.Font.Arcade,
	Spacing = { xs = 4, sm = 8, md = 12, lg = 16, xl = 24 },
	Border = 2,
	Touch = 44,
}
local ramps = {
	Ember = { 0x3D2948, 0x79384B, 0xBD5750, 0xED9765, 0xFFD6A0 },
	Tidal = { 0x253B57, 0x356580, 0x489BBA, 0x80CFCC, 0xC6EBCF },
	Leaf = { 0x293E4B, 0x416358, 0x61966B, 0x9FC477, 0xDDE7AA },
	Sand = { 0x453A54, 0x7C5860, 0xAD8270, 0xD8B482, 0xF4D9A0 },
	Sky = { 0x333B63, 0x576392, 0x849AC3, 0xB1CEE0, 0xEBE9D6 },
	Veil = { 0x302D4F, 0x55446E, 0x866594, 0xB293BC, 0xE3BCD0 },
	Metal = { 0x273746, 0x4C6573, 0x7B969E, 0xB2BFB4, 0xE8DEC3 },
	Rose = { 0x482E4E, 0x824862, 0xB97588, 0xE3A3A1, 0xFAD7BD },
}
T.Ramps = {}
T.Palette = {}
local function color(hex)
	return Color3.fromRGB(math.floor(hex / 65536) % 256, math.floor(hex / 256) % 256, hex % 256)
end
for name, values in ramps do
	T.Ramps[name] = {}
	for _, hex in values do
		local c = color(hex)
		table.insert(T.Ramps[name], c)
		table.insert(T.Palette, c)
	end
end
for _, hex in { 0x192B36, 0x283C46, 0x3B5159, 0x587078, 0x8C9D9C, 0xB7C5B8, 0xDEDAC0, 0xFFF0CF } do
	table.insert(T.Palette, color(hex))
end
T.Ink = color(0xFFF0CF)
T.Muted = color(0xB7C5B8)
T.Panel = color(0x192B36)
T.Card = color(0x283C46)
T.Edge = color(0x587078)
T.Shadow = color(0x192B36)
T.Accent = T.Ramps.Sand[4]
T.Mint = T.Ramps.Leaf[4]
T.Elements = {
	Fogo = T.Ramps.Ember,
	["Água"] = T.Ramps.Tidal,
	Natureza = T.Ramps.Leaf,
	Terra = T.Ramps.Sand,
	Ar = T.Ramps.Sky,
	Sombra = T.Ramps.Veil,
}
T.Biomes = {
	Alvorecer = "Leaf",
	Brasa = "Ember",
	Recife = "Tidal",
	Floresta = "Leaf",
	Dunas = "Sand",
	Picos = "Sky",
	Pantano = "Veil",
}
function T.ramp(id)
	return T.Ramps[T.Biomes[id] or "Metal"]
end
function T.nearest(c)
	local best, distance = T.Palette[1], math.huge
	for _, candidate in T.Palette do
		local d = (c.R - candidate.R) ^ 2 + (c.G - candidate.G) ^ 2 + (c.B - candidate.B) ^ 2
		if d < distance then
			best, distance = candidate, d
		end
	end
	return best
end
return T
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Breeding</string>
          <string name="Source"><![CDATA[--!nonstrict
local C = require(script.Parent.Creatures)
local Species = require(script.Parent.SpeciesRules)
local B = {}
-- Cruzamento: 25% de híbrido (elementos diferentes); senão sorteia por raridade. Lendário exige pais raros+.
function B.pick(a, b, rng)
	local A, Z = C.ById[a], C.ById[b]
	if A.el ~= Z.el and rng:NextNumber() < 0.25 then
		local pool = {}
		for _, c in C.List do
			local h = c.hybrid
			if
				Species.isGeneral(c.id)
				and h
				and ((h[1] == A.el and h[2] == Z.el) or (h[1] == Z.el and h[2] == A.el))
			then
				table.insert(pool, c.id)
			end
		end
		if #pool > 0 then
			return pool[rng:NextInteger(1, #pool)]
		end
	end
	local cap = math.min(4, math.max(A.rar, Z.rar) + (rng:NextNumber() < 0.1 and 1 or 0))
	if cap >= 4 and math.min(A.rar, Z.rar) < 3 then
		cap = 3
	end
	local pool, tot = {}, 0
	for _, c in C.List do
		if Species.isGeneral(c.id) and not c.hybrid and c.rar <= cap and (c.el == A.el or c.el == Z.el) then
			local w = 1 / (c.rar * c.rar)
			table.insert(pool, { c.id, w })
			tot += w
		end
	end
	local r = rng:NextNumber() * tot
	for _, e in pool do
		r -= e[2]
		if r <= 0 then
			return e[1]
		end
	end
	return pool[1][1]
end
-- Distribuição exata do algoritmo pick: mesma regra, sem mudar receitas existentes.
function B.outcomes(a, b)
	local A, Z = C.ById[a], C.ById[b]
	if not A or not Z then
		return {}
	end
	local out = {}
	local hybrids = {}
	if A.el ~= Z.el then
		for _, c in C.List do
			local h = c.hybrid
			if
				Species.isGeneral(c.id)
				and h
				and ((h[1] == A.el and h[2] == Z.el) or (h[2] == A.el and h[1] == Z.el))
			then
				table.insert(hybrids, c.id)
			end
		end
	end
	local hybridChance = #hybrids > 0 and 0.25 or 0
	for _, id in hybrids do
		out[id] = hybridChance / #hybrids
	end
	for boost = 0, 1 do
		local cap = math.min(4, math.max(A.rar, Z.rar) + boost)
		if cap >= 4 and math.min(A.rar, Z.rar) < 3 then
			cap = 3
		end
		local total = 0
		local pool = {}
		for _, c in C.List do
			if Species.isGeneral(c.id) and not c.hybrid and c.rar <= cap and (c.el == A.el or c.el == Z.el) then
				local weight = 1 / (c.rar * c.rar)
				pool[c.id] = weight
				total += weight
			end
		end
		local branch = (1 - hybridChance) * (boost == 1 and 0.1 or 0.9)
		for id, w in pool do
			out[id] = (out[id] or 0) + branch * w / total
		end
	end
	return out
end
return B
]]></string>
        </Properties>
