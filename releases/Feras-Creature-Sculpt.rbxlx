		elementalMotif = r[8],
		head = r[3],
		eyes = r[4],
		tail = r[5],
		limbs = r[6],
		feature = r[7],
		surface = r[8],
		dimensions = Vector3.new(table.unpack(r[9])),
		palette = palette,
		stages = {
			{
				scale = 0.65,
				headRatio = 1.2,
				detail = 1,
				keep = { "face", "body" },
				replace = { "shortlimbs" },
				add = {
					"bud",
				},
			},
			{
				scale = 1,
				headRatio = 1,
				detail = 2,
				keep = { "face" },
				replace = { "limbs" },
				add = { "tail", "pattern" },
			},
			{
				scale = 1.35,
				headRatio = 0.9,
				detail = 3,
				keep = { "palette" },
				replace = { "posture", "appendages" },
				add = {
					"armor",
					"crest",
				},
			},
		},
		budget = { 105, 155, 200 },
		anim = r[2],
		lod = { near = 70, mid = 150, hide = 300 },
	}
end
D.fenix.budget = { 245, 245, 245 }
return D
]]></string>
