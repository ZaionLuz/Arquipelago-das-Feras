for _, r in rows do
	local palette = {}
	for _, hex in r[10] do
		table.insert(
			palette,
			Art.nearest(Color3.fromRGB(math.floor(hex / 65536) % 256, math.floor(hex / 256) % 256, hex % 256))
		)
	end
