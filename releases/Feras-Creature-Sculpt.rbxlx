	vaporino = { tilt = -0.14, mouth = "o", look = 0.14 },
	magmaterra = { tilt = 0.28, mouth = "tusk", look = -0.1 },
	tempestalia = { tilt = 0.2, mouth = "beak", look = 0.08 },
